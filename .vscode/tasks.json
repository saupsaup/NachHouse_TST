{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	// Attention: Keep structure and do not change labels of this file!
	"version": "2.0.0",
	"tasks": [
		
	// ============================================================
		// 1️⃣  MAPOVANIE DISKU M: (Mac → Windows VM)
		// ============================================================
		{
  "label": "Map M:",
  "type": "shell",
  "command": "prlctl",
  "args": [
    "exec",
    "ae0a527c-1a74-4e39-9845-1622f6a3c782",
    "cmd",
    "/c",
   // "net use"
		"${config:mosaic.mosaicBin}MosaicL.exe",
					"-ttr",
				"-lnk",
				"-sg+",
				"-sr-",
				"-log-",
				"-pub",
				"-olc-",
				"-psw-",
				"-plcpsw-",
				"-sc-",
				"-sl-",
				"-exml-",
				"-epub-",
				"-eexp+",
				"\"${config:mosaic.makPathWin}.mak\""
//				"${mosaic.makPathWin}.mak"
			],
			"options": {
				"cwd": "${workspaceFolder}"

},

			//    "net use M: /delete /y >nul 2>&1 & net use M: \\\\Mac\\Mosaic /persistent:yes"
    "problemMatcher": []
},

				{
			"label": "Mac-Build----",
			"type": "shell",
			"command": "prlctl",
			"args": [
				"exec",
				"${config:mosaic.vmName}",
				"cmd",
				"/v:on",
				"/c",
				"cd /d \"${config:mosaic.mosaicBin}\" && MosaicL.exe -ttr -lnk -sg+ -sr- -log- -pub -olc- -psw- -plcpsw- -sc- -sl- -exml- -epub- -eexp+ \"${config:mosaic.makPathWin}\""
//				"cd /d \"${config:mosaic.mosaicBin}\" && MosaicL.exe -ttr -lnk -sg+ -sr- -log- -pub -olc- -psw- -plcpsw- -sc- -sl- -exml- -epub- -eexp+ \"${workspaceFolder}/APP.mak"
],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			// ========================================================
			// 🧩 PARSOVANIE CHÝB DO OKNA "PROBLEMS"
			// ========================================================
			"problemMatcher": [
				{
					"owner": "st",
					"fileLocation": ["relative", "${workspaceFolder}/0"],
					"pattern": { 
						"regexp": "^\\[ST:(Error|Warning)\\]\\s+([_A-Za-z0-9\\.-]+)\\s+\\((\\d+),\\s*(\\d+)\\):\\s*(.*)$",
						"severity": 1,
						"file": 2,
						"line": 3,
						"column": 4,
						"message": 5
					}
				},
				{
					"owner": "st",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^\\[Xpro:(Fatal|Error)\\]\\:\\s*(.*)$",
						"severity": 1,
						"message": 2
					}
				}
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},

		
		
		
		{
			"label": "Mosaic project compiler",
			"type": "process",
			"command": "C:\\Program Files (x86)\\Teco\\Mosaic 2025.1\\Application\\MosaicL.exe",
			"args": [
				"-ttr",
				"-lnk",
				"-sg+",
				"-sr-",
				"-log-",
				"-pub",
				"-olc-",
				"-psw-",
				"-plcpsw-",
				"-sc-",
				"-sl-",
				"-exml-",
				"-epub-",
				"-eexp+",
				"${workspaceFolderBasename}.mak"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": {
				"owner": "st",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^\\[.+:(.*)\\]\\s*(.*)\\s+\\((\\d+),\\s*(\\d+)\\):\\s*(.*)$",
					"severity": 1,
					"file": 2,
					"line": 3,
					"column": 4,
					"message": 5
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Upload TecoTar",
			"type": "process",
			"command": "C:\\Program Files (x86)\\Teco\\Mosaic 2025.1\\Application\\VSC2m.exe",
			"args": [
				"192.168.33.200:61682",
				"upload-ttr",
				"--autorun"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			}
		},
		{
			"label": "Disconnect Mosaic",
			"type": "process",
			"command": "C:\\Program Files (x86)\\Teco\\Mosaic 2025.1\\Application\\VSC2m.exe",
			"args": [
				"DISCONNECT"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			}
		},
		{
			"label": "Connect Mosaic",
			"type": "process",
			"command": "C:\\Program Files (x86)\\Teco\\Mosaic 2025.1\\Application\\VSC2m.exe",
			"args": [
				"CONNECT"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			}
		},
		{
			"label": "Set PLC HALT",
			"type": "process",
			"command": "C:\\Program Files (x86)\\Teco\\Mosaic 2025.1\\Application\\VSC2m.exe",
			"args": [
				"192.168.33.200:61682",
				"halt"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			}
		},
		{
			"label": "Set PLC RUN",
			"type": "process",
			"command": "C:\\Program Files (x86)\\Teco\\Mosaic 2025.1\\Application\\VSC2m.exe",
			"args": [
				"192.168.33.200:61682",
				"run"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			}
		},
		{
			"label": "DEBUG Mosaic",
			"type": "process",
			"command": "C:\\Program Files (x86)\\Teco\\Mosaic 2025.1\\Application\\VSC2m.exe",
			"args": [
				"DEBUG"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			}
		}
	]
}
