{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile: V13",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/build-plc.cjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "st",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^\\[ST:(Error|Warning)\\]\\s+(.+?)\\s+\\((\\d+),\\s*(\\d+)\\):\\s*(.*)$",
            "severity": 1,
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "PLC: Compile + FTP upload TTR (without activation)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/ftp-upload.cjs",
        "--compile"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "PLC: Compile + FTP Upload + Activate + Verify RUN",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/deploy-plc.cjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "PLC: Compile + FTP Upload (without activation)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/deploy-plc.cjs",
        "--upload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "PLC: Activate uploaded TTR + Verify RUN",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/deploy-plc.cjs",
        "--activate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "PLC: Check V13 + RUN",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/deploy-plc.cjs",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Map N:",
      "type": "process",
      "command": "prlctl",
      "args": [
        "exec",
        "${config:mosaic.vmName}",
        "--current-user",
        "cmd",
        "/c",
        "net use N: /DELETE /y >nul 2>&1 & net use N: ${config:mosaic.shareRoot} /persistent:yes"
      ],
      "problemMatcher": []
    }
  ]
}
