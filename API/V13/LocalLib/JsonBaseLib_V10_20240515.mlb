// {LIBRARY="LOCALLIB\STDLIB_V22_20180619.MLB"}
{LIBRARY="LOCALLIB\SYSLIB_V50_20230202.MLB"}
{LIBRARY="LOCALLIB\FILELIB_V31_20231122.MLB"}

VAR_GLOBAL CONSTANT
 JSON_MAX_STACK_LEVEL {HIDDEN} : sint := 9;  (*`{ENU} max level of JSON stack {CSY} maximální úroveò JSON stacku*)

END_VAR

TYPE TJsonItem :
  STRUCT
    name             : string [255];  (*`{ENU} full name of item  {CSY} celý název položky*)
    value            : string [255];  (*`{ENU} value of item {CSY} hodnota položky*)
  END_STRUCT;
END_TYPE

TYPE TJsonParserStat {HIDDEN} : 
  (json_none2,
   json_object_name2,
   json_object_value2 
  );
END_TYPE

TYPE TJsonStackItem :
  STRUCT
    stat             : TJsonParserStat;  (*`{ENU} state of parsing {CSY} stav parseru*)
    isArray          : bool;  (*`{ENU} array flag       {CSY} pøíznak pole*)
    arrayIndex       : uint;  (*`{ENU} index of array   {CSY} index pole*)
    name             : string [31];  (*`{ENU} name of item     {CSY} název položky*)
  END_STRUCT;
END_TYPE

TYPE TJsonStack :
  STRUCT
    done {ALIGNED}   : bool;  (*`{ENU} next item is avalable {CSY} byla vyparsovaná položka*)
    eod {ALIGNED}    : bool;  (*`{ENU} end of document       {CSY} konec dokumentu*)
    error            : usint;  (*`{ENU} error code            {CSY} kód chyby*)
    errTxt           : string [32];  (*`{ENU} error description     {CSY} popis chyby*)
    maxLevel {HIDDEN} : sint;  (*`{ENU} max stack level       {CSY} max úroveò stacku*)
    level            : sint;  (*`{ENU} stack level           {CSY} úroveò stacku*)
    item             : ARRAY [0..9] OF TJsonStackItem;
  END_STRUCT;
END_TYPE

TYPE TJsonInfo :
  STRUCT
    item             : TJsonItem;  (*`{ENU} JSON parser output  {CSY} výstup JSON parseru*)
    stack            : TJsonStack;  (*`{ENU} stack for parsing   {CSY} zásobník pro analýzu dokumentu*)
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK fbJsonParser
(*`{ENU} Converts one item from JSON document into a TJsonItem structure
   {CSY} Pøevádí jednu položku JSON dokumentu do struktury TJsonItem*)
  VAR_INPUT
    start            : bool;  (*`{ENU} TRUE means start of parsing at the begin of JSON document, FALSE means continue {CSY} TRUE zaène parsovat od zaèátku JSON dat, FALSE pokraèuje tam, kde se minule skonèilo*)
    shrink           : bool;  (*`{ENU} {CSY} TRUE odstraní z bufferu již zpracovanou èást a nezpracovaný zbytek pøesune na zaèátek bufferu*)
    size             : udint;  (*`{ENU} {CSY} velikost bufferu s JSON dokumentem*)
  END_VAR
  VAR_IN_OUT
    sourceJSON       : usint;  (*`{ENU} begin of JSON document {CSY} zaèátek JSON dat*)
    jsonItem         : TJsonItem;  (*`{ENU} JSON parser output     {CSY} výstup JSON parseru*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENU} new item is ready    {CSY} byla vyparsována další položka*)
    eod              : bool;  (*`{ENU} end of JSON document {CSY} konec JSON dokumentu*)
    error            : usint;  (*`{ENU} error code           {CSY} error <> 0 ... došlo k chybì*)
    restLen          : uint;  (*`{ENU} number of bytes remaining to be processed {CSY} poèet bytù, který zbývá zpracovat*)
    jsonStack        : TJsonStack;  (*`{ENU} stack for parsing    {CSY} zásobník pro analýzu dokumentu*)
  END_VAR
  VAR
    i                : sint;
    index            : udint;
    src              : PTR_TO usint;
    end              : PTR_TO usint;
    char             : usint;
    break            : bool;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbJsonParserEx
(*`{ENU} Converts one item from JSON document into a TJsonInfo structure
   {CSY} Pøevádí jednu položku JSON dokumentu do struktury TJsonInfo*)
  VAR_INPUT
    start            : bool;  (*`{ENU} TRUE means start of parsing at the begin of JSON document, FALSE means continue  {CSY} TRUE zaène parsovat od zaèátku JSON dat, FALSE pokraèuje tam, kde se minule skonèilo*)
    shrink           : bool;  (*`{ENU} value = TRUE, removed from the buffer processed portion of the file. Unprocessed remnants of the buffer moves to the beginning the buffer {CSY} TRUE odstraní z bufferu již zpracovanou èást a nezpracovaný zbytek pøesune na zaèátek bufferu*)
    size             : udint;  (*`{ENU} buffer size with the JSON document                                               {CSY} velikost bufferu s JSON dokumentem*)
  END_VAR
  VAR_IN_OUT
    sourceJSON       : usint;  (*`{ENU} begin of JSON document                                                           {CSY} zaèátek JSON dat*)
    JsonInfo         : TJsonInfo;  (*`{ENU} JSON parser output                                                               {CSY} výstup JSON parseru*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENU} new item is ready                                                                {CSY} byla vyparsována další položka*)
    eod              : bool;  (*`{ENU} end of JSON document                                                             {CSY} konec JSON dokumentu*)
    error            : usint;  (*`{ENU} error code                                                                       {CSY} error <> 0 ... došlo k chybì*)
    restLen          : uint;  (*`{ENU} number of bytes remaining to be processed                                        {CSY} poèet bytù, který zbývá zpracovat*)
  END_VAR
  VAR
    i                : sint;
    index            : udint;
    src              : PTR_TO usint;
    end              : PTR_TO usint;
    char             : usint;
    break            : bool;
    tmp              : udint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbJsonFileParser
(*`{ENU} Parsing of JSON document from file. Information about JSON element is saved into TJsonInfo structure.
  {CSY} Parsování JSON dokumentu ze souboru. Informace o vyparsované položce je uložena do struktury TJsonInfo.*)
  VAR CONSTANT
    JSON_BUMPER      : uint :=  256;  (*`{ENU} bumper of JSON buffer                  {CSY} nárazník v JSON bufferu*)
    JSON_BUFFER_SIZE : uint :=  768;  (*`{ENU} size of JSON buffer                    {CSY} velikost bufferu*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{ENU} request for parsing                    {CSY} parsovat JSON soubor*)
  END_VAR
  VAR_IN_OUT
    fileName         : string [80];  (*`{ENU} mame of JSON file                      {CSY} jméno souboru s JSON dokumentem*)
    JsonInfo         : TJsonInfo;  (*`{ENU} result of parsing                      {CSY} výsledek parsování*)
  END_VAR
  VAR_OUTPUT
    start            : bool;  (*`{ENU} initialization flag                    {CSY} príznak inicializace bloku*)
    done             : bool;  (*`{ENU} new item is ready in JSONItem          {CSY} výsledek parsování je pripraven v JsonInfo*)
    busy             : bool;  (*`{ENU} block is busy                          {CSY} blok je zaneprázdnen*)
    eof              : bool;  (*`{ENU} end of file                            {CSY} konec souboru*)
    break            : bool;  (*`{ENU} buffer processed, continue next cycle  {CSY} buffer zpracován, pokracovat príští cyklus*)
    err              : bool;  (*`{ENU} error flag                             {CSY} príznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description                      {CSY} popis chyby*)
    fileSize         : udint;  (*`{ENU} size of file                           {CSY} velikost souboru*)
    processed        : udint;  (*`{ENU} processed                              {CSY} zpracováno (pocet znaku)*)
  END_VAR
  VAR
    rqInit           : bool;
    rqFile           : bool;
    rqParse          : bool;
    rqStart          : bool;
    trgExecOn        : R_TRIG;
    ReadFile         : ReadFromFile;
    JsonParser       : fbJsonParserEx;
    JsonBuffer       : ARRAY [0..768] OF usint;
    sumaLen          : udint;  (*`kolik nacteno ze souboru*)
    actLen           : udint;  (*`aktualni velikost JSON bufferu*)
    restLen          : uint;
  END_VAR
END_FUNCTION_BLOCK



{USES=fbJsonParser:Memset,MemcpyPtr}
{USES=fbJsonParserEx:Memset,MemcpyPtr}
{USES=fbJsonFileParser:Memset,FileInfo,GetLastErr,GetLastErrTxt}
