__DECL FUNCTION_BLOCK fbMQTT_Comm_Init {HIDDEN}
  VAR_INPUT
    connect          : bool;
    keepAlive        : bool :=  true;
    chanCode         : uint;
    remoteIP         : TIPadr;
    remotePort       : uint;
    localPort        : uint;
  END_VAR
  VAR_OUTPUT
    status           : bool;
    error            : usint;
  END_VAR
  VAR
    ethAdr           : TRemoteEthAdr;
    KeepAliveTCP     : fbKeepAliveTCP;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbMQTTPublisher
(*`{ENG} FB client (publisher) sending a text data (string type, up to 255 characters)  to the broker, using a topic name (STRING up to 80 characters).
  {CSY} FB klient (publisher) odesнlб data (typ STRING, aћ 255 znakщ) do brokeru (MQTT Broker) pomocн nбzvu tйmatu (topic, STRING max 80 znakщ)*)
  VAR_INPUT
    connect          : bool;  (*`{CSY} Pшнkaz k pшipojenн {ENU} Connect or disconnect command*)
    chanCode         : uint;  (*`{CSY} Komunikaиnн UNI kanбl {ENU} Communication UNI channel for MQTT commands and states*)
    brokerIP         : TIPadr;  (*`{CSY} IP adresa MQTT brokeru {ENU} IP address of MQTT broker*)
    brokerPort       : uint :=  1883;  (*`{CSY} port MQTT brokru (vэchozн hodnota je 1883) {ENU} port of MQTT broker (default value is 1883)*)
    localPort        : uint :=  5000;  (*`{CSY} lokбlnн port PLC {ENU} local port PLC*)
    keepAlive        : bool :=  true;  (*`{CSY} FB udrћuje komunikaиnн kanбl otevшenэ {ENU} FB keep comm channel opened during communication session (Brocker keeps all settings)*)
    keepAliveInterval : time :=  T#20s;  (*`{CSY} maximбlnн doba, po kterй broker uzavшe spojenн a vymaћe vљechna nastavenн publishera {ENU} maximum time when broker close session and clear all settings of publisher*)
    connTimeOut      : time :=  T#5s;  (*`{CSY} maximбlnн иasovэ limit odezvy od brokera {ENU} maximum timeout of response from broker*)
    pingInterval     : time :=  T#15s;  (*`{CSY} Interval pro udrћeni ћivй relace mezi publisherem a brokerem {ENU} Interval for keep alive comm session between publisher and broker MUST BE: keepAliveInterval > pingInterval*)
    clientId_auto    : bool :=  true;  (*`{CSY} ID klienta bude generovбno automaticky {ENU} client ID will be generated automatically and append timestamp to MQTT client id*)
    clientId         : string [40];  (*`{CSY} statickй ID klienta, relevantnн, kdyћ clientId_auto = false {ENU} static client ID, relevant when clientId_auto = false, therefore, this ID should be unique per client and broker.*)
    loginName        : string [40];  (*`{CSY} Pшihlaљovacн jmйno, kterй se pouћнvб v pшнpadм potшeby atorizace {ENU} A login name, using when required authorization*)
    loginPass        : string [40];  (*`{CSY} Heslo, kterй se pouћнvб v pшнpadм potшeby autorizace {ENU} A password, using when required authorization*)
    comParam         : T_MQTT_COM_PUB_PARAM;  (*`{CSY} Parametry relace MQTT {ENU} Parameters of MQTT session*)
    willParam        : T_MQTT_COM_WILL_PARAM;  (*`{CSY} Konfigurace parametrщ pro sledovбnн stavu pшipojenн mezi brokerem a uzlem MQTT. {ENU} Configuration of parameters for monitoring the connection status between the broker and the MQTT node*)
    dataTxt          : string [255];  (*`{CSY} Data k pшenosu v textovй podobм {ENU} data to transmit in text form*)
    topicTxt         : string [80];  (*`{CSY} Topic kam se data odesнlajн {ENU} topic where published sends data*)
    sendCom          : bool R_EDGE;  (*`{CSY} Pшнkaz k odeslбnн dat {ENU} command to send data*)
  END_VAR
  VAR_OUTPUT
    conn_status      : bool;  (*`{CSY} Stav pшipojenн TCP {ENU} TCP connection state*)
    connected_to_broker : bool;  (*`{CSY} Stav pшipojenн k brokeru MQTT {ENU} Connection state to MQTT broker*)
    client_id        : string [40];  (*`{CSY} ID klienta pouћitй v komunikaиnн relaci {ENU} Client ID used in communication session*)
    local_port       : uint;  (*`{CSY} Lokбlnн port PLC {ENU} Current PLC local port*)
    rxCounter        : uint;  (*`{CSY} Poинtadlo pшнchozнch zprбv {ENU} Incoming messages counter*)
    txCounter        : uint;  (*`{CSY} Poинtadlo odchozнch zprбv {ENU} Outgoing messages counter*)
    messageID        : uint;  (*`{CSY} ID odchozн zprбvy - pouћнvб se, kdyћ QOS > 0 {ENU} message id, used when QOS > 0*)
    busy             : bool;  (*`{CSY} FB je zaneprбzdnмn {ENU} FB is busy and not accessible for user application*)
    ok               : bool;  (*`{CSY} FB je pшipraven pшijнmat uћivatelskй pшнkazy {ENU} FB is ready for user app commands*)
    err              : bool;  (*`{CSY} Vyskytla se chyba {ENU} Error occurred*)
    errCode          : usint;  (*`{CSY} Kуd chyby {ENU} Code of error*)
    msgCounter       : uint;  (*`{CSY} Poиet odchozнch mqtt zprбv  {ENU} Count of outgoing mqtt messages*)
  END_VAR
  VAR
    MQTT_Comm_Init   : fbMQTT_Comm_Init;
    MQTT_ping_timer  : fbTick;
    MQTT_com_intervat : fbTick;
    MQTT_com_responce_timeout : TON;
    SendTo           : fbSendTo;
    RecvFrom         : fbRecvFrom;
    txData           : ARRAY [0..512] OF usint;
    rxData           : ARRAY [0..512] OF usint;
    payloadLengthArrayTemp : ARRAY [1..4] OF usint;
    MQTT_PROTOCOL    : string [4] :=  'MQTT';
    txMsgLength      : uint;
    payloadLength    : uint;
    payloadLength1   : uint;
    txMsgLengthTemp  : uint;
    encodedByte      : byte;
    tx_data_request  : bool;
    localPortExtension : uint;
    idle_time        : usint;
    payloadLengthSize : usint;
    reconnect_counter : usint;
    wait_response    : bool;
    connectFlags     : byte;
    aliveTime        : uint;
    pubReleaseRq     : bool;
    messageIDpubRel  : uint;
    messageIDpubRel_ptr : PTR_TO uint;
    index            : usint;
    responce_recived : bool;
    messageIDlast    : uint;
    msgLenShift      : uint;
    wait_response_command : byte;
  END_VAR
  VAR CONSTANT
    MQTT_PROTOCOL_VERSION : usint :=  4;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbMQTTPublisherEx
(*`{ENG} FB client sending a data up to 1200 bytes (text/binary) to the broker, using a topic name.
  {CSY} FB klient posilб data aћ 1200 bytu (text / binбrnн) do brokeru pomocн nбzvu tйmatu (topic).*)
  VAR_INPUT
    connect          : bool;  (*`{CSY} Pшнkaz k pшipojenн {ENU} Connect or disconnect command*)
    chanCode         : uint;  (*`{CSY} Komunikaиnн UNI kanбl {ENU} Communication UNI channel for MQTT commands and states*)
    brokerIP         : TIPadr;  (*`{CSY} IP adresa MQTT brokeru {ENU} IP address of MQTT broker*)
    brokerPort       : uint :=  1883;  (*`{CSY} port MQTT brokru (vэchozн hodnota je 1883) {ENU} port of MQTT broker (default value is 1883)*)
    localPort        : uint :=  5000;  (*`{CSY} lokбlnн port PLC {ENU} local port PLC*)
    keepAlive        : bool :=  true;  (*`{CSY} FB udrћuje komunikaиnн kanбl otevшenэ {ENU} FB keep comm channel opened during communication session (Brocker keeps all settings)*)
    keepAliveInterval : time :=  T#20s;  (*`{CSY} maximбlnн doba, po kterй broker uzavшe spojenн a vymaћe vљechna nastavenн publishera {ENU} maximum time when broker close session and clear all settings of publisher*)
    connTimeOut      : time :=  T#5s;  (*`{CSY} maximбlnн иasovэ limit odezvy od brokera {ENU} maximum timeout of response from broker*)
    pingInterval     : time :=  T#15s;  (*`{CSY} Interval pro udrћeni ћivй relace mezi publisherem a brokerem {ENU} Interval for keep alive comm session between publisher and broker MUST BE: keepAliveInterval > pingInterval*)
    clientId_auto    : bool :=  true;  (*`{CSY} ID klienta bude generovбno automaticky {ENU} client ID will be generated automatically and append timestamp to MQTT client id*)
    clientId         : string [40];  (*`{CSY} statickй ID klienta, relevantnн, kdyћ clientId_auto = false {ENU} static client ID, relevant when clientId_auto = false, therefore, this ID should be unique per client and broker.*)
    loginName        : string [40];  (*`{CSY} Pшihlaљovacн jmйno, kterй se pouћнvб v pшнpadм potшeby atorizace {ENU} A login name, using when required authorization*)
    loginPass        : string [120];  (*`{CSY} Heslo, kterй se pouћнvб v pшнpadм potшeby autorizace {ENU} A password, using when required authorization*)
    comParam         : T_MQTT_COM_PUB_PARAM;  (*`{CSY} Parametry relace MQTT {ENU} Parameters of MQTT session*)
    willParam        : T_MQTT_COM_WILL_PARAM;  (*`{CSY} Konfigurace parametrщ pro sledovбnн stavu pшipojenн mezi brokerem a uzlem MQTT. {ENU} Configuration of parameters for monitoring the connection status between the broker and the MQTT node*)
    topicTxt         : string [80];  (*`{CSY} Topic kam se data odesнlajн {ENU} topic where published sends data*)
    sendCom          : bool R_EDGE;  (*`{CSY} Pшнkaz k odeslбnн dat {ENU} command to send data*)
    pData            : PTR_TO usint;  (*`{CSY} Pointer na buffer/pamмќ odchozнch dat {ENU} pointer to buffer of outgoing data*)
    dataLength       : uint;  (*`{CSY} Dйlka zprбvy {ENU} length of message*)
  END_VAR
  VAR_OUTPUT
    conn_status      : bool;  (*`{CSY} Stav pшipojenн TCP {ENU} TCP connection state*)
    connected_to_broker : bool;  (*`{CSY} Stav pшipojenн k brokeru MQTT {ENU} Connection state to MQTT broker*)
    client_id        : string [40];  (*`{CSY} ID klienta pouћitй v komunikaиnн relaci {ENU} Client ID used in communication session*)
    local_port       : uint;  (*`{CSY} Lokбlnн port PLC {ENU} Current PLC local port*)
    rxCounter        : uint;  (*`{CSY} Poинtadlo pшнchozнch zprбv {ENU} Incoming messages counter*)
    txCounter        : uint;  (*`{CSY} Poинtadlo odchozнch zprбv {ENU} Outgoing messages counter*)
    messageID        : uint;  (*`{CSY} ID odchozн zprбvy - pouћнvб se, kdyћ QOS > 0 {ENU} message id, used when QOS > 0*)
    busy             : bool;  (*`{CSY} FB je zaneprбzdnмn {ENU} FB is busy and not accessible for user application*)
    ok               : bool;  (*`{CSY} FB je pшipraven pшijнmat uћivatelskй pшнkazy {ENU} FB is ready for user app commands*)
    err              : bool;  (*`{CSY} Vyskytla se chyba {ENU} Error occurred*)
    errCode          : usint;  (*`{CSY} Kуd chyby {ENU} Code of error*)
    msgCounter       : uint;  (*`{CSY} Poиet odchozнch mqtt zprбv  {ENU} Count of outgoing mqtt messages*)
    mesSent {HIDDEN} : bool;  (*`{CSY} {ENU} message sent*)
    mesRec {HIDDEN}  : bool;  (*`{CSY} {ENU} message recieved*)
    mesType {HIDDEN} : usint;  (*`{CSY} {ENU} type of message*)
    txMsgLength {HIDDEN} : uint;  (*`{CSY} {ENU} length of outgoing message*)
  END_VAR
  VAR
    MQTT_Comm_Init   : fbMQTT_Comm_Init;
    MQTT_ping_timer  : fbTick;
    MQTT_com_intervat : fbTick;
    MQTT_com_responce_timeout : TON;
    SendTo           : fbSendTo;
    RecvFrom         : fbRecvFrom;
    txData           : ARRAY [0..1350] OF usint;
    rxData           : ARRAY [0..512] OF usint;
    payloadLengthArrayTemp : ARRAY [1..4] OF usint;
    MQTT_PROTOCOL    : string [4] :=  'MQTT';
    payloadLength    : uint;
    payloadLength1   : uint;
    txMsgLengthTemp  : uint;
    encodedByte      : byte;
    tx_data_request  : bool;
    localPortExtension : uint;
    idle_time        : usint;
    payloadLengthSize : uint;
    reconnect_counter : usint;
    wait_response    : bool;
    connectFlags     : byte;
    aliveTime        : uint;
    pubReleaseRq     : bool;
    messageIDpubRel  : uint;
    messageIDpubRel_ptr : PTR_TO uint;
    index            : uint;
    responce_recived : bool;  (*`{CSY} {ENU} code of error*)
    messageIDlast    : uint;
    msgLenShift      : uint;
    wait_response_command : byte;
  END_VAR
  VAR CONSTANT
    MQTT_PROTOCOL_VERSION : usint :=  4;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbMQTTSubscriber
(*`{ENG} FB acts as client for incoming data in text form
        A client-subscriber tells the broker which topics interest it.
        Once subscribed, the broker sends messages published to that topic.
        A client can subscribe to multiple topics.
  {CSY} FB funguje jako klient pro pшнchozн data v textovй podobм
        FB navazuje komunikaci s definovanym MQTT brokerem a sdмluje brokeru, kterб tйmata (topiky) ho zajнmajн.
        Po pшihlбљenн broker odeљle zprбvy publikovanй k tomuto tйmatu.
        Klient se mщћe pшihlбsit k odbмru vнce tйmat.*)
  VAR_INPUT
    connect          : bool;  (*`{CSY} Pшнkaz k pшipojenн {ENU} Connect or disconnect command*)
    chanCode         : uint;  (*`{CSY} Komunikaиnн UNI kanбl {ENU} Communication UNI channel for MQTT commands and states*)
    brokerIP         : TIPadr;  (*`{CSY} IP adresa MQTT brokeru {ENU} IP address of MQTT broker*)
    brokerPort       : uint :=  1883;  (*`{CSY} port MQTT brokeru (vэchozн hodnota je 1883) {ENU} port of MQTT broker (default value is 1883)*)
    localPort        : uint :=  5000;  (*`{CSY} lokбlnн port PLC {ENU} local port PLC*)
    keepAlive        : bool :=  true;  (*`{CSY} FB udrћuje komunikaиnн kanбl otevшenэ {ENU} FB keep comm channel opened during communication session (Brocker keeps all settings)*)
    keepAliveInterval : time :=  T#20s;  (*`{CSY} maximбlnн doba, kdy broker uzavшe spojenн a vymaћe vљechna nastavenн publishera {ENU} maximum time when broker close session and clear all settings of publisher*)
    connTimeOut      : time :=  T#10s;  (*`{CSY} maximбlnн иasovэ limit odezvy od brokera {ENU} maximum timeout of response from broker*)
    pingInterval     : time :=  T#15s;  (*`{CSY} Interval pro udrћenн ћivй relace mezi publisherem a brokerem {ENU} Interval for keep alive comm session between publisher and broker MUST BE: keepAliveInterval > pingInterval*)
    clientId_auto    : bool :=  true;  (*`{CSY} ID klienta bude generovбno automaticky {ENU} client ID will be generated automatically and append timestamp to MQTT client id*)
    clientId         : string [40];  (*`{CSY} statickй ID klienta, relevantnн, kdyћ clientId_auto = false {ENU} static client ID, relevant when clientId_auto = false, therefore, this ID should be unique per client and broker.*)
    loginName        : string [40];  (*`{CSY} Pшihlaљovacн jmйno, kterй se pouћнvб v pшнpadм potшeby autorizace {ENU} A login name, using when required authorization*)
    loginPass        : string [40];  (*`{CSY} Heslo, kterй se pouћнvб v pшнpadм potшeby autorizace {ENU} A password, using when required authorization*)
    comParam         : T_MQTT_COM_SUB_PARAM;  (*`{CSY} Parametry relace MQTT {ENU} Parameters of MQTT session*)
    willParam        : T_MQTT_COM_WILL_PARAM;  (*`{CSY} Konfigurace parametru pro sledovбnн stavu pripojenн mezi brokerem a uzlem MQTT. {ENU} Configuration of parameters for monitoring the connection status between the broker and the MQTT node*)
    subRq            : bool R_EDGE;  (*`{CSY} Pшihlбsit se k odbмru topiku definovanй v 'topicTxt' {ENU} Subscribe request to topic defined in 'topicTxt'*)
    unSubRq          : bool R_EDGE;  (*`{CSY} Odhlбsit tйma definovanйm v 'topicTxt' {ENU} Unsubscribe request from topic defined in 'topicTxt'*)
    topicTxt         : string [80];  (*`{CSY} Tйma k odbмru nebo odhlбљenн {ENU} Topic to subscribe or unsubscribe*)
  END_VAR
  VAR_OUTPUT
    conn_status      : bool;  (*`{CSY} Stav pшipojenн TCP {ENU} TCP connection state*)
    connected_to_broker : bool;  (*`{CSY} Stav pшipojenн k brokeru MQTT {ENU} Connection state to MQTT broker*)
    client_id        : string [40];  (*`{CSY} ID klienta pouћitй v komunikaиnн relaci {ENU} Client ID used in communication session*)
    local_port       : uint;  (*`{CSY} Lokбlnн port PLC {ENU} Current PLC local port*)
    rxCounter        : uint;  (*`{CSY} Poинtadlo pшнchozнch zprбv {ENU} Incoming messages counter*)
    txCounter        : uint;  (*`{CSY} Poиitadlo odchozнch zprбv {ENU} Outgoing messages counter*)
    messageID        : uint;  (*`{CSY} ID odchozн zprбvy pouћнvб se, kdyћ QOS > 0 {ENU} message id, used when QOS > 0*)
    busy             : bool;  (*`{CSY} FB je zaneprбzdnмn {ENU} FB is busy and not accessible for user application*)
    ok               : bool;  (*`{CSY} FB je pшipraven pшijнmat uћivatelskй pшнkazy {ENU} FB is ready for user app commands*)
    err              : bool;  (*`{CSY} Vyskytla se chyba {ENU} Error occurred*)
    errCode          : usint;  (*`{CSY} Kуd chyby {ENU} Code of error*)
    dataRec          : bool;  (*`{CSY} Indikace pшijatэch dat od brokera  {ENU} Indication of received data from broker*)
    dataRecDT        : dt;  (*`{CSY} Datum a иas naposledy pшijatэch dat od brokera {ENU} Date and time of last received data from broker*)
    dataTopicTxt     : string [80];  (*`{CSY} Topik pшijatэch dat {ENU} Topic of received data*)
    dataTxt          : string [255];  (*`{CSY} Pшijatб data {ENU} Received data, message*)
    responce_recived : bool;  (*`{CSY} Poslednн pшijatб zprбva {ENU} Responce of last command recieved*)
    msgCounter       : uint;  (*`{CSY} Инtaи pшнchozнch zprбv {ENU} Counter of incomming mqtt data messages*)
  END_VAR
  VAR
    MQTT_Comm_Init   : fbMQTT_Comm_Init;
    MQTT_ping_timer  : fbTick;
    MQTT_com_intervat : fbTick;
    MQTT_com_responce_timeout : TON;
    index            : uint;
    SendTo           : fbSendTo;
    RecvFrom         : fbRecvFrom;
    txData           : ARRAY [0..512] OF usint;
    rxInData         : ARRAY [0..512] OF usint;
    rxData           : ARRAY [0..2560] OF usint;
    rxDataOffset     : uint :=  0;
    rxDataLen        : int :=  0;
    myLenRx          : uint :=  0;
    trxDataLen       : int :=  0;
    tlenRx           : uint :=  0;
    trxDataOffset    : uint :=  0;
    tmyLenRx         : uint :=  0;
    txMsgLength      : uint;
    payloadLength    : uint;
    payloadLength1   : uint;
    MQTT_PROTOCOL    : string [4] :=  'MQTT';
    tx_data_request  : bool;
    localPortExtension : uint;
    idle_time        : usint;
    reconnect_counter : usint;
    wait_response    : bool;
    connectFlags     : byte;
    aliveTime        : uint;
    inDataCom_param  : T_MQTT_COM_SUB_PARAM;
    inTopicLen       : uint;
    inMsgLen         : uint;
    pubAckRq         : bool;
    messageIDpubAck_ptr : PTR_TO uint;
    messageIDpubAck  : uint;
    pubRecRq         : bool;
    pubCompRq        : bool;
    payloadLengthSize : uint;
    payloadLengthBytes : uint;
    dataMsgType      : byte;
    comErrorCode     : usint;
    comErrorTxt      : string [80];
    rxDataPointer    : uint;
    clearBufferWatchDog : TON;
    msgLenShift      : uint;
    txMsgLengthTemp  : uint;
  END_VAR
  VAR CONSTANT
    MQTT_PROTOCOL_VERSION : usint :=  4;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbMQTTSubscriberEx
(*`{ENG} FB acts as client for incoming data in text or binary form up to 512 bytes
        A client tells the broker which topics interest it.
        Once subscribed, the broker sends messages published to that topic.
        A client can subscribe to multiple topics.
  {CSY} FB funguje jako klient pro pшнchozн data v textovй nebo binбrnн podobм aћ do 512 bytщ
        FB navazuji komunikaci definovanym MQTT brokerema  sdмlujiн brokeru, ktere topiky ho zajнmajн.
        Po pшihlбљenн broker odeљle zprбvy publikovanй k tomuto topiku
        Klient se mщћe pшihlбsit k odbмru vнce tйmat.*)
  VAR_INPUT
    connect          : bool;  (*`{CSY} Pшнkaz k pшipojenн {ENU} Connect or disconnect command*)
    chanCode         : uint;  (*`{CSY} Komunikaиnн UNI kanбl {ENU} Communication UNI channel for MQTT commands and states*)
    brokerIP         : TIPadr;  (*`{CSY} IP adresa MQTT brokeru {ENU} IP address of MQTT broker*)
    brokerPort       : uint :=  1883;  (*`{CSY} port MQTT brokeru (vэchozн hodnota je 1883) {ENU} port of MQTT broker (default value is 1883)*)
    localPort        : uint :=  5000;  (*`{CSY} lokбlnн port PLC {ENU} local port PLC*)
    keepAlive        : bool :=  true;  (*`{CSY} FB udrћuje komunikaиnн kanбl otevшenэ {ENU} FB keep comm channel opened during communication session (Brocker keeps all settings)*)
    keepAliveInterval : time :=  T#20s;  (*`{CSY} maximбlnн doba, kdy broker uzavшe spojenн a vymaћe vљechna nastavenн publishera {ENU} maximum time when broker close session and clear all settings of publisher*)
    connTimeOut      : time :=  T#10s;  (*`{CSY} maximбlnн иasovэ limit odezvy od brokera {ENU} maximum timeout of response from broker*)
    pingInterval     : time :=  T#15s;  (*`{CSY} Interval pro udrћenн ћivй relace mezi publisherem a brokerem {ENU} Interval for keep alive comm session between publisher and broker MUST BE: keepAliveInterval > pingInterval*)
    clientId_auto    : bool :=  true;  (*`{CSY} ID klienta bude generovбno automaticky {ENU} client ID will be generated automatically and append timestamp to MQTT client id*)
    clientId         : string [40];  (*`{CSY} statickй ID klienta, relevantnн, kdyћ clientId_auto = false {ENU} static client ID, relevant when clientId_auto = false, therefore, this ID should be unique per client and broker.*)
    loginName        : string [40];  (*`{CSY} Pшihlaљovacн jmйno, kterй se pouћнvб v pшнpadм potшeby autorizace {ENU} A login name, using when required authorization*)
    loginPass        : string [120];  (*`{CSY} Heslo, kterй se pouћнvб v pшнpadм potшeby autorizace {ENU} A password, using when required authorization*)
    comParam         : T_MQTT_COM_SUB_PARAM;  (*`{CSY} Parametry relace MQTT {ENU} Parameters of MQTT session*)
    willParam        : T_MQTT_COM_WILL_PARAM;  (*`{CSY} Konfigurace parametru pro sledovбnн stavu pripojenн mezi brokerem a uzlem MQTT. {ENU} Configuration of parameters for monitoring the connection status between the broker and the MQTT node*)
    subRq            : bool R_EDGE;  (*`{CSY} Pшihlбsit se k odbмru topiku definovanй v 'topicTxt' {ENU} Subscribe request to topic defined in 'topicTxt'*)
    unSubRq          : bool R_EDGE;  (*`{CSY} Odhlбsit tйma definovanйm v 'topicTxt' {ENU} Unsubscribe request from topic defined in 'topicTxt'*)
    topicTxt         : string [80];  (*`{CSY} Tйma k odbмru nebo odhlбљenн {ENU} Topic to subscribe or unsubscribe*)
    pData            : PTR_TO usint;
  END_VAR
  VAR_OUTPUT
    conn_status      : bool;  (*`{CSY} Stav pшipojenн TCP {ENU} TCP connection state*)
    connected_to_broker : bool;  (*`{CSY} Stav pшipojenн k brokeru MQTT {ENU} Connection state to MQTT broker*)
    client_id        : string [40];  (*`{CSY} ID klienta pouћitй v komunikaиnн relaci {ENU} Client ID used in communication session*)
    local_port       : uint;  (*`{CSY} Lokбlnн port PLC {ENU} Current PLC local port*)
    rxCounter        : uint;  (*`{CSY} Poинtadlo pшнchozнch zprбv {ENU} Incoming messages counter*)
    txCounter        : uint;  (*`{CSY} Poиitadlo odchozнch zprбv {ENU} Outgoing messages counter*)
    messageID        : uint;  (*`{CSY} ID odchozн zprбvy pouћнvб se, kdyћ QOS > 0 {ENU} message id, used when QOS > 0*)
    busy             : bool;  (*`{CSY} FB je zaneprбzdnмn {ENU} FB is busy and not accessible for user application*)
    ok               : bool;  (*`{CSY} FB je pшipraven pшijнmat uћivatelskй pшнkazy {ENU} FB is ready for user app commands*)
    err              : bool;  (*`{CSY} Vyskytla se chyba {ENU} Error occurred*)
    errCode          : usint;  (*`{CSY} Kуd chyby {ENU} Code of error*)
    dataRec          : bool;  (*`{CSY} Indikace pшijatэch dat od brokera  {ENU} Indication of received data from broker*)
    dataRecDT        : dt;  (*`{CSY} Datum a иas naposledy pшijatэch dat od brokera {ENU} Date and time of last received data from broker*)
    dataTopicTxt     : string [80];  (*`{CSY} Topik pшijatэch dat {ENU} Topic of received data*)
    inMsgLen         : uint;  (*`{CSY} Poиet bajtu v pшijatй zprбve {ENU} Count of bytes in received message*)
    responce_recived : bool;  (*`{CSY} Poslednн pшijatб zprбva {ENU} Responce of last command recieved*)
    msgCounter       : uint;  (*`{CSY} Инtaи pшнchozнch zprбv {ENU} Counter of incomming mqtt data messages*)
  END_VAR
  VAR
    MQTT_Comm_Init   : fbMQTT_Comm_Init;
    MQTT_ping_timer  : fbTick;
    MQTT_com_intervat : fbTick;
    MQTT_com_responce_timeout : TON;
    index            : uint;
    i                : uint;
    SendTo           : fbSendTo;
    RecvFrom         : fbRecvFrom;
    txData           : ARRAY [0..512] OF usint;
    rxInData         : ARRAY [0..512] OF usint;
    rxData           : ARRAY [0..2560] OF usint;
    rxDataOffset     : uint :=  0;
    rxDataLen        : int :=  0;
    myLenRx          : uint :=  0;
    trxDataLen       : int :=  0;
    tlenRx           : uint :=  0;
    trxDataOffset    : uint :=  0;
    tmyLenRx         : uint :=  0;
    txMsgLength      : uint;
    payloadLength    : uint;
    payloadLength1   : uint;
    MQTT_PROTOCOL    : string [4] :=  'MQTT';
    tx_data_request  : bool;
    localPortExtension : uint;
    idle_time        : usint;
    reconnect_counter : usint;
    wait_response    : bool;
    connectFlags     : byte;
    aliveTime        : uint;
    inDataCom_param  : T_MQTT_COM_SUB_PARAM;
    inTopicLen       : uint;
    pubAckRq         : bool;
    messageIDpubAck_ptr : PTR_TO uint;
    messageIDpubAck  : uint;
    pubRecRq         : bool;
    pubCompRq        : bool;
    payloadLengthSize : uint;
    payloadLengthBytes : uint;
    dataMsgType      : byte;
    rxDataPointer    : uint;
    clearBufferWatchDog : TON;
    msgLenShift      : uint;
    txMsgLengthTemp  : uint;
    wait_response_command : byte;
    lenDataTemp      : uint;
    rxDataPointerTemp : uint;
  END_VAR
  VAR CONSTANT
    MQTT_PROTOCOL_VERSION : usint :=  4;
  END_VAR
END_FUNCTION_BLOCK



