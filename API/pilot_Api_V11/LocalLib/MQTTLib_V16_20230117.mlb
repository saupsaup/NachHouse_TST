TYPE T_MQTT_COM_PUB_PARAM :
  STRUCT
    pRetain          : bool;  (*`{CSY} Pokud je pшнznak nastaven na 1, broker udrћuje posledni zprбvu v topiku*)
    qos              : usint;  (*`{CSY} Kvalita sluћeb doruиovбnн (hodnota:0,1,2)*)
    dup              : bool;  (*`{CSY} Duplikбt je nastaven, kdyћ klient nebo broker MQTT provede opмtovnй odeslбnн paketu (pouћнvб se v PUBLISH, SUBSCRIBE, UNSUBSCRIBE, PUBREL).*)
    clean            : bool;  (*`{CSY} Pokud je pшнznak nastaven na «0», broker relaci uloћн, vљechny odbмry klienta, a pшi pшнљtнm pшipojenн mu pшedб vљechny zprбvy z QoS1 a QoS2, kterй byly pшijaty brokerem bмhem odpojenн klienta. Pokud je tedy pшнznak nastaven na «1», pшi opмtovnйm pшipojenн se klient bude muset znovu pшihlбsit k odbмru tйmat.*)
  END_STRUCT;
END_TYPE

TYPE T_MQTT_COM_SUB_PARAM :
  STRUCT
    qos              : usint;  (*`{CSY} Kvalita sluћeb doruиovбnн (hodnota:0,1,2)*)
    clean            : bool;  (*`{CSY} Pokud je pшнznak nastaven na «0», broker relaci uloћн, vљechny odbмry klienta, a pшi pшнљtнm pшipojenн mu pшedб vљechny zprбvy z QoS1 a QoS2, kterй byly pшijaty brokerem bмhem odpojenн klienta. Pokud je tedy pшнznak nastaven na «1», pшi opмtovnйm pшipojenн se klient bude muset znovu pшihlбsit k odbмru tйmat.*)
  END_STRUCT;
END_TYPE

TYPE T_MQTT_COM_WILL_PARAM :
  STRUCT
    wRetain          : bool;  (*`{CSY} Pokud je pшнznak nastaven na 1, broker udrћuje Will Message.*)
    topic            : string [80];  (*`{CSY} Topik do kterйho broker poљle Will Message v pшнpadм vэpadku komunikace*)
    mess             : string [255];  (*`{CSY} Will Message {ENU} Will Message*)
    flag             : bool;  (*`{CSY} Pokud je nastaven pшнznak, potй, co se klient odpojн od brokera bez odeslбnн pшнkazu DISCONNECT (v pшнpadм nepшedvнdatelnйho pшeruљenн komunikace atd.), broker to oznбmн vљem pшipojenэm klientщm prostшednictvнm tzv. Will Message.*)
    qos              : usint;  (*`{CSY} Kvalita sluћeb pro Will Message, pokud je nastaven pшнznak Will Flag, jsou Will QoS a Will Retain povinnй (hodnota: 0,1,2)*)
  END_STRUCT;
END_TYPE

TYPE  MQTT_EX_PUBLISHER_BUFFER : ARRAY [0..1200] OF usint;
END_TYPE

TYPE  MQTT_EX_SUBSCRIBER_BUFFER : ARRAY [0..512] OF usint;
END_TYPE

VAR_GLOBAL CONSTANT
 MQTT_CONTROL_SUBSCRIBER_IN_DATA_BUFFER_BLOCKS {HIDDEN} : usint := 5;
 MQTT_CONTROL_PACK_CONNECT {HIDDEN} : usint := 16#10;  (*`Client request to connect to Server*)
 MQTT_CONTROL_PACK_CONNACK {HIDDEN} : usint := 16#20;  (*`Connect acknowledgment*)
 MQTT_CONTROL_PACK_PUBLISH {HIDDEN} : usint := 16#30;  (*`Publish message ( Client to Server or Server to Client)*)
 MQTT_CONTROL_PACK_PUBACK {HIDDEN} : usint := 16#40;  (*`Publish acknowledgment ( Client to Server or Server to Client)*)
 MQTT_CONTROL_PACK_PUBREC {HIDDEN} : usint := 16#50;  (*`Publish received (assured delivery part 1) ( Client to Server or Server to Client)*)
 MQTT_CONTROL_PACK_PUBREL {HIDDEN} : usint := 16#60;  (*`Publish release (assured delivery part 2)*)
 MQTT_CONTROL_PACK_PUBCOMP {HIDDEN} : usint := 16#70;  (*`Publish complete (assured delivery part 3)*)
 MQTT_CONTROL_PACK_SUBSCRIBE {HIDDEN} : usint := 16#80;  (*`Client subscribe request (Client to Server)*)
 MQTT_CONTROL_PACK_SUBACK {HIDDEN} : usint := 16#90;  (*`Subscribe acknowledgment ( Server to Client)*)
 MQTT_CONTROL_PACK_UNSUBSCRIBE {HIDDEN} : usint := 16#A0;  (*`Unsubscribe request (Client to Server)*)
 MQTT_CONTROL_PACK_UNSUBACK {HIDDEN} : usint := 16#B0;  (*`Unsubscribe acknowledgment ( Server to Client)*)
 MQTT_CONTROL_PACK_PINGREQ {HIDDEN} : usint := 16#C0;  (*`PING request (Client to Server)*)
 MQTT_CONTROL_PACK_PINGRESP {HIDDEN} : usint := 16#D0;  (*`PING response ( Server to Client)*)
 MQTT_CONTROL_PACK_DISCONNECT {HIDDEN} : usint := 16#E0;  (*`Client is disconnecting (Client to Server)*)
 MQTT_CONTROL_ERROR_CODE_OK : usint := 0;  (*`{CSY} bez chyby {ENU} without failures*)
 MQTT_CONTROL_ERROR_CODE_BROKER_ANSWER_TIME_OUT : usint := 201;  (*`{CSY} broker neodpovмdмl ve stanovenйm иasovйm limitu {ENU} the broker did not respond within the set time limit*)
 MQTT_CONTROL_ERROR_CODE_SUBSCRIBE_FAILED : usint := 202;  (*`{CSY} broker nenн pшipojen {ENU} broker not connected*)
 MQTT_CONTROL_ERROR_CODE_BROKER_DISCONNECTED : usint := 203;  (*`{CSY} spojenн s brokerem nenн navбzбno {ENU} connection with the broker is not established*)
 MQTT_CONTROL_ERROR_CODE_ANSWER_LENGTH_TO_LONG : usint := 204;  (*`{CSY} pшijatб zprбva je pшнliљ dlouhб {ENU} the received message is too long*)
 MQTT_CONTROL_ERROR_CODE_LOGIN_FAILED : usint := 205;  (*`{CSY} pшihlбљenн se nezdaшilo, zkontrolujte uћivatelskй jmйno nebo heslo {ENU} login failed, check username or password*)
 MQTT_CONTROL_ERROR_CODE_BUFFER_OVERFLOW : usint := 206;  (*`{CSY} chyba pшeteиenн pшijнmaciho bufferu {ENU} receive buffer overflow error*)
 MQTT_CONTROL_ERROR_CODE_DATA_PROCESSING_ERROR : usint := 207;  (*`{CSY} chyba pri zpracovбnн pшijatй zprбvy {ENU} error processing received message*)
 MQTT_CONTROL_ERROR_CODE_PUBLISHER_PAYLOAD_OUT_OF_RANGE : usint := 208;  (*`{CSY} pшekrocena dйlka vysнlacнch dat {ENU} transmission data length exceeded*)

END_VAR

