__DECL FUNCTION AES128_encrypt : uint
(*`{CSY} AES-128 CBC šifrování
   {ENU} AES-128 CBC encryption*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes (must be divisible by 16)  {CSY} délka vstupních dat v bytech (musí být dìlitelná 16)*)
    bufferLen        : uint;  (*`{ENU} Size of output buffer in bytes                     {CSY} velikost datového bufferu v bytech*)
  END_VAR
  VAR_IN_OUT
    key              : usint;  (*`{ENU} Encryption key (16 bytes)                          {CSY} šifrovací klíè (16 bytù)*)
    iv               : usint;  (*`{ENU} Encryption init vector for CBC mode (16 bytes)     {CSY} inicializaèní vektor (16 bytù)*)
    data             : usint;  (*`{ENU} Data to encrypt in-place                           {CSY} šifrovaná data (vstup i výstup)*)
  END_VAR
  VAR_TEMP
    aesLen           : uint;
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION AES128_decrypt : uint
(*`{CSY} AES-128 CBC dešifrování
   
   {ENU} AES-128 CBC decryption*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes (must be divisible by 16)  {CSY} délka vstupních dat v bytech (musí být dìlitelná 16)*)
  END_VAR
  VAR_IN_OUT
    key              : usint;  (*`{ENU} Decryption key (16 bytes)                          {CSY} dešifrovací klíè (16 bytù)*)
    iv               : usint;  (*`{ENU} Decryption init vector for CBC mode (16 bytes)     {CSY} inicializaèní vektor (16 bytù)*)
    data             : usint;  (*`{ENU} Data to decrypt in-place                           {CSY} dešifrovaná data (vstup i výstup)*)
  END_VAR
  VAR_TEMP
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION RC4 : uint
(*`{CSY} RC4 šifrování / dešifrování
   {ENU} RC4 encryption / decryption*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes                                {CSY} délka vstupních dat v bytech*)
    keyLen           : uint;  (*`{ENU} Length of the encryption/decryption key in bytes       {CSY} délka šifrovacího / dešifrovacího klíèe v bytech*)
    skip             : uint;  (*`{ENU} How many bytes from the RC4 generator are skipped      {CSY} kolik bytù RC4 generátoru je pøeskoèeno*)
  END_VAR
  VAR_IN_OUT
    key              : usint;  (*`{ENU} Encryption / decryption key                            {CSY} šifrovací / dešifrovací klíè*)
    data             : usint;  (*`{ENU} Data to encrypt / decrypt in-place                     {CSY} šifrovaná data (vstup i výstup)*)
  END_VAR
  VAR_TEMP
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION Chacha : bool
(*`{CSY} Chacha šifrování / dešifrování. Vrací TRUE pokud nejde k žádné chybì.
   {ENU} Chacha encryption / decryption. Returns TRUE if no error occurs.*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes                                     {CSY} délka vstupních dat v bytech*)
    keyLen           : uint;  (*`{ENU} Length of the encryption/decryption key in bytes (16 or 32) {CSY} délka šifrovacího / dešifrovacího klíèe v bytech (16 or 32)*)
    nonceLen         : uint;  (*`{ENU} Length of the nonce in bytes (8 or 12)                      {CSY} délka nonce v bytech (8 or 12)*)
    rounds           : uint;  (*`{ENU} Number of rounds to be applied (8, 12 or 20)                {CSY} poèet provedených cyklù (8, 12 or 20)*)
  END_VAR
  VAR_IN_OUT
    data             : usint;  (*`{ENU} Data to encrypt / decrypt in-place   {CSY} šifrovaná data (vstup i výstup)*)
    key              : usint;  (*`{ENU} Encryption / decryption key          {CSY} šifrovací / dešifrovací klíè*)
    nonce            : usint;  (*`{ENU} Encryption / decryption nonce        {CSY} šifrovací / dešifrovací nonce*)
  END_VAR
  VAR_TEMP
    tmp              : bool;
  END_VAR
END_FUNCTION

__DECL FUNCTION Base64_encode : uint
(*`{CSY} Zakódování binárních dat pomocí ASCII znakù
         Funkce vrací velikost zakódovaného textu v bytech
   {ENU} Binary-to-text encoding
         Function returns size of encoded text in bytes*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes          {CSY} délka vstupních dat v bytech*)
    bufferLen        : uint;  (*`{ENU} Size of output buffer in bytes   {CSY} velikost datového bufferu v bytech*)
  END_VAR
  VAR_IN_OUT
    data             : usint;  (*`{ENU} Data to encode                   {CSY} vstupní data*)
    out              : usint;  (*`{ENU} encoded output                   {CSY} zakódovaný text*)
  END_VAR
  VAR_TEMP
    baseLen          : uint;
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION Base64_decode : uint
(*`{CSY} Dekódování ASCII textu na binární data
         Funkce vrací velikost dekódovaných dat v bytech
   {ENU} text-to-binary decoding
         Function returns size of decoded data in bytes*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes     {CSY} délka vstupních dat v bytech*)
  END_VAR
  VAR_IN_OUT
    data             : usint;  (*`{ENU} Data to decode              {CSY} vstupní text*)
    out              : usint;  (*`{ENU} decoded output              {CSY} dekódovaná data*)
  END_VAR
  VAR_TEMP
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION SHA1_hash : uint
(*`{CSY} Secure Hash Algorithm
         Funkce vytváøí ze vstupních dat hash (otisk) fixní délky 160 bitù reprezentovaný jako øetìzec hexadecimálních cifer (40 znakù). Funkce vrací velikost vytvoøeného otisku v bytech. Velikost promìnné hash musí být minimálnì 41 bytù, jinak funkce vrátí 0.
   {ENU} Secure Hash Algorithm
         SHA1_hash produces a 160-bit hash value which is rendered to output as a string of hexadecimal numbers, 40 digits long. Function returns size of produced hash in bytes. Size of hash variable must be 41 bytes or more. In other cases function returns 0.*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes          {CSY} délka vstupních dat v bytech*)
    bufferLen        : uint;  (*`{ENU} Size of output buffer in bytes   {CSY} velikost bufferu pro hash v bytech (minimálnì 41 bytù)*)
  END_VAR
  VAR_IN_OUT
    data             : usint;  (*`{ENU} Data to encode                   {CSY} vstupní data*)
    hash             : string [80];  (*`{ENU} output                           {CSY} výsledný hash*)
  END_VAR
  VAR_TEMP
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION SHA256_hash : uint
(*`{CSY} Secure Hash Algorithm SHA256
         Funkce vytvárí ze vstupních dat hash (otisk) fixní délky 256 bitù reprezentovaný jako øetìzec hexadecimálních cifer (64 znakù). Funkce vrací velikost vytvoøeného otisku v bytech. Velikost promìnné hash musí být minimálnì 65 bytù, jinak funkce vrátí 0.
   {ENU} Secure Hash Algorithm SHA256
         SHA1_hash produces a 256-bit hash value which is rendered to output as a string of hexadecimal numbers, 64 digits long. Function returns size of produced hash in bytes. Size of hash variable must be 65 bytes or more. In other cases function returns 0.*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes          {CSY} délka vstupních dat v bytech*)
    bufferLen        : uint;  (*`{ENU} Size of output buffer in bytes   {CSY} velikost bufferu pro hash v bytech (minimálnì 65 bytù)*)
  END_VAR
  VAR_IN_OUT
    data             : usint;  (*`{ENU} Data to encode                   {CSY} vstupní data*)
    hash             : string [80];  (*`{ENU} output                           {CSY} výsledný hash*)
  END_VAR
  VAR_TEMP
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION HMAC_SHA256 : uint
(*`{CSY} Secure Hash Algorithm HMAC-SHA256
         Funkce vytvárí ze vstupních dat hash (otisk) fixní délky 256 bitù reprezentovaný jako pole 32 bytù. Funkce vrací velikost vytvoøeného otisku v bytech. Velikost promìnné hash musí být minimálnì 32 bytù, jinak funkce vrátí 0
   {ENU} Secure Hash Algorithm HMAC-SHA256
         HMAC-SHA256 produces a 256-bit hash value which is rendered to output as byte array, 32 bytes long. Function returns size of produced hash in bytes. Size of hash variable must be 32 bytes or more. In other cases function returns 0.*)
  VAR_INPUT
    keyLen           : uint;  (*`{ENU} Length of key in bytes           {CSY} délka klíèe v bytech*)
    dataLen          : uint;  (*`{ENU} Length of data in bytes          {CSY} délka vstupních dat v bytech*)
    bufferLen        : uint;  (*`{ENU} Size of output buffer in bytes   {CSY} velikost bufferu pro hash v bytech (minimálnì 32 bytù)*)
  END_VAR
  VAR_IN_OUT
    key              : usint;  (*`{ENU} key code                         {CSY} klíè*)
    data             : usint;  (*`{ENU} Data to encode                   {CSY} vstupní data*)
    hash             : string [80];  (*`{ENU} output                           {CSY} výsledný hash*)
  END_VAR
  VAR_TEMP
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION Base64_encode_string : string
(*`{CSY}Kóduje ASCII String na Base64 String
  {ENU}Encode ASCII String to Base64 String*)
  VAR_INPUT
    data             : string [60];  (*`{ENU}input ASCII string of maximum length 60 characters {CSY}vstupní ASCII øetìzec o max. délce 60 znakù*)
  END_VAR
  VAR_TEMP
    dataLen          : uint;  (*`{ENU} length of data in bytes {CSY} délka vstupních dat v bytech*)
  END_VAR
END_FUNCTION

__DECL FUNCTION Base64_encode_ptr_string : string
(*`{CSY}Kóduje ASCII String na Base64 String
  {ENU}Encode ASCII String to Base64 String*)
  VAR_INPUT
    data             : PTR_TO usint;  (*`{ENU} pointer to first byte of data to encode {CSY}ukazatel na první byte dat ke kódování*)
    dataLen          : uint;  (*`{ENU} length of data in bytes (max. 60)       {CSY}délka vstupních dat v bytech (max. 60)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION MD5_hash : uint
(*`{CSY} MD5 Algorithm (pouze pro Foxtrot 2)
         Funkce vytváøí ze vstupních dat hash (otisk) fixní délky 128 bitù reprezentovaný jako øetìzec hexadecimálních cifer (32 znakù). Funkce vrací velikost vytvoøeného otisku v bytech. Velikost promìnné hash musí být minimálnì 33 bytù, jinak funkce vrátí 0.
   {ENU} MD5 Algorithm (Foxtrot 2 only)
         MD5_hash produces a 128-bit hash value which is rendered to output as a string of hexadecimal numbers, 32 digits long. Function returns size of produced hash in bytes. Size of hash variable must be 33 bytes or more. In other cases function returns 0.*)
  VAR_INPUT
    dataLen          : uint;  (*`{ENU} Length of data in bytes          {CSY} délka vstupních dat v bytech*)
    bufferLen        : uint;  (*`{ENU} Size of output buffer in bytes   {CSY} velikost bufferu pro hash v bytech (minimálnì 33 bytù)*)
  END_VAR
  VAR_IN_OUT
    data             : usint;  (*`{ENU} Data to encode                   {CSY} vstupní data*)
    hash             : string [80];  (*`{ENU} output                           {CSY} výsledný hash*)
  END_VAR
  VAR_TEMP
    tmp              : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION QRcode_toBmp : int
(*`{CSY} Ze vstupního textu vytvoøit QR kód a uložit ho do BMP souboru.
   Pokud je generování QR kódu bez chyby, funkce vrátí rozmìr vygenerovaného kódu, což je èíslo vìtší než 0 (napø. pokud je vygenerován kód 21x21 pixelù tak funkce vrátí 21).
   Když funkce vrátí 0 znamená to, že se nepodaøilo pøevést vstupní text na QR kód.
   Záporné hodnoty znamenají chybu a mají následující význam:
   -1 ... chybné jméno pro BMP soubor
   -2 ... nepodaøilo se otevøít/založit BMP soubor
   -3 ... došlo k pøeteèení interního pracovního bufferu (je tøeba zmenšit hodnotu scale)
   -4 ... došlo k chybì pøi zápisu do BMP souboru

  {ENU} Create a QR code from the input text and save it to a BMP file.
  If the QR code generation is error-free, the function returns the size of the generated code, which is a number greater than 0 (e.g. if a 21x21 pixel code is generated, the function returns 21).
  If the function returns 0, it means that the input text could not be converted to a QR code.
  Negative values indicate an error and have the following meaning:
  -1 ... invalid name for BMP file
  -2 ... failed to open/create the BMP file
  -3 ... the internal working buffer overflowed (the scale value needs to be reduced)
  -4 ... an error occurred while writing to the BMP file*)
  VAR_IN_OUT
    inputText        : string [255];  (*`{ENU} text that will be stored in the QR code (ASCII or UTF-8 coded)  {CSY} text, který bude uložen do QR kódu (ASCII nebo UTF-8 kódování)*)
  END_VAR
  VAR_INPUT
    errCodeLev       : usint;  (*`<0,1,2,3> {ENU} The QR Code can tolerate about <7%,15%,25%,30%> erroneous codewords  {CSY} QR kód toleruje pøibližnì <7%,15%,25%,30%> chybných kódových slov*)
    minVersion       : usint;  (*`{ENU} The minimum version number supported in the QR Code Model 2 standard: 0 = auto, <1,40> {CSY} Minimální èíslo verze podporované ve standardu QR Code Model 2: 0 = auto, <1,40>*)
    maxVersion       : usint;  (*`{ENU} The maximum version number supported in the QR Code Model 2 standard: 0 = auto, <1,40> {CSY} Maximální èíslo verze podporované ve standardu QR Code Model 2: 0 = auto, <1,40>*)
    quietZone        : usint;  (*`{ENU} The quiet zone (QR code frame width in BMP file) <0,15> {CSY} šíøka rámeèku QR kódu v BMP souboru <0,15>*)
    bmpFileName      : string [80];  (*`{ENU} Name of the BMP file where the QR code will be saved {CSY} název BMP souboru, kam se uloží QR kód*)
    bmpScale         : usint :=  1;  (*`{ENU} BMP image magnification <1.10>, default value = 1 {CSY} zvìtšení BMP obrázku <1,10>, výchozí hodnota = 1*)
    invertedBmp      : bool;  (*`{ENU} TRUE = draw BMP image inversely (white on black background) {CSY} TRUE = nakreslit BMP obrázek inverznì (bílá na èerném pozadí)*)
  END_VAR
  VAR_TEMP
    tmp              : int;
  END_VAR
END_FUNCTION

__DECL FUNCTION SPD_Sanitize {HIDDEN} : string [255]
  VAR_IN_OUT
    InStr            : string [255];
  END_VAR
  VAR
    i                : int;
    ch               : string [1];
    ln               : int;
  END_VAR
  VAR_TEMP
    ptrCh            : PTR_TO usint;
    ptrIn            : PTR_TO usint;
    ptrOut           : PTR_TO usint;
  END_VAR
END_FUNCTION

__DECL FUNCTION SPayD_string : string [255]
(*`{CSY} Vytvoøit Short Payment Descriptor
        viz https:www.cbaonline.cz/clanky/format-pro-sdileni-platebnich-udaju-v-czk-qr-kody
  {ENU} Create Short Payment Descriptor
        see https:www.cbaonline.cz/clanky/format-pro-sdileni-platebnich-udaju-v-czk-qr-kody*)
  VAR_INPUT
    ACC              : string [46];  (*`{CSY} úèet pøíjemce: ideálnì IBAN (CZ...), pøípadnì BBAN dle bank {ENU} recipient's account: ideally IBAN (CZ...), or BBAN depending on the bank*)
    CC               : string [3];  (*`{CSY} mìna, typicky 'CZK' {ENU} currency, typically 'CZK'*)
    AM               : string [10];  (*`{CSY} èástka ve tvaru '1500.00' (2 desetinná místa oddìlená teèkou) {ENU} amount in the form '1500.00' (2 decimal places separated by dot)*)
    MSG              : string [60];  (*`{CSY} zpráva pro pøíjemce       {ENU} message to recipient*)
    VS               : string [10];  (*`{CSY} variabilní symbol -> X-VS {ENU} variable symbol -> X-VS*)
    SS               : string [10];  (*`{CSY} specifický symbol -> X-SS {ENU} specific symbol -> X-SS*)
    KS               : string [10];  (*`{CSY} konstantní symbol -> X-KS {ENU} constant symbol -> X-KS*)
    DDT              : date;  (*`{CSY} datum splatnosti          {ENU} due date*)
    RN               : string [35];  (*`{CSY} jméno pøíjemce            {ENU} recipient's name*)
    PT               : string [3];  (*`{CSY} typ platby, napø. 'IP' pro okamžitou (pokud to banka respektuje) {ENU} payment type, e.g. 'IP' for immediate (if the bank respects it)*)
  END_VAR
  VAR
    s                : string [255];
    tmp              : string [255];
  END_VAR
END_FUNCTION



{USES=SPayD_string:SPD_Sanitize,DATE_TO_STRINGF}
#srcfile 'D:\TECOLIBSRC\ENCRYPTLIB\ENCRYPTLIB\AES128_ENCRYPT.ST'
#pou AES128_encrypt
#srcline 10 ;FUNCTION AES128_encrypt : UINT

#struct AES128_encrypt__temp__
  uint aesLen,
  uint tmp
P     61
AES128_encrypt_L0:
 LINK __SizeOf(AES128_encrypt__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__AES128_encrypt
; End initialize - variables
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 31 ;  aesLen := (dataLen / 16) * 16;
 LDX  dataLen
#debug uint dataLen
 LD   uint 16
 DIVL
 AND  $FFFF
 LD   uint 16
 MUL
 AND  $FFFF
 WRY  aesLen
#debug_left uint aesLen
#srcline 32 ;  IF dataLen > aesLen THEN aesLen := aesLen + 16; END_IF;
 LDX  dataLen
#debug uint dataLen
 LDY  aesLen
#debug uint aesLen
 GT
 JMC  AES128_encrypt_L1
 LDY  aesLen
#debug uint aesLen
 LD   uint 16
 ADD
 AND  $FFFF
 WRY  aesLen
#debug_left uint aesLen
AES128_encrypt_L1:
#srcline 33 ;  IF aesLen > bufferLen THEN
 LDY  aesLen
#debug uint aesLen
 LDX  bufferLen
#debug uint bufferLen
 GT
 JMC  AES128_encrypt_L3
#srcline 34 ;    AES128_encrypt := 0; RETURN;   // malo mista v bufferu
 LD   uint 0
 WRX  __fc__AES128_encrypt
#debug_left uint AES128_encrypt
 JMP  AES128_encrypt_RET
#srcline 35 ;  END_IF;
AES128_encrypt_L3:
#srcline 36 ;  {asm}
#srcline 37
    LDX      key
#srcline 38
    LDX      iv
#srcline 39
    LDX      data
#srcline 40
    LDY      aesLen
#srcline 41
    LD       1
#srcline 42
    SYS      85         ; SYS 85, subcode 1
#srcline 43
    WRY      tmp        ; delka vystupnich dat
#srcline 44 ;  {end_asm}
#srcline 45 ;  AES128_encrypt := tmp;
 LDY  tmp
#debug uint tmp
 WRX  __fc__AES128_encrypt
#debug_left uint AES128_encrypt
#srcline 46 ;END_FUNCTION
AES128_encrypt_RET:
 PRV  
 LDX  __fc__AES128_encrypt
 ULNK
RET
E     61
#endpou 

#pou AES128_decrypt
#srcline 56 ;FUNCTION AES128_decrypt : UINT

#struct AES128_decrypt__temp__
  uint tmp
P     61
AES128_decrypt_L0:
 LINK __SizeOf(AES128_decrypt__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__AES128_decrypt
; End initialize - variables
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 76 ;  IF MOD(IN1 := dataLen, IN2 := 16) <> 0 THEN
 LDX  dataLen
#debug uint dataLen
 LD   uint 16
 MOD
 AND  $FFFF
 LD   uint 0
 EQ
 NEG
 JMC  AES128_decrypt_L1
#srcline 77 ;    AES128_decrypt := 0; RETURN;   // delka neni modulo 16
 LD   uint 0
 WRX  __fc__AES128_decrypt
#debug_left uint AES128_decrypt
 JMP  AES128_decrypt_RET
#srcline 78 ;  END_IF;
AES128_decrypt_L1:
#srcline 79 ;  {asm}
#srcline 80
    LDX      key
#srcline 81
    LDX      iv
#srcline 82
    LDX      data
#srcline 83
    LDX      dataLen
#srcline 84
    LD       2
#srcline 85
    SYS      85         ; SYS 85, subcode 2
#srcline 86
    WRY      tmp        ; delka vystupnich dat
#srcline 87 ;  {end_asm}
#srcline 88 ;  AES128_decrypt := tmp;
 LDY  tmp
#debug uint tmp
 WRX  __fc__AES128_decrypt
#debug_left uint AES128_decrypt
#srcline 89 ;END_FUNCTION
AES128_decrypt_RET:
 PRV  
 LDX  __fc__AES128_decrypt
 ULNK
RET
E     61
#endpou 

#pou RC4
#srcline 100 ;FUNCTION RC4 : UINT

#struct RC4__temp__
  uint tmp
