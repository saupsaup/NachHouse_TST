#pou QRcode_toBmp
#srcline 1 ;FUNCTION QRcode_toBmp : INT

#struct QRcode_toBmp__temp__
  int tmp
P     61
QRcode_toBmp_L0:
 LINK __SizeOf(QRcode_toBmp__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__QRcode_toBmp
; End initialize - variables
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 41 ;  errCodeLev := LIMIT( MN := 0, IN := errCodeLev, MX := 3);
 LDX  errCodeLev
#debug usint errCodeLev
 LD   usint 0
 MAX
 LD   usint 3
 MIN
 WRX  errCodeLev
#debug_left usint errCodeLev
#srcline 42 ;  minVersion := LIMIT( MN := 0, IN := minVersion, MX := 40);
 LDX  minVersion
#debug usint minVersion
 LD   usint 0
 MAX
 LD   usint 40
 MIN
 WRX  minVersion
#debug_left usint minVersion
#srcline 43 ;  maxVersion := LIMIT( MN := 0, IN := maxVersion, MX := 40);
 LDX  maxVersion
#debug usint maxVersion
 LD   usint 0
 MAX
 LD   usint 40
 MIN
 WRX  maxVersion
#debug_left usint maxVersion
#srcline 44 ;  quietZone  := LIMIT( MN := 0, IN := quietZone,  MX := 15);
 LDX  quietZone
#debug usint quietZone
 LD   usint 0
 MAX
 LD   usint 15
 MIN
 WRX  quietZone
#debug_left usint quietZone
#srcline 45 ;  bmpScale   := LIMIT( MN := 1, IN := bmpScale,   MX := 10);
 LDX  bmpScale
#debug usint bmpScale
 LD   usint 1
 MAX
 LD   usint 10
 MIN
 WRX  bmpScale
#debug_left usint bmpScale
#srcline 46 ;  {asm}
#srcline 47
    LDX  bmpScale     ; zvetseni bmp obrazku <1,10>
#srcline 48
    LDX  invertedBmp  ; invertovat BMP
#srcline 49
    AND  16#00000080
#srcline 50
    OR
#srcline 51
    LDX  inputText    ; input text
#srcline 52
    LEAX bmpFileName  ; output file
#srcline 53
    LDX  errCodeLev   ; redundance QR kódu
#srcline 54
    LDX  minVersion
#srcline 55
    LD   8
#srcline 56
    SHL
#srcline 57
    OR
#srcline 58
    LDX  maxVersion
#srcline 59
    LD   16
#srcline 60
    SHL
#srcline 61
    OR
#srcline 62
    LDX  quietZone
#srcline 63
    LD   24
#srcline 64
    SHL
#srcline 65
    OR                ; nejnizsi byte = errCodeLev, byte+1 = minVersion QR code, byte+2 = maxVersion QR code, byte+3 = ramecek
#srcline 66
    LD   14           ; subkod CreateQRcodeAndSaveAsBmp
#srcline 67
    SYS  85           ; SYS 101
#srcline 68
    WRY  tmp
#srcline 69 ;  {end_asm}
#srcline 70 ;  QRcode_toBmp := tmp;  // velikost vygenerovaného QR kódu (v pixelech), 0 nebo záporné èíslo = generování QR kódu selhalo
 LDY  tmp
#debug int tmp
 EXTW 
 WRX  __fc__QRcode_toBmp
#debug_left int QRcode_toBmp
#srcline 71 ;END_FUNCTION
 PRV  
 LDX  __fc__QRcode_toBmp
 EXTW 
 ULNK
RET
E     61
#endpou 



 

#srcfile ''
#srcfile 'D:\TECOLIBSRC\ENCRYPTLIB\ENCRYPTLIB\SPD_STRING.ST'
#pou SPD_Sanitize
#srcline 45 ;FUNCTION SPD_Sanitize {HIDDEN}: STRING[255]

#struct SPD_Sanitize__temp__
  pointer ptrCh,
  pointer ptrIn,
  pointer ptrOut,
  int P0__st__
#data byte _str_SPD_Sanitize_0 = 
  '*',0
#data byte _str_SPD_Sanitize_1 = 
  '\','r',0
#data byte _str_SPD_Sanitize_2 = 
  '\','n',0
#data byte _str_SPD_Sanitize_3 = 
  '*',0
P     61
SPD_Sanitize_L0:
 LINK __SizeOf(SPD_Sanitize__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__SPD_Sanitize
 WRX  i
 WRX  ch
 WRX  ln
; End initialize - variables
; Initialize - dynamic variables
 LD   udint $FFFFFFFF    ; nil
 WRY  ptrCh
 LD   udint $FFFFFFFF    ; nil
 WRY  ptrIn
 LD   udint $FFFFFFFF    ; nil
 WRY  ptrOut
; End initialize - dynamic variables
#srcline 60 ;  ptrIn  := ADR( InStr);
 LDX  InStr
#debug pointer InStr
 LEAY ptrIn
 WRIL 
#debug_left pointer ptrIn
#srcline 61 ;  ptrCh  := ADR( ch);
 LEAX ch
#debug pointer ch
 LEAY ptrCh
 WRIL 
#debug_left pointer ptrCh
#srcline 62 ;  ptrOut := ADR( SPD_Sanitize);
 LEAX __fc__SPD_Sanitize
#debug pointer SPD_Sanitize
 LEAY ptrOut
 WRIL 
#debug_left pointer ptrOut
#srcline 63 ;  ln := LEN(IN := InStr);
 LDX  InStr
#debug string InStr
 SLEN 
 WRX  ln
#debug_left int ln
#srcline 64 ;  IF ln > 0 THEN
 LDX  ln
#debug int ln
 EXTW 
 LD   int 0
 GTS
 JMC  SPD_Sanitize_L1
#srcline 65 ;    WHILE ptrIn^ = 16#20 DO ptrIn := ptrIn + 1; END_WHILE;  // trim leading spaces
SPD_Sanitize_L3:
 LEAY ptrIn
 LDIL    ; dereference 
 LDI  
#debug usint ptrIn^
 LD   usint $20
 EQ
 JMC  SPD_Sanitize_L4
 DBG 
 LEAY ptrIn
 LDIL 
#debug pointer ptrIn
 LD   udint 1
 ADD
 LEAY ptrIn
 WRIL 
#debug_left pointer ptrIn
 JMP  SPD_Sanitize_L3
SPD_Sanitize_L4:
 NOP  -1
#srcline 66 ;    ln := ln - UDINT_TO_INT( PTR_TO_UDINT(ptrIn) - PTR_TO_UDINT( ADR( InStr)));
 LDX  ln
#debug int ln
 EXTW 
 LEAY ptrIn
 LDIL 
#debug pointer ptrIn
 LDX  InStr
#debug pointer InStr
 SUB
 EXTW
 SUB
 EXTW
 WRX  ln
#debug_left int ln
#srcline 67 ;    FOR i := 1 TO ln DO
 LD   int 1
 WRX  i
 LDX  ln
#debug int ln
 EXTW 
 WRY  P0__st__
SPD_Sanitize_L5:
 LDX  i
 EXTW 
 LDY  P0__st__
 EXTW 
 GTS  
 JMD  SPD_Sanitize_L6
 DBG  
#srcline 68 ;      ptrCh^ := ptrIn^;
 LEAY ptrIn
 LDIL    ; dereference 
 LDI  
#debug usint ptrIn^
 LEAY ptrCh
 LDIL    ; dereference 
 WRI 
#debug_left usint ptrCh^
#srcline 69 ;      // Drop SPD separators and newlines
#srcline 70 ;      IF(ch <> '*') AND (ch <> '\r') AND (ch <> '\n') THEN
 LEAX ch
#debug string ch
 LEA  _str_SPD_Sanitize_0
 SCMP 
 EQ   0
 NEG
 LEAX ch
#debug string ch
 LEA  _str_SPD_Sanitize_1
 SCMP 
 EQ   0
 NEG
 AND
 LEAX ch
#debug string ch
 LEA  _str_SPD_Sanitize_2
 SCMP 
 EQ   0
 NEG
 AND
 JMC  SPD_Sanitize_L7
#srcline 71 ;        ptrOut^ := ptrIn^;  // copy char to output
 LEAY ptrIn
 LDIL    ; dereference 
 LDI  
#debug usint ptrIn^
 LEAY ptrOut
 LDIL    ; dereference 
 WRI 
#debug_left usint ptrOut^
#srcline 72 ;        ptrOut := ptrOut + 1;
 LEAY ptrOut
 LDIL 
#debug pointer ptrOut
 LD   udint 1
 ADD
 LEAY ptrOut
 WRIL 
#debug_left pointer ptrOut
#srcline 73 ;      ELSE
 JMP  SPD_Sanitize_L8
SPD_Sanitize_L7:
#srcline 74 ;        IF ch = '*' THEN                           // znak '*' nahradit v textu '%2A' (jako v url)
 LEAX ch
#debug string ch
 LEA  _str_SPD_Sanitize_3
 SCMP 
 EQ   0
 JMC  SPD_Sanitize_L9
#srcline 75 ;          ptrOut^ := 16#25; ptrOut := ptrOut + 1;  // %
 LD   usint $25
 LEAY ptrOut
 LDIL    ; dereference 
 WRI 
#debug_left usint ptrOut^
 LEAY ptrOut
 LDIL 
#debug pointer ptrOut
 LD   udint 1
 ADD
 LEAY ptrOut
 WRIL 
#debug_left pointer ptrOut
#srcline 76 ;          ptrOut^ := 16#32; ptrOut := ptrOut + 1;  // 2
 LD   usint $32
 LEAY ptrOut
 LDIL    ; dereference 
 WRI 
#debug_left usint ptrOut^
 LEAY ptrOut
 LDIL 
#debug pointer ptrOut
 LD   udint 1
 ADD
 LEAY ptrOut
 WRIL 
#debug_left pointer ptrOut
#srcline 77 ;          ptrOut^ := 16#41; ptrOut := ptrOut + 1;  // A
 LD   usint $41
 LEAY ptrOut
 LDIL    ; dereference 
 WRI 
#debug_left usint ptrOut^
 LEAY ptrOut
 LDIL 
#debug pointer ptrOut
 LD   udint 1
 ADD
 LEAY ptrOut
 WRIL 
#debug_left pointer ptrOut
#srcline 78 ;        END_IF;
SPD_Sanitize_L9:
#srcline 79 ;      END_IF;
SPD_Sanitize_L8:
#srcline 80 ;      ptrIn := ptrIn + 1;  // next char
 LEAY ptrIn
 LDIL 
#debug pointer ptrIn
 LD   udint 1
 ADD
 LEAY ptrIn
 WRIL 
#debug_left pointer ptrIn
#srcline 81 ;    END_FOR;
 LDX  i
 LD   1
 ADD  
 EXTW 
 WRX  i
 JMP  SPD_Sanitize_L5
SPD_Sanitize_L6:
 NOP  -1
#srcline 82 ;    ptrOut^ := 0;
 LD   usint 0
 LEAY ptrOut
 LDIL    ; dereference 
 WRI 
#debug_left usint ptrOut^
#srcline 83 ;    REPEAT
SPD_Sanitize_L11:
 DBG
#srcline 84 ;      ptrOut := ptrOut - 1;
 LEAY ptrOut
 LDIL 
#debug pointer ptrOut
 LD   udint 1
 SUB
 LEAY ptrOut
 WRIL 
#debug_left pointer ptrOut
#srcline 85 ;      IF ptrOut^ = 16#20 THEN ptrOut^ := 0; END_IF;
 LEAY ptrOut
 LDIL    ; dereference 
 LDI  
#debug usint ptrOut^
 LD   usint $20
 EQ
 JMC  SPD_Sanitize_L13
 LD   usint 0
 LEAY ptrOut
 LDIL    ; dereference 
 WRI 
#debug_left usint ptrOut^
SPD_Sanitize_L13:
#srcline 86 ;    UNTIL ptrOut^ <> 0 END_REPEAT;
 LEAY ptrOut
 LDIL    ; dereference 
 LDI  
#debug usint ptrOut^
 LD   usint 0
