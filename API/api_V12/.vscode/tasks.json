{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PLC: Compile + Upload + Activate + Verify RUN",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/.vscode/deploy-plc.cjs"],
			"options": {"cwd": "${workspaceFolder}"},
			"problemMatcher": [],
			"presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
			"runOptions": {"instanceLimit": 1}
		},
		{
			"label": "PLC: Compile + Upload TTR (without activation)",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/.vscode/deploy-plc.cjs", "--upload"],
			"options": {"cwd": "${workspaceFolder}"},
			"problemMatcher": [],
			"presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
			"runOptions": {"instanceLimit": 1}
		},
		{
			"label": "PLC: Activate uploaded TTR + Verify RUN",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/.vscode/deploy-plc.cjs", "--activate"],
			"options": {"cwd": "${workspaceFolder}"},
			"problemMatcher": [],
			"presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
			"runOptions": {"instanceLimit": 1}
		},
		{
			"label": "PLC: Check connection and build",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/.vscode/deploy-plc.cjs", "--check"], 
			"problemMatcher": []
		},
		{
			"label": "PLC: Run LOAD 800 tests",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/.vscode/load-800-test.cjs"],
			"options": {"cwd": "${workspaceFolder}"},
			"problemMatcher": [],
			"presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
			"runOptions": {"instanceLimit": 1}
		},
		{
			"label": "Map N:",
			"type": "shell",
			"command": "prlctl",
			"args": [
				"exec",
				"${config:mosaic.vmName}",
				"cmd",
				"/c",
				//				"net use N: /DELETE /y >nul 2>&1 & net use N: \\\\Mac\\NachHouse  /persistent:yes "
				"net use N: /DELETE /y >nul 2>&1 & net use N: ${config:mosaic.shareRoot}  /persistent:yes "
			],
		},
		{
			"label": "Compile: api_V12",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/.vscode/build-plc.cjs"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			// ========================================================
			// 🧩 PARSOVANIE CHÝB DO OKNA "PROBLEMS"
			// ========================================================
			"problemMatcher": [
				{
					"owner": "st",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"pattern": {
						"regexp": "^\\[ST:(Error|Warning)\\]\\s+(?:\\.\\.[\\\\/]){3}CORE[\\\\/]V200[\\\\/]200[\\\\/]([^\\\\/]+?)\\s+\\((\\d+),\\s*(\\d+)\\):\\s*(.*)$",
						"severity": 1,
						"file": 2,
						"line": 3,
						"column": 4,
						"message": 5
					}
				},
				{
					"owner": "st",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"pattern": {
						"regexp": "^\\[ST:(Error|Warning)\\]\\s+([_A-Za-z0-9\\.-]+)\\s+\\((\\d+),\\s*(\\d+)\\):\\s*(.*)$",
						"severity": 1,
						"file": 2,
						"line": 3,
						"column": 4,
						"message": 5
					}
				},
				{
					"owner": "st",
					"fileLocation": [
						"relative",
						"${workspaceFolder }"
					],
					"pattern": {
						"regexp": "^\\[Xpro:(Fatal|Error)\\]\\:\\s*(.*)$",
						"severity": 1,
						"message": 2
					}
				}
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
	]
}
