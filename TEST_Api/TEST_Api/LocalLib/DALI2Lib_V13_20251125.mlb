 LDIB 
#debug bool Global_DALI_in.stat.RNDOK
 JMC  fbDL2_Transceiver_L51
#srcline 164 ;          Err := 1;                                 // chyba
 LD   bool -1      ; true
 WRX  Err
#debug_left bool Err
#srcline 165 ;          ErrID := 3;                               // nenÌ uû co hledat
 LD   usint 3
 WRX  ErrID
#debug_left usint ErrID
#srcline 166 ;        END_IF;
