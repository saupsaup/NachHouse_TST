__DECL FUNCTION_BLOCK fbDL2_DT1Emergency
(*`{ENG} The function block defines the emergency lighting type DT1 and enables monitoring of basic operating states and faults. In addition, the function block allows you to manually run tests and change operating modes.
 {CSY} FunkËnÌ blok definuje nouzovÈ osvÏtlenÌ typu DT1 a umoûnuje sledovat z·kladnÌ provoznÌ stavy a poruchy. KromÏ toho funkcnÌ blok umoûnuje ruËnÏ spouötÏt testy a mÏnit provoznÌ reûimy.*)
  VAR_INPUT
    pDevReg          : udint;  (*`{ENG} A pointer to the main communication control structure through which the function block performs its registration {CSY} Ukazatel na hlavnÌ strukturu ¯ÌzenÌ komunikace, jejÌmû prost¯ednictvÌm funkËnÌ blok prov·dÌ svou registraci*)
    sAdrMan          : usint :=  255;  (*`{ENG} Short address of the relay in the range 0 to 63  {CSY} Kr·tk· adresa relÈ v rozmezÌ 0 az 63*)
    blinkEn          : bool;  (*`{ENG} A command to start authentication mode for 15 seconds, during which time the emergency light blinking.  {CSY} P¯Ìkaz pro spuötÏnÌ reûimu identifikace po dobu 15 sekund, bÏhem tÈto doby bude blikat nouzovÈ osvÏtlenÌ.*)
    webCmd           : tDALI2_DT1_WebCommands;  (*`{ENG} Individual commands for the web user interface {CSY} JednotlivÈ p¯Ìkazy pro webovÈ uûivatelskÈ rozhranÌ*)
    group            : tDALI2_Groups;  (*`{ENG} Assignment to DALI groups  {CSY} PrirazenÌ do DALI skupin*)
    scene            : tDALI2_DT1_Scene;  (*`{ENG} Assignment and configuration of DALI scenes  {CSY} PrirazenÌ a konfigurace DALI scÈn*)
    param            : tDALI2_CGearBasicParam;  (*`{ENG} Configuration of the DALI parameters stored in DALI device  {CSY} Konfigurace parametru DALI uloûen˝ch v za¯ÌzenÌ DALI*)
    fTestStart       : bool R_EDGE;  (*`{ENG} Function Test Start command {CSY} P¯Ìkaz k zah·jenÌ testu "Function test"*)
    fTestStop        : bool R_EDGE;  (*`{ENG} Function Test Stop  command {CSY} P¯Ìkaz k p¯eruöenÌ testu "Function test"*)
    dTestStart       : bool R_EDGE;  (*`{ENG} Duration Test Start command {CSY} P¯Ìkaz k zah·jenÌ testu "Duration Test"*)
    dTestStop        : bool R_EDGE;  (*`{ENG} Duration Test Stop  command {CSY} P¯Ìkaz k p¯eruöenÌ testu "Duration Test"*)
    inModeStart      : bool R_EDGE;  (*`{ENG} Inhibit  mode Start command {CSY} P¯Ìkaz pro p¯epnutÌ za¯ÌzenÌ do reûimu "Inhibit  mode"*)
    inModeStop       : bool R_EDGE;  (*`{ENG} Inhibit  mode Stop  command {CSY} P¯Ìkaz k p¯eruöenÌ reûimu "Inhibit  mode"*)
    restModeStart    : bool R_EDGE;  (*`{ENG} Rest     mode Start command {CSY} P¯Ìkaz pro p¯epnutÌ za¯ÌzenÌ do reûimu "Rest  mode"*)
    restModeStop     : bool R_EDGE;  (*`{ENG} Rest     mode Stop  command {CSY} P¯Ìkaz k p¯eruöenÌ reûimu "Rest  mode"*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENG} done {CSY}hotovo*)
    busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    err              : bool;  (*`{ENG} Err (usually responded two ballasts at a time!){CSY} Chyba (obvykle odpovÏdÏly dva p¯ed¯adnÌky najednou!)*)
    errID            : usint;  (*`{ENG} Error code: 1-Main communication FB is not connected, 2-Dali device not paired {CSY} KÛd chyby: 1-HlavnÌ komunikaËnÌ FB nenÌ propojen, 2-Dali za¯ÌzenÌ nesp·rov·no*)
    sAdr             : usint;  (*`{ENG} Current short address  {CSY} Aktu·lnÌ kr·tk· adresa*)
    actLevel         : usint;  (*`{ENG} Current power level (brightness) {CSY}Aktu·lnÌ ˙roveÚ v˝konu (jas)*)
    linkState        : bool;  (*`{ENG} Pairing status {CSY} Stav p·rov·nÌ*)
    emergCnt         : tDALI2_DT1_Device;  (*`{ENG}State structure of the function block  {CSY} Stavov· struktura funkËnÌho bloku*)
  END_VAR
  VAR
    ptrDevRegStat {HIDDEN} : PTR_TO tDALI2_DevCommNetState;
    i {HIDDEN}       : usint;
    levelLast {HIDDEN} : usint;
    blinkRq {HIDDEN} : bool;
    blinkTimer {HIDDEN} : TON;
    idenStarted      : bool;
    idenStartTrig    : R_TRIG;
    idenStart        : bool;  (*`{ENG} Identification Start - lamp blinking during 10 seconds*)
    idenRepeat       : bool;  (*`{ENG} Identification restarted every 12 seconds;*)
  END_VAR
END_FUNCTION_BLOCK

