    actRed           : usint;  (*`{ENG} Actual value of RED,   color range 1-254, 0 - off {CSY} SkuteËn· hodnota »ERVEN…, rozsah barev 1-254, 0 - vypnuto*)
    actGreen         : usint;  (*`{ENG} Actual value of GREEN, color range 1-254, 0 - off {CSY} SkuteËn· hodnota ZELEN…, barevn˝ rozsah 1-254, 0 - vypnuto*)
    actBlue          : usint;  (*`{ENG} Actual value of BLUE,  color range 1-254, 0 - off {CSY} SkuteËn· hodnota MODR¡, rozsah barev 1-254, 0 - vypnuto*)
    actWhite         : usint;  (*`{ENG} Actual value of WHITE, color range 1-254, 0 - off {CSY} SkuteËn· hodnota BÕL¡, rozsah barev 1-254, 0 - vypnuto*)
    actRGB           : T_RGB_COLOR;  (*`{ENG}Actual value RGB, format Teco                {CSY} SkuteËn· hodnota RGB, form·t Teco*)
    linkState        : bool;  (*`{ENG} Pairing status {CSY} Stav p·rov·nÌ*)
    ledCnt           : tDALI2_DT8_RGBW_Device;  (*`{ENG}State structure of the function block  {CSY} Stavov· struktura funkËnÌho bloku*)
  END_VAR
  VAR
