#srcfile ''
#srcfile 'D:\TECOLIBSRC\DALI2LIB\DALI2LIB\FB_DL2_TRANSCEIVER.ST'
#pou fbDL2_Transceiver
#srcline 4 ;  FUNCTION_BLOCK fbDL2_Transceiver  {HIDDEN}
P     61
fbDL2_Transceiver_L0:
 LINK 0
#srcline 43 ;  IF Enable AND NOT Busy THEN
 LDX  Enable
#debug bool Enable
 LDX  Busy
#debug bool Busy
 NEG
 AND
 JMC  fbDL2_Transceiver_L1
#srcline 44 ;    IF (command <> command_old) OR (Power <> Power_old) OR (Adr_Oper <> Adr_Oper_old) OR (Enable AND NOT Enable_old) THEN        // nov˝ p¯Ìkaz  nebo nov˝ operand
 LDX  command
#debug int command
 EXTW 
 LDX  command_old
#debug int command_old
 EXTW 
 EQ
 NEG
 LDX  Power
#debug usint Power
 LDX  Power_old
#debug usint Power_old
 EQ
 NEG
 OR  
 LDX  Adr_Oper
#debug usint Adr_Oper
 LDX  Adr_Oper_old
#debug usint Adr_Oper_old
 EQ
 NEG
 OR  
 LDX  Enable
#debug bool Enable
 LDX  Enable_old
#debug bool Enable_old
 NEG
 AND
 OR  
 JMC  fbDL2_Transceiver_L3
#srcline 45 ;      NewMessage.cont.CHS  := 0;
 LD   bool 0       ; false
 WRX  NewMessage~cont~CHS
#debug_left bool NewMessage.cont.CHS
#srcline 46 ;      NewMessage.cont.TRG  := 1;
 LD   bool -1      ; true
 WRX  NewMessage~cont~TRG
#debug_left bool NewMessage.cont.TRG
#srcline 47 ;      IF Adr_Oper = 16#FF AND Command = 16#FE AND Power >= 16#1D THEN
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint $FF
 EQ
 LDX  Command
#debug int Command
 EXTW 
 LD   int $FE
 EQ
 AND
 LDX  Power
#debug usint Power
 LD   usint $1D
 LT
 NEG
 AND
 JMC  fbDL2_Transceiver_L5
#srcline 48 ;          NewMessage.cont.LENM := 1;                  // z·kladnÌ prostÈ p¯Ìkazy 3 byte
 LD   bool -1      ; true
 WRX  NewMessage~cont~LENM
#debug_left bool NewMessage.cont.LENM
#srcline 49 ;      ELSE
 JMP  fbDL2_Transceiver_L6
fbDL2_Transceiver_L5:
