    Busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    Err              : bool;  (*`{ENG} Err (usually responded two ballasts at a time!){CSY} Chyba (obvykle odpovÏdÏly dva p¯ed¯adnÌky najednou!)*)
    ErrID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address, 12 - Tunable white color out of range {CSY} 1.. WatchDog odpovÏdi, 2.. Kolize dvou Short Address, 12 - Biodynamick· ˙roveÚ osvÏtlenÌ mimo rozsah*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_2012Sin;
    C_DL_ModuleOut   : tC_DL_2012Sout;
  END_VAR
  VAR
    Transciever {HIDDEN} : fbDL2_Transceiver;
    First            : bool;
    commandStep      : usint :=  0;
    colorDaliCode    : word;
  END_VAR
END_FUNCTION_BLOCK

