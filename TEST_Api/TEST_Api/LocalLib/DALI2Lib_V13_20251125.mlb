__DECL FUNCTION_BLOCK fbDL2_DT8_SetTc {HIDDEN}
(*`{$END_IF}
 
  {ENG} Tunable white color control from 2702K to 6535K {CSY} ÿÌzenÌ ˙rovnÏ biodynamickÈho osvÏtlenÌ v rozsahu 2702K to 6535K*)
  VAR_INPUT
    enab             : bool :=  TRUE;
    Set              : bool R_EDGE;
    Address          : usint;  (*`{ENG} ShortAddress= 0 .. 63 or GroupAddress= 100 .. 115 {CSY}Kr·tk· adresa= 0 .. 63 nebo Skupinov· adresa= 100 .. 115*)
    color            : uint;  (*`{ENG} Tunable white color range is from 2702K to 6535K {CSY} Biodynamick· ˙roveÚ osvÏtlenÌ v rozsahu 2702K to 6535K*)
    power            : usint;  (*`1 .. 254, 0 - off , 255 - {ENG}no change power {CSY}beze zmÏny v˝konu {DEU}unver‰ndern leistung*)
  END_VAR
  VAR_OUTPUT
