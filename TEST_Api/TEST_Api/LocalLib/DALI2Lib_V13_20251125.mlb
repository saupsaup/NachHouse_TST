 LDX  pom_Bit
#debug bool pom_Bit
 NEG
 LDX  Global_DALI_out
 MUL  8   ; -> bool pointer 
 ADD  7   ; Bool offset 
 WRIB 
#debug_left bool Global_DALI_out.CONT.ACN
#srcline 202 ;        Confirmation := 1;                          // cekat na potvrzenÌ
 LD   bool -1      ; true
 WRX  Confirmation
