#debug usint Global_DALI_in.DATA_LO
 LD   usint 2
 DIVL
 AND  $FF
 WRX  Output
#debug_left usint Output
#srcline 161 ;          Done :=1;
 LD   bool -1      ; true
 WRX  Done
#debug_left bool Done
#srcline 162 ;        END_IF;
fbDL2_Transceiver_L49:
