__DECL FUNCTION_BLOCK fbDL2_Transceiver {HIDDEN}
(*`{$END_IF}
 {ENG} transmiter and receiver of DALI commands {CSY}*)
  VAR_INPUT
    Enable           : bool;  (*`{ENG} Enable {CSY}PovolenÌ*)
    Command          : int;  (*`{ENG} Command number (-1,0..287) according to the table in the documentation {CSY} »Ìslo p¯Ìkazu (-1,0..287) podle tabulky v dokumentaci*)
    Adr_Oper         : usint;  (*`{ENG} Address [0..63,100..115,255] for commands (1..128, 267, 268) or data for commands (-2,-1 257,258,264,265.266 and 272) {CSY}Adresa[0..63,100..115,255] pro p¯Ìkazy(1 aû 128, 267, 268) nebo Data pro p¯Ìkazy (-2,-1, 257,258,264,265,266 a 272)*)
    Power            : usint;  (*`{ENG} {CSY} Pro p¯Ìkaz -1 û·dan˝ v˝kon, pro p¯Ìkaz -2 maska p¯Ìkaz˘*)
  END_VAR
  VAR_OUTPUT
    Done             : bool;  (*`{ENG} Done {CSY}Hotovo*)
    Busy             : bool;  (*`{ENG} Busy {CSY}Zpracov·nÌ*)
    Yes              : bool;  (*`{ENG} Yes {CSY} Ano*)
    Err              : bool;  (*`{ENG} Error {CSY}Chyba*)
    ErrID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address, 3.. Not what to look for*)
    Output           : usint;  (*`{ENG} Reading value {CSY}P¯eËten· hodnota*)
  END_VAR
  VAR_IN_OUT
    Global_DALI_in   : tC_DL_2012Sin;
    Global_DALI_out  : tC_DL_2012Sout;
  END_VAR
  VAR
    command_old      : int;  (*`pamÏù p¯Ìkazu*)
    Adr_Oper_old     : usint;  (*`pamÏù adresy*)
    Power_old        : usint;  (*`pamÏù Power*)
    NewMessage       : tC_DL_2012Sout;  (*`1.zpr·va pro odvysÌl·nÌ*)
    WatchDog         : TON;  (*`WatchDog pro dummy4*)
    WatchDog1        : TON;  (*`WatchDog pro Confirmace*)
    Answer           : bool;  (*`OËek·vat odpovÏÔ*)
    RqMes            : bool;
    Confirmation     : bool;  (*`je stav Ëek·nÌ na potvrzenÌ p¯es DONE =1*)
    Confirmation1    : bool;  (*`je stav Ëek·nÌ na potvrzenÌ p¯es DONE =0*)
    ARC_old          : bool;  (*`pamÏù alternace*)
    Enable_old       : bool;
    pom_Bit          : bool;
    PocOpak          : usint;  (*`poËet opakov·nÌ povel˘ p¯i chybÏ     //****Pet 1.10.2014*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION fDL2_Level_To_Power : usint
(*`{ENG}The function fDL2_Level_To_Power converts the level in percent (0.0 .. 100.0) % to DALI power (0 .. 254) according to the selected algorithm using the variable "lin_log"
  {CSY}Funkce fDL2_Level_To_Power p¯ev·dÌ ˙roveÚ v procentech (0,0 .. 100,0) % na v˝kon DALI (0 .. 254) podle zvolenÈho agoritmu pomocÌ promÏnnÈ "lin_log"*)
  VAR_INPUT
    level            : real;  (*`{ENG} Input % {CSY} Vstup %*)
    lin_log          : bool;  (*`{ENG} Output power correction 0..linear, 1..logarithmic function {CSY}korekce  v˝stupu power 0..line·rnÌ 1..logaritmick·  funkce*)
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fbDL2_ShortAdrSet2 {HIDDEN}
  VAR_INPUT
    set              : bool R_EDGE;  (*`{ENG} Store sAdrNew as SHORT ADDRESS {CSY} uloûit sAdrNew jako kr·tkou adresu*)
    reset            : bool R_EDGE;
    sAdrNew          : usint;
    sAdr             : usint;  (*`{ENG} Current short address {CSY} Aktu·lnÌ kr·tk· adresa*)
  END_VAR
  VAR_OUTPUT
    Done             : bool;  (*`{ENG} done {CSY}hotovo*)
    Busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    Err              : bool;  (*`{ENG} Err communication error or address parameter faulty. {CSY} Chyba komunikace nebo parametru*)
    ErrID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_2012Sin;
    C_DL_ModuleOut   : tC_DL_2012Sout;
  END_VAR
  VAR
    Transciever {HIDDEN} : fbDL2_Transceiver;
    cmdLevel         : uint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbDL2_ShortAdrSet
(*`{ENG} The function block allows you to change the short address of the ballast, provided that the new address is not occupied
   {CSY} FunkËnÌ blok umoûÚuje zmÏnit kr·tkou adresu p¯ed¯adnÌku za p¯edpokladu, ûe nov· adresa nenÌ obsazena*)
  VAR_INPUT
    set              : bool R_EDGE;  (*`{ENG} Store sAdrNew as SHORT ADDRESS {CSY} Uloûit sAdrNew jako kr·tkou adresu*)
    reset            : bool R_EDGE;  (*`{ENG} Stop and reset communication session {CSY}  Resetovat prov·dÏnÌ p¯Ìkazu*)
    sAdrNew          : usint;  (*`{ENG} New short address {CSY} Nov· kr·tk· adresa*)
    sAdr             : usint;  (*`{ENG} Current short address {CSY} Aktu·lnÌ kr·tk· adresa*)
  END_VAR
  VAR_OUTPUT
    Done             : bool;  (*`{ENG} done {CSY}hotovo*)
    Busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    Err              : bool;  (*`{ENG} Err communication error or address parameter faulty. {CSY} Chyba komunikace nebo parametru*)
    ErrID            : usint;  (*`{ENG} Error code 1.. Request WatchDog, 2.. Any collision of Short Address, 20..Short address sAdr outside the allowed range, 21..Short address sAdrNew outside the allowed range, 22..Module with short address sAdr does not communicate, 23..New short sAdrNew address already exists, 24..After writing the new short address sAdrNew gave the module does not respond, 25..All short addresses are occupied {CSY} Chybov˝ kÛd 1.. WatchDog odpovÏdi, 2.. Kolize dvou kr·tk˝ch adres, 20..Kr·tk· adresa sAdr mimo povolen˝ rozsah, 21..Kr·tk· adresa sAdrNew mimo povolen˝ rozsah, 22..Modul s kr·tkou adresou sAdr nekomunikuje, 23..Nov· kr·tk· sAdrNew adresa uû existuje, 24..Po zapsanÌ novÈ kr·tkÈ adresy sAdrNew dali modul neodpovÌd·, 25..Vöechny kr·tkÈ adresy jsou obsazenÈ*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_2012Sin;  (*`{ENG} Input zone of the module {CSY} VstupnÌ zÛna modulu*)
    C_DL_ModuleOut   : tC_DL_2012Sout;  (*`{ENG} Output zone of the module {CSY} V˝stupnÌ zÛna modulu*)
  END_VAR
  VAR
    Transciever {HIDDEN} : fbDL2_Transceiver;
    cmdLevel         : uint;
    freeSAdr         : usint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbDL2_Query {HIDDEN}
(*`{$END_IF}
 {ENG} reading individual parameters {CSY} ctenÌ jednotliv˝ch parametru*)
  VAR_INPUT
    enab             : bool :=  TRUE;  (*`{ENG}  {CSY}*)
    set              : bool R_EDGE;  (*`{ENG} Command trigger to reading individual parameters {CSY} spustÌ ctenÌ jednotliv˝ch parametru*)
    reset            : bool R_EDGE;  (*`{ENG}  {CSY}*)
    sAdr             : usint;  (*`{ENG} Device short address {CSY} Dali kr·tk· adresa*)
    parNum           : usint;  (*`{ENG} Number of individual parameter  {CSY} CÌslo jednotlivÈho parametru*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENG} done {CSY}hotovo*)
    busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    err              : bool;  (*`{ENG} Err (usually responded two ballasts at a time!){CSY} Chyba (obvykle odpovÏdÏly dva p¯ed¯adnÌky najednou!)*)
    errID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address {CSY} 1.. WatchDog odpovÏdi, 2.. Kolize dvou kr·tk˝ch adres, 30..DALI povel nenÌ podporovan*)
    rec              : bool;  (*`{ENG} Status of answer FALSE=not received, TRUE=received {CSY} Stav odpovÏdi FALSE=nep¯ijato, TRUE=p¯ijato*)
    parVal           : usint;  (*`{ENG} Answer value {CSY} hodnota*)
    parDes           : string [24];  (*`{ENG} Parameter description {CSY} jmÈno parametru*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_2012Sin;
    C_DL_ModuleOut   : tC_DL_2012Sout;
  END_VAR
  VAR
    Transciever {HIDDEN} : fbDL2_Transceiver;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbDL2_ReadHWAdr
(*`{ENG} Functional block allows to read DALI device 24 bit hardware address, based on short address.
       IMPORTANT: hardware address changed every time when RANDOMISE command broadcasted to the DALI bus
 {CSY} FunkËnÌ blok umoûnuje ËÌst 24bitovou hardwarovou adresu za¯ÌzenÌ DALI na z·kladÏ kr·tkÈ adresy.
       DŸLEéIT…: hardwarov· adresa se mÏnÌ po kaûdÈm spuötÏnÌ novÈ adresace na sbÏrnici DALI. fbDL2_ComControl.netAdrType := 2;*)
  VAR_INPUT
    readRq           : bool R_EDGE;  (*`{ENG} Command trigger to read random hardware address {CSY} SpustÌ ËtenÌ n·hodnÈ hardwarovÈ adresy*)
    reset            : bool R_EDGE;  (*`{ENG} Stop and reset communication session {CSY}  Resetovat prov·dÏnÌ p¯Ìkazu*)
    sAdr             : usint;  (*`{ENG} Device short address {CSY} Dali kr·tk· adresa*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENG} done {CSY}hotovo*)
    busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    err              : bool;  (*`{ENG} Err (usually responded two ballasts at a time!){CSY} Chyba (obvykle odpovÏdÏly dva p¯ed¯adnÌky najednou!)*)
    errID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address, 20..short address sAdr outside the allowed range, 22..module with short address sAdr does not communicate, 26..address hwAdrH not detected, 27..address hwAdrM not detected, 28..address hwAdrL not detected {CSY} 1.. WatchDog odpovÏdi, 2.. Kolize dvou kr·tk˝ch adres, 20..kr·tk· adresa sAdr mimo povolen˝ rozsah, 22..modul s kr·tkou adresou sAdr nekomunikuje, 26..adresa hwAdrH nenÌ zjiötÏna, 27..adresa hwAdrM nenÌ zjiötÏna, 28..adresa hwAdrL nenÌ zjiötÏna*)
    step             : usint;  (*`{ENG}  {CSY}*)
    hwAdrH           : usint;  (*`{ENG} Hardware address third byte 16#xxHHxxxx  {CSY} Hardwarov· adresa t¯etÌ bajt  16#xxHHxxxx*)
    hwAdrM           : usint;  (*`{ENG} Hardware address second byte 16#xxxxMMxx {CSY} Hardwarov· adresa druh˝ bajt 16#xxxxMMxx*)
    hwAdrL           : usint;  (*`{ENG} Hardware address first byte 16#xxxxxxLL  {CSY} PrvnÌ bajt hardwarovÈ adresy 16#xxxxxxLL*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_2012Sin;  (*`{ENG} Input zone of the module {CSY} VstupnÌ zÛna modulu*)
    C_DL_ModuleOut   : tC_DL_2012Sout;  (*`{ENG} Output zone of the module {CSY} V˝stupnÌ zÛna modulu*)
  END_VAR
  VAR
    fb_DL2_Query     : fbDL2_Query;
    cmdLevel         : usint;
    paramID          : usint;
    hwAdrHtemp       : int;
    hwAdrMtemp       : int;
    hwAdrLtemp       : int;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbDL2_HWToShortAdrSet
(*`{ENG} The function block allows you to change a short address based on a 24-bit hardware address

 {CSY} FunkËnÌ blok umoûÚuje zmÏnit kr·tkou adresu na z·klade 24bitovÈ hardwarovÈ adresy*)
  VAR_INPUT
    set              : bool R_EDGE;  (*`{ENG} Store sAdrNew as SHORT ADDRESS {CSY} P¯Ìkaz pro z·pis kr·tkÈ adresy*)
    reset            : bool R_EDGE;  (*`{ENG} Stop and reset communication session {CSY}  Resetovat prov·dÏnÌ p¯Ìkazu*)
    sAdrNew          : usint;  (*`{ENG} New short address in range 0..63 {CSY} Nova kr·tk· adresa v rozsahu 0..63*)
    hwAdrH           : usint;  (*`{ENG} Hardware address third byte  16#xxHHxxxx {CSY} Hardwarov· adresa t¯etÌ bajt 16#xxHHxxxx*)
    hwAdrM           : usint;  (*`{ENG} Hardware address second byte 16#xxxxMMxx {CSY} Hardwarov· adresa druh˝ bajt 16#xxxxMMxx*)
    hwAdrL           : usint;  (*`{ENG} Hardware address first byte  16#xxxxxxLL {CSY} PrvnÌ bajt hardwarovÈ adresy 16#xxxxxxLL*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENG} done {CSY}P¯Ìkaz proveden ( impulz trv·nÌ 1 cyklu PLC)*)
    busy             : bool;  (*`{ENG} busy, the command is still executing {CSY}P¯Ìkaz st·le vykon·v·*)
    err              : bool;  (*`{ENG} Err communication error or address parameter faulty. {CSY} Chyba komunikace nebo parametru*)
    errID            : usint;  (*`{ENG} Error code 1.. Request WatchDog, 20..The short sAdr address is outside the allowed range, 23..The new short sAdrNew address already exists, 24..After writing the new short sAdrNew address, the Dali module does not respond, 25..Dali module with hardware address (hwAdrH+hwAdrM+hwAdrL) does not respond {CSY} Chybov˝ kÛd 1.. WatchDog odpovÏdi, 20..Kr·tk· adresa sAdr mimo povolen˝ rozsah, 23..Nova kr·tk· sAdrNew adresa uû existuje, 24..Po zapsanÌ novÈ kr·tkÈ adresy sAdrNew Dali modul neodpovÌd·, 25..Dali modul s hardwarovou adresou (hwAdrH+hwAdrM+hwAdrL) nereaguje*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_2012Sin;  (*`{ENG} Input zone of the module {CSY} VstupnÌ zÛna modulu*)
    C_DL_ModuleOut   : tC_DL_2012Sout;  (*`{ENG} Output zone of the module {CSY} V˝stupnÌ zÛna modulu*)
  END_VAR
  VAR
    Transciever {HIDDEN} : fbDL2_Transceiver;
    cmdLevel         : uint :=  0;
    sAdr             : usint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbDL2_HWToShortAdrGet
(*`{ENG} The function block allows to read short address based on the 24-bit hardware address (16#xxHHMMLL) of the DALI device

 {CSY} FunkËnÌ blok umoûÚuje p¯eËÌst kr·tkou adresu na z·klade  24bitovou hardwarovou adresu za¯ÌzenÌ DALI*)
  VAR_INPUT
    get              : bool R_EDGE;  (*`{ENG} Command to read short address {CSY} P¯Ìkaz pro ËtenÌ kr·tkÈ adresy*)
