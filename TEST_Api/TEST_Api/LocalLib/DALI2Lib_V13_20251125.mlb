TYPE tDALI2_CGearStates :
  STRUCT
    BallastSate      : bool;  (*`{CSY} 0=OK,  Ballast State        {ENG} Bit 0: status of ballast; 0 = OK*)
    LampFailure      : bool;  (*`{CSY} 0=OK,  Lamp Failure         {ENG} Bit 1: lamp failure; 0 = OK*)
    LampPowerOn      : bool;  (*`{CSY} 0=Off, Lamp Power On        {ENG} Bit 2: lamp arc power on; 0 = OFF*)
    LimitError       : bool;  (*`{CSY} 0=Off, Limit Error          {ENG} Bit 3: limit error; 0 = "last requested power was OFF or was between MIN..MAX LEVEL" ( Limit Error)*)
    TerminateFading  : bool;  (*`{CSY} 0=Terminate Fading          {ENG} Bit 4: fade ready; 0 = ready, 1 = running*)
    ResetState       : bool;  (*`{CSY} 0=No, Reset State           {ENG} Bit 5: reset state? 0 = NO (Query: RESET STATE)*)
    MissingShortAddr : bool;  (*`{CSY} 0=No, Missing Short Address {ENG} Bit 6: missing short address? 0 = NO*)
    PowerFailure     : bool;  (*`{CSY} 0=No, Power Failure         {ENG} Bit 7: power failure? 0 = "RESET" or an arc power control command has been received since the last power-on (Query: POWER FAILURE)*)
  END_STRUCT;
END_TYPE

TYPE tDALI2_CGearStatus :
  STRUCT
    actualLevel      : usint :=  0;  (*`actual lighting level*)
    balStatus        : tDALI2_CGearStates;
    balStatusValue   : byte;  (*`value of balStatus*)
    contGear         : bool;  (*`FF-yes, 0-no*)
    lampFailure      : bool;  (*`no answer-OK, 0xFF-failure*)
    powOnState       : bool;  (*`no answer-OFF, 0xFF-lamp ON*)
    limErr           : bool;  (*`no answer-OK,  0xFF-Limit error*)
    resState         : bool;  (*`no answer-OK,  0xFF-Reset*)
    powerFailure     : bool;
  END_STRUCT;
END_TYPE

TYPE tDALI2_CGearBasicParam :
  STRUCT
    actualLevel      : usint :=  0;
    minLevel         : usint :=  0;
    maxLevel         : usint :=  0;
    powerOnLevel     : usint :=  0;
    systemFailLevel  : usint :=  0;
    fadeTime         : usint :=  0;
    fadeRate         : usint :=  0;
  END_STRUCT;
END_TYPE

TYPE tDALI2_CGear_Comm :
  STRUCT
    sAdr             : usint;
    linkState        : bool;  (*`link state of dali device*)
    busy             : bool;  (*`communication session execution status*)
  END_STRUCT;
END_TYPE

TYPE tDALI2_Groups :
  STRUCT
    groups           : ARRAY [0..15] OF bool;  (*`indication of joined group*)
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_WebCommands :
  STRUCT  (*`ok*)
    offSet           : bool;  (*`turn off*)
    onSet            : bool;  (*`turn on*)
    actLevelGet      : bool;
    minSet           : bool;  (*`preset minimal define level*)
    maxSet           : bool;  (*`preset maximal define level*)
    readAll          : bool;  (*`command to read all device status and parameters in one session*)
    readState        : bool;  (*`single command to read device states*)
    readParam        : bool;  (*`single command to read configurable parameters*)
    readFaults       : bool;  (*`single command to read faults*)
    writeParam       : bool;  (*`single command to write all configurable parameters in one session*)
    readGroup        : bool;  (*`single command to read added groups*)
    writeGroup       : bool;  (*`single command to adds/removes a ballast to/from the group*)
    readScene        : bool;  (*`single command to read predefined scenes presets*)
    writeScene       : bool;  (*`single command to write all scenes presets in one session*)
    copyScene        : bool;  (*`single command to copy scene presets from state to write array*)
    resetBurningTime : bool;
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Commands :
  STRUCT
    offSet           : bool;  (*`turn off*)
    onSet            : bool;  (*`turn on*)
    actLevelGet      : bool;
    minSet           : bool;  (*`preset minimal define level*)
    maxSet           : bool;  (*`preset maximal define level*)
    readState        : bool;  (*`single command to read device states*)
    readParam        : bool;  (*`single command to read configurable parameters*)
    readFaults       : bool;  (*`single command to read faults*)
    writeParam       : bool;  (*`single command to write all configurable parameters in one session*)
    readGroup        : bool;  (*`single command to read added groups*)
    writeGroup       : bool;  (*`single command to adds/removes a ballast to/from the group*)
    readScene        : bool;  (*`single command to read predefined scenes presets*)
    writeScene       : bool;  (*`single command to write all scenes presets in one session*)
    resetBurningTime : bool;
    identificationStart : bool;
    functionTestStart : bool;
    functionTestStop : bool;
    durationTestStart : bool;
    durationTestStop : bool;
    inhibitModeStart : bool;
    inhibitModeStop  : bool;
    restModeStart    : bool;
    restModeStop     : bool;
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_BatteryStatus :
  STRUCT
    fullyCharged     : bool;
    fault            : bool;
    chargingState    : usint;
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Info :
  STRUCT
    actualLevel      : usint :=  0;  (*`actual lighting level*)
    timeSpanDurationTest : uint;  (*`(min)             // 03F3	A1	QUERY DURATION TEST RESULT*)
    lampBurningHoursEmerMode : uint;  (*`(hour)            // 03F4	A1	QUERY LAMP EMERGENCY TIME*)
    totalLampBurningHours : uint;  (*`(hour) * 4        // 03F5	A1	QUERY LAMP TOTAL OPERATION TIME*)
    ratedDuration    : uint;  (*`(min) * 2         // 03F9	A1	QUERY RATED DURATION*)
    battery          : tDALI2_DT1_BatteryStatus;  (*`03F1	A1	QUERY BATTERY CHARGE*)
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Status :
  STRUCT  (*`03FD	A1	QUERY EMERGENCY STATUS*)
    status           : byte;
    inhibitModeActive : bool;
    functionTestCompleted : bool;
    durationTestCompleted : bool;
    batteryFullyCharged : bool;
    functionTestOnHold : bool;
    durationTestOnHold : bool;
    identificationActive : bool;
    adrWithPhysSelection : bool;
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Mode :
  STRUCT  (*`03FA	A1	QUERY EMERGENCY MODE*)
    mode             : byte;
    restModeActive   : bool;
    mainsModeActive  : bool;
    emerModeActive   : bool;
    emerModeAfterMainsActive : bool;
    funcTestInProgress : bool;
    durationTestInProgress : bool;
    hardwiredInhibitModeActive : bool;
    switchedMaintainedLightOn : bool;
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Faults :
  STRUCT  (*`03FC	A1	QUERY FAILURE STATUS*)
    status           : byte;
    circuitDefective : bool;
    ratedDurationNotAchieved : bool;
    batteryFault     : bool;
    failureDuringEmergencyMode : bool;
    functionTestDelayExceeded : bool;
    durationTestDelayExceeded : bool;
    functionTestFailed : bool;
    durationTestFailed : bool;
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Scene :
  STRUCT
    Enab             : ARRAY [0..15] OF bool;  (*`indication of scene state (active or inactive)*)
    onOffStat        : ARRAY [0..15] OF bool;
    level            : ARRAY [0..15] OF usint;  (*`lighting level of scene*)
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Control :
  STRUCT
    actualLevel      : usint :=  0;  (*`Desired lighting level*)
  END_STRUCT;
END_TYPE

TYPE tDALI2_DT1_Device :
  STRUCT
    com              : tDALI2_CGear_Comm;
    cmd              : tDALI2_DT1_Commands;
    group            : tDALI2_Groups;
    cntr             : tDALI2_DT1_Control;
    groupCmd {HIDDEN} : tDALI2_Groups;
    scene            : tDALI2_DT1_Scene;
    info             : tDALI2_DT1_Info;
    status           : tDALI2_DT1_Status;
    mode             : tDALI2_DT1_Mode;
    faults           : tDALI2_DT1_Faults;
    param            : tDALI2_CGearBasicParam;
  END_STRUCT;
END_TYPE

