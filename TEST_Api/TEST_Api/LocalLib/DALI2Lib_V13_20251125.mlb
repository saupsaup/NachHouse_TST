__DECL FUNCTION_BLOCK fbDL2_ComControl
(*`{ENG} The functional block serves the requirements of the user program and ensures complete DALI communication via the C-DL-2064M converter.
 {CSY} FunkËnÌ blok obsluhuje poûadavky uûivatelskÈho programu a zajiöùuje kompletnÌ DALI komunikaci p¯es p¯evodnÌk C-DL-2064M*)
  VAR_INPUT
    enab             : bool;  (*`{ENG} Enable DALI communication  {CSY} PovolenÌ DALI komunikace*)
    netAdrType       : usint;  (*`{ENG} Type of DALI Addressing Procedure: 1-Search unmapped devices, 2-Complete new installation, 3-Scan network {CSY} Typ procedury adresov·nÌ DALI: 1-RozöÌ¯enÌ systÈmu (vyhledat nenamapovan· za¯ÌzenÌ), 2-KompletnÏ nov· instalace, 3-Prohledat sÌù*)
    netAdrExRq       : bool;  (*`{ENG} Command to start addressing, type of addresing procedure defined in "netAdrType"  {CSY} P¯Ìkaz pro zah·jenÌ adresov·nÌ, typ adresovacÌ procedury definovan˝ v "netAdrType"*)
    webSceneCmd      : tDALI2_CGearSceneControl;  (*`{ENG} Setting the order to start the scene  {CSY} NastavenÌ p¯Ìkazu ke spuötÏnÌ scÈny*)
    groupCmd         : tDALI2_CGearGroupControl;  (*`{ENG} Settings of group command  {CSY} NastavenÌ skupinovÈho p¯Ìkazu*)
    webCntr          : tDALI2_CGearWebNetControl;  (*`{ENG} Common basic settings and commands for all ballasts, when sAdrTest = 255 (Broadcast), when sAdrTest = 0..65 command for selected ballasts   {CSY} SpoleËn· z·kladnÌ nastavenÌ a p¯Ìkazy pro vöechny p¯ed¯adnÌky p¯i sAdrTest = 255 (Broadcast), p¯i sAdrTest = 0..65 pro vybranÈ p¯ed¯adnÌky*)
    cfg              : tDALI2_CGearCommNetConfig;  (*`{ENG} Settings for automatic command execution  {CSY} NastavenÌ pro automatickÈ prov·dÏnÌ p¯Ìkaz˘*)
    sAdrTest         : usint :=  255;  (*`{ENG} Short address for basic control and setting of function of ballast {CSY} Kr·tk· adresa pro z·kladnÌ ovl·d·nÌ a nastavenÌ funkcÌ p¯ed¯adnÌku*)
  END_VAR
  VAR_OUTPUT
    pDevReg {TRACK_ADR} : udint;  (*`{ENG} A pointer to the main communication control structure that allows the registration of selected function blocks in the user application in order to control the required type of DALI ballasts // {CSY} Ukazatel na hlavnÌ komunikaËnÌ ¯ÌdicÌ strukturu, kter· umoûÚuje registraci vybran˝ch funkËnÌch blok˘ v uûivatelskÈ aplikaci za ˙Ëelem ¯ÌzenÌ poûadovanÈho typu DALI p¯ed¯adnÌku*)
    done             : bool;  (*`{ENG} done {CSY}hotovo*)
    busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    err              : bool;  (*`{ENG} Err (usually responded two ballasts at a time!){CSY} Chyba (obvykle odpovÏdÏly dva p¯ed¯adnÌky najednou!)*)
    errID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address {CSY} 1.. Watchdog poûadavku 2..Jak·koli kolize kr·tk˝ch adres*)
    netFree          : bool;  (*`{ENG} Status of the DALI bus being occupied by the functional block  {CSY} Stav linky obsazenÈ funkËnÌm blokem*)
    webComState0_31  : dword;  (*`{ENG} Communication status of ballasts from 0 to 31 (binary sequence)  {CSY} Stav komunikace p¯ed¯adnÌku od 0 do 31 (bin·rnÌ sekvence)*)
    webComState32_63 : dword;  (*`{ENG} Communication status of ballasts from 2 to 63 (binary sequence)  {CSY} Stav komunikace p¯ed¯adnÌku od 32 do 63 (bin·rnÌ sekvence)*)
    webAdrConflictState0_31 : dword;  (*`{ENG} Indication of short for address collision status from 0 to 31 (binary sequence) {CSY} Indikace zkratu pro stav kolize adres od 0 do 31 (bin·rnÌ sekvence)*)
    webAdrConflictState32_63 : dword;  (*`{ENG} Indication of short for address collision status from 32 to 63 (binary sequence) {CSY} Indikace zkratu pro stav kolize adres od 32 do 63 (bin·rnÌ sekvence)*)
    macStatDesc      : string [80];  (*`{ENG} A short description of the execution status of the command {CSY} Kr·tk˝ popis stavu prov·dÏnÌ p¯Ìkazu*)
    machinePrimState {HIDDEN} : usint;  (*`{CSY} LadÌcÌ informace. Prim·rnÌ krok prov·dÏnÈho p¯Ìkazu*)
    machineSubState {HIDDEN} : usint;  (*`{CSY} LadÌcÌ informace. Sekund·rnÌ krok prov·dÏnÈho p¯Ìkazu*)
    devCom {HIDDEN}  : DALI2_DEVICE_COMM_STATE;
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_2012Sin;  (*`{ENG} Input zone of the module {CSY} VstupnÌ zÛna modulu*)
    C_DL_ModuleOut   : tC_DL_2012Sout;  (*`{ENG} Output zone of the module {CSY} V˝stupnÌ zÛna modulu*)
  END_VAR
  VAR
    LAST_CRC         : dword;
    INIT             : bool;
    Transciever {HIDDEN} : fbDL2_Transceiver;
    fb_DL2_Addressing : fbDL2_NewAutoAddressing;
    fb_DL2_ReadDeviceType : fbDL2_ReadDeviceType;
    netScanRq        : bool;
    netConflictScanCheckRq : bool;
    netConflictScanRq : bool;
    netConflictSolveRq : bool;
    netAdresingUnmappedRq : bool;
    netReadDeviceTypeRq : bool;
    sAdr             : usint;
    startAdrTrig     : R_TRIG;
    startAdrExecRq   : bool;
    newAdrresRq      : bool;
    netAdrExStartRq  : bool;
    hdAdrReadStep    : usint;
    readDTRq         : bool;
    seqRead          : bool;
    numDaliDevices   : usint :=  64;
    foundDevices     : usint;
    goNext           : bool;
    comStateTemp     : dword;
    conflictStateTemp : dword;
    webCmdDesc       : string [80];
    daliCommand      : int;
    subDaliCommand2  : int;
    daliNetworkScanned : bool;
    daliDevTypeLoaded : bool;
    pollToDaliCGearDevice : usint;
    ledDT1_PTR       : PTR_TO tDALI2_DT1_Device;
    ledDT6_PTR       : PTR_TO tDALI2_DT6_Device;
    ledDT8_Tc_PTR    : PTR_TO tDALI2_DT8_TC_Device;
    ledDT8_RGBW_PTR  : PTR_TO tDALI2_DT8_RGBW_Device;
    relayDT7_PTR     : PTR_TO tDALI2_DT7_Device;
    ledDT6_PTR_NULL  : PTR_TO tDALI2_DT6_Device;
    ledDT8_Tc_PTR_NULL : PTR_TO tDALI2_DT8_TC_Device;
    ledDT8_RGBW_PTR_NULL : PTR_TO tDALI2_DT8_RGBW_Device;
    relayDT7_PTR_NULL : PTR_TO tDALI2_DT7_Device;
    writeParamIndex  : usint;
    groups0_7        : usint;
    groups8_15       : usint;
    shiftedMask      : byte;
    timerWD          : TON;
    pollToDaliCGearGroups : usint :=  15;
    groupCmdTemp     : tDALI2_CGearWebNetCommands;
    groupCmdClear    : tDALI2_CGearWebNetCommands;
    groupValTemp     : tDALI2_CGearBasicParam;
    sceneNum         : usint;
    balStatusValue   : byte;  (*`value of balStatus*)
    balStatus        : tDALI2_CGearStates;
    actTCValue       : word;
    fb_DL2_DT8_SetTc : fbDL2_DT8_SetTc;
    fb_DL2_SetRBGW   : fbDL2_SetRBGW;
    colorDaliCode    : word;
    paramIndex       : usint;
    colorSetIndex    : usint;
    cycleIdleState   : usint :=  10;
    powerUpTimer     : TON;
    powerUp          : bool;
    unexpStateWD     : TON;
    changeToRxRq     : bool;
    stopQuiescentModeRq : bool;
    devComStatus     : ARRAY [0..63] OF bool;
    commandCounter   : uint;
    machinePrimStateLast : usint;
    ADDRESS_Last     : usint;
    COMMAND_Last     : usint;
    DATA_LO_Last     : usint;
    resetWDtimers    : bool;
    scanFirstCycle   : bool;
    rqToClearGroupSelect : bool;
    readSubIndex     : uint;
  END_VAR
  VAR_TEMP
    i                : usint;
    j                : usint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbDL2_DT6Led
(*`{ENG} The function block defines a DT6 type ballast for monochrome tapes and sets the lamp power level
 {CSY} FunkËnÌ blok definuje p¯ed¯adnÌk typu DT6 pro jednobarevnÈ p·sky a nastavuje ˙roveÚ v˝konu lampy*)
  VAR_INPUT
    pDevReg          : udint;  (*`{ENG} A pointer to the main communication control structure through which the function block performs its registration {CSY} Ukazatel na hlavnÌ strukturu ¯ÌzenÌ komunikace, jejÌmû prost¯ednictvÌm funkËnÌ blok prov·dÌ svou registraci*)
    sAdrMan          : usint :=  255;  (*`{ENG} Short address of the ballast in the range 0 to 63  {CSY} Kr·tk· adresa p¯ed¯adnÌku v rozmezÌ 0 az 63*)
    blinkEn          : bool;  (*`{ENG} The start command  lamp blinking at MIN LEVEL and MAX LEVEL      {CSY} P¯Ìkaz k zah·jenÌ blik·nÌ lampy na MIN LEVEL a MAX LEVEL*)
    levelSet         : bool R_EDGE;  (*`{ENG} Command to set the new power level from the variable "level"     {CSY} P¯Ìkaz pro nastavenÌ novÈ ˙rovnÏ v˝konu*)
    level            : usint;  (*`{ENG} New power level                                                  {CSY} Nov· ˙roveÚ v˝konu*)
    webCmd           : tDALI2_DT6_WebCommands;  (*`{ENG} Individual commands for the web user interface {CSY} JednotlivÈ p¯Ìkazy pro webovÈ uûivatelskÈ rozhranÌ*)
    cfg {HIDDEN}     : tDALI2_DT6_Config;  (*`{ENG} Configuration of functional block  {CSY} Konfigurace funkËnÌho bloku*)
    group            : tDALI2_Groups;  (*`{ENG} Assignment to DALI groups  {CSY} PrirazenÌ do DALI skupin*)
    scene            : tDALI2_DT6_Scene;  (*`{ENG} Assignment and configuration of DALI scenes  {CSY} PrirazenÌ a konfigurace DALI scÈn*)
    param            : tDALI2_CGearBasicParam;  (*`{ENG} Configuration of the DALI parameters stored in DALI device  {CSY} Konfigurace parametru DALI uloûen˝ch v za¯ÌzenÌ DALI*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENG} done {CSY}hotovo*)
    busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    err              : bool;  (*`{ENG} Err (usually responded two ballasts at a time!){CSY} Chyba (obvykle odpovÏdÏly dva p¯ed¯adnÌky najednou!)*)
    errID            : usint;  (*`{ENG} Error code: 1-Main communication FB is not connected, 2-Dali device not paired {CSY} KÛd chyby: 1-HlavnÌ komunikaËnÌ FB nenÌ propojen, 2-Dali za¯ÌzenÌ nesp·rov·no*)
    sAdr             : usint;  (*`{ENG} Current short address  {CSY} Aktu·lnÌ kr·tk· adresa*)
    actLevel         : usint;  (*`{ENG} Current power level (brightness) {CSY}Aktu·lnÌ ˙roveÚ v˝konu (jas)*)
    linkState        : bool;  (*`{ENG} Pairing status {CSY} Stav p·rov·nÌ*)
    ledCnt           : tDALI2_DT6_Device;  (*`{ENG}State structure of the function block  {CSY} Stavov· struktura funkËnÌho bloku*)
  END_VAR
  VAR
    LAST_CRC {HIDDEN} : dword;
    INIT {HIDDEN}    : bool;
    ptrDevRegStat {HIDDEN} : PTR_TO tDALI2_DevCommNetState;
    i {HIDDEN}       : usint;
    levelLast {HIDDEN} : usint;
    actLevelGetTimer {HIDDEN} : TON;
    actLevelGetRq {HIDDEN} : bool;
    actLevelGetFTRIG {HIDDEN} : F_TRIG;
    actLevelGetCounter {HIDDEN} : usint;
    blinkEnRTRIG {HIDDEN} : R_TRIG;
    blinkRq {HIDDEN} : bool;
    blinkTimer {HIDDEN} : TON;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbDL2_DT8LedTc
(*`{ENG} Functional block for contol and monitoring TC LED Dimmer (CV, DT8) color temperature Tc type DT8
 {CSY} FunkËnÌ blok definuje p¯ed¯adnÌk typu DT8 pro ovl·d·nÌ p¯ed¯adnÌku se zad·v·nÌm barevnÈ teploty Tc typ DT8 a nastavuje ˙roveÚ jasu.*)
  VAR_INPUT
    pDevReg          : udint;  (*`{ENG} A pointer to the main communication control structure through which the function block performs its registration {CSY} Ukazatel na hlavnÌ strukturu ¯ÌzenÌ komunikace, jejÌmû prost¯ednictvÌm funkËnÌ blok prov·dÌ svou registraci*)
    sAdrMan          : usint :=  255;  (*`{ENG} Short address of the ballast in the range 0 to 63  {CSY} Kr·tk· adresa p¯ed¯adnÌku v rozmezÌ 0 az 63*)
    blinkEn          : bool;  (*`{ENG} The start command  lamp blinking at MIN LEVEL and MAX LEVEL      {CSY} P¯Ìkaz k zah·jenÌ blik·nÌ lampy na MIN LEVEL a MAX LEVEL*)
    levelSet         : bool R_EDGE;  (*`{ENG} Command to set the new power level from the variable "level"     {CSY} P¯Ìkaz pro nastavenÌ novÈ ˙rovnÏ v˝konu*)
    level            : usint;  (*`{ENG} New power level {CSY} Nov· ˙roveÚ v˝konu*)
    TcLevelSet       : bool R_EDGE;  (*`{ENG} Command for setting a new color temperature level Tc  {CSY} P¯Ìkaz pro nastavenÌ novÈ ˙rovnÏ teploty chromatiËnosti Tc*)
    TcLevel          : uint;  (*`{ENG} Entering the color temperature in the range Tc (2702-6493K) or according to the color limits "limitsTc"  {CSY} Zad·nÌ teploty chromatiËnosti v rozsahu Tc (2702-6493K) nebo podle barevn˝ch limitu "limitsTc"*)
    webCmd           : tDALI2_DT8_TC_WebCommands;  (*`{ENG} Individual commands for the web user interface {CSY} JednotlivÈ p¯Ìkazy pro webovÈ uûivatelskÈ rozhranÌ*)
    cfg {HIDDEN}     : tDALI2_DT8_TC_Config;  (*`{ENG} Configuration of functional block  {CSY} Konfigurace funkËnÌho bloku*)
    group            : tDALI2_Groups;  (*`{ENG} Assignment to DALI groups  {CSY} PrirazenÌ do DALI skupin*)
    scene            : tDALI2_DT8_TC_Scene;  (*`{ENG} Assignment and configuration of DALI scenes  {CSY} PrirazenÌ a konfigurace DALI scÈn*)
    param            : tDALI2_CGearBasicParam;  (*`{ENG} Configuration of the DALI parameters stored in DALI device  {CSY} Konfigurace parametru DALI uloûen˝ch v za¯ÌzenÌ DALI*)
    paramTc          : tDALI2_DT8_TC_Param;  (*`{ENG} Configuration specific color control parameters stored in the DALI device  {CSY} Konfigurace speci·lnÌch parametru ¯ÌzenÌ barev teploty chromatiËnosti uloûen˝ch v za¯ÌzenÌ DALI*)
    limitsTc         : tDALI2_DT8_TC_Limits;  (*`{ENG} Configuration of color limits  {CSY} Konfigurace barevn˝ch limit˘*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENG} done {CSY}hotovo*)
    busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    err              : bool;  (*`{ENG} Err (usually responded two ballasts at a time!){CSY} Chyba (obvykle odpovÏdÏly dva p¯ed¯adnÌky najednou!)*)
    errID            : usint;  (*`{ENG} Error code: 1-Main communication FB is not connected, 2-Dali device not paired {CSY} KÛd chyby: 1-HlavnÌ komunikaËnÌ FB nenÌ propojen, 2-Dali za¯ÌzenÌ nesp·rov·no*)
    sAdr             : usint;  (*`{ENG} Actual short DALI address {CSY} Aktu·lnÌ kr·tk· adresa*)
    actLevel         : usint;  (*`{ENG} Actual intensity value {CSY} Aktu·lnÌ ˙roveÚ v˝konu (jas)*)
    actTcLevel       : uint;  (*`{ENG} Actual colour temperature value {CSY} SkuteËn· hodnota teploty chromatiËnosti*)
    linkState        : bool;  (*`{ENG} Pairing status  {CSY} Stav p·rov·nÌ*)
    ledCnt           : tDALI2_DT8_TC_Device;  (*`{ENG} State structure of the function block {CSY} Stavov· struktura funkËnÌho bloku*)
  END_VAR
  VAR
    LAST_CRC         : dword;
    INIT             : bool;
    ptrDevRegStat    : PTR_TO tDALI2_DevCommNetState;
    i                : usint;
    newLinked        : bool;
    levelLast        : usint;
    TcLevelLast      : uint;
    ledCntAdr        : udint;
    actLevelGetTimer : TON;
