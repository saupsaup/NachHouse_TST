 LD   bool 0       ; false
 WRX  Err
#debug_left bool Err
#srcline 205 ;        ErrID := 0;                                 //
 LD   usint 0
 WRX  ErrID
#debug_left usint ErrID
#srcline 206 ;      END_IF;
fbDL2_Transceiver_L63:
#srcline 207 ;    END_IF;
fbDL2_Transceiver_L60:
#srcline 208 ;    ARC_old := Global_DALI_in.stat.ARC;
 LDX  Global_DALI_in
 MUL  8   ; -> bool pointer 
 ADD  7   ; Bool offset 
 LDIB 
#debug bool Global_DALI_in.stat.ARC
 WRX  ARC_old
#debug_left bool ARC_old
#srcline 209 ;    Busy := RqMes OR Confirmation or Done ;                  //                                            //****Pet 1.10.2014
 LDX  RqMes
#debug bool RqMes
 LDX  Confirmation
#debug bool Confirmation
 OR  
 LDX  Done
#debug bool Done
 OR  
 WRX  Busy
#debug_left bool Busy
#srcline 210 ;  END_IF; // (Busy)
fbDL2_Transceiver_L35:
#srcline 211 ; // Enable_old := Enable;
#srcline 212 ;END_FUNCTION_BLOCK
 ULNK
RET
E     61
#endpou 



 

#srcfile ''
#srcfile 'D:\TECOLIBSRC\DALI2LIB\DALI2LIB\FC_DL_LEVEL_TO_POWER.ST'
#pou fDL2_Level_To_Power
#srcline 3 ;  FUNCTION fDL2_Level_To_Power : usint
P     61
fDL2_Level_To_Power_L0:
 LINK 0
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__fDL2_Level_To_Power
; End initialize - variables
#srcline 13 ;    IF lin_log THEN                        // korekce logaritmickou funkcÌ pro DALI
 LDX  lin_log
#debug bool lin_log
 JMC  fDL2_Level_To_Power_L1
#srcline 14 ;      fDL2_Level_To_Power := REAL_TO_USINT( log( level + 0.0973066) * 84.333333 + 85.333333);
 LDX  level
#debug real level
 LD   real 0.0973066
 ADF
 LOG
 LD   real 84.333333
 MUF
 LD   real 85.333333
 ADF
 RND
 UFW
 AND  $FF
 WRX  __fc__fDL2_Level_To_Power
#debug_left usint fDL2_Level_To_Power
#srcline 15 ;    ELSE
 JMP  fDL2_Level_To_Power_L2
fDL2_Level_To_Power_L1:
#srcline 16 ;      fDL2_Level_To_Power := REAL_TO_USINT( level * 2.54);
 LDX  level
#debug real level
 LD   real 2.54
 MUF
 RND
 UFW
 AND  $FF
 WRX  __fc__fDL2_Level_To_Power
#debug_left usint fDL2_Level_To_Power
#srcline 17 ;    END_IF;
fDL2_Level_To_Power_L2:
#srcline 18 ;END_FUNCTION
 PRV  
 LDX  __fc__fDL2_Level_To_Power
 ULNK
RET
E     61
#endpou 



 

