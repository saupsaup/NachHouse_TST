vices.BinaryOutputsDevice.Enabled == 0"><Data>00</Data></When></ValueDependency></SubObject><SubObject name="bloko" access="rw"><DefaultData>00</DefaultData><ValueDependency><Formula>(0x01 * (@Devices.BinaryOutputsDevice.DO1_HaltingState == 1)) + (0x02 * (@Devices.BinaryOutputsDevice.DO2_HaltingState == 1))</Formula></ValueDependency></SubObject><SubObject name="leindev" access="const"></SubObject><SubObject name="leoutdev" access="const"><DefaultValue>2</DefaultValue></SubObject></SubObjects></SubObject></SubObjects></SubObject><SubObject name="ezs" access="rw"><DefaultData>00</DefaultData><ValueDependency><Formula>(0x01 * (@Devices.BinaryInputsDevice.DI1_Type != 0)) + (0x02 * (@Devices.BinaryInputsDevice.DI2_Type != 0)) + (0x10 * (@Devices.BinaryInputsDevice.DI1_Type == 2)) + (0x20 * (@Devices.BinaryInputsDevice.DI2_Type == 2))</Formula></ValueDependency></SubObject><SubObject name="ai1type" access="rw"><DefaultData>22</DefaultData><ValueDependency><ValueOf>Devices.AnalogInput1Device.Type</ValueOf></ValueDependency></SubObject><SubObject name="ai2type" access="rw"><DefaultData>22</DefaultData><ValueDependency><ValueOf>Devices.AnalogInput2Device.Type</ValueOf></ValueDependency></SubObject><SubObject name="ai1tau" access="rw"><ValueDependency><Formula>@Devices.AnalogInput1Device.Filter * 10</Formula></ValueDependency></SubObject><SubObject name="ai2tau" access="rw"><ValueDependency><Formula>@Devices.AnalogInput2Device.Filter * 10</Formula></ValueDependency></SubObject></SubObjects></Object><Object index="#x6000" name="r{RACK}_p{POSITION}_IN" type="TCIB_C_OR_0202B_IN"><SubObjects><SubObject name="STAT"><DisplayName><label lang="cz">STAT</label><label lang="en">STAT</label></DisplayName><Disabled>@Devices.StateDevice == 0</Disabled></SubObject><SubObject name="AI1"><DisplayName><label lang="cz">AI1</label><label lang="en">AI1</label></DisplayName><Transformation><Conversion condition="@Devices.AnalogInput1Device.Type == 0x2D">94</Conversion><Conversion>93</Conversion></Transformation><Disabled>(@Devices.AnalogInput1Device.Enabled == 0)</Disabled></SubObject><SubObject name="AI2"><DisplayName><label lang="cz">AI2</label><label lang="en">AI2</label></DisplayName><Transformation><Conversion condition="@Devices.AnalogInput2Device.Type == 0x2D">94</Conversion><Conversion>93</Conversion></Transformation><Disabled>(@Devices.AnalogInput2Device.Enabled == 0)</Disabled></SubObject><SubObject name="DI"><DisplayName><label lang="cz">DI</label><label lang="en">DI</label></DisplayName><Disabled>@Devices.BinaryInputsDevice.Enabled == 0</Disabled></SubObject></SubObjects></Object><Object index="#x7000" name="r{RACK}_p{POSITION}_OUT" type="TCIB_C_OR_0202B_OUT"><SubObjects><SubObject name="DOs"><DisplayName><label lang="cz">DOs</label><label lang="en">DOs</label></DisplayName><Disabled>@Devices.BinaryOutputsDevice.Enabled == 0</Disabled></SubObject></SubObjects></Object><Object index="#x9001" name="r{RACK}_p{POSITION}_DriverInit" type="BYTE" access="rw"><Comment><label lang="cz">Inicializacni tabulka driveru</label><label lang="en">Initialization table of driver</label></Comment><Excluded>&quot;{SYSTEM}&quot; != &quot;FOXTROT2&quot; &amp;&amp; &quot;{SYSTEM}&quot; != &quot;TC800&quot;</Excluded><MacroValue>$01,{PRODUCT_NAME_LEN},'{PRODUCT_NAME}',\n$02,{DEVICE_ALIAS_LEN},'{DEVICE_ALIAS}',\n$03,{CONV_IN_LEN},{$CONV_IN_ARRAY},\n$04,{CONV_OUT_LEN},{$CONV_OUT_ARRAY},\n$00</MacroValue></Object><Object index="#xA000" name="r{RACK}_p{POSITION}_Module" type="TModulE2" access="rw"><Excluded>&quot;{SYSTEM}&quot; != &quot;FOXTROT2&quot; &amp;&amp; &quot;{SYSTEM}&quot; != &quot;TC800&quot;</Excluded><SubObjects><SubObject name="version" access="ro"><DefaultValue>2</DefaultValue></SubObject><SubObject name="hwCode" access="ro"><MacroValue>{HWCODE}</MacroValue></SubObject><SubObject name="busId" access="ro"><MacroValue>${$RACK}</MacroValue></SubObject><SubObject name="address" access="ro"><MacroValue>{POSITION}</MacroValue></SubObject><SubObject name="port" acc