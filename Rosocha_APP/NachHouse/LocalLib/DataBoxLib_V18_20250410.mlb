 LDY  j
#debug uint j
 LD   uint 250
 SUB
 AND  $FFFF
 RCHK 10000   ; Range Check
 ADD     ; + offset 
 WR   __Instance__WriteBlockToDBx~variable
#debug_left pointer __Instance__WriteBlockToDBx.variable
 PRV
 LEA  __Instance__WriteBlockToDBx
#debug pointer __Instance__WriteBlockToDBx ;<debug_call>
 CAL  WriteBlockToDBx_L0
 AND  $FFFF
 WRY  t
#debug_left uint t
#srcline 292 ;     IF t = 0 THEN  EXIT;  END_IF;
 LDY  t
#debug uint t
 LD   uint 0
 EQ
 JMC  WriteToDataBox_L5
 JMP  WriteToDataBox_L2
WriteToDataBox_L5:
#srcline 293 ;           j := j - t;
 LDY  j
#debug uint j
 LDY  t
#debug uint t
 SUB
 AND  $FFFF
 WRY  j
#debug_left uint j
#srcline 294 ;    ELSE
 JMP  WriteToDataBox_L4
WriteToDataBox_L3:
#srcline 295 ;           j :=j - USINT_TO_UINT( WriteBlockToDBx(
 LDY  j
#debug uint j
 NXT
 LDX  dataBoxAddress
#debug udint dataBoxAddress
 WR   __Instance__WriteBlockToDBx~dataBoxAddress
#debug_left udint __Instance__WriteBlockToDBx~dataBoxAddress
#srcline 297 ;                        length         := UINT_TO_USINT(j),
 LDY  j
#debug uint j
 AND  $FF
 WR   __Instance__WriteBlockToDBx~length
#debug_left usint __Instance__WriteBlockToDBx~length
#srcline 298 ;                        variable       := void(variable)));
 LDX  variable
 WR   __Instance__WriteBlockToDBx~variable
#debug_left pointer __Instance__WriteBlockToDBx.variable
 PRV
 LEA  __Instance__WriteBlockToDBx
#debug pointer __Instance__WriteBlockToDBx ;<debug_call>
 CAL  WriteBlockToDBx_L0
 AND  $FFFF
 SUB
 AND  $FFFF
 WRY  j
#debug_left uint j
#srcline 299 ;     EXIT;
 JMP  WriteToDataBox_L2
#srcline 300 ;    END_IF;
WriteToDataBox_L4:
#srcline 301 ;    END_WHILE;
 JMP  WriteToDataBox_L1
WriteToDataBox_L2:
 NOP  -1
#srcline 302 ;    WriteToDataBox := j = 0;
 LDY  j
#debug uint j
 LD   uint 0
 EQ
 WRX  __fc__WriteToDataBox
#debug_left bool WriteToDataBox
#srcline 303 ;END_FUNCTION
 PRV  
 LDX  __fc__WriteToDataBox
 ULNK
RET
E     61
#endpou 

