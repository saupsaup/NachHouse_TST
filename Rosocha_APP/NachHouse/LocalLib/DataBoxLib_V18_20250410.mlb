 LD   uint 250
 GT
 JMC  ReadFromDataBox_L3
#srcline 237 ;       t := USINT_TO_UINT( ReadBlockFromDBx(
 NXT
 LDX  dataBoxAddress
#debug udint dataBoxAddress
