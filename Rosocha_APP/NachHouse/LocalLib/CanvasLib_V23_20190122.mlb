    length           : int;  (*`{CSY}délka èáry grafu v pixelech{ENU}length of the graph line in pixels*)
    numPoints        : int;  (*`{CSY}poèet datových bodù{ENU}number of data points*)
  END_VAR
  VAR_IN_OUT
