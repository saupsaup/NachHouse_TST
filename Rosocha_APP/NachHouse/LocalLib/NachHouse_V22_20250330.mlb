    ChkSha           : bool;  (*`Zistit pritomnost SHA*)
    QueSha           : bool;  (*`Nacitat vsetky parametre*)
    ChkGrp           : bool;  (*`Zistit pritomnost GRP*)
    QueGrp           : bool;  (*`Nacitat default par*)
