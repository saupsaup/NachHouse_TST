TYPE NH_LOG_EVN :
  STRUCT  (*`struktura EVN-log*)
    evn              : string [3] := '   ';  (*`globalny kod udalosti, PSN,PIR,OVL,HET,VEN,*)
    sevn             : byte :=  16#3b;  (*`globalny kod udalosti, PSN,PIR,OVL,HET,VEN,*)
    wht              : string [3] := '   ';  (*`blizsie urcenie udalosti BEG/END/STR/STP*)
    swht             : byte :=  16#3b;  (*`blizsie urcenie udalosti BEG/END/STR/STP*)
    cfg              : string [3] := '   ';  (*`ktore CFG, u dali je master*)
    scfg             : byte :=  16#3b;  (*`ktore CFG, u dali je master*)
    nbr              : string [4] := '    ';  (*`veta v CFG, u dali je short adresa*)
    snbr             : byte :=  16#3b;  (*`veta v CFG, u dali je short adresa*)
    rom              : string [3] := '   ';  (*`veta v CFG*)
    srom             : byte :=  16#3b;  (*`veta v CFG*)
    eDate            : string [8] := '        ';
    sdat             : byte :=  16#3b;
    eTime            : string [11] := '00:00:00.00';
    stim             : byte :=  16#3b;
    val1             : string [7] := '       ';  (*`podla udalosti, vacsinou nova hodnota*)
    sval1            : byte :=  16#3b;  (*`podla udalosti, vacsinou nova hodnota*)
    val2             : string [7] := '       ';  (*`podla udalosti, vacsinou stara hodnota*)
    sval2            : byte :=  16#3b;  (*`podla udalosti, vacsinou stara hodnota*)
    lck              : string [1] := ' ';  (*`lock status	0..9*)
    slock            : byte :=  16#3b;  (*`lock status	0..9*)
    subj             : string [2] := '  ';  (*`lock status	0..9*)
    sSubj            : byte :=  16#3b;  (*`lock status	0..9*)
    Cr               : byte :=  16#0D;
    Lf               : byte :=  16#0A;
  END_STRUCT;
END_TYPE

TYPE NH_LOG_IDX :
  STRUCT  (*`index po dnoch*)
    bckAdr           : udint;
    dayAdr           : ARRAY [1..31] OF udint;
  END_STRUCT;
END_TYPE

TYPE NH_LOG_IXD :
  STRUCT  (*`index po dnoch*)
    offset           : udint;
  END_STRUCT;
END_TYPE

