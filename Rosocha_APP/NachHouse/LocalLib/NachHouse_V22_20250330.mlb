    RunOff           : bool;
    EndOn            : bool;
    EndOFF           : bool;
  END_VAR
  VAR_OUTPUT
    Q                : bool;  (*`vystup*)
    Qi               : bool;  (*`zmena ON-OFF-ON*)
    Qn               : bool;  (*`imp. pri dosiahnuti poctu zaplikani*)
  END_VAR
  VAR
    Qr               : bool;
    Qo               : bool;
  END_VAR
END_FUNCTION_BLOCK

