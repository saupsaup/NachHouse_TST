    NotifyMessage    : string [80] :=  'NachHouse';  (*`Foxtrot1 Notification Message';*)
    NotifyToken      : string [80] :=  'f7ab034164f9378b1f2b65fd0554f912c0e2272f43a9d2e6fa25d377c65031cf';  (*`moj*)
  END_VAR
  VAR
    HttpPostName     : string [80] :=  'NachHouse';
    HttpPostAction   : string [80] :=  '/pushapi/message';
    HttpPostIP       : TIPadr :=  [77, 236, 203, 179];  (*`iOS Notify Server   foxtrotapi.geovap.cz:60080/pushapi/message*)
    HttpPort         : uint :=  60080;
    HttpRequest {HIDDEN} : fbHttpRequestL;
    DataOut          : THttpPostData;
    HttpPostLen      : uint;
    Data             : THttpBuffer;
    pStr             : PTR_TO string [255];
    file             : string [80] :=  'PUTREPLY.TXT';
    WTFSeq           : WriteToFileSeq;
    msg              : usint;
  END_VAR
  VAR_OUTPUT
    busy             : bool;
    out              : bool;  (*`{ENG} TRUE means Notification Succesfully Sent {CSY} TRUE znamenï¿½ Notifikace zaslï¿½na ï¿½spï¿½nï¿½*)
  END_VAR
END_FUNCTION_BLOCK

