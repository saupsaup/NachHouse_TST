                                       (x:=x0+50 ,       y:= y1-50, w:= 54), //  <
                                       (x:=x2-45 ,       y:= y1-50, w:= 60), //  setup
                                       (x:=xc-xz*2-xz/2, y:= yy2+55),         // home
                                       (x:=xc-xz  -xz/2, y:= yy2+55),         // FAV
                                       (x:=xc-xz/2,      y:= yy2+55),         // rom
                                       (x:=xc+xz/2,      y:= yy2+55),         // cat
                                       (x:=xc+xz+xz/2,   y:= yy2+55),         // act
