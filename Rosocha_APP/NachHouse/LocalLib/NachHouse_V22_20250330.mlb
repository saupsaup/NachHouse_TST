    cf               : NH_CFG_ALL;
    al               : NH_DEV_ALL;  (*`spolocne pre vsetky DEV  cf+io*)
    cx               : NH_CFX_LUX :=  (fil := 100);  (*`, dark := 0.0, Sun := 50000.0);*)
    hw               : NH_DEV_HW0;  (*`zakladna adresa HW*)
    me               : NH_LUX_MEM;
  END_STRUCT;
END_TYPE

