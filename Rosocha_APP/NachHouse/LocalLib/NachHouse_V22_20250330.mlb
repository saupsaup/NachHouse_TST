    cf               : NH_CFG_ALL;
    al               : NH_DEV_ALL;  (*`spolocne pre vsetky DEV  cf+io*)
    cx               : NH_CFX_TER :=  (fil := 250, hys := 0.1);
    hw               : NH_DEV_HW0;  (*`zakladna adresa HW*)
    me               : NH_TER_MEM;
  END_STRUCT;
END_TYPE

TYPE NH_DOR {HIDDEN} :
  STRUCT  (*`dor,win,co2*)
    ok               : NH_REC_OK;
    cf               : NH_CFG_ALL :=  (psn:=1);
