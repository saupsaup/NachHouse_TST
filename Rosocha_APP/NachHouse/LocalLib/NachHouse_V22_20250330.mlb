  STRUCT  (*`categorie*)
    ok               : NH_REC_OK :=  (ok := true);
    cf               : NH_CFG_ALL :=  (Name := 'User');  (*`cf.rom = uzivatel, cf.typ : -1,-2 Dash,quick, 0=FAV all, 1... cislo FAV usra*)
