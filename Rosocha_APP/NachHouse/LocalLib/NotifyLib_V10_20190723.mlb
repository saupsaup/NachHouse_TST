TYPE TWebPushNotif :
  STRUCT
    title            : string [40];  (*`titulek*)
    body             : string [100];  (*`hlavni text*)
    badge            : string [255];  (*`url pro zobrazeni symbolu*)
    icon             : string [255];  (*`url pro zobrazeni ikony*)
    image            : string [255];  (*`url pro zobrazeni obrazku*)
    vibrate          : string [80];  (*`definice vibrace pri zobrazeni notifikace*)
  END_STRUCT;
END_TYPE

VAR_GLOBAL
 NotifySubscribe AT %S74.0 : bool;

END_VAR

__DECL FUNCTION fcAppendString {HIDDEN} : udint
  VAR_INPUT
    stringToAppend   : string [255];
    currentLen       : udint;
    bufferSize       : udint;
  END_VAR
  VAR
    pString          : PTR_TO string [255];
  END_VAR
  VAR_IN_OUT
    buffer           : usint;
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fbWebPushService
(*`{CSY} Funkèní blok pro odesílání upozornìní
  {ENU} Function block for notifications sending*)
  VAR_INPUT
    init             : bool R_EDGE;
    send             : bool R_EDGE;
    serverAddr       : TIPadr :=  [127,0,0,1];
    serverPort       : uint :=  5001;
    chanCode         : uint;
    charset          : string [25] :=  'win1250';
    key              : string [80];
  END_VAR
  VAR_OUTPUT
    ready            : bool;
    subscriptions    : uint;
    done             : bool;
    busy             : bool;
    err              : usint;
  END_VAR
  VAR
    state            : usint;
    request          : fbHttpRequestL2;
    postData         : THttpPostData;
    response         : THttpBuffer;
    action           : string [10];
    contentType      : string [80];
    get              : bool;
    post             : bool;
    totalLen         : uint;
  END_VAR
  VAR_IN_OUT
    notification     : TWebPushNotif;
  END_VAR
END_FUNCTION_BLOCK



