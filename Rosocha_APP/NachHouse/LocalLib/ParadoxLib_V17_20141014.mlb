{LIBRARY="LOCALLIB\STDLIB_V20_20100519.MLB"}
{LIBRARY="LOCALLIB\COMLIB_V19_20120614.MLB"}
{LIBRARY="LOCALLIB\TOSTRINGLIB_V13_20110203.MLB"}
// {LIBRARY="LOCALLIB\SYSLIB_V31_20120621.MLB"}
// {LIBRARY="LOCALLIB\DATABOXLIB_V14_20100902.MLB"}
// {LIBRARY="LOCALLIB\DEBUGCOMLIB_V15_20120321.MLB"}
// {LIBRARY="LOCALLIB\FILELIB_V18_20110614.MLB"}

VAR_GLOBAL CONSTANT
 PAR_DIG_EVO_MAX_ZONES : uint :=  192;
 PAR_DIG_EVO_MAX_PARTITIONS : uint :=  8;
 PAR_DIG_EVO_MAX_VIRTUAL_INPUTS : uint :=  16;
 PAR_DIG_EVO_MAX_VIRTUAL_PGM_EVENTS : uint :=  30;

END_VAR

TYPE T_PAR_DIG_EVO_PART_STATE_CODE : 
  (PAR_DIG_EVO_PART_STATE_CODE_DISARMED,
   PAR_DIG_EVO_PART_STATE_CODE_ARMED,
   PAR_DIG_EVO_PART_STATE_CODE_FORCED_ARMED,
   PAR_DIG_EVO_PART_STATE_CODE_STAY_ARMED,
   PAR_DIG_EVO_PART_STATE_CODE_INSTANT_ARMED 
  );
END_TYPE

TYPE T_PAR_DIG_EVO_ZONE :
  STRUCT
    state            : bool;
    tamper           : bool;
    fault            : bool;
    fire_loop_trouble : bool;
    alarm            : bool;
    fire_alarm       : bool;
    low_battery      : bool;
  END_STRUCT;
END_TYPE

TYPE T_PAR_DIG_EVO_PART_STATE :
  STRUCT
    ready            : bool;
    alarm            : bool;
    armed            : bool;
    trouble          : bool;
    zone_in_memory   : bool;
    in_programming   : bool;
    strobe           : bool;
    code             : T_PAR_DIG_EVO_PART_STATE_CODE;
  END_STRUCT;
END_TYPE

TYPE T_PAR_DIG_EVO_PART_CONTROL :
  STRUCT
    armRegular       : bool;
    armForce         : bool;
    armStay          : bool;
    armInstant       : bool;
    armWithCode      : bool;
    disarmWithCode   : bool;
    userCode         : string [6];
  END_STRUCT;
END_TYPE

TYPE T_PAR_DIG_EVO_PART :
  STRUCT
    state            : T_PAR_DIG_EVO_PART_STATE;
    control          : T_PAR_DIG_EVO_PART_CONTROL;
  END_STRUCT;
END_TYPE

TYPE T_PAR_DIG_EVO_VIRTUAL :
  STRUCT
    inputOpen        : ARRAY [1..16] OF bool;  (*`{ENU} open virtual input {CSY} sepnout virtuбlnн vstup EZS*)
    inputClose       : ARRAY [1..16] OF bool;  (*`{ENU} close virtual input {CSY} rozepnout virtuбlnн vstup EZS*)
    pgm              : ARRAY [1..30] OF bool;  (*`{ENU} state of virtual PGM events {CSY} stav virtuбlnнch PGM udбlostн EZS*)
  END_STRUCT;
END_TYPE

TYPE T_PAR_DIG_EVO_SYSTEM_DATA :
  STRUCT
    zone             : ARRAY [1..192] OF T_PAR_DIG_EVO_ZONE;  (*`{ENU} zones {CSY} zуny*)
    part             : ARRAY [1..8] OF T_PAR_DIG_EVO_PART;  (*`{ENU} sections {CSY} sekce (bloky)*)
    virtual          : T_PAR_DIG_EVO_VIRTUAL;  (*`{ENU} virtual objects {CSY} virtuбlnн objekty*)
  END_STRUCT;
END_TYPE

TYPE  T_PAR_DIG_EVO_RESPONSE {HIDDEN} : ARRAY [1..20] OF usint;
END_TYPE

__DECL FUNCTION PAR_DIG_EVO_support {HIDDEN} : bool
  VAR_INPUT
    code             : udint;
    tim              : udint;
  END_VAR
END_FUNCTION

__DECL FUNCTION PAR_DIG_EVO_MemcpyPtr {HIDDEN} : udint
(*`{ENU}Function memcpy copies a block of n bytes from source to dest.
  Function returns number of copied bytes.
  {CSY}Funkce memcpy kopнruje blok n bytщ ze source do dest.
  Funkce vracн poиet zkopнrovanэch bytщ*)
  VAR_INPUT
    source           : PTR_TO udint;  (*`source*)
    dest             : PTR_TO udint;  (*`destination*)
    length           : udint;  (*`number of bytes*)
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fbPAR_DIG_EVOsystem
(*`{CSY} Komunikace se zabezpeиovacн ъstшednou PARADOX Digiplex EVO48, EVO96, EVO192
  Sйriovэ kanбl musн bэt v reЮimu uni, 9600 Baud, bez parity, RTS auto
  velikost pшijнmacнho bufferu 250 bytщ, velikost vysнlacнho bufferu 50 bytщ,
  klid mezi pшijнmanэmi zprбvami 4, klid mezi vysнlanэmi zprбvami 4
  {ENU}
  Communication with Paradox security system PARADOX Digiplex EVO48, EVO96, EVO192
  Communication channel have to be in uni mode, 9600 Baud, without parity, RTS auto
  size of receiving buffer is 250 bytes, size of sending buffer is 50 bytes,
  minimal idle time between received messages 4, minimal idle time between send messages 4*)
  VAR_INPUT
    chan_code        : uint;  (*`{ENU} code of serial channel (CH1_uni, ... ) {CSY}kуd sйriovйho kanбlu (CH1_uni,...)*)
    max_zone_count   : uint :=  PAR_DIG_EVO_MAX_ZONES;
  END_VAR
  VAR_OUTPUT
    com_ok           : bool;  (*`{ENU} communication is OK {CSY} komunikace s ъstшednou PAR_DIG_EVO navбzбna*)
    err              : bool;  (*`{ENU} error flag {CSY} pшнznak chyby*)
    err_ID           : usint;  (*`{ENU} number of error {CSY} инslo chyby*)
    err_txt          : string [80];  (*`{ENU} description of error {CSY} chybovй hlбЪenн*)
    mes_accepted     : bool;  (*`{ENU} last message received from PAR_DIG_EVO is processed {CSY} poslednн zprбva od PAR_DIG_EVO zpracovanб*)
    zone_updated     : bool;  (*`{ENU} all zones updated {CSY} vЪechny zуny obnoveny*)
    part_updated     : bool;  (*`{ENU} all partitions updated {CSY} vЪechny sekce obnoveny*)
    last_mes         : string [80];  (*`{ENU} text of last received message {CSY} text poslednн zprбvy od PAR_DIG_EVO*)
    num_mes          : udint;  (*`{ENU} number of received messages {CSY} celkovэ poиet pшijatэch zprбv*)
  END_VAR
  VAR_IN_OUT
    par_system_data  : T_PAR_DIG_EVO_SYSTEM_DATA;  (*`{ENU} variable contains state of security system {CSY} promмnnб popisujнcн stav ъstшedny*)
  END_VAR
  VAR CONSTANT
    PAR_DIG_EVO_MAX_RX_DATA_BUFFER : uint :=  255;
    PAR_DIG_EVO_MAX_TX_DATA_BUFFER : uint :=  20;
    PAR_DIG_EVO_MAX_LENGTH_COMMAND : uint :=  6;
    PAR_DIG_EVO_MAX_LENGTH_ARM_COMMAND : uint :=  13;
    PAR_DIG_EVO_MAX_LENGTH_QUICK_ARM_COMMAND : uint :=  7;
    PAR_DIG_EVO_MAX_LENGTH_DISARM_COMMAND : uint :=  12;
    PAR_DIG_EVO_MAX_LENGTH_VIRTUAL_COMMAND : uint :=  6;
    PAR_DIG_EVO_ZONE_STATUS_POLL_SESSION : uint :=  0;
    PAR_DIG_EVO_PART_STATUS_POLL_SESSION : uint :=  1;
    PAR_DIG_EVO_ZONE_ARM_POLL_SESSION : uint :=  2;
    PAR_DIG_EVO_ZONE_QUICKARM_POLL_SESSION : uint :=  3;
    PAR_DIG_EVO_ZONE_DISARM_POLL_SESSION : uint :=  4;
    PAR_DIG_EVO_VIRTUAL_INPUT_OPEN_SESSION : uint :=  5;
    PAR_DIG_EVO_VIRTUAL_INPUT_CLOSE_SESSION : uint :=  6;
  END_VAR
  VAR
    PAR_DIG_EVO_ZONE_STATUS_REQUEST : string [6] :=  'RZ001$0D';
    PAR_DIG_EVO_PART_STATUS_REQUEST : string [6] :=  'RA001$0D';
    PAR_DIG_EVO_ZONE_ARM_REQUEST : string [13] :=  'AA001Axxxxxx$0D';
    PAR_DIG_EVO_ZONE_QUICKARM_REQUEST : string [7] :=  'AQ001A$0D';
    PAR_DIG_EVO_ZONE_DISARM_REQUEST : string [12] :=  'AD001xxxxxx$0D';
    PAR_DIG_EVO_VIRTUAL_INPUT_OPEN_REQUEST : string [6] :=  'VO001$0D';
    PAR_DIG_EVO_VIRTUAL_INPUT_CLOSE_REQUEST : string [6] :=  'VC001$0D';
    p_to_out_command : PTR_TO string [80];
    SendMes          : fbSendTo;
    tx_data          : ARRAY [0..20] OF usint;
    RecvMes          : fbRecvTxtChar;
    rx_data          : ARRAY [0..255] OF usint;  (*`prijimaci buffer pro fbRecvTxt*)
    rx_msg           : string [80];
    ptr_last_mes     : PTR_TO T_PAR_DIG_EVO_RESPONSE;
    indexZone        : uint :=  0;  (*`zone index (smycka)*)
    indexPart        : uint :=  0;  (*`partition index (podsystem)*)
    poll_session     : uint :=  PAR_DIG_EVO_ZONE_STATUS_POLL_SESSION;
    last_poll_session : uint;
    sendTimer        : TON;
    recvTimer        : TON;
    commandFound     : bool;
    wait             : bool;
    result_RZ        : bool;
    result_RA        : bool;
    result_G         : bool;
    result_PGM       : bool;
    result_FAIL      : bool;
    last_cmd_address : uint;
    last_cmd_param   : usint;
    last_event_group : uint;
    last_event_number : uint;
    last_group_number : uint;
    str_temp         : string [80];
    tx_length        : uint;
    index            : uint;
    command_parameter : string [4];
    ptrVirtualIn     : PTR_TO word;
    timEVO           : TON;
  END_VAR
END_FUNCTION_BLOCK



