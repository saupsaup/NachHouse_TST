TYPE T_METEO_IQWS_4000 :
  STRUCT
    windspeed        : real;  (*`{CSY} Okamћitб rychlost vмtru               [m/s]       {ENU} wind speed                        [m/s]*)
    winddir          : real;  (*`{CSY} Smмr proudмnн vмtru                   [0-15]      {ENU} wind flow direction               [0-15]*)
    wdird            : real;  (*`{CSY} Smмr proudмnн vмtru ve stupnнch       [deg]       {ENU} wind flow direction in degrees    [deg]*)
    windgust         : real;  (*`{CSY} Maximбlnн rychlost vмtru              [m/s]       {ENU} wind gust                         [m/s]*)
    pressure         : real;  (*`{CSY} Absolutnн tlak                        [hPa]       {ENU} atmosperic pressure               [hPa]*)
    systemp          : real;  (*`{CSY} Vnitшnн teplota meteostanice - systйm [°C]        {ENU} inside temperature of anemometer  [°C]*)
    temperature      : real;  (*`{CSY} Teplota                               [°C]        {ENU} temperature                       [°C]*)
    baraltitude      : real;  (*`{CSY} Barometickб nadmoшskб vэљka           [m]         {ENU} barometic altitude                [m]*)
    windchill        : real;  (*`{CSY} Pocitovб teplota                      [°C]        {ENU} windchill                         [°C]*)
    relhumidity      : real;  (*`{CSY} Relativnн vlhkost                     [%]         {ENU} relative humidity                 [%]*)
    abshumidity      : real;  (*`{CSY} Absolutnн vlhkost                     [g/m3]      {ENU} absolute humidity                 [g/m3]*)
    dewpoint         : real;  (*`{CSY} Rosnэ bod                             [°C]        {ENU} dew point                         [°C]*)
    devname          : string [80];  (*`{CSY} Nбzev zaшнzenн                        'IQWS-4000' {ENU} name of device                    'IQWS-4000'*)
    spower           : real;  (*`{CSY} Intenzita sluneиnнho zбшenн           [W/m2]      {ENU} intensity of sunlight             [W/m2]*)
    uf               : real;  (*`{CSY} UV faktor                                         {ENU} UV factor*)
    stime            : dt;  (*`{CSY} иas bouшky                            [UTC]       {ENU} storm time                        [UTC]*)
    sdist            : real;  (*`{CSY} Vzdбlenost bouшky                     [km]        {ENU} storm distance                    [km]*)
    senr             : real;  (*`{CSY} Bouшkovб energie                                  {ENU} storm energy*)
    lpd              : udint;  (*`{CSY} Poиet bleskщ za den                               {ENU} number of lightnings per day*)
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK fbMeteoIQWS4000
(*`{CSY} Zpracovбnн dat poskytovanэch anemometrem IQWS 4000
  {ENU} Communication with anemometer IQWS 4000*)
  VAR_INPUT
    chanCode         : uint;  (*`{CSY} kуd kanбlu ANY_UNI nebo ETH1_uni0, ETH1_uni1,... (TCP Client, 512 IN, 512 OUT) {ENU} channel code ANY_UNI or ETH1_uni0, ETH1_uni1,... (TCP Client, 512 IN, 512 OUT)*)
    ipIQWS           : string [16];  (*`{CSY} IP adresa anemometru IQWS 4000 {ENU} IP address of anemometer IQWS 4000*)
    delay            : time :=  T#10s;  (*`{CSY} prodleva mezi dotazy na poиasн {ENU} delay between weather queries*)
  END_VAR
  VAR_IN_OUT
    weatherInfo      : T_METEO_IQWS_4000;  (*`{CSY} data anemometru {ENU} anemometer data*)
  END_VAR
  VAR_OUTPUT
    newData          : bool;  (*`{CSY} pшijata novб data     {ENU} new data received*)
    err              : bool;  (*`{CSY} nastala chyba         {ENU} an error occurred*)
    errTxt           : string [80];  (*`{CSY} popis poslednн chyby  {ENU} description of the last error*)
  END_VAR
  VAR
    rqDoc            : bool :=  TRUE;  (*`ћбdost o naиtenн a vypбrsovanн xml*)
    rqParam          : bool :=  TRUE;  (*`nastavit parametry*)
    chanHandle       : uint;
    xmlPage          : string [80];  (*`end point meteo stanice*)
    XmlDocParser     : fbXmlPageParser;  (*`FB pro pбrsovбnн souboru*)
    xml              : TXmlInfo;  (*`struktura pro vэsledky pбrsovбnн*)
    parseEnable      : bool;  (*`pomocnб pro pбrsovбnн*)
    timDelay         : TON;  (*`prodleva mezi komunikacн*)
    tempString       : string [80];  (*`pomocnб pro pбrsovanн иasu*)
    timeout          : TON;
  END_VAR
END_FUNCTION_BLOCK



