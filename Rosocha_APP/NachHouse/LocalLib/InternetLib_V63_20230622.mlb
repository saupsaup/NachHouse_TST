    Err              : bool;  (*`{ENG}Communication error {CSY}Chyba komunikace*)
    ErrId            : usint;  (*`{ENG}Error number {CSY}»Ìslo chyby*)
    DataReady        : bool;  (*`{ENG}New data received {CSY}P¯ijata nov· data*)
