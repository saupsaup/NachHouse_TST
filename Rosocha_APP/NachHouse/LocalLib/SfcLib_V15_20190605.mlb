VAR_GLOBAL CONSTANT
 SFC_ZERO_T : time :=  T#0:0:0;;
 SFC_DWMAX_T : dword :=  16#7FFF_FFFF;
 SFC_POU_NAME_LEN : int :=  64;  (*`length of SFC POU type name*)
 CHART_CTRL_VERSION : byte :=  16#01;
 ID_SfcException_ActionConcurrentT : uint :=  13;
 ID_SfcException_ActionSD_SLQ1 : uint :=  14;
 ID_SfcException_ActionSL_SDQ1 : uint :=  15;

END_VAR

VAR_GLOBAL
 _GSfcForcesActive AT %S75.0 : bool;  (*`some SFC POU has active SFC forces (has both installed & enabled)*)
 _GSfcForcesEnabled AT %S75.1 : bool;  (*`some SFC POU has enabled SFC forces*)
 _GSfcForcesInstalled AT %S75.2 : bool;  (*`some SFC forces are installed*)
 _GSfcEvolutionDisabled AT %S75.3 : bool;  (*`some SFC POU has disabled evolution*)
 _GSfcStepAlarm AT %S75.4 : bool;  (*`some step has any alarm*)
 _GSfcInfoValid AT %S75.7 : bool;  (*`program contains at least one SFC POU*)
 _SfcTempBool AT %S1.1 : bool;  (*`this is used by SFC progs/fbs as temporary boolean result*)
 _SfcTempTonQ AT %S1.2 : bool;  (*`this is used by SFC progs/fbs as temporary boolean result*)
 _SfcTempIf AT %S1.3 : bool;  (*`'_SfcTempIf' nabyde hodnoty FALSE, pokud je nejaka predchozi podminka splnena*)
 _SfcTempIsMacroStep AT %S1.4 : bool;  (*`used by 'T_SFC_fbStep'*)
 _SfcHotRestart AT %S2.3 : bool;  (*`used by SFC POU instances*)
 _SfcMilisecCnt AT %S52 : dint;  (*`system milisec counter*)

END_VAR

__DECL FUNCTION_BLOCK T_SFC_ExtControl {HIDDEN}
  VAR_INPUT
    Restart          : bool;
    ClearAlarms      : bool;
    AlarmsDisabled   : bool;
    SfcForcesEnabled : bool;
    SetSituation     : bool;
    ReserveI5 {HIDDEN} : bool;
    ReserveI6 {HIDDEN} : bool;
    DisableLocalCtrl : bool;
  END_VAR
  VAR_OUTPUT
    ReserveO {HIDDEN} : byte;
  END_VAR
  VAR_INPUT
    Ptr {HIDDEN}     : PTR_TO T_SFC_ExtControl;
  END_VAR
END_FUNCTION_BLOCK

TYPE T_SFC_ChartControl {HIDDEN} :
  STRUCT  (*`instance pro ladeni SFC schematu*)
    SfcForcesInstalled : bool;  (*`je TRUE, pokud nejaky trans/step schematu ma nastavenou SFC force*)
    StepAlarmLo      : bool;  (*`je TRUE, pokud nejaky step ma LoAlarm*)
    StepAlarmHi      : bool;  (*`je TRUE, pokud nejaky step ma HiAlarm*)
    RuntimeError     : bool;  (*`je TRUE, pokud ma POU runtimovou chybu*)
    SfcForcesActive  : bool;  (*`je TRUE, pokud ma POU aktivni SFC forces (enabled & installed)*)
    ExtControled     : bool;  (*`je TRUE, pokud ma POU prirazen pointer na externi rizeni*)
    StepAlarmDisabled : bool;  (*`je TRUE, pokud nejaky step ma nastaveno 'AlarmDisabled'*)
    _Unused07        : bool;
    SfcForcesEnabled : bool;  (*`state of scheme SFC forces enabled*)
    AlarmsDisabled   : bool;  (*`state of scheme AlarmsDisabled, zakazuje generovani alarmu stepu*)
    EvolutionDisabled : bool;  (*`state of scheme EvolutionDisabled, zakazuje provadeni stavovych zmen ve schematu*)
    Restarted        : bool;  (*`je TRUE po dobu, kdy je system ve stavu restartovani*)
    RestartedP       : bool;  (*`je TRUE po dobu jedne otocky, kdy je system ve stavu restartovani*)
    RestartedF       : bool;  (*`je TRUE po dobu jedne otocky, kdy je system ukoncil restartovani*)
    ClearAlarms      : bool;  (*`je TRUE, pokud je pozadovano resetovani alarmu*)
    SetSituation     : bool;  (*`je TRUE, pokud je pozadovano nastaveni situace*)
    SfcForcesEnabledFF : bool;  (*`povoluje SFC forces pro schema*)
    AlarmsDisabledFF : bool;  (*`zakazuje nastavovani step alarmu pro schema*)
    RestartFF        : bool;  (*`vnuceni restartu POU, dokud je TRUE tak schme je ve stavu Restarted*)
    EvolutionDisabledFF : bool;  (*`zakazuje provadeni stavovych zmen ve schematu*)
    SetSituationFF   : bool;  (*`nastavit situaci ve schematu podle 'step.Situ' bitu, auto reset*)
    _Unused25        : bool;
    _Unused26        : bool;
    _Unused27        : bool;
    ClearAlarmsRq    : bool;  (*`clear all scheme step alarms, nastavuje globalne system, schema po vykonani priznak vynuluje*)
    EvoTickRq        : bool;  (*`pozaduje provedeni vsech 'transition dependent' prechodu mezi stavy (provede se pouze ve stavu 'EvolutionDisabled==TRUE')*)
    RecordSituRq     : bool;  (*`nahrat soucasnou situaci schematu do 'step.Situ', auto reset*)
    _Unused33        : bool;
    _Unused34        : bool;
    _Unused35        : bool;
    _Unused36        : bool;
    _Unused37        : bool;
    ExtControl {HIDDEN} : T_SFC_ExtControl;  (*`external control*)
    VersionR         : byte :=  CHART_CTRL_VERSION;  (*`verze 'T_SFC_ChartControl'*)
    FirstPass        : bool :=  TRUE;  (*`priznak prvni otocky schematu*)
    LocalPrevTime    : time;
    LocalTick        : time;  (*`tick instance*)
    AliveCounter     : udint;
    SfcException     : uint;
  END_STRUCT;
END_TYPE

TYPE T_SFC_DPouDescr {HIDDEN} :
  STRUCT  (*`this descriptor is created for every SFC POU type and placed to 'D' area*)
    StateGatherLabel : udint;  (*`(offset 0) = index of execution point for gathering SFC POU state*)
    HotRestartLabel  : udint;  (*`(offset 4) = index of execution point for hot restart*)
    ChartCtrlOffs    : udint;  (*`(offset 8) = offset of '__ChartCtrl' from the start of the POU*)
    PouName          : string [64];  (*`(offset 12) = SFC POU data type name*)
  END_STRUCT;
END_TYPE

__DECL FUNCTION fnSfcCollectGlobals {HIDDEN} : bool
  VAR
    SfcInstancesCount : dint;
    SfcInstanceOffsetR : dint;
    SfcInstanceOffsetD : dint;
    i                : dint;
  END_VAR
END_FUNCTION

__DECL FUNCTION fnSfcSpreadHotRestart {HIDDEN} : bool
  VAR
    SfcInstancesCount : dint;
    SfcInstanceOffsetR : dint;
    SfcInstanceOffsetD : dint;
    i                : dint;
  END_VAR
END_FUNCTION

__DECL FUNCTION fnSfcGetLocalTick {HIDDEN} : time
  VAR_IN_OUT
    LocalPrevTime    : time;
  END_VAR
END_FUNCTION

__DECL FUNCTION fnSfcRuntimeError : bool
  VAR_INPUT
    PouOffs          : udint;  (*`offset v zapisniku na zacatek volajici POU*)
    PouName          : string [80];  (*`'prgDinoPark'*)
    StepName         : string [80];  (*`'Att2'*)
    ActionName       : string [80];  (*`'Scream'*)
    Qualifier        : string [80];  (*`'D'*)
    ErrorCode        : uint;  (*`ID_SfcException_ActionConcurrentT*)
  END_VAR
  VAR
    PouInstanceName  : string [200];
    ErrorMessage     : string [250];
  END_VAR
END_FUNCTION

TYPE T_SFC_ActCtrlInput {HIDDEN} :
  STRUCT
    N                : bool;
    R                : bool;
    S                : bool;
    P                : bool;
    P1               : bool;
    P0               : bool;
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK T_SFC_fbSfcActionControl
  VAR_INPUT
    InCtrl           : T_SFC_ActCtrlInput;
  END_VAR
  VAR_OUTPUT
    Q                : bool;
    A                : bool;
    FS               : bool;  (*`rozsireni mxSOFT, je TRUE, pokud akce startuje poprve (First Scan)*)
  END_VAR
  VAR
    _S_FF_Q1 {HIDDEN} : bool;  (*`vystup R1S pro 'S' a 'R'*)
    _P_TRIG_Q {HIDDEN} : bool;  (*`vystup R_TRIG pro 'P'*)
    _P1_TRIG_Q {HIDDEN} : bool;  (*`vystup R_TRIG pro 'P1'*)
    _P0_TRIG_Q {HIDDEN} : bool;  (*`vystup F_TRIG pro 'P0'*)
  END_VAR
END_FUNCTION_BLOCK

TYPE T_SFC_ActCtrlInputT {HIDDEN} :
  STRUCT
    N                : bool;
    R                : bool;
    S                : bool;
    P                : bool;
    P1               : bool;
    P0               : bool;
    L                : bool;
    D                : bool;
    DS               : bool;
    T_Done           : bool;  (*`je TRUE, pokud casovac ridiciho kroku >= PT*)
    T_Used           : bool;  (*`je TRUE, pokud nejaky krok jiz aktivoval input s casovym kvalifikatorem L/D/DS*)
    PT               : time;  (*`vstup PT casovacu - je tu jen z duvodu hodnoty pro zobrazeni v debug*)
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK T_SFC_fbSfcActionControlT
  VAR_INPUT
    InCtrl           : T_SFC_ActCtrlInputT;
    T_ConcurrentErr  : bool;  (*`je true, pokud jsou nejake soubezne pozadavky na L/D/DS, neni nulovano pri kazdem provedeni POU*)
  END_VAR
  VAR_OUTPUT
    Q                : bool;
    A                : bool;
    FS               : bool;  (*`rozsireni mxSOFT, je TRUE, pokud akce startuje poprve (First Scan)*)
  END_VAR
  VAR
    _S_FF_Q1 {HIDDEN} : bool;  (*`vystup R1S pro 'S' a 'R'*)
    _P_TRIG_Q {HIDDEN} : bool;  (*`vystup R_TRIG pro 'P'*)
    _P1_TRIG_Q {HIDDEN} : bool;  (*`vystup R_TRIG pro 'P1'*)
    _P0_TRIG_Q {HIDDEN} : bool;  (*`vystup F_TRIG pro 'P0'*)
    _DS_FF_Q1 {HIDDEN} : bool;  (*`vystup RS pro 'DS'*)
  END_VAR
END_FUNCTION_BLOCK

TYPE T_SFC_ActCtrlInputTS {HIDDEN} :
  STRUCT
    N                : bool;
    R                : bool;
    S                : bool;
    P                : bool;
    P1               : bool;
    P0               : bool;
    L                : bool;
    D                : bool;
    DS               : bool;
    SD               : bool;
    SL               : bool;
    T_Done           : bool;  (*`je TRUE, pokud casovac ridiciho kroku >= PT*)
    T_Used           : bool;  (*`je TRUE, pokud nejaky krok jiz aktivoval input s casovym kvalifikatorem L/D/DS/SL/SD*)
    PT               : time;  (*`vstup PT casovacu - je tu jen z duvodu hodnoty pro zobrazeni v debug*)
  END_STRUCT;
END_TYPE

TYPE TSfcActionCtrlStored {HIDDEN} :
  STRUCT
    SD_FF_Q1         : bool;  (*`vystup RS pro 'SD'*)
    SL_FF_Q1         : bool;  (*`vystup RS pro 'SL'*)
    TON_T            : time;  (*`pocitadlo casovace SD/SL*)
    TON_PT           : time;  (*`predvolba casovace SD/SL*)
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK T_SFC_fbSfcActionControlTS
  VAR_INPUT
    InCtrl           : T_SFC_ActCtrlInputTS;
    T_ConcurrentErr  : bool;  (*`je true, pokud jsou nejake soubezne pozadavky na L/D/DS, neni nulovano pri kazdem provedeni POU*)
    T_ConcurrentStoredErr : bool;  (*`je true, pokud bezi SD a chci SL nebo bezi SL a chci SD, neni nulovano pri kazdem provedeni POU*)
    LocalTick        : time;  (*`tick instance*)
  END_VAR
  VAR_OUTPUT
    Q                : bool;
    A                : bool;
    FS               : bool;  (*`rozsireni mxSOFT, je TRUE, pokud akce startuje poprve (First Scan)*)
    _SD_Running {HIDDEN} : bool;  (*`for external read only*)
    _SL_Running {HIDDEN} : bool;  (*`for external read only*)
  END_VAR
  VAR
    _S_FF_Q1 {HIDDEN} : bool;  (*`vystup R1S pro 'S' a 'R'*)
    _P_TRIG_Q {HIDDEN} : bool;  (*`vystup R_TRIG pro 'P'*)
    _P1_TRIG_Q {HIDDEN} : bool;  (*`vystup R_TRIG pro 'P1'*)
    _P0_TRIG_Q {HIDDEN} : bool;  (*`vystup F_TRIG pro 'P0'*)
    _DS_FF_Q1 {HIDDEN} : bool;  (*`vystup RS pro 'DS'*)
    _Stored          : TSfcActionCtrlStored;  (*`casovac a R1S pro SD a SL*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK T_SFC_fbStep
(*`instance je definovana pro kazdy step,
  vsechny promenne zacinajici podtrzitkem jsou user read-only*)
  VAR_OUTPUT
    X                : bool;  (*`step activity*)
    Ovf              : bool;  (*`timer overflow*)
    Done             : bool;  (*`step Preset time reached*)
    AlarmLo          : bool;  (*`step active shorter then LimitLo time*)
    AlarmHi          : bool;  (*`step active longer then LimitHi time*)
    Enter            : bool;  (*`step first scan*)
    Leave            : bool;  (*`step last scan*)
  END_VAR
  VAR_INPUT
    AlarmDisabled    : bool;  (*`non-reset variable, disables alarm for step, user can Read/Write*)
  END_VAR
  VAR_OUTPUT
    T                : time;  (*`step timer, holds value until next step activations*)
    TSum             : time;  (*`total step activity time, holds value until PLC cold restart*)
    Count            : udint;  (*`number of step activations, holds value until PLC cold restart*)
  END_VAR
  VAR_INPUT
    Situ             : bool;  (*`non-reset variable, preset for SetSituation*)
    _Reset {HIDDEN}  : bool;  (*`step reset request*)
    _FalseForced {HIDDEN} : bool;  (*`non-reset variable, step is FALSE-forced by user request*)
    _EnterStep {HIDDEN} : bool;  (*`pozadavek na vstup do stepu*)
    _LeaveStep {HIDDEN} : bool;  (*`pozadavek na opusteni stepu*)
    _Preg {HIDDEN}   : bool;  (*`first step (shora pripojen k paralelni divergenci) in simultaneous branch has '_FalseForced==TRUE' and the branch was activated*)
    _PassThru {HIDDEN} : bool;  (*`request to enter _MayForceFalse or _MayForceStep step*)
    Preset           : time;  (*`non-reset variable, minimal step activity duration time*)
    LimitLo          : time;  (*`non-reset variable, step LO alarm time limit*)
    LimitHi          : time;  (*`non-reset variable, step HI alarm time limit*)
    ChartCtrl {HIDDEN} : PTR_TO T_SFC_ChartControl;  (*`instance control structure*)
  END_VAR
  VAR
    _MayForceFalse {HIDDEN} : bool;  (*`initialised, tento step muze byt FALSE-forced (shora pripojen k paralelni divergenci)*)
    _MayForceStep {HIDDEN} : bool;  (*`initialised, tento step muze byt TRUE-forced (shora pripojen pres transition k selektivni divergenci)*)
    _Macro {HIDDEN}  : bool;  (*`initializaed, tento krok nepatri do hlavniho schematu (je tedy soucasti nejakehp makra)*)
    _MacroBeginPtr {HIDDEN} : PTR_TO T_SFC_fbStep;  (*`initialised, pointer na pripadny MacroStepBegin*)
    _MacroEndPtr {HIDDEN} : PTR_TO T_SFC_fbStep;  (*`initialised, pointer na pripadny MacroStepEnd*)
  END_VAR
END_FUNCTION_BLOCK



