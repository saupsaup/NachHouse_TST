#srcfile ''
#srcfile 'D:\TECOAPP\SFC-LIB\SFCLIB_V1_51\FBSFCSTEP.ST'
#pou T_SFC_fbStep
#srcline 1 ;FUNCTION_BLOCK T_SFC_fbStep
P     61
T_SFC_fbStep_L0:
 LINK 0
#srcline 55 ;  Leave := false; Enter := false;
 LD   bool 0       ; false
 WRX  Leave
#debug_left bool Leave
 LD   bool 0       ; false
 WRX  Enter
#debug_left bool Enter
#srcline 57 ;  if not _MayForceFalse then  // tento step nemuze mit forced-FALSE
 LDX  _MayForceFalse
#debug bool _MayForceFalse
 NEG
 JMC  T_SFC_fbStep_L1
#srcline 58 ;    _FalseForced := false;
 LD   bool 0       ; false
 WRX  _FalseForced
#debug_left bool _FalseForced
#srcline 59 ;  end_if;
T_SFC_fbStep_L1:
#srcline 60 ;  if _Macro then              // makrostep nemuze pouzivat Situ
 LDX  _Macro
#debug bool _Macro
 JMC  T_SFC_fbStep_L3
#srcline 61 ;    Situ := false;
 LD   bool 0       ; false
 WRX  Situ
#debug_left bool Situ
#srcline 62 ;  end_if;
T_SFC_fbStep_L3:
#srcline 63 ;  if ChartCtrl^.ClearAlarms then
 LEAX ChartCtrl
 LDIL    ; dereference 
 ADD  1  ; + offset 
 MUL  8   ; -> bool pointer 
 ADD  6   ; Bool offset 
 LDIB 
#debug bool ChartCtrl^.ClearAlarms
 JMC  T_SFC_fbStep_L5
#srcline 64 ;    AlarmLo := false;
 LD   bool 0       ; false
 WRX  AlarmLo
#debug_left bool AlarmLo
#srcline 65 ;    AlarmHi := false;
 LD   bool 0       ; false
 WRX  AlarmHi
#debug_left bool AlarmHi
#srcline 66 ;  end_if;
T_SFC_fbStep_L5:
#srcline 67 ;  ChartCtrl^.StepAlarmDisabled := ChartCtrl^.StepAlarmDisabled or (AlarmDisabled and ((LimitLo <> SFC_ZERO_T) or (LimitHi <> SFC_ZERO_T)));
 LEAX ChartCtrl
 LDIL    ; dereference 
 MUL  8   ; -> bool pointer 
 ADD  6   ; Bool offset 
 LDIB 
#debug bool ChartCtrl^.StepAlarmDisabled
 LDX  AlarmDisabled
#debug bool AlarmDisabled
 LDX  LimitLo
#debug time LimitLo
 LD   time 0
 EQ
 NEG
 LDX  LimitHi
#debug time LimitHi
 LD   time 0
 EQ
 NEG
 OR  
 AND
 OR  
 LEAX ChartCtrl
 LDIL    ; dereference 
 MUL  8   ; -> bool pointer 
 ADD  6   ; Bool offset 
 WRIB 
#debug_left bool ChartCtrl^.StepAlarmDisabled
#srcline 69 ;  // je restartovaci puls
#srcline 70 ;  if ChartCtrl^.RestartedP then
 LEAX ChartCtrl
 LDIL    ; dereference 
 ADD  1  ; + offset 
 MUL  8   ; -> bool pointer 
 ADD  4   ; Bool offset 
 LDIB 
#debug bool ChartCtrl^.RestartedP
 JMC  T_SFC_fbStep_L7
#srcline 71 ;    // Zachovany: Preset, LimitLo, LimitHi, AlarmDisabled, Reset, AlarmLo, AlarmHi,
#srcline 72 ;    //            Situ, _FalseForced, _MayForceFalse, _MayForceStep, _Macro,
#srcline 73 ;    //            TSum, Count,
#srcline 74 ;    //            _MacroBeginPtr, _MacroEndPtr
#srcline 75 ;    _EnterStep := false; _LeaveStep := false;
 LD   bool 0       ; false
 WRX  _EnterStep
#debug_left bool _EnterStep
 LD   bool 0       ; false
 WRX  _LeaveStep
#debug_left bool _LeaveStep
#srcline 76 ;    _Preg := false; X := false; Ovf := false; Done := false;
 LD   bool 0       ; false
 WRX  _Preg
#debug_left bool _Preg
 LD   bool 0       ; false
 WRX  X
#debug_left bool X
 LD   bool 0       ; false
 WRX  Ovf
#debug_left bool Ovf
 LD   bool 0       ; false
 WRX  Done
#debug_left bool Done
#srcline 77 ;    T := SFC_ZERO_T;
 LD   time 0
 WRX  T
#debug_left time T
#srcline 78 ;    //TSum:= SFC_ZERO_T; Count:= 0;
#srcline 79 ;    // _PassThru bude restartovano pozdeji a neprijdu o to
#srcline 80 ;  end_if;
T_SFC_fbStep_L7:
#srcline 82 ;  // vyuziti globalnich bool hodnot pro urychleni
#srcline 83 ;  // - pokud je makrostep (hodnota '_MacroBeginPtr' ruzna od -1 - same jednicky) =>> '_SfcTempIsMacroStep' je true
#srcline 84 ;  {asm}
#srcline 85
  ldx   _MacroBeginPtr
#srcline 86
  neg
#srcline 87
  wr    _SfcTempIsMacroStep
#srcline 88 ;  {end_asm}
#srcline 89 ;  // - (2019-03-05) pokud je povoleno generovani alarmu =>> '_SfcTempIf' je true
#srcline 90 ;  _SfcTempIf := not AlarmDisabled and not ChartCtrl^.AlarmsDisabled;
 LDX  AlarmDisabled
#debug bool AlarmDisabled
 NEG
 LEAX ChartCtrl
 LDIL    ; dereference 
 ADD  1  ; + offset 
 MUL  8   ; -> bool pointer 
 ADD  1   ; Bool offset 
 LDIB 
#debug bool ChartCtrl^.AlarmsDisabled
 NEG
 AND
 WR   _SfcTempIf
#debug_left bool _SfcTempIf
#srcline 92 ;  // neprobiha restartovani ani restartovaci puls
#srcline 93 ;  if not ChartCtrl^.Restarted and not ChartCtrl^.RestartedP then
 LEAX ChartCtrl
 LDIL    ; dereference 
 ADD  1  ; + offset 
 MUL  8   ; -> bool pointer 
 ADD  3   ; Bool offset 
 LDIB 
#debug bool ChartCtrl^.Restarted
 NEG
 LEAX ChartCtrl
 LDIL    ; dereference 
 ADD  1  ; + offset 
 MUL  8   ; -> bool pointer 
 ADD  4   ; Bool offset 
 LDIB 
#debug bool ChartCtrl^.RestartedP
 NEG
 AND
 JMC  T_SFC_fbStep_L9
#srcline 94 ;    if X then
 LDX  X
#debug bool X
 JMC  T_SFC_fbStep_L11
#srcline 95 ;      T := T + ChartCtrl^.LocalTick;
 LDX  T
#debug time T
 LEAX ChartCtrl
 LDIL    ; dereference 
 ADD  16  ; + offset 
 LDIL 
#debug time ChartCtrl^.LocalTick
 ADD
 WRX  T
#debug_left time T
#srcline 96 ;      Ovf := Ovf or (TIME_TO_DWORD(T) > SFC_DWMAX_T);
 LDX  Ovf
#debug bool Ovf
 LDX  T
#debug time T
 LD   dword 2147483647
 GT
 OR  
 WRX  Ovf
#debug_left bool Ovf
#srcline 97 ;      if not Ovf then
 LDX  Ovf
#debug bool Ovf
 NEG
 JMC  T_SFC_fbStep_L13
#srcline 98 ;        Done := T >= Preset;
 LDX  T
#debug time T
 LDX  Preset
#debug time Preset
 LTS
