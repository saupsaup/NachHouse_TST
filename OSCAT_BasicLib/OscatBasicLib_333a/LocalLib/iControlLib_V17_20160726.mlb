VAR_GLOBAL CONSTANT
 ICL_SIZE_NAME : int :=  24;

END_VAR

TYPE T_SET_RGB_LIGHT :
  STRUCT
    level            : real;
    RGB              : T_RGB_COLOR;
  END_STRUCT;
END_TYPE

TYPE  T_TIME_VAL : time :=  T#24h00m0s;
END_TYPE

TYPE T_TIME_PROG_WEEK :
  STRUCT
    name             : string [24];  (*`{ENG} name of time program                 {CSY} nбzev casoveho programu*)
    update           : usint;  (*`pozadavek na update cas. programu z aplikace iFoxtrot*)
    typ              : usint;  (*`ICL_TPW_TYPE_HEATING, ICL_TPW_TYPE_COOLING, ICL_TPW_TYPE_HEATING_COOLING*)
    numTimes         : usint;  (*`pocet casovych znacek za den (min 1, max 7)*)
    heatTemp         : ARRAY [0..3] OF real;  (*`teploty topeni pro kazdy rezim casoveho programu*)
    coolTemp         : ARRAY [0..3] OF real;  (*`teploty chlazeni pro kazdy rezim casoveho programu*)
    times            : ARRAY [0..6,0..6] OF T_TIME_VAL;  (*`casove intervaly casoveho programu*)
    values           : ARRAY [0..6,0..7] OF usint;  (*`rezimy casoveho programu*)
    crc              : uint;  (*`crc = 0 ... povel ze strany termostatu a nebo web rozhrani pro ukladani struktury do souboru*)
  END_STRUCT;
END_TYPE

TYPE T_TIME_PROG_WEEK_STAT :
  STRUCT
    manual           : bool;  (*`0 = auto, 1 = manual*)
    heat             : bool;  (*`pozadavek na topeni*)
    cool             : bool;  (*`pozadavek na chlazeni*)
    roomTemp         : real;  (*`teplota v mistnosti*)
    heatTemp         : real;  (*`pozadovana teplota topeni*)
    coolTemp         : real;  (*`pozadovana teplota chlazeni*)
    mode             : sint;  (*`zvoleny rezim ... 0 = limit, 1 = ECO, 2 = NIGHT {utlum), 3 = DAY (komfort)*)
    interval         : usint;  (*`aktualni interval podle cas. programu*)
    delta            : real;  (*`aktualni delta <-5.0, 5.0>*)
  END_STRUCT;
END_TYPE

TYPE T_TIME_PROG_WEEK_CONT :
  STRUCT
    nextProg         : bool;  (*`auto -> manual, manual -> auto*)
    nextMode         : bool;  (*`zmena rezimu v manualnim modu (ECO <-> NIGHT <-> DAY)*)
    incDelta         : bool;  (*`+0.5*)
    decDelta         : bool;  (*`-0.5*)
  END_STRUCT;
END_TYPE

TYPE T_TIME_PROG_WEEK_INTERFACE :
  STRUCT
    stat             : T_TIME_PROG_WEEK_STAT;
    cont             : T_TIME_PROG_WEEK_CONT;
  END_STRUCT;
END_TYPE

TYPE T_TIME_PROG_WEEK_WEB_SETTINGS :
  STRUCT
    copyT            : string [20];  (*`:= 'Copy ';*)
    selT             : string [20];  (*`:= 'Select dest. day';*)
    days             : ARRAY [0..6] OF string [4];  (*`:= ['MON','TUE','WED','THU','FRI','SAT','SUN'];*)
    buttons          : ARRAY [0..3] OF string [8];  (*`:= ['HEAT','COOL','SAVE','CANCEL']*)
  END_STRUCT;
END_TYPE

VAR_GLOBAL CONSTANT
 TIME_PROG_WEEK_WEB_SETTINGS_CZ : T_TIME_PROG_WEEK_WEB_SETTINGS :=  ( copyT   := 'Kopнrovat ',
                                                                        selT    := 'Zvolte cнlovэ den',
                                                                        days    := ['PO','ЪT','ST','ИT','PБ','SO','NE'],
                                                                        buttons := ['TOPENН','CHLAZENН','ULOЋIT','ZRUЉIT']);
 TIME_PROG_WEEK_WEB_SETTINGS_ENG : T_TIME_PROG_WEEK_WEB_SETTINGS :=  ( copyT   := 'Copy ',
                                                                        selT    := 'Select dest. day',
                                                                        days    := ['MON','TUE','WED','THU','FRI','SAT','SUN'],
                                                                        buttons := ['HEATING','COOLING','SAVE','CANCEL']);

END_VAR

__DECL FUNCTION_BLOCK fb_iLight
(*`{ENG} Basic control of light output {CSY} Zбkladnн ovlбdбnн vэstupu pro svмtlo*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} light on                   {CSY} zapnutн svмtla*)
    lightOff         : bool R_EDGE;  (*`{ENG} light off                  {CSY} vypnutн svмtla*)
    lightToggle      : bool R_EDGE;  (*`{ENG} light toggle               {CSY} pшepnutн svмtla*)
    timeLimit        : time;  (*`{ENG} duration of light on       {CSY} max. doba svнcenн*)
    webToggle        : bool R_EDGE;  (*`{ENG} light toggle from web page {CSY} pшepnutн svмtla z web strбnky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central reset of light     {CSY} centrбlnн vypnutн svмtel*)
    name             : string [24];  (*`{ENG} name of light              {CSY} nбzev svмtla*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} light control  {CSY} ovlбdбnн svмtla*)
  END_VAR
  VAR
    GTSAP1_LIGHT_name {PUBLIC_IN} : string [24];
    GTSAP1_LIGHT_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_type {PUBLIC_IN} : bool :=  0;
    GTSAP1_LIGHT_onoff {PUBLIC} {OPEN_UP} : bool;
    stopTime         : time;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iRelay
(*`{ENG} Basic control of relay output {CSY} Zбkladnн ovlбdбnн vэstupu pro relй*)
  VAR_INPUT
    relayOn          : bool R_EDGE;  (*`{ENG} relay on                   {CSY} zapnutн relй*)
    relayOff         : bool R_EDGE;  (*`{ENG} relay off                  {CSY} vypnutн relй*)
    relayToggle      : bool R_EDGE;  (*`{ENG} relay toggle               {CSY} pшepnutн relй*)
    pulseTime        : time;  (*`{ENG} pulse duration             {CSY} doba trvбnн pulzu*)
    webToggle        : bool R_EDGE;  (*`{ENG} relay toggle from web page {CSY} pшepnutн relй z web strбnky*)
    relayReset       : bool R_EDGE;  (*`{ENG} central reset of relay     {CSY} centrбlnн vypnutн relй*)
    name             : string [24];  (*`{ENG} name                       {CSY} nбzev*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} relay control  {CSY} шнzenн relй*)
  END_VAR
  VAR
    GTSAP1_SOCKET_name {PUBLIC_IN} : string [24];
    GTSAP1_SOCKET_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_SOCKET_onoff {PUBLIC} {OPEN_UP} : bool;
    stopTime         : time;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iAction
(*`{ENG} block catches requests of actions which are generated from mobile app or web page
  {CSY} zachytбvб poћadavky na akci nastavovanй z mobilnн aplikace nebo z web strбnky
   pokud pшijde poћadavek, tak nastavн vэstup bloku na TRUE a vynuluje poћadavek
   vэstup bloku se pak pouћije pro vyvolбnн akce v PLC*)
  VAR_INPUT
    action           : bool R_EDGE;  (*`{ENG} request for action {CSY} poћadavek na akci*)
    webAction        : bool R_EDGE;  (*`{ENG} request for action from web page {CSY} poћadavek na akci z web strбnky*)
    name             : string [24];  (*`{ENG} name               {CSY} nбzev*)
  END_VAR
  VAR
    GTSAP1_ACTION_name {PUBLIC_IN} : string [24];
    GTSAP1_ACTION_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_ACTION_state {PUBLIC_OUT} {OPEN_UP} : bool;
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} TRUE means make action  {CSY} TRUE znamenб provйst akci*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iButton1
(*`{ENG} block for processing of signals from button; long and short press detection
   {CSY} blok pro zpracovani tlaинtka s vyhodnocenнm krбtkйho a dlouhйho stisku*)
  VAR_INPUT
    in               : bool;  (*`{ENG} button              {CSY} vstup tlaинtka*)
    pressTime        : time :=  T#750ms;  (*`{ENG} time for long click {CSY} иas dlouhйho stisku*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} copy of input in  {CSY} kopie vstupu in*)
    click            : bool;  (*`{ENG} short click       {CSY} krбtkэ stisk*)
    press            : bool;  (*`{ENG} long click        {CSY} dlouhэ stisk*)
  END_VAR
  VAR
    GTSAP1_BUTTON_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_BUTTON_click {PUBLIC_IN} : bool;
    GTSAP1_BUTTON_press {PUBLIC_IN} : bool;
    GTSAP1_BUTTON_click_counter {PUBLIC_IN} : usint;
    GTSAP1_BUTTON_press_counter {PUBLIC_IN} : usint;
    in_Ftrig         : F_TRIG;
    in_ton           : TON;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iButton2
(*`{ENG} block for processing of signals from double button
   {CSY} blok pro zpracovani 2-tlaинtka a export pro Control4*)
  VAR_INPUT
    inUp             : bool;  (*`{ENG} button up   {CSY} stisk tlaинtka 'up'*)
    inDown           : bool;  (*`{ENG} button down {CSY} stisk tlaинtka 'down'*)
    name             : string [24];  (*`{ENG} name        {CSY} nбzev*)
  END_VAR
  VAR_OUTPUT
    outUp            : bool;  (*`{ENG} copy of input inUp  {CSY} kopie vstupu inUp*)
    outDown          : bool;  (*`{ENG} copy of input inDw  {CSY} kopie vstupu inDw*)
  END_VAR
  VAR
    GTSAP1_BUTTON_name {PUBLIC_IN} : string [24];
    GTSAP1_BUTTON_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_BUTTON_up {PUBLIC_IN} : bool;
    GTSAP1_BUTTON_down {PUBLIC_IN} : bool;
    GTSAP1_BUTTON_up_counter {PUBLIC_IN} : usint;
    GTSAP1_BUTTON_down_counter {PUBLIC_IN} : usint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iContact
(*`{ENG}block for testing BOOL variable and export for Control4
   {CSY} blok pro testovбnн BOOL promмnnй a export pro Control4*)
  VAR_INPUT
    in               : bool;  (*`{ENG} contact (BOOL variable) {CSY} kontakt (BOOL promмnnб)*)
