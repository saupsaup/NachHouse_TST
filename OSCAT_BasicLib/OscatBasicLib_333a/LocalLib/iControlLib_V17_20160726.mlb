__DECL FUNCTION_BLOCK fb_iWebConf
(*`{CSY} Zveшejnмnн web strбnky do aplikace iFoxtrot nebo odkaz na aplikaci spouљtмnou z iFoxtrot
   {ENU} Publication of web page into iFoxtrot application or link of external application*)
  VAR_INPUT
    name             : string [24];  (*`{ENG} name of block (iFoxtrot icon) {CSY} nбzev bloku (iFoxtrot ikony)*)
    link             : string [80];  (*`{ENG} link on PLC web page or URl link of application ('vlc://', 'XBMCREMOTE://', ...) ! case sensitive {CSY} odkaz na web strбnku v PLC nebo URL aplikace ('vlc://', 'XBMCREMOTE://', ...) !*)
    symbol           : string [16];  (*`{ENG} icon name of application (VLC, MUSIC, PARKING, KODI, ...) {CSY} nбzev ikony pro aplikaci (VLC, MUSIC, PARKING, KODI, ...)*)
  END_VAR
  VAR
    GTSAP1_WEBCONF_name {PUBLIC_IN} : string [24];
    GTSAP1_WEBCONF_url {PUBLIC_IN} : string [80];  (*`napr. http://192.168.33.143/index.xml*)
    GTSAP1_WEBCONF_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_WEBCONF_symbol {PUBLIC_IN} : string [16];  (*`VLC, MUSIC, PARKING, KODI, ...*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iWebCamera
(*`{CSY} Zveшejnмnн web kamery do aplikace iFoxtrot
   {ENU} Publication of web camera into iFoxtrot application*)
  VAR_INPUT
    name             : string [24];  (*`{ENG} name of block (iFoxtrot icon) {CSY} nбzev bloku (iFoxtrot ikony)*)
    url              : string [80];  (*`{ENG} URL address of web camera     {CSY} URL adresa web kamery*)
  END_VAR
  VAR
    GTSAP1_CAMERA_name {PUBLIC_IN} : string [24];
    GTSAP1_CAMERA_url {PUBLIC_IN} : string [80];  (*`napr. http://posta.mukolin.cz/axis-cgi/jpg/image.cgi*)
    GTSAP1_CAMERA_enable {PUBLIC_IN} : bool :=  1;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iSocket
(*`{ENG} Basic control of relay output {CSY} Zбkladnн ovlбdбnн vэstupu pro relй*)
  VAR_INPUT
    socketOn         : bool R_EDGE;  (*`{ENG} socket on                   {CSY} zapnutн zбsuvky*)
    socketOff        : bool R_EDGE;  (*`{ENG} socket off                  {CSY} vypnutн zбsuvky*)
    socketToggle     : bool R_EDGE;  (*`{ENG} socket toggle               {CSY} pшepnutн zбsuvky*)
    pulseTime        : time;  (*`{ENG} pulse duration              {CSY} doba trvбnн pulzu*)
    webToggle        : bool R_EDGE;  (*`{ENG} socket toggle from web page {CSY} pшepnutн zбsuvky z web strбnky*)
    socketReset      : bool R_EDGE;  (*`{ENG} central reset of socket     {CSY} centrбlnн vypnutн zбsuvky*)
    name             : string [24];  (*`{ENG} name                        {CSY} nбzev*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} socket control  {CSY} шнzenн zбsuvky*)
  END_VAR
  VAR
    GTSAP1_SOCKET_name {PUBLIC_IN} : string [24];
    GTSAP1_SOCKET_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_SOCKET_onoff {PUBLIC} {OPEN_UP} : bool;
    stopTime         : time;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iDisplay
(*`{ENG} function block for display of value including units
   {CSY} blok pro zobrazenн hodnoty vиetnм fyzikбlnнch jednotek*)
  VAR_INPUT
    in               : real;  (*`{ENG} value (REAL variable)       {CSY} hodnota (REAL promмnnб)*)
    unit             : string [8];  (*`{ENG} units (kWh, km/h, ...)      {CSY} jednotky (kWh, km/h, ...)*)
    precision        : int;  (*`{ENG} size of fraction part       {CSY} poиet zobrazenэch desetinnэch mнst (0 = celй инslo)*)
    filterTime       : time :=  T#30s;  (*`{ENG} time constant of filter     {CSY} иasovб konstanta filtru*)
    url              : string [80];  (*`{ENG} URL address of web page     {CSY} URL adresa web strбnky*)
    name             : string [24];  (*`{ENG} name                        {CSY} nбzev*)
  END_VAR
  VAR_OUTPUT
    out              : real;  (*`{ENG} out := filter( in + offset) {CSY} out := filter( in + offset)*)
  END_VAR
  VAR
    GTSAP1_DISPLAY_name {PUBLIC_IN} : string [24];
    GTSAP1_DISPLAY_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_DISPLAY_value {PUBLIC_IN} : real;
    GTSAP1_DISPLAY_unit {PUBLIC_IN} : string [8];
    GTSAP1_DISPLAY_precision {PUBLIC_IN} : int;
    GTSAP1_DISPLAY_url {PUBLIC_IN} : string [80];
    filter           : fbFirstOrder;  (*`filtr prvniho radu*)
  END_VAR
END_FUNCTION_BLOCK

VAR_GLOBAL CONSTANT
 ICL_TPW_TYPE_HEATING : usint :=  1;
 ICL_TPW_TYPE_COOLING : usint :=  2;
 ICL_TPW_TYPE_HEATING_COOLING : usint :=  3;
 ICL_TPW_PATH : string [20] :=  'WWW/IFOX/';
 ICL_TPW_PREFIX : string [4] :=  'WTP_';
 ICL_TPW_FORMAT : string [8] :=  '%04X.JSN';
 ICL_TPW_JSN_EXT : string [8] :=  '.JSN';
 ICL_TPW_APP_EXT : string [8] :=  '.APP';
 ICL_TPW_BAK_EXT : string [8] :=  '.BAK';
 ICL_TPW_TMP_EXT : string [8] :=  '.TMP';
 ICL_TPW_ERR1 : string [26] :=  'Name of program is empty!';
 ICL_TPW_ERR2 : string [11] :=  ' not found!';
 ICL_TPW_ERR3 : string [19] :=  'Corrupted JSON file';
 ICL_TPW_ERR4 : string [23] :=  'No time program in JSON';
 ICL_TPW_KEYWORD : string [16] :=  'timeProgWeekData';

END_VAR

__DECL FUNCTION AddTextToRecord {HIDDEN} : udint
(*`Add next part of record*)
  VAR_INPUT
    text             : string [80];
    ptrRec           : PTR_TO string [255];
  END_VAR
  VAR
    lenRec           : uint;
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fb_TimeProgWeek_LoadDefault {HIDDEN}
  VAR_IN_OUT
    timeProgWeekData : T_TIME_PROG_WEEK;
  END_VAR
  VAR CONSTANT
    initTimeProg24x7data : T_TIME_PROG_WEEK :=  ( typ      := ICL_TPW_TYPE_HEATING_COOLING,
                                                 numTimes := 5,
                                                 heatTemp := [5.0,19.0,21.0,23.0],  // musi byt vzestupne
                                                 coolTemp := [33.0,28.0,25.0,24.0], // musi byt sestupne
                                                 times    := [T#0h0m0s, T#6h15m0s, T#8h0m0s,  T#15h00m0s, T#21h00m0s, T#24h0m0s, T#24h0m0s,
                                                              T#0h0m0s, T#6h15m0s, T#8h0m0s,  T#15h00m0s, T#21h00m0s, T#24h0m0s, T#24h0m0s,
                                                              T#0h0m0s, T#6h15m0s, T#8h0m0s,  T#15h00m0s, T#21h00m0s, T#24h0m0s, T#24h0m0s,
                                                              T#0h0m0s, T#6h15m0s, T#8h0m0s,  T#15h00m0s, T#21h00m0s, T#24h0m0s, T#24h0m0s,
                                                              T#0h0m0s, T#6h15m0s, T#8h0m0s,  T#15h00m0s, T#21h00m0s, T#24h0m0s, T#24h0m0s,
                                                              T#0h0m0s, T#7h15m0s, T#22h0m0s, T#24h00m0s, T#24h00m0s, T#24h0m0s, T#24h0m0s,
                                                              T#0h0m0s, T#7h15m0s, T#22h0m0s, T#24h00m0s, T#24h00m0s, T#24h0m0s, T#24h0m0s],
                                                 values   := [1,2,3,2,3,1,1,1,
                                                              1,2,3,2,3,1,1,1,
                                                              1,2,3,2,3,1,1,1,
                                                              1,2,3,2,3,1,1,1,
                                                              1,2,3,2,3,1,1,1,
                                                              1,2,3,2,1,1,1,1,
                                                              1,2,3,2,1,1,1,1],
                                                 crc      := 0);
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_TimeProgWeek_LoadDataFromFile {HIDDEN}
  VAR_INPUT
    exec             : bool;
    fileName         : string [24];
    timeProgName     : string [80];  (*`jmeno promenne s casovym programem*)
    timeProgAdr      : udint;  (*`adresa promenne s casovym programem*)
  END_VAR
  VAR_OUTPUT
    done             : bool;
    busy             : bool;
    lastErr          : string [80];  (*`{ENG} last error description        {CSY} popis pшнpadnй chyby*)
    err              : bool;
  END_VAR
  VAR
    JsonParser {HIDDEN} : fbJsonFileParser;  (*`FB pro pбrsovбnн souboru*)
    json             : TJsonInfo;  (*`struktura pro vэsledky pбrsovбnн*)
    res              : bool;
    isTimeProg24x7   : bool;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iTimeProgWeek
  VAR_INPUT
    enable           : bool :=  true;  (*`{ENG} time program shown or not on APP GUI {CSY} zobrazovani casoveho programu v APP GUI*)
    name             : string [24];  (*`{ENG} name of time program                 {CSY} nбzev casoveho programu*)
    typ              : usint :=  ICL_TPW_TYPE_HEATING_COOLING;  (*`typ иasovйho programu : ICL_TPW_TYPE_HEATING, ICL_TPW_TYPE_COOLING, ICL_TPW_TYPE_HEATING_COOLING*)
    numTimes         : usint;  (*`pocet casovych znacek za den (min 1, max 7)*)
  END_VAR
  VAR_OUTPUT
    timeProgWeekData {OPEN_UP} {TRACK_ADR} : T_TIME_PROG_WEEK;  (*`tэdennн иasovэ program*)
    adrTimeProg      : udint;  (*`adresa promмnnй timeProgWeekData*)
    busy             : bool;  (*`{ENG} block is busy                 {CSY} blok pracuje*)
    lastErr          : string [80];  (*`{ENG} last error description        {CSY} popis pшнpadnй chyby*)
    file             : string [12];  (*`{ENG} name of json file with description of time program  {CSY} jmйno json souboru s popisem иasovйho programu*)
  END_VAR
  VAR
    WeekTimeProg24x7data_temp : T_TIME_PROG_WEEK;
    TimeProgWeek_LoadDefault : fb_TimeProgWeek_LoadDefault;
    TimeProgWeek_LoadDataFromFile : fb_TimeProgWeek_LoadDataFromFile;
    fb_CreatePath    : CreatePath;
    fb_WriteToFile   : WriteToFile;
    fb_ReadFromFile  : ReadFromFile;
    fileDesc         : TFileInfo;  (*`struktura s informacemi o souboru*)
    jsonBuf          : ARRAY [0..1023] OF usint;  (*`buffer pro sestaveni json souboru*)
    fileName         : string [24];
    fileName_app     : string [24];
    fileName_tmp     : string [24];
    fileName_bak     : string [24];
    extSaveRq        : bool;
    extCopyReadRq    : bool;
    extCopyWriteRq   : bool;
    extSaveToBAKRq   : bool;
    extSaveToJSNRq   : bool;
    extPowerUpLoadRq : bool :=  TRUE;
    extPowerUpLoadJSNRq : bool :=  TRUE;
    extPowerUpLoadBAKRq : bool;
    extSaveNewDataToJSNRq : bool :=  TRUE;
    extSaveNewDataToBAKRq : bool;
    extLoadTempDataRq : bool;
    last_crc         : uint;
    ptr              : PTR_TO usint;
    ptr_str          : PTR_TO string [80];
    crc              : uint;
    varBaseName      : string [80];
    iFoxPath         : string [20] :=  ICL_TPW_PATH;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION CustomTimeProgTimToPos {HIDDEN} : int
  VAR_INPUT
    tim              : time;
    width            : int;
  END_VAR
END_FUNCTION

__DECL FUNCTION CustomTimeProgPosToTim {HIDDEN} : time
  VAR_INPUT
    pos              : int;
    width            : int;
    lim              : real;
    w                : real;
    t                : time;
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fb_iTimeProgWeek_Web
  VAR_INPUT
    darkBg           : bool;  (*`:= FALSE = light background, TRUE = dark background*)
    webGuiSettings   : T_TIME_PROG_WEEK_WEB_SETTINGS;
    adrTimeProg      : udint;
  END_VAR
  VAR_OUTPUT
    canvasOK         : bool;
    canvasLen        : uint;
    canvasData       : TCanvasData1024;  (*`TCanvasData1536;*)
  END_VAR
  VAR CONSTANT
    C_HEAT_3         : udint :=  GCOLOR_RED_600;  (*`16#182CDD;*)
    C_HEAT_2         : udint :=  GCOLOR_DEEP_ORANGE_500;  (*`16#1958E2;*)
    C_HEAT_1         : udint :=  GCOLOR_ORANGE_600;  (*`16#1B83E6;*)
    C_HEAT_0         : udint :=  GCOLOR_AMBER_400;  (*`16#D9CE7E;*)
    C_COOL_3         : udint :=  GCOLOR_INDIGO_600;  (*`16#DD7718;*)
    C_COOL_2         : udint :=  GCOLOR_BLUE_600;  (*`16#E2A219;*)
    C_COOL_1         : udint :=  GCOLOR_LIGHT_BLUE_400;  (*`16#E6D11B;*)
    C_COOL_0         : udint :=  GCOLOR_CYAN_200;  (*`16#58AEFF;*)
    C_BUTTONS        : udint :=  GCOLOR_DEEP_PURPLE_500;
    C_BACKGR         : udint :=  16#686868;  (*`== GCOLOR_GREY_650;*)
    C_LINE           : udint :=  GCOLOR_GREY_300;  (*`16#E1E1E1;*)
    C_NUM_STEPS      : usint :=  4;  (*`pocet teplot*)
    C_NUM_TIMES      : usint :=  7;  (*`max. pocet casovych znacek za den*)
    C_HEAT_COLOR     : ARRAY [0..3] OF udint :=  [C_HEAT_0, C_HEAT_1, C_HEAT_2, C_HEAT_3];
    C_COOL_COLOR     : ARRAY [0..3] OF udint :=  [C_COOL_0, C_COOL_1, C_COOL_2, C_COOL_3];
    C_width          : int :=  500;
    C_width2         : int :=  C_width /2;
    C_width3         : int :=  C_width /3;
    C_width5         : int :=  C_width /5;
    C_width10        : int :=  C_width /10;
    C_9C_width10     : int :=  9*C_width10;
    C_height         : int :=  350;
    C_hMarg          : int :=  3*C_width /20;
    C_hMarg2         : int :=  C_hMarg /2;
    C_hMarg4         : int :=  C_hMarg /4;
    C_wMarg          : int :=  C_width /20;
    C_wMarg2         : int :=  C_wMarg /2;
    C_hStep          : int :=  C_width /20;
    C_hStep2         : int :=  C_hStep /2;
    C_selDist        : int :=  C_width /20;
    C_textSize       : int :=  C_hMarg2 /3 -1;
    C_textSize2      : int :=  C_textSize /2;
    C_controlBar     : int :=  -70-C_hMarg2;
    C_R              : int :=  C_textSize*3 /2 +3;
    C_wb             : int :=  C_width /8 +5;
    C_wb2            : int :=  C_wb /2;
    C_wb4            : int :=  C_wb /4;
    C_ws             : int :=  C_width /7;
    C_ws2            : int :=  C_ws /2;
    C_delta          : real :=  0.5;
  END_VAR
  VAR
    numTimes         : usint;  (*`pocet casovych znacek za den*)
    selLine          : int;
    selBlock         : int;
    selButton1       : int;
    endTime          : time :=  T#24h;
    actTim           : PTR_TO time;
    actTim2          : PTR_TO time;
    actTim3          : PTR_TO time;
    heatCool         : bool;  (*`0 heating, 1 cooling*)
    wasTouch         : bool;
    rqSave           : bool;
    repaint          : bool;
    counterInit      : bool;
    copy             : int;
    counterTON       : TON;
    ptr_time_prog    : PTR_TO T_TIME_PROG_WEEK;
    disp             : usint :=  255;
    corrDist         : int;
    x_time           : int;
    lastTouchX       : int;
    lastTouchY       : int;
    lastCRC          : uint;
    triangle         : ARRAY [0..2] OF TCanvasPoint :=  [( x := 0,  y := 0), ( x := -5,  y := 9),( x := 5,  y := 9)];
    triangleUP       : ARRAY [0..2] OF TCanvasPoint :=  [( x := 0,  y := -7),( x := -7,  y := 6),( x := 7,  y := 6)];
    triangleDW       : ARRAY [0..2] OF TCanvasPoint :=  [( x := -7, y := -6),( x := 0,   y := 7),( x := 7,  y := -6)];
    canvasMax        : uint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iTimeProgWeek_Control
  VAR_INPUT
    enable           : bool :=  TRUE;
    roomTemp         : real;  (*`teplota v mistnosti*)
    webNextProg      : bool R_EDGE;  (*`auto -> manual, manual -> auto*)
    webNextMode      : bool R_EDGE;  (*`zmena rezimu v manualnim modu*)
    webIncDelta      : bool R_EDGE;
    webDecDelta      : bool R_EDGE;
    adrTimeProg      : udint;
  END_VAR
  VAR_IN_OUT
    settings         : T_TIME_PROG_WEEK_INTERFACE;
  END_VAR
  VAR_OUTPUT
    manual           : bool;  (*`0 = auto, 1 = manual*)
    heat             : bool;  (*`pozadavek na topeni*)
    cool             : bool;  (*`pozadavek na chlazeni*)
    heatTemp         : real;  (*`pozadovana teplota topeni*)
    coolTemp         : real;  (*`pozadovana teplota chlazeni*)
    mode             : sint;  (*`zvoleny rezim ... 0 = limit, 1 = ECO, 2 = NIGHT {utlum), 3 = DAY (komfort)*)
    interval         : usint;  (*`aktualni interval podle cas. programu*)
    delta            : real;
  END_VAR
  VAR
    GTSAP1_TPW_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_TPW_name {PUBLIC_IN} : string [24];
    GTSAP1_TPW_type {PUBLIC_IN} : usint;  (*`typ casoveho programu*)
    GTSAP1_TPW_file {PUBLIC_IN} : string [24];
    GTSAP1_TPW_crc {PUBLIC_IN} : uint;  (*`{ENG} last valid crc of time program    {CSY} posledni platne crc casoveho programu*)
    GTSAP1_TPW_update {PUBLIC_OUT} : bool;  (*`{ENG} command from app to update week program data from file  {CSY} povel z aplikace na nacteni dat casoveho programu z souboru*)
    GTSAP1_TPW_manual {PUBLIC_IN} : bool;  (*`0 = auto, 1 = manual*)
    GTSAP1_TPW_heat {PUBLIC_IN} : bool;  (*`pozadavek na topeni*)
    GTSAP1_TPW_cool {PUBLIC_IN} : bool;  (*`pozadavek na chlazeni*)
    GTSAP1_TPW_roomTemp {PUBLIC_IN} : real;  (*`teplotav mistnosti*)
    GTSAP1_TPW_heatTemp {PUBLIC_IN} : real;  (*`pozadovana teplota topeni*)
    GTSAP1_TPW_coolTemp {PUBLIC_IN} : real;  (*`pozadovana teplota chlazeni*)
    GTSAP1_TPW_mode {PUBLIC_IN} : sint;  (*`zvoleny rezim ... 0 = limit, 1 = ECO, 2 = NIGHT {utlum), 3 = DAY (komfort)*)
    GTSAP1_TPW_delta {PUBLIC_IN} : real;  (*`aktualni delta <-5.0, 5.0>*)
    GTSAP1_TPW_nextProg {PUBLIC_OUT} : bool;  (*`auto -> manual, manual -> auto*)
    GTSAP1_TPW_nextMode {PUBLIC_OUT} : bool;  (*`zmena rezimu v manualnim modu (ECO <-> NIGHT <-> DAY)*)
    GTSAP1_TPW_incDelta {PUBLIC_OUT} : bool;  (*`+0.5*)
    GTSAP1_TPW_decDelta {PUBLIC_OUT} : bool;  (*`-0.5*)
    init             : bool;
    lastManual       : bool;
    numTimes         : usint;
    lastInterval     : usint;
    ptr_time_prog    : PTR_TO T_TIME_PROG_WEEK;
    incMode          : sint;
  END_VAR
END_FUNCTION_BLOCK



