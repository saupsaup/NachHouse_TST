__DECL FUNCTION_BLOCK fb_iDimmerRGB
(*`{CSY} Stmнvanй RGB svмtlo,
         krбtkй stisky zapнnajн a vypнnajн svмtlo (na nastavenou ъroveт s rampou "offOnRamp")
         dlouhй stisky mмnн nastavenou ъroveт s rampou "setRamp"
         Vэstup 3 x level 0..100%, 3 x rampa [sec] - pro 3 RGB kanбly CIB modulu ULED/ILED
   {ENU} RGB dimmer,
         short press activates and deactivates light (to set level with ramp "offOnRamp")
         long press changes the level with ramp "setRamp"
         Outputs: 3 x level 0..100%, 3 x ramp [sec] for 3 RGB channels of ULED/ILED CIB module*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} turn on the light at the last level (short press) {CSY} zapnout svмtlo na poslednн ъroveт (krбtkэ stisk)*)
    levelUp          : bool;  (*`{ENG} increase the level (long press)                   {CSY} zvэљit ъroveт (dlouhэ stisk)*)
    lightOff         : bool R_EDGE;  (*`{ENG} turn off the light (short press)                  {CSY} vypnout svмtlo (krбtkэ stisk)*)
    levelDw          : bool;  (*`{ENG} decrease the level (long press)                   {CSY} snнћit ъroveт (dlouhэ stisk)*)
    lightToggle      : bool R_EDGE;  (*`{ENG} toggle of the light                               {CSY} pшepnutн svмtla*)
    offOnRamp        : time :=  T#5s;  (*`{ENG} ramp Off/On from min level to 100% [sec]          {CSY} rampa Off/On z minLevel na 100% [sec]*)
    setRamp          : time :=  T#8s;  (*`{ENG} ramp Up/Dw from min level to 100%  [sec]          {CSY} rampa Up/Dw z minLevel na 100% [sec]*)
    timeLimit        : time;  (*`{ENG} maximum time limit light [sec]                    {CSY} omezenн max. doby svнcenн (automaticky zhasne) [sec]*)
    webToggle        : bool R_EDGE;  (*`{ENG} control lights from web page                      {CSY} ovlбdбnн svмtla z web strбnky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central switching off                             {CSY} centrбlnн zhasnutн*)
    name             : string [24];  (*`{ENG} name of light                                     {CSY} nбzev svмtla*)
  END_VAR
  VAR_IN_OUT
    setLight         : T_SET_RGB_LIGHT;  (*`{ENG} last level and color (this variable have to be in VAR_GLOBAL RETAIN) {CSY} poslednн nastavenб ъroveт a barva (promмnnou umнstit do VAR_GLOBAL RETAIN)*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} indication Off/On      {CSY} signalizace On/Off*)
    levelRed         : real;  (*`{ENG} red level 0..100 [%]   {CSY} red ъroveт 0..100 [%]*)
    levelGreen       : real;  (*`{ENG} green level 0..100 [%] {CSY} green ъroveт 0..100 [%]*)
    levelBlue        : real;  (*`{ENG} blue level 0..100 [%]  {CSY} blue ъroveт 0..100 [%]*)
    rampRed          : usint;  (*`{ENG} red ramp [sec]         {CSY} red rampa [sec]*)
    rampGreen        : usint;  (*`{ENG} green ramp [sec]       {CSY} green rampa [sec]*)
    rampBlue         : usint;  (*`{ENG} blue ramp [sec]        {CSY} blue rampa [sec]*)
  END_VAR
  VAR
    GTSAP1_LIGHT_name {PUBLIC_IN} : string [24];
    GTSAP1_LIGHT_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_type {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_dimtype {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_onoff {PUBLIC} {OPEN_UP} : bool;
    GTSAP1_LIGHT_dimlevel {PUBLIC} {OPEN_UP} : real;
    GTSAP1_LIGHT_rgb {PUBLIC} {OPEN_UP} : udint;
    toggleOn         : bool;  (*`pomocna pro zapnuti*)
    toggleOff        : bool;  (*`pomocna pro vypnuti*)
    lastLevelUp      : bool;
    lastLevelDw      : bool;
    lastSL52         : udint;
    level            : real;  (*`svetelnost RGB (jas)*)
    oldSetGTSAP1     : T_SET_RGB_LIGHT;
    oldSetLight      : T_SET_RGB_LIGHT;
    tim              : TON;  (*`casovac pro omezeni doby osvetleni*)
    red              : real;
    green            : real;
    blue             : real;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iJalousie
(*`{CSY} Ovlбdбnн ћaluziн
   {ENU} Jalousie control*)
  VAR_INPUT
    rotUp            : bool R_EDGE;  (*`{ENG} step up  {CSY} pootoиit ћaluzie nahoru*)
    up               : bool R_EDGE;  (*`{ENG} move up {CSY} ћaluzie nahoru*)
    rotDw            : bool R_EDGE;  (*`{ENG} step down  {CSY} pootoиit ћaluzie dolu*)
    dw               : bool R_EDGE;  (*`{ENG} move down {CSY} ћaluzie dolu*)
    block            : bool;  (*`{ENG} blocking {CSY} blokace ovlбdacнch vstupщ*)
    stop             : bool R_EDGE;  (*`{ENG} stop the movement {CSY} zastavenн pohybu*)
    ctrUp            : bool R_EDGE;  (*`{ENG} central up {CSY} centrбlnн vytaћenн ћaluzie*)
    ctrDw            : bool R_EDGE;  (*`{ENG} central down {CSY} centrбlnн spuљtмnн ћaluzie*)
    webUp            : bool R_EDGE;  (*`{ENG} activation of "move up" from web interface {CSY} pro vysunutн ћaluziн z web rozhranн*)
    webDw            : bool R_EDGE;  (*`{ENG} activation of "move down"  from web interface {CSY} pro spuљtмnн ћaluziн z web rozhranн*)
    upDwTime         : time :=  T#20s;  (*`{ENG} maximum time of movement {CSY} maximбlnн doba bмhu pohonu*)
    rotTime          : time :=  T#0.5s;  (*`{ENG} lenght of step [sec]  {CSY} doba trvбnн kroku pri pootбиenн*)
    pauseTime        : time :=  T#1.0s;  (*`{ENG} delay between reversation of movement [sec] {CSY} prodleva pшed otoиenнm smмru*)
    ctrTime          : time := T#10.0s ;  (*`{ENG} central movement delay [sec] {CSY} zpoћdмnн centrбlnнho pohybu*)
    name             : string [24];  (*`{ENG} name of the jalousie {CSY} nбzev ћaluzie*)
  END_VAR
  VAR_OUTPUT
    outUp            : bool;  (*`{ENG}  {CSY} ћaluzie nahoru*)
    outDw            : bool;  (*`{ENG}  {CSY} ћaluzie dolu*)
    sig              : bool;  (*`{ENG}  {CSY} signalizace chodu*)
    sigUp            : bool;  (*`{ENG}  {CSY} signalizace ћaluzie nahoшe*)
    sigDw            : bool;  (*`{ENG}  {CSY} signalizace ћaluzie dole*)
  END_VAR
  VAR
    GTSAP1_SHUTTER_name {PUBLIC_IN} : string [24];
    GTSAP1_SHUTTER_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_SHUTTER_up {PUBLIC_IN} : bool;
    GTSAP1_SHUTTER_down {PUBLIC_IN} : bool;
    GTSAP1_SHUTTER_run {PUBLIC_IN} : bool;
    GTSAP1_SHUTTER_uppos {PUBLIC_IN} : bool;
    GTSAP1_SHUTTER_downpos {PUBLIC_IN} : bool;
    GTSAP1_SHUTTER_up_control {PUBLIC_OUT} {OPEN_UP} : bool;
    GTSAP1_SHUTTER_down_control {PUBLIC_OUT} {OPEN_UP} : bool;
    GTSAP1_SHUTTER_rotup_control {PUBLIC_OUT} {OPEN_UP} : bool;
    GTSAP1_SHUTTER_rotdown_control {PUBLIC_OUT} {OPEN_UP} : bool;
    cas_stop         : time :=  T#0s;
    pauseUp          : bool;
    pauseDw          : bool;
    longUpDw         : bool;
    timUp            : TOF;
    timDw            : TOF;
    centrUp          : bool;
    centrUpH         : bool;
    centrDw          : bool;
    centrDwH         : bool;
    centrDelay       : time;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_TimeAction
(*`{CSY} Blok pro vytvoшenн impulsu v zadanэ иas.
   timeOfAction := T#22h odpovнdб иasu 22:00:00 [hh:mm:ss]
   {ENU} Function block that creates action impulse in given time of day.
   timeOfAction := T#22h activates the output in 22:00:00 [hh:mm:ss]*)
  VAR_INPUT
    enable           : bool;  (*`{CSY} povolenн aktivace*)
    timeOfAction1    : time;  (*`{ENG} time of 1st action  {CSY} иas aktivace 1.vэstupu*)
    timeOfAction2    : time;  (*`{ENG} time of 2nd action  {CSY} иas aktivace 2.vэstupu*)
  END_VAR
  VAR_OUTPUT
    out1             : bool;  (*`{ENG} output for 1st action {CSY} vэstup pro 1.akci*)
    out2             : bool;  (*`{ENG} output for 2nd action {CSY} vэstup pro 2.akci*)
  END_VAR
  VAR
    out1Trgr         : R_TRIG;
    out2Trgr         : R_TRIG;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_JalAlarm
(*`{CSY} Zбkladnн reakce ћaluzie na poplachy.
    Priority:
    1. poћбr   : blokace a otevшenн
    2. nбmraza : blokace a zastavenн
    3. vнtr    : blokace a otevшenн
    4. sklo    : zavшenн
   {ENU} Basic reaction to alerts.
    Precedency:
    1. fire  : move up and block
    2. ice   : stop and block
    3. wind  : move up and block
    4. glass : move down*)
  VAR_INPUT
    fire             : bool;  (*`{ENG} fire alert: move up and block jalousie inputs {CSY} poplach poћбr: vytaћenн ћaluzie a blokace vstupщ*)
    ice              : bool;  (*`{ENG} ice alert: stop the movement and block jalousie inputs {CSY} poplach nбmraza: zastavenн pohybu, blokace vstupщ*)
    wind             : bool;  (*`{ENG} wind alert: move up and block jalousie inputs  {CSY} poplach silnэ vнtr: vytaћenн ћaluzie a blokace vstupщ*)
    glass            : bool;  (*`{ENG} glass breaking alert: move down {CSY} poplach rozbitн skla: spuљtмnн ћaluzie*)
    blockJal         : bool;  (*`{ENG} blocking of jalousie inputs {CSY} blokace ovlбdбnн*)
    stopJal          : bool R_EDGE;  (*`{ENG} stop the movement {CSY} vstup zastavenн pohybu ћaluzie*)
    ctrUpJal         : bool R_EDGE;  (*`{ENG} central movement up {CSY} central nahoru*)
    ctrDwJal         : bool R_EDGE;  (*`{ENG} central movement down {CSY} central dolu*)
  END_VAR
  VAR_OUTPUT
    block            : bool;  (*`{ENG} blocking of jalousie inputs, connect with jalousie control {CSY} blokace ovlбdбnн, propojit s blokem zaluzie*)
    stop             : bool;  (*`{ENG} stop the movement, connect with jalousie cotnrol {CSY} zastavenн pohybu ћaluzie, propojit s blokem zaluzie*)
    ctrUp            : bool;  (*`{ENG} central movement up, connect with jalousie cotnrol {CSY} central nahoru, propojit s blokem zaluzie*)
    ctrDw            : bool;  (*`{ENG} central movement down, connect with jalousie cotnrol  {CSY} centralne dolu, propojit s blokem zaluzie*)
  END_VAR
  VAR
    fire_Rtrig       : R_TRIG;
    ice_Rtrig        : R_TRIG;
    wind_Rtrig       : R_TRIG;
    glass_Rtrig      : R_TRIG;
    fireH            : bool;
    iceH             : bool;
    windH            : bool;
    glassH           : bool;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_RndPulse
(*`{CSY} Funkиnн blok pro generovбnн nбhodnэch zapнnacнch pulzщ s rщznou dйlkou.
   {ENU} Function block that randomly activates its output for a radnom time duration.*)
  VAR_INPUT
    enable           : bool;  (*`{ENG} Enables the FB  {CSY} Povolenн funkce FB*)
    sTime            : time;  (*`{ENG} Start of the generating (time) {CSY} zaибtek generovбnн pulzщ T#21h odpovнdб 21:00:00 [hh:mm:ss]*)
    eTime            : time;  (*`{ENG} End of the generating (time) {CSY} Konec generovбnн novэch pulzщ T#21h odpovнdб 21:00:00 [hh:mm:ss]*)
    minOffT          : time :=  T#5m;  (*`{ENG} Minimal time of "0" {CSY} Minimбlnн dйlka intervalu nuly*)
    minOnT           : time :=  T#10m;  (*`{ENG} Minimal time of "1" {CSY} Minimбlnн dйlka intervalu jedniиky*)
    maxLenght        : time :=  T#1h;  (*`{ENG} Maximal lenght of "1" and "0".  {CSY}  Maximбlnн dйlka pulzu jak "1" tak "0".*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} randomly generated output signal  {CSY} vэstup nбhodnм generovanэch a nбhodnм dlouhэch pulzщ*)
    outOn            : bool;  (*`{ENG} rising edge of out  {CSY} nбbмћnб hrana vэstupu out*)
    outOff           : bool;  (*`{ENG} falling edge of out {CSY} sestupnб hrana vэstupu out*)
  END_VAR
  VAR
    tOffStart        : bool;
    timerOff         : TON;
    timerOn          : TON;
    bottleneck       : real;
    i                : usint :=  1;
    duration         : time;
    cas              : ARRAY [1..2] OF time;
    dTime            : time;
    trigOn           : R_TRIG;
    trigOff          : F_TRIG;
    seed             : dint;
    init_seed        : bool :=  1;
    k                : dint;
    random           : real;
  END_VAR
END_FUNCTION_BLOCK

VAR_GLOBAL CONSTANT
 ICL_SCENE_PATH : string [12] :=  'WWW/iFOX/';
 ICL_SCENE_PREFIX : string [4] :=  'SCN_';
 ICL_SCENE_FORMAT : string [8] :=  '%04X.sc?';
 ICL_SCENE_ERR1 : string [23] :=  'Name of scene is empty!';
 ICL_SCENE_ERR2 : string [11] :=  ' not found!';

END_VAR

