    GTSAP1_SCENE_name {PUBLIC_IN} : string [24];
    GTSAP1_SCENE_file {PUBLIC_IN} : string [24];
    GTSAP1_SCENE_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_SCENE_num {PUBLIC_IN} : usint :=  4;
    GTSAP1_SCENE_set1 {PUBLIC_OUT} {OPEN_UP} : bool;
    GTSAP1_SCENE_set2 {PUBLIC_OUT} {OPEN_UP} : bool;
    GTSAP1_SCENE_set3 {PUBLIC_OUT} {OPEN_UP} : bool;
    GTSAP1_SCENE_set4 {PUBLIC_OUT} {OPEN_UP} : bool;
    rqScene1         : bool;
    rqScene2         : bool;
    rqScene3         : bool;
    rqScene4         : bool;
    rqScene          : bool;
    JsonParser       : fbJsonFileParser;  (*`FB pro pбrsovбnн souboru*)
    json             : TJsonInfo;  (*`struktura pro vэsledky pбrsovбnн*)
    fileName         : string [24];
    extNum           : usint;
  END_VAR
END_FUNCTION_BLOCK

