    scene2On         : bool R_EDGE;  (*`{ENG} set up scene 2                {CSY} zapnutн scйny 2*)
    scene3On         : bool R_EDGE;  (*`{ENG} set up scene 3                {CSY} zapnutн scйny 3*)
    scene4On         : bool R_EDGE;  (*`{ENG} set up scene 4                {CSY} zapnutн scйny 4*)
    webScene1On      : bool R_EDGE;  (*`{ENG} set up scene 1 from web page  {CSY} zapnutн scйny 1 z web strбnky*)
    webScene2On      : bool R_EDGE;  (*`{ENG} set up scene 2 from web page  {CSY} zapnutн scйny 2 z web strбnky*)
    webScene3On      : bool R_EDGE;  (*`{ENG} set up scene 3 from web page  {CSY} zapnutн scйny 3 z web strбnky*)
    webScene4On      : bool R_EDGE;  (*`{ENG} set up scene 4 from web page  {CSY} zapnutн scйny 4 z web strбnky*)
    name             : string [24];  (*`{ENG} name of scene                 {CSY} nбzev scйny*)
  END_VAR
  VAR_OUTPUT
    busy             : bool;  (*`{ENG} block is busy                 {CSY} blok pracuje*)
    lastErr          : string [80];  (*`{ENG} last error description        {CSY} popis pшнpadnй chyby*)
    file             : string [12];  (*`{ENG} name of json file with description of scene  {CSY} jmйno json souboru s popisem scйny*)
  END_VAR
