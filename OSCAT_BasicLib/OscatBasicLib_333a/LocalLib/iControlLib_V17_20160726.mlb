  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iSensorPIR
(*`{ENG} presence detection  {CSY} иidlo pшнtomnosti*)
  VAR_INPUT
    in               : bool;  (*`{ENG} PIR sensor    {CSY} PIR иidlo*)
    delay            : time;  (*`{ENG} insensitivity {CSY} necitlivost*)
    name             : string [24];  (*`{ENG} name          {CSY} nбzev*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} detection of motion {CSY} detekce pohybu*)
