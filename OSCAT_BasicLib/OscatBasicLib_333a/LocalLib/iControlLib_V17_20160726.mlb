    timSensor        : TON;  (*`zpozdeni detekce*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iDimmer
(*`{CSY} Stmнvanй svмtlo s nastavovбnнm ъrovnм pomocн dlouhэch stiskщ,
         krбtkй stisky zapнnajн a vypнnajн svмtlo (na nastavenou ъroveт s rampou "offOnRamp")
         dlouhй stisky mмnн nastavenou ъroveт s rampou "setRamp"
         Vэstup level 0..100% - pro шнzenн 0..10V
   {ENU} Light dimmer,
         short press activates and deactivates light (to set level with ramp "offOnRamp")
         long presses changes the level with ramp "setRamp". Output level 0..100% - for controlling 0..10V*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} turn on the light at the last level (short press) {CSY} zapnout svмtlo na poslednн ъroveт (krбtkэ stisk)*)
    levelUp          : bool;  (*`{ENG} increase the level (long press)          {CSY} zvэљit ъroveт (dlouhэ stisk)*)
    lightOff         : bool R_EDGE;  (*`{ENG} turn off the light (short press)         {CSY} vypnout svмtlo (krбtkэ stisk)*)
    levelDw          : bool;  (*`{ENG} decrease the level (long press)          {CSY} snнћit ъroveт (dlouhэ stisk)*)
    lightToggle      : bool R_EDGE;  (*`{ENG} toggle of the light                      {CSY} pшepnutн svмtla*)
    minLevel         : real :=  10.0;  (*`{ENG} min level for light [%]                  {CSY} min ъroveт pro svмtlo (zapalovacн ъroveт) [%]*)
    offOnRamp        : time :=  T#5s;  (*`{ENG} ramp Off/On from min level to 100% [sec] {CSY} rampa Off/On z minLevel na 100% [sec]*)
    setRamp          : time :=  T#8s;  (*`{ENG} ramp Up/Dw from min level to 100%  [sec] {CSY} rampa Up/Dw z minLevel na 100% [sec]*)
    timeLimit        : time;  (*`{ENG} maximum time limit light [sec]           {CSY} omezenн max. doby svнcenн (automaticky zhasne) [sec]*)
    webToggle        : bool R_EDGE;  (*`{ENG} control lights from web page             {CSY} ovlбdбnн svмtla z web strбnky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central switching off                    {CSY} centrбlnн zhasnutн*)
    name             : string [24];  (*`{ENG} name of light                            {CSY} nбzev svмtla*)
  END_VAR
  VAR_IN_OUT
    setLevel         : real;  (*`{ENG} last level (this variable have to be RETAIN) {CSY} poslednн nastavenб ъroveт (promмnnou umнstit do VAR_GLOBAL RETAIN)*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} indication Off/On  {CSY} signalizace On/Off*)
    level            : real;  (*`{ENG} level 0..100[%]    {CSY} ъroveт 0..100[%]*)
    minLev           : real;  (*`{ENG} min level 0..90[%] {CSY} minimбlnн ъroveт 0..90[%]*)
  END_VAR
  VAR
    GTSAP1_LIGHT_name {PUBLIC_IN} : string [24];
    GTSAP1_LIGHT_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_type {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_dimtype {PUBLIC_IN} : bool :=  0;
    GTSAP1_LIGHT_onoff {PUBLIC} {OPEN_UP} : bool;
    GTSAP1_LIGHT_dimlevel {PUBLIC} {OPEN_UP} : real;
    gtsap1_old       : real;  (*`pro vyhodnoceni zmeny od mobilni aplikace*)
    oldSetLevel      : real;  (*`pro vyhodnoceni zmeny retain promenne*)
    toggleOn         : bool;  (*`pomocna pro zapnuti*)
    toggleOff        : bool;  (*`pomocna pro vypnuti*)
    lastLevelUp      : bool;
    lastLevelDw      : bool;
    lastSL52         : udint;
    tim              : TON;  (*`casovac pro omezeni doby osvetleni*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iTherm
(*`{ENG} function block for measurement of temperature (degrees of Celsius) including first order filter
   and posibility of temperature correction
   {CSY} blok pro mмшenн teploty (ve stupnнch Celsia) s fitrem 1.шбdu
   a moћnostн korekce vstupnн hodnoty*)
  VAR_INPUT
    in               : real;  (*`{ENG} temperature (REAL variable) {CSY} teplota (REAL promмnnб)*)
    offset           : real;  (*`{ENG} correction of temperature   {CSY} korekce teploty*)
    filterTime       : time :=  T#30s;  (*`{ENG} time constant of filter     {CSY} иasovб konstanta filtru*)
    name             : string [24];  (*`{ENG} name                        {CSY} nбzev*)
  END_VAR
  VAR_OUTPUT
    out              : real;  (*`{ENG} out := filter( in + offset) {CSY} out := filter( in + offset)*)
  END_VAR
  VAR
    GTSAP1_TSENSOR_name {PUBLIC_IN} : string [24];
    GTSAP1_TSENSOR_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_TSENSOR_value {PUBLIC_IN} : real;
    filter           : fbFirstOrder;  (*`filtr prvniho radu*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iDimmerLED
(*`{CSY} Stmнvanй LED svмtlo s nastavovбnнm ъrovnм pomocн dlouhэch stiskщ,
         krбtkй stisky zapнnajн a vypнnajн svмtlo (na nastavenou ъroveт s rampou "offOnRamp")
         dlouhй stisky mмnн nastavenou ъroveт s rampou "setRamp"
         Vэstup level 0..100%, rampa [sec] - pro jeden kanбl CIB modulu ULED/ILED/RLC
   {ENU} LED light dimmer,
         short press activates and deactivates light (to set level with ramp "offOnRamp")
         long presses changes the level with ramp "setRamp".
         Output level 0..100%, ramp [sec] for one channel of a CIB ULED/ILED/RLC*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} turn on the light at the last level (short press) {CSY} zapnout svмtlo na poslednн ъroveт (krбtkэ stisk)*)
    levelUp          : bool;  (*`{ENG} increase the level (long press)                   {CSY} zvэљit ъroveт (dlouhэ stisk)*)
    lightOff         : bool R_EDGE;  (*`{ENG} turn off the light (short press)                  {CSY} vypnout svмtlo (krбtkэ stisk)*)
    levelDw          : bool;  (*`{ENG} decrease the level (long press)                   {CSY} snнћit ъroveт (dlouhэ stisk)*)
    lightToggle      : bool R_EDGE;  (*`{ENG} toggle of the light                               {CSY} pшepnutн svмtla*)
    minLevel         : real :=  10.0;  (*`{ENG} min level for light [%]                           {CSY} min ъroveт pro svмtlo (zapalovacн ъroveт) [%]*)
    offOnRamp        : time :=  T#5s;  (*`{ENG} ramp Off/On from min level to 100% [sec]          {CSY} rampa Off/On z minLevel na 100% [sec]*)
    setRamp          : time :=  T#8s;  (*`{ENG} ramp Up/Dw from min level to 100%  [sec]          {CSY} rampa Up/Dw z minLevel na 100% [sec]*)
    timeLimit        : time;  (*`{ENG} maximum time limit light [sec]                    {CSY} omezenн max. doby svнcenн (automaticky zhasne) [sec]*)
    webToggle        : bool R_EDGE;  (*`{ENG} control lights from web page                      {CSY} ovlбdбnн svмtla z web strбnky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central switching off                             {CSY} centrбlnн zhasnutн*)
    name             : string [24];  (*`{ENG} name of light                                     {CSY} nбzev svмtla*)
  END_VAR
  VAR_IN_OUT
    setLevel         : real;  (*`{ENG} last level (this variable have to be RETAIN) {CSY} poslednн nastavenб ъroveт (promмnnou umнstit do VAR_GLOBAL RETAIN)*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} indication Off/On  {CSY} signalizace On/Off*)
    level            : real;  (*`{ENG} level 0..100 [%]   {CSY} ъroveт 0..100 [%]*)
    ramp             : usint;  (*`{ENG} ramp for On/Off    {CSY} rampa pro On/Off*)
    minLev           : real;  (*`{ENG} min level 0..90[%] {CSY} minimбlnн ъroveт 0..90[%]*)
  END_VAR
  VAR
    GTSAP1_LIGHT_name {PUBLIC_IN} : string [24];
    GTSAP1_LIGHT_enable {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_type {PUBLIC_IN} : bool :=  1;
    GTSAP1_LIGHT_dimtype {PUBLIC_IN} : bool :=  0;
    GTSAP1_LIGHT_onoff {PUBLIC} {OPEN_UP} : bool;
    GTSAP1_LIGHT_dimlevel {PUBLIC} {OPEN_UP} : real;
    gtap1_old        : real;  (*`pro vyhodnoceni zmeny od mobilni aplikace*)
    oldSetLevel      : real;  (*`pro vyhodnoceni zmeny retain promenne*)
    toggleOn         : bool;  (*`pomocna pro zapnuti*)
    toggleOff        : bool;  (*`pomocna pro vypnuti*)
    lastLevelUp      : bool;
    lastLevelDw      : bool;
    lastSL52         : udint;
    tim              : TON;  (*`casovac pro omezeni doby osvetleni*)
  END_VAR
END_FUNCTION_BLOCK

