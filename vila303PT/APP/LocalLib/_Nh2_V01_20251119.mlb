#srcline 1947 ;				_Nh_Fix_HET_MAN(fix := xFix, chg := ADR(xTve^.cx.chg), ref := true, off:=true);	// vynuluje datum/cas konca
#srcline 1948 ;			END_IF;
#srcline 1950 ;			xTve^.me.CMD		:= 10;		
#srcline 1951 ;			_NhDevRef(xR := xDev);					
#srcline 1952 ;		END_IF;
