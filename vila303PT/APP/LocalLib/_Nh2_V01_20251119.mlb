#srcline 375 ;							_Nh_Frm_Row_O13(ob:=5, t:=1, vb:=PTR_TO_UDINT(ADR(xDLs^.cx.scn.LVL[ dlgr ])) );
#srcline 376 ;							xR^.o.ob[2].cm 	:= 0;
#srcline 377 ;						ELSIF xDls^.cx.cfg.out5inOne THEN
#srcline 378 ;							IF xF^.cf.c = 8 THEN													// zatial len pre TVE
