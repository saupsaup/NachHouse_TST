    StatRow          : bool :=  true;  (*`vykresluju sa aj statusove obrazky a hodnoty pod obrazkom*)
    ShwLamUp         : bool :=  true;  (*`vykresluju sa aj statusove obrazky a hodnoty pod obrazkom*)
