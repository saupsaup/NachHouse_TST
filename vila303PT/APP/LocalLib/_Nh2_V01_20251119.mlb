#srcline 696 ;                  xR^.o.ob[2].wh := 0;                           						
#srcline 697 ;                  xR^.o.ob[3].wh := 0;                           						
#srcline 698 ;               END_IF;
#srcline 700 ;               xR^.o.ob[0].wh := 0;  															// vymazat vsetky SHA 									                        										
#srcline 702 ;(*
