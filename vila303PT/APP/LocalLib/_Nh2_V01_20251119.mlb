    Lam              : uint :=  1300;  (*`1100 ;            // cas lamely [1ms]*)
    Mot              : usint;  (*`opozdenie motora po On/Off [10ms]*)
    chg              : usint;  (*`opozdenie motora po pri zmene smeru [10ms]*)
  END_STRUCT;
END_TYPE

