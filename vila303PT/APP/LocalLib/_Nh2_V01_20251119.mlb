    SldRol           : bool :=  true;  (*`zobrazit slider ROL   .. odpoveda Qf*)
    SldLam           : bool :=  true;  (*`zobrazit slider LAM*)
    tchLam           : bool :=  true;  (*`povolit nastavovanie slidera LAM*)
