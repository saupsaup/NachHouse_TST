  STRUCT
    ok               : NH_REC_OK;
    cf               : NH_CFG_ALL;
    al               : NH_DEV_ALL_M;  (*`spolocne pre vsetky DEV  cf+io*)
    cx               : NH_HET_CFX;
    io               : ARRAY [0..3] OF NH_VAL_IO;  (*`teplota,TVE,KOT,CET*)
