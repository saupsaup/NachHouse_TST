#srcline 612 ;        {$IFDEF __NH_DALI}
#srcline 613 ;				_Nh_Frm_SCR_DLpar();
#srcline 614 ;				IF init  THEN                        // pri prvom vstupe do FRM. nacitat iny formular podla menu. n
#srcline 615 ;	            IF xA^.usr = 1 THEN      					// len ino naspodku dls/dlm
#srcline 616 ;   	            xR^.o.ob[9].wh    := 6;
#srcline 617 ;      	         xR^.o.ob[9].cf.c  := 254;
#srcline 618 ;         	      xR^.o.ob[9].w     := 200;
#srcline 619 ;            	   xR^.o.ob[9].y     := 1020;
#srcline 620 ;	               xR^.o.ob[9].fmt   := CONCAT(USINT_TO_STRING(dlsl),'#',USINT_TO_STRING(dlma)) ;
#srcline 621 ;   	         END_IF;
#srcline 622 ;      	      xDLpar            := ADR(xR^.o.ob[10]);                              // tu budu data parametrov DLS,DLg....
#srcline 623 ;	            xDLpar^.wh        := 0;
#srcline 624 ;   	         xPtU     			:= ADR(xDLpar^.par[3]);
#srcline 625 ;			      // par :  ARRAY[1..8] OF USINT;  	// 1.LVL 2.FADE.TIME 3.FADE_RATE 4.min LVL 3.HW min LVL 6.MAx LVL 7.LVL po rest. 8.LVL on Error				
#srcline 626 ;	            FOR i := 1 TO 8  DO
#srcline 627 ;   	            ix    := xR^.o.ob[i].fn;                                          // CISLO SLIDERA
#srcline 628 ;      	         xB^.s[ ix ].vb := PTR_TO_UDINT(ADR(xDLpar^.par[i]));
#srcline 629 ;						IF xF^.cf.c = 44 AND i > 3 THEN
#srcline 630 ;	   	            xR^.o.ob[i].wh := 0;
#srcline 631 ;						END_IF;
#srcline 632 ;	            END_FOR;
#srcline 633 ;//   	         xDLpar^.par[1] := _Nh_100_254(xDev^.al.in.val);
#srcline 634 ;					IF xF^.cf.c = 42 THEN                                     				// ide sa z mastra, alebo DLG
#srcline 635 ;   	            xR^.o.ob[5].wh := 0;
#srcline 636 ;					ELSE
#srcline 637 ;						FOR i := 1 TO 8 DO
#srcline 638 ;		    				_Nh_DL_ADD_Task(wht:=3 ,dlm :=dlma ,sha:=dlsl, sh2:=dlsl ,par:=INT_TO_USINT(xR^.o.ob[i].cf.p), web:=true);    // zakladne parametre DLg/DLs
#srcline 639 ;                  END_FOR;
#srcline 640 ;					END_IF;
#srcline 641 ;				ELSE
#srcline 642 ;	      		IF xR^.o.ob[1].tch   THEN                            										// drzime slider ActLvl
#srcline 643 ;						IF xA^.tch.Qf OR (xDlfb^.cmd[1].cmd = 0 AND SYSTEM_S.F_EDGE_500MS)  THEN         // pustenie slideru alebo je volno alebo vzdy po 500ms
#srcline 644 ;							IF xA^.tch.Qf THEN
#srcline 645 ;								xR^.o.ob[1].tch := false;
#srcline 646 ;							END_IF;
#srcline 647 ;         	      	xDev^.al.in.val :=  ROUND(USINT_TO_REAL(MIN(254,xDLpar^.par[1])) / 2.54);
#srcline 648 ;         	      	xDev^.al.ou.val := xDev^.al.in.val;
#srcline 649 ;      	         	_Nh_DL_ADD_Task(wht:=1, sha:=dlsl, lvl := xDev^.al.in.val, dlm:=dlma);        // nastavit LVL ballastu
#srcline 650 ;						END_IF;
#srcline 651 ;					ELSE
#srcline 652 ;	            	FOR i := 2 TO 8 DO
#srcline 653 ;   	      	      IF xR^.o.ob[i].tch AND xA^.tch.Qf THEN                                     // parametre len po pustenie slidera
#srcline 654 ;								IF xA^.tch.Qf THEN
#srcline 655 ;									xR^.o.ob[i].tch := false;
#srcline 656 ;   		   	            _Nh_DL_ADD_Task(wht := 2, sha := dlsl, par := INT_TO_USINT(xR^.o.ob[i].cf.p), val := xDLpar^.par[i], dlm :=dlma );
#srcline 657 ;									EXIT;
#srcline 658 ;								END_IF;
#srcline 659 ;      		         END_IF;
#srcline 660 ;   	      	   END_FOR;
#srcline 661 ;					END_IF;
#srcline 662 ;			END_IF;
#srcline 663 ;//				yDLpar := xDLpar^;
#srcline 664 ;        {$END_IF}
