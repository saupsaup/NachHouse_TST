#pou _NhMap
#srcline 1081 ;FUNCTION _NhMap {HIDDEN} : BOOL	    // nmapuje xNh na vetu aCfg/aPar/aVaz, do sz vlozi velkost vety, do va virtualnu adresu a do xDev pinter 1.vety

#struct _NhMap__temp__
  udint P0__st__
P     61
_NhMap_L0:
 LINK __SizeOf(_NhMap__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc___NhMap
; End initialize - variables
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 1086 ;   CASE wh OF
 LDX  wh
#debug usint wh
 WRY  P0__st__
 LD   1
 LDY  P0__st__
 EQ  
 JMC  _NhMap_L2
#srcline 1087 ;     1 : xNh := ADR(aPar[cx]);
 LEA  aPar
 LDX  cx
#debug usint cx
 SUB  1   ; Low range[1]
 RCHK 15   ; Range Check
 MUL  23   ; SizeOf(...)
 ADD     ; + offset 
#debug pointer aPar[cx]
 LEA  xNh
 WRIL 
#debug_left pointer xNh
 JMP  _NhMap_L1
_NhMap_L2:
 LD   2
 LDY  P0__st__
 EQ  
 JMC  _NhMap_L3
#srcline 1088 ;     2 : xNh := ADR(aVaz[cx]);
 LEA  aVaz
 LDX  cx
#debug usint cx
 SUB  1   ; Low range[1]
 RCHK 8   ; Range Check
 MUL  18   ; SizeOf(...)
 ADD     ; + offset 
#debug pointer aVaz[cx]
 LEA  xNh
 WRIL 
#debug_left pointer xNh
 JMP  _NhMap_L1
_NhMap_L3:
#srcline 1089 ;   ELSE  xNh := ADR(aCfg[cx]);
 LEA  aCfg
 LDX  cx
#debug usint cx
 SUB  1   ; Low range[1]
 RCHK 69   ; Range Check
 MUL  52   ; SizeOf(...)
 ADD     ; + offset 
#debug pointer aCfg[cx]
 LEA  xNh
 WRIL 
#debug_left pointer xNh
#srcline 1090 ;   END_CASE;
_NhMap_L1:
#srcline 1091 ;   sz     := xNh^.siz;
 LEA  xNh
 LDIL    ; dereference 
 LDIL 
#debug udint xNh^.siz
 WR   sz
#debug_left udint sz
#srcline 1092 ;   va     := xNh^.ram;                                             // virtualna adresa 1.vety
 LEA  xNh
 LDIL    ; dereference 
 ADD  4  ; + offset 
 LDIL 
#debug udint xNh^.ram
 WR   va
#debug_left udint va
#srcline 1093 ;   _NhMap := xNh^.Rec > 0 OR xNh^.New > 0;
 LEA  xNh
 LDIL    ; dereference 
 ADD  8  ; + offset 
 LDIW 
#debug int xNh^.Rec
 EXTW 
 LD   int 0
 GTS
 LEA  xNh
 LDIL    ; dereference 
 ADD  15  ; + offset 
 LDIW 
#debug int xNh^.New
 EXTW 
 LD   int 0
 GTS
 OR  
 WRX  __fc___NhMap
#debug_left bool _NhMap
#srcline 1094 ;END_FUNCTION
 PRV  
 LDX  __fc___NhMap
 ULNK
RET
E     61
#endpou 

