    mnu              : bool;  (*`dotyk bol na menu*)
    sld              : bool;  (*`pohybujeme sliderom*)
    p1               : bool;  (*`priznak s ktorym pracuje  program*)
    p2               : bool;  (*`priznak s ktorym pracuje  program*)
