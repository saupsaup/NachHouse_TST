#srcline 552 ;      xR^.o.ob[ 2].w    := 72;                                                      // zvacsi sa velkot obrazka PIR-On (088)
 LD   int 72
 LEA  xR
 LDIL    ; dereference 
 ADD  73  ; + offset 
 WRIW 
#debug_left int xR^.o.ob[2].w
#srcline 553 ;      xR^.o.ob[ 2].fn   := xR^.o.ob[ 1].fn;                                         // zvacsi sa velkot obrazka PIR-On (088)
