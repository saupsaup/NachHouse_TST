#srcfile ''
#srcfile 'M:\NACHHOUSEAPP\DEV\DEV_V200\200\_NH_TYP.ST'
#pou _Nh_DIF_REG
#srcline 1960 ;FUNCTION_BLOCK _Nh_DIF_REG  {HIDDEN}
P     61
_Nh_DIF_REG_L0:
 LINK 0
#srcline 1990 ;	Qout := false	;
 LD   bool 0       ; false
 WRX  Qout
#debug_left bool Qout
#srcline 1991 ;	Qchg := false	;
 LD   bool 0       ; false
 WRX  Qchg
#debug_left bool Qchg
#srcline 1992 ;	// opozdenie zmeny predvolby z regulatora / ovladaca
#srcline 1993 ;	IF pv <> pvNew THEN									// prvy rozdiel predvolieb
 LDX  pv
#debug usint pv
 LDX  pvNew
#debug usint pvNew
 EQ
 NEG
 JMC  _Nh_DIF_REG_L1
#srcline 1994 ;		EtChg 	:= MAX(1,EtChg,xReg^.Delay);	   // nastavi s cas opozdenia, po restarte bude min 30s
 LD   usint 1
 LDX  EtChg
#debug usint EtChg
 MAX
 LEA  xReg
 LDIL    ; dereference 
 ADD  3  ; + offset 
 LDI  
#debug usint xReg^.Delay
 MAX
 WRX  EtChg
#debug_left usint EtChg
#srcline 1995 ;		pv 		:= pvNew;                        // preberie sa predvolba
 LDX  pvNew
#debug usint pvNew
 WRX  pv
#debug_left usint pv
#srcline 1996 ;		RETURN;
 JMP  _Nh_DIF_REG_RET
#srcline 1997 ;	ELSIF EtChg	> 0 THEN
 JMP  _Nh_DIF_REG_L2
_Nh_DIF_REG_L1:
 LDX  EtChg
#debug usint EtChg
 LD   usint 0
 GT
 JMC  _Nh_DIF_REG_L3
#srcline 1998 ;		EtChg := EtChg - aSys.n1Sec;
 LDX  EtChg
#debug usint EtChg
 LD   aSys~n1Sec
#debug usint aSys.n1Sec
 SUB
 AND  $FF
 WRX  EtChg
#debug_left usint EtChg
#srcline 1999 ;		IF EtChg = 0 THEN                        	// uplynul cas opozdenia
 LDX  EtChg
#debug usint EtChg
 LD   usint 0
 EQ
 JMC  _Nh_DIF_REG_L4
#srcline 2000 ;			RefSta	:= 1;                      	// prepocita sa aj ked nebola zmena tepoty
 LD   bool -1      ; true
 WRX  RefSta
#debug_left bool RefSta
#srcline 2001 ;			EtOut		:= 0;									// aby preslo priamo do vypoctu
 LD   uint 0
 WRX  EtOut
#debug_left uint EtOut
#srcline 2002 ;			Qchg		:= true;
 LD   bool -1       ; true
 WRX  Qchg
#debug_left bool Qchg
#srcline 2003 ;		ELSE
 JMP  _Nh_DIF_REG_L5
_Nh_DIF_REG_L4:
#srcline 2004 ;			RETURN;
 JMP  _Nh_DIF_REG_RET
#srcline 2005 ;		END_IF;
_Nh_DIF_REG_L5:
#srcline 2006 ;	END_IF;
 JMP  _Nh_DIF_REG_L2
_Nh_DIF_REG_L3:
_Nh_DIF_REG_L2:
#srcline 2007 ;	IF xRegMod^.wht = 0 THEN													// kuri sa na pevny stupen
 LEA  xRegMod
 LDIL    ; dereference 
 LDI  
#debug usint xRegMod^.wht
 LD   usint 0
 EQ
 JMC  _Nh_DIF_REG_L6
#srcline 2008 ;		Qout	:= Sta <> pv;
 LDX  Sta
#debug usint Sta
 LDX  pv
#debug usint pv
 EQ
 NEG
 WRX  Qout
#debug_left bool Qout
#srcline 2009 ;		Sta 	:= pv;         							
 LDX  pv
#debug usint pv
 WRX  Sta
#debug_left usint Sta
#srcline 2010 ;		out	:= sta;                             // tu ziadny odbez vzorky nie je, okamzite sa presuva PV na stat aj Out
 LDX  sta
#debug usint sta
 WRX  out
#debug_left usint out
#srcline 2011 ;	ELSIF EtOut > 0 THEN									// cas do odobratia dalsej vzorky
 JMP  _Nh_DIF_REG_L7
_Nh_DIF_REG_L6:
 LDX  EtOut
#debug uint EtOut
 LD   uint 0
 GT
 JMC  _Nh_DIF_REG_L8
#srcline 2012 ;		ETout 	:= ETout - aSys.u1Sec;
 LDX  ETout
#debug uint ETout
 LD   aSys~u1Sec
#debug uint aSys.u1Sec
 SUB
 AND  $FFFF
 WRX  ETout
#debug_left uint ETout
#srcline 2013 ;		IF ETout = 0 THEN
 LDX  ETout
#debug uint ETout
 LD   uint 0
 EQ
 JMC  _Nh_DIF_REG_L9
#srcline 2014 ;			RefOut	:= true;
 LD   bool -1       ; true
 WRX  RefOut
#debug_left bool RefOut
#srcline 2015 ;		END_IF;
_Nh_DIF_REG_L9:
#srcline 2016 ;	ELSE
 JMP  _Nh_DIF_REG_L7
_Nh_DIF_REG_L8:
#srcline 2017 ;		EtOut		:= sample;	
 LDX  sample
#debug uint sample
 WRX  EtOut
#debug_left uint EtOut
#srcline 2018 ;		Grad		:= REAL_TO_SINT( LIMIT(-127.,(xPtIO^.val - Old)*10.,127.) );
 LEA  xPtIO
 LDIL    ; dereference 
 ADD  1  ; + offset 
 LDIL 
#debug real xPtIO^.val
 LDX  Old
#debug real Old
 SUF
 LD   real 10.
 MUF
 LD   real -127.
 MAXF
 LD   real 127.
 MINF
 RND
 IFW
 EXTB
 WRX  Grad
#debug_left sint Grad
#srcline 2019 ;		Old 		:= xPtIO^.val;
 LEA  xPtIO
 LDIL    ; dereference 
 ADD  1  ; + offset 
 LDIL 
#debug real xPtIO^.val
 WRX  Old
#debug_left real Old
#srcline 2020 ;		IF Grad <> 0 OR RefSta THEN		// vypocet len ak je zmena teploty, alebo pri refresi
 LDX  Grad
#debug sint Grad
 EXTB 
 LD   sint 0
 EQ
 NEG
 LDX  RefSta
#debug bool RefSta
 OR  
 JMC  _Nh_DIF_REG_L11
#srcline 2021 ;			Up	:= Grad > 0;
 LDX  Grad
#debug sint Grad
 EXTB 
 LD   sint 0
 GTS
 WRX  Up
#debug_left bool Up
#srcline 2022 ;			Sta	:= 3;
 LD   usint 3
 WRX  Sta
#debug_left usint Sta
#srcline 2023 ;			WHILE sta >= 1 DO
_Nh_DIF_REG_L13:
 LDX  sta
#debug usint sta
 LD   usint 1
 LT
 NEG
 JMC  _Nh_DIF_REG_L14
 DBG 
#srcline 2024 ;				IF heat THEN								// pri kureni sa je najvyssi vykon najnizzsie pod ziadanou hodnotou
 LDX  heat
#debug bool heat
 JMC  _Nh_DIF_REG_L15
#srcline 2025 ;					IF Old <= xRegMod^.reQ[ pv ] + xRegMod^.hys[ BOOL_TO_USINT( up ) ,Sta] THEN
 LDX  Old
#debug real Old
 LEA  xRegMod
 LDIL    ; dereference 
 ADD  5  ; + offset 
 LDX  pv
#debug usint pv
 RCHK 3   ; Range Check
 MUL  4   ; SizeOf(...)
 ADD     ; + offset 
 LDIL 
#debug real xRegMod^.reQ[pv]
 LEA  xRegMod
 LDIL    ; dereference 
 ADD  21  ; + offset 
 LDX  up
#debug bool up
 AND  1
 RCHK 1   ; Range Check
 MUL  3   ; Num items[2]
 LDX  Sta
#debug usint Sta
 SUB  1  ; Low range[2]
 RCHK 2   ; Range Check
 ADD
 MUL  4   ; SizeOf(...)
 ADD     ; + offset 
 LDIL 
#debug real xRegMod^.hys[BOOL_TO_USINT(up),Sta]
 ADF
 GTF
 NEG
 JMC  _Nh_DIF_REG_L17
#srcline 2026 ;						EXIT;
 JMP  _Nh_DIF_REG_L14
#srcline 2027 ;					END_IF;
_Nh_DIF_REG_L17:
#srcline 2028 ;				ELSIF Old >= xRegMod^.reQ[ pv ] + xRegMod^.hys[ BOOL_TO_USINT( up ) ,Sta] THEN
 JMP  _Nh_DIF_REG_L16
_Nh_DIF_REG_L15:
 LDX  Old
#debug real Old
 LEA  xRegMod
 LDIL    ; dereference 
 ADD  5  ; + offset 
 LDX  pv
#debug usint pv
 RCHK 3   ; Range Check
 MUL  4   ; SizeOf(...)
 ADD     ; + offset 
 LDIL 
#debug real xRegMod^.reQ[pv]
 LEA  xRegMod
 LDIL    ; dereference 
 ADD  21  ; + offset 
 LDX  up
#debug bool up
 AND  1
 RCHK 1   ; Range Check
 MUL  3   ; Num items[2]
 LDX  Sta
#debug usint Sta
 SUB  1  ; Low range[2]
 RCHK 2   ; Range Check
 ADD
 MUL  4   ; SizeOf(...)
 ADD     ; + offset 
 LDIL 
#debug real xRegMod^.hys[BOOL_TO_USINT(up),Sta]
 ADF
 LTF
 NEG
 JMC  _Nh_DIF_REG_L19
#srcline 2029 ;					EXIT;										// pri chladeni/odvlhceni/CO2 sa je najvyssi vykon najvyssie nad ziadanou hodnotou
 JMP  _Nh_DIF_REG_L14
#srcline 2030 ;				END_IF;	
 JMP  _Nh_DIF_REG_L16
_Nh_DIF_REG_L19:
_Nh_DIF_REG_L16:
#srcline 2031 ;				Sta := Sta-1;
 LDX  Sta
#debug usint Sta
 LD   usint 1
 SUB
 AND  $FF
 WRX  Sta
#debug_left usint Sta
#srcline 2032 ;			END_WHILE;
 JMP  _Nh_DIF_REG_L13
_Nh_DIF_REG_L14:
 NOP  -1
#srcline 2033 ;		END_IF;
_Nh_DIF_REG_L11:
#srcline 2034 ;		IF RefOut THEN
 LDX  RefOut
#debug bool RefOut
 JMC  _Nh_DIF_REG_L20
#srcline 2035 ;			Qout	:= out <> sta;
 LDX  out
#debug usint out
 LDX  sta
#debug usint sta
 EQ
 NEG
 WRX  Qout
#debug_left bool Qout
#srcline 2036 ;			out	:= sta;
 LDX  sta
#debug usint sta
 WRX  out
#debug_left usint out
#srcline 2037 ;		END_IF;
_Nh_DIF_REG_L20:
#srcline 2038 ;		RefSta	:= false;
 LD   bool 0       ; false
 WRX  RefSta
#debug_left bool RefSta
#srcline 2039 ;		RefOut	:= false;		
 LD   bool 0       ; false
 WRX  RefOut
#debug_left bool RefOut
#srcline 2040 ;	END_IF;
_Nh_DIF_REG_L7:
#srcline 2041 ;END_FUNCTION_BLOCK
_Nh_DIF_REG_RET:
 ULNK
RET
E     61

