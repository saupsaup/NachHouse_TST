#srcline 405 ;					END_IF;
#srcline 407 ;				ELSIF	xR^.h.chk THEN
#srcline 408 ;						IF xF^.cf.c = 44 THEN                                		// do DLg
#srcline 409 ;      					dlgr := _Nh_DL_sha(gr:=1,nd := xF^.cf.n)-100 ;				// 0..15
