TYPE NH_LOG_HED_MSG {HIDDEN} :
  STRUCT  (*`12*)
    row              : udint;  (*`adresa riadku, ktory sa spracovava*)
    size             : udint :=  303;
    pozi             : ARRAY [1..7,0..1] OF usint := 
							[ 	 1,  3,					// kod
								 5,  8,					// datum evetu
								14,  8,					// Cas EVN
								23,  2,					// user
								26, 10,              // status
								37,  8,              // cas odoslania/vyhodnotenia
								46,255]
				;
  END_STRUCT;
END_TYPE

