#srcline 391 ;      					xR^.o.ob[5].wh 	:= 0;
#srcline 392 ;						ELSIF _NhxPar(cp := aCfg[xR^.h.cf.c].par , np := xR^.h.cf.p,x:=-1006) THEN		// SCN,ACT,BLK
#srcline 393 ;							_Nh_Frm_Row_O13(ob:=5, t:=1, vb:=PTR_TO_UDINT(ADR(xPar^.all.lvl)) );											
#srcline 394 ;						ELSE
#srcline 395 ;							xR^.o.ob[5].wh := 0;								
#srcline 396 ;							xR^.o.ob[2].cm := 0;								
#srcline 397 ;						END_IF;
