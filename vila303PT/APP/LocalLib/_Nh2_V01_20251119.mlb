#srcline 386 ;							END_IF;
#srcline 387 ;						ELSIF _Nh_IO_MAP(cIo:=xF^.cf.c, Dev:=xR^.h.cf.c)  THEN
#srcline 388 ;							_Nh_Frm_Row_O13(ob:=5, t:=0, vb:=PTR_TO_UDINT(ADR( xPtIOa^.val ) ));
#srcline 389 ;							xR^.o.ob[2].cm 	:= 0;
