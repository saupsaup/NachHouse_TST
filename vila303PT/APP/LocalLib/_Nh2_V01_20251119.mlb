#srcline 458 ;							END_IF;
#srcline 459 ;						ELSIF xR^.o.ob[4].cf.c <>  15 THEN
#srcline 460 ;		         	   _Nh_Frm_Row_O13(off:=xR^.h.pir, ob:=5);						
