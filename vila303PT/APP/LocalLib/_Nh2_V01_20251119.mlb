 sPtr {HIDDEN} : udint;
 sRun {HIDDEN} : udint;
 offSrc {HIDDEN} : udint;  (*`posun pri kopirovani*)
 offDst {HIDDEN} : udint;
 xBtn15 {HIDDEN} : PTR_TO NH_BTN15;  (*`koli memCpyPtr*)
 yBtn15 {HIDDEN} : NH_BTN15;  (*`koli memCpyPtr*)
 i {HIDDEN} : usint;
 k {HIDDEN} : usint;
 ii {HIDDEN} : usint;
