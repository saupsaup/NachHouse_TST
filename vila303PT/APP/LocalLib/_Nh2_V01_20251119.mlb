    clrh             : ARRAY [0..4] OF int :=  [4,8,6,7,2];  (*`siva/zelena/oranzova,cervena*)
    OFFon            : ARRAY [0..1] OF int :=  [54,400];  (*`OFF=siva off, ON = zeleny podklad ON*)
