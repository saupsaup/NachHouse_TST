_Nh_SVX_L13:
#srcline 3326 ;			///// toto je pokus 21.12.24 pri oprave stmievania cez DIM {presunute do ELSE}
#srcline 3327 ;			{$IFDEF __NH_DALI}
#srcline 3328 ;			CASE cf OF
#srcline 3329 ;			  	42: 	// DALI MASTER DLma
#srcline 3330 ;						xDLm	:= xDev;
#srcline 3331 ;						IF xDLm^.al.sta < 2 THEN										// NE-bezi QUERY, alebo RND
#srcline 3332 ;							IF cmd = 42 THEN									
#srcline 3333 ;								dlma := INT_TO_USINT(nd);
#srcline 3334 ;     							_Nh_DL_ADD_Task(wht:=2, sha:=255, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);				// rampa
#srcline 3335 ;								_Nh_DL_ADD_Task(wht:=1, sha:=255, lvl:=xDev^.al.IN.val, dlm:=dlma ); // lvl
#srcline 3336 ;								xDLm^.me.lvl255 	:= true;                                                          // priznak mastra
#srcline 3337 ;								xDLm^.me.Rmp255 	:= xDev^.al.rmp;                                                  // aka rampa do vsetkych DLS
#srcline 3338 ;				      	   _NhMemSetPTR(size := SIZEOF(NH_DLM_GRP), dest:= ADR(xDLm^.me.scn) );						// vynuluje sceny
#srcline 3339 ;							ELSE
#srcline 3340 ;								xDLm^.al.In.val 	:= 0.0;											// vynuluje sa, LVL urobi az sumarne DLs
#srcline 3341 ;							END_IF;
#srcline 3342 ;							xDev^.al.OU.val	:= xDev^.al.IN.val;              			
#srcline 3343 ;							xDLm^.al.sta	:= 0;                               			// stav	sa urobi az v DLs	
#srcline 3344 ;						END_IF;
#srcline 3345 ;//						ok3 := 0;                               								// nevyhodnoti sta, to az kazde DEV
#srcline 3347 ;				44:	// DLg sa robi pred DLs ( ballastom )
#srcline 3348 ;    					xDLg 					:= xDev;
#srcline 3349 ;				  		dlma 					:= _Nh_DL_sha(nd:=nd, gr:=true, ma:=true);   // 1..2
#srcline 3350 ;	              	dlsl 					:= _Nh_DL_sha(nd:=nd, gr:=true);     			// 100..115
#srcline 3351 ;						_NhxDLm(dlm:=dlma);															// namapuje xDLm
#srcline 3352 ;						IF xDLm^.me.lvl255 THEN														// prikaz z mastra oznaci len v SW sceny vypnute, nic neposiela do HW
#srcline 3353 ;							xDev^.al.IN.val := 0.0;						
#srcline 3354 ;						ELSIF cmd = 44 THEN									
#srcline 3355 ;	 						IF xDLg^.me.rmp <> xDev^.al.rmp THEN                   		// zmena rampy
#srcline 3356 ;		         			_Nh_DL_ADD_Task(wht:=2, sha:=dlsl, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);			// rampa dp vsetkych ballastov v scene
#srcline 3357 ;	   						xDLg^.me.rmp := xDev^.al.rmp;
#srcline 3358 ;   		   	      END_IF;
#srcline 3359 ;							
#srcline 3360 ;							IF xDev^.al.IN.val > 99.0 THEN								      // zapnut celu scenu na LVL ballastov v scene, na nizsi Level sa drobi v DLs
#srcline 3361 ;								_Nh_DL_ADD_Task(wht:=7, sha:=dlsl, par:=dlsl-100, dlm:=dlma );	// par je GRP 0..15,  sha je skupinova adresa 100..115
#srcline 3362 ;							ELSE	//IF xDev^.al.IN.val = 0. THEN											// len vypnut
#srcline 3363 ;								_Nh_DL_ADD_Task(wht:=1, sha:=dlsl, dlm:=dlma, lvl:=xDev^.al.IN.val );  // sha je skupinova adresa 100..115
#srcline 3364 ;							END_IF;		
#srcline 3366 ;      					// v mastri oznaci, ze bol set sceny
#srcline 3367 ;							xDev^.al.Qx						:= true;									// priznak, ze scena je zapnuta
#srcline 3368 ;							xDLm^.me.scn.SET[dlsl-100] := true;									// priznak nastavene sceny						
#srcline 3369 ;							xDLm^.me.scn.LVL[dlsl-100] := REAL_TO_USINT(xDev^.al.IN.val);
#srcline 3370 ;							xDLm^.me.scn.RMP[dlsl-100] := xDLg^.me.rmp;						//	ramapa do vsetkych SHA					
#srcline 3372 ;						ELSIF xDLm^.me.scn.LVL[dlsl-100] > 0  THEN							// SCN je zapnuta
#srcline 3373 ;							IF xDLm^.me.scn.DEV[dlsl-100] = false THEN						// ziadne DEV v SCN NIE-je zanute aspon na minimum
#srcline 3374 ;								xDLm^.me.scn.LVL[dlsl-100] := 0;									// toto musi byt koli xDlG^.al.in.CMD 	:= 3;
#srcline 3375 ;								xDlG^.al.in.CMD 				:= 3;									// len vypne scenu a resetne casy, ALE NEPOJDE DALEJ DO PRIKAZU !!!
#srcline 3376 ;							END_IF;
#srcline 3377 ;						END_IF;        	
#srcline 3378 ;						xDLm^.me.scn.DEV[dlsl-100] := false;
#srcline 3379 ;						xDev^.al.OU.val	:= xDev^.al.IN.val;
#srcline 3381 ;				43:	// na konci urobi ballast , sumare do mastra aj skontroluje scenu
#srcline 3382 ;						xDLs	:= xDev;
#srcline 3383 ;  		            dlsl 	:= _Nh_DL_sha(nd:=nd);              								// 0..64 pre master
#srcline 3384 ;     					dlma 	:= _Nh_DL_sha(nd:=nd, ma:=true);          						// 1..2
#srcline 3385 ;						_NhxDLm(dlm := dlma);                              					// xDLm
#srcline 3387 ;						IF xDLm^.me.lvl255 THEN															// bol centralny LVL, ma najvyssiu prioritu
#srcline 3388 ;							xDev^.al.In.Val	:= xDLm^.al.Ou.Val;           					// do ballastu zapise LVL z mastra
#srcline 3389 ;     						xDLs^.me.rmp 		:= xDlm^.al.rmp;                             // preberie sa aj rampa, ktoru nastavil master do vsetkych SHA
#srcline 3390 ;							xDev^.al.OU.Val 	:= xDev^.al.IN.Val;									
#srcline 3391 ;						ELSIF cmd = 43 THEN									      					// klasicke dev
#srcline 3392 ;							IF xDLs^.me.rmp <> xDev^.al.rmp THEN
#srcline 3393 ; 								_Nh_DL_ADD_Task(wht:=2, sha:=dlsl, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);
#srcline 3394 ;      						xDLs^.me.rmp := xDev^.al.rmp;
#srcline 3395 ;           				END_IF;
#srcline 3396 ;							_Nh_DL_ADD_Task(wht:=1, sha:=dlsl, lvl:=xDev^.al.IN.val, dlm:=dlma );
#srcline 3397 ;							xDev^.al.OU.Val 	:= xDev^.al.IN.Val;									
#srcline 3398 ;						ELSIF  cmd = 143 THEN 															// len pre xDLs^.cx.cfg.out5inOne
#srcline 3399 ;							xDev^.al.et 	:= 0;
#srcline 3400 ;							xDev^.al.ex 	:= 0;
#srcline 3401 ;	         			xDLs^.al.rmp   := 0;                                        // tu sa nestmieva, ide sa na ON/OFF
#srcline 3402 ;							IF xDLs^.me.rmp <> xDLs^.al.rmp THEN
#srcline 3403 ;  								_Nh_DL_ADD_Task(wht:=2, sha:=dlsl, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);
#srcline 3404 ;       						xDLs^.me.rmp := xDev^.al.rmp;
#srcline 3405 ;	           			END_IF;
#srcline 3406 ;							xDLs^.me.SendDLM := true;
#srcline 3407 ;							_Nh_DL_ADD_Task(wht:=6, sha := dlsl, dlm := dlma, lvl := xDev^.al.IN.Val  );
#srcline 3408 ;							// zistit stav
#srcline 3409 ;							xDev^.al.Ou.Val := 0.0;     											// na zaciatku podhodi sa vypnute			
#srcline 3410 ;							FOR i := 1 TO 5 DO
#srcline 3411 ;								IF xPar^.rgb.lvl[i] > 0 THEN          							// default parameter je namapovany
#srcline 3412 ;//									xDev^.al.Ou.Val := 254;											// ak je nieco z RGBWA zapnute, je cely SHA zapnuty
#srcline 3413 ;									xDev^.al.Ou.Val := 100.;										// ak je nieco z RGBWA zapnute, je cely SHA zapnuty
#srcline 3414 ;									EXIT;
#srcline 3415 ;								END_IF;
#srcline 3416 ;          				END_FOR;
#srcline 3417 ;							xDev^.al.In.Val := 0.0;													// u tohto typu vynuluje vstup
#srcline 3418 ;						
#srcline 3419 ;						// ponastavuje DLg
#srcline 3420 ;						ELSIF xDLs^.cx.scn.grp <> _eBtn15 THEN									// patri do nejakej sceny
#srcline 3421 ;                  	FOR i := 0 TO 15 DO															
#srcline 3422 ;								IF xDLs^.cx.scn.grp[i] THEN										// patri do sceny i
#srcline 3423 ;									_NhxDLg(grp := i, dlm := dlma);								// namapuje scenu	
#srcline 3424 ;									IF xDLm^.me.scn.set[i]	THEN									// scena bola v tomto cykle ON alebo OFF
#srcline 3425 ;										IF xDLg^.al.Ou.Val < 100. THEN                 		// scena pola stmievana, toto dev sa nezaplo/nevyplo 	
#srcline 3426 ;											xDev^.al.IN.Val := xDLg^.al.Ou.Val;					// scena nastavila len lvl, nezapla DEV
#srcline 3427 ;										ELSE
#srcline 3428 ;											xDev^.al.IN.Val := USINT_TO_REAL(xDLs^.cx.scn.lvl[i]);	// toto DLs sa nastavilo na LVL, ktoru ma urcenu v SCENE
#srcline 3429 ;										END_IF;
#srcline 3430 ;										xDLs^.me.rmp 		:= xDLm^.me.scn.RMP[i];				// scena vzdy nastavi rmpu kazdeho DLs
#srcline 3431 ;										xDev^.al.OU.Val 	:= xDev^.al.IN.Val;									
#srcline 3432 ;										xDLm^.me.scn.DEV[i] := true;
#srcline 3433 ;//									ELSIF xDlg^.al.Qx = false THEN								// uz bola vypnuta scena predchadzajucin DEV
#srcline 3434 ;										;
#srcline 3435 ;									ELSIF xDLs^.cx.scn.lvl[i] > 0 AND xDev^.al.Ou.Val > 0. THEN // DEV ma mat uroven a je vypnute
#srcline 3436 ;//										xDlg^.al.Qx 		:= false;
#srcline 3437 ;										xDLm^.me.scn.DEV[i] := true;
#srcline 3438 ;//										xDlG^.al.in.CMD 	:= 3;										// len vypne scenu a resetne casy
#srcline 3440 ;(*
#srcline 3441 ;									ELSIF xDev^.al.Ou.Val = 0 AND xDLs^.cx.scn.lvl[i] > 0 THEN // DEV ma mat uroven a je vypnute
#srcline 3442 ;										xDlg^.al.Qx 		:= false;
#srcline 3443 ;										xDlG^.al.in.CMD 	:= 3;										// len vypne scenu a resetne casy
#srcline 3444 ;*)
#srcline 3445 ;									
#srcline 3446 ;(*
#srcline 3447 ;									ELSIF xDlg^.al.Qx = false THEN
#srcline 3448 ;										;
#srcline 3449 ;									ELSIF xDLg^.al.Ou.Val < 100. THEN                 		// scena pola stmievana, toto dev sa nezaplo/nevyplo 	
#srcline 3450 ;										IF xDev^.al.Ou.Val <> xDLg^.al.Ou.Val THEN  // dev ma iny LVL ak o ma mat v ecene
#srcline 3451 ;											xDlg^.al.Qx 		:= false;
#srcline 3452 ;											xDlG^.al.in.CMD 	:= 3;										// len vypne scenu a resetne casy
