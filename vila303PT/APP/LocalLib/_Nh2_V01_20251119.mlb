#srcline 1968 ;(*
#srcline 1970 ;		IF xPvA^.Qr THEN
#srcline 1972 ;			_NhDevRef(xR := xTve);			
#srcline 1973 ;			IF xPvA^.prg THEN														// ma byt program
#srcline 1974 ;				;
#srcline 1975 ;			ELSIF xPva2^.pv <> xPvA^.pv OR xPva2^.Qr THEN	// zmena v manuali, alebo stlacena ta ista predvolba
#srcline 1976 ;				IF xFix^.wht = 1 THEN                                 // prva zmena v automatike
#srcline 1977 ;					_Nh_Fix_HET_MAN(fix := xFix, chg := ADR(xTve^.cx.chg), ref := true, off:=true);	// vynuluje datum/cas konca
#srcline 1978 ;			  	ELSE
#srcline 1979 ;  					_Nh_Fix_HET_MAN(fix := xFix, chg := ADR(xTve^.cx.chg));   	// pri prepnuti na MAN zisti koniec z parametra
#srcline 1980 ;				END_IF;
#srcline 1981 ;			END_IF;	
#srcline 1982 ;			_Nh_Fix_HET_MAN(fix := xFix, chg := ADR(xTve^.cx.chg), ref:=true);	// urobi refresh zostavajuceho casu toChg
#srcline 1983 ;			xPva2^.Qr := false;
#srcline 1984 ;		ELSIF xPvA^.prg THEN                             							
#srcline 1985 ;			xPva2^.PV   := MIN(xTve^.me.pvMax,INT_TO_USINT(xTve^.al.in.par));					// kazdy cyklus sa prebera PV		
#srcline 1986 ;	  		xTve^.al.in.par	:= 0;                                  		// pripravi na dalsi otocku primania pri PRG
#srcline 1987 ;			xPvA^.Qr				:= xPvA^.pv <> xPva2^.PV;              // prisla zmena
#srcline 1988 ;			xPvA^.pv  			:= xPva2^.PV;									// vyrovna sa zmena
#srcline 1989 ;		ELSIF	xTve^.cx.chg.dtChg = UINT_TO_DT(0) THEN                  	// MAN sa nikdy neskonci - nepojde sa do porovnania
#srcline 1990 ;			;
#srcline 1991 ;		ELSIF xTve^.cx.chg.dtChg <= aSys.NhDT THEN                     	// prave sa skoncil MAN
#srcline 1992 ;			xPvA^.prg   	:= true;	
#srcline 1993 ;			xPvA^.Qr			:= true;
#srcline 1994 ;		END_IF;
#srcline 1995 ;		xPtIO 	:= ADR(xTve^.io[1]);												// teplota vyhrievacie teleso {podlahy}
#srcline 1996 ;		IF _Nh_IO_DEV(io := xPtIO) AND xTve^.cx.reg.Guard THEN				// zapnut tepelne ochrany = zatial len TVE
#srcline 1997 ;				IF	xPtIO^.val = 0.0   OR                               		// nula je ako ze nedava teplotu
#srcline 1998 ;					xPtIO^.val <= -40.0 OR                              		// snimac ukazuje chujovinu
#srcline 1999 ;      	 		xPtIO^.val >= 124.0 THEN                            		// snimac ukazuje chujovinu
#srcline 2000 ;					xPtIO^.val := -0.0;													// toto sa zobrazi
#srcline 2001 ;		      ELSIF xTve^.cx.reg.Mode = 1 THEN       							// chladenie
#srcline 2002 ;					// CHLADENIE
#srcline 2003 ;		      	IF xTve^.cx.guard.val[1,1] > 0 AND REAL_TO_USINT(xPtIO^.val) > xTve^.cx.guard.val[1,1] THEN       // vysoka teplota
#srcline 2004 ;	      		   	xTve^.al.CM    	:= 110;
#srcline 2005 ;   	      		   xPvA^.prg      	:= false;
#srcline 2006 ;	   	         	xPva^.pv       	:= 1;
#srcline 2007 ;  	   		   ELSIF xTve^.cx.guard.val[1,0] > 0 AND REAL_TO_USINT(xPtIO^.val) < xTve^.cx.guard.val[1,0] THEN       // nizka teplota
#srcline 2008 ;	         			xTve^.al.CM    	:= 120;
#srcline 2009 ;	   	      	 	xPvA^.prg      	:= false;
#srcline 2010 ;   	   	     		xPva^.pv       	:= 0;
#srcline 2011 ;					ELSIF xTve^.al.CM > 100 THEN														// prave sa skoncilo obmedzenie
#srcline 2012 ;						xTve^.al.CM			:= 0;
#srcline 2013 ;			      	xPvA^.Qr      		:= true;
#srcline 2014 ;      				xPvA^.prg      	:= true;
#srcline 2015 ;	      			xPva^.pv       	:= 0;
#srcline 2016 ;					END_IF;
#srcline 2017 ;		      	//KURENIE
#srcline 2018 ;				ELSIF xTve^.cx.guard.val[0,1] > 0 AND REAL_TO_USINT(xPtIO^.val) > xTve^.cx.guard.val[0,1] THEN       // vysoka teplota
