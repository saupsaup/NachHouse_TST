#srcline 476 ;				ELSE                                                          	// aj den
#srcline 477 ;					_NhPathRRmmDD(rr:=1, mm:=1, dd:=1, slash:=1, yTxt:=yTxt, sufix:='');		// LOG/HET/ rom /RR/MM/DD
#srcline 478 ;				END_IF;
#srcline 479 ;			END_IF;			
#srcline 480 ;			CASE file OF
#srcline 481 ;				0: ;
#srcline 482 ;           -1: ;
#srcline 483 ;			ELSE  yTxt := CONCAT(yTxt,'het.csv');			
#srcline 484 ;         END_CASE;
#srcline 487 ;	  3 : //LOG/VEN/rr/mm/dd/
