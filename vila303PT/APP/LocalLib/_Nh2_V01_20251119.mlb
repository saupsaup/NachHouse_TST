#srcline 711 ;       1     (wh:= 20, x:= x2-85  , y:= y1 + 100,   w:= 68     , FgC := 0, BgC :=50, fn := 372),  // 1 1.VYMAZA túto DALI-adresu
#srcline 712 ;       2     (wh:= 20, x:= x2-85  , y:= y1 + 200,   w:= 68     , FgC := 0, BgC :=50, fn := 373),  // 2 2.PREPISAT túto DALI-adresu
