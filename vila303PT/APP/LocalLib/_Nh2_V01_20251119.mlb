#srcline 550 ;//         blk               := xR^.h.chk = false;                                       // blk len ked nie je vo vazbe
#srcline 551 ;   IF aCfg[ xR^.h.cf.c].tgrp = 13 THEN                                                    // vo vazbe nie je v riadku wsb
 LEA  aCfg
 LEA  xR
 LDIL    ; dereference 
 LDI  
#debug usint xR^.h.cf.c
 SUB  1   ; Low range[1]
 RCHK 69   ; Range Check
 MUL  52   ; SizeOf(...)
 ADD     ; + offset 
 ADD  25  ; + offset 
 LDI  
#debug usint aCfg[xR^.h.cf.c].tgrp
 LD   usint 13
 EQ
