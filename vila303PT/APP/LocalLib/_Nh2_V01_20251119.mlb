  STRUCT  (*`spolocna CFG pre analogove DEV*)
    tOnL             : usint :=  0;  (*`25;             // cas nabehu do minima [100mS]*)
    DimHW            : bool :=  1;  (*`ma sa hardwarovo stmievanat (ak ma adrresu)*)
    dummy1           : bool;
    dummy2           : bool;
    dummy3           : bool;
  END_STRUCT;
END_TYPE

