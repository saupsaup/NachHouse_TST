; End initialize - variables
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 1107 ;	etAct	:= USINT_TO_UINT(SYSTEM_S.COUNTER_HOURS) * 60 + USINT_TO_UINT(SYSTEM_S.COUNTER_MINUTES) ;
 LD   SYSTEM_S~COUNTER_HOURS
#debug usint SYSTEM_S.COUNTER_HOURS
 AND  $FFFF
 LD   uint 60
 MUL
 AND  $FFFF
 LD   SYSTEM_S~COUNTER_MINUTES
#debug usint SYSTEM_S.COUNTER_MINUTES
 AND  $FFFF
 ADD
 AND  $FFFF
 WRY  etAct
#debug_left uint etAct
#srcline 1108 ;	IF xNhDT^.hour = 0 THEN
 LEAX xNhDT
 LDIL    ; dereference 
 ADD  3  ; + offset 
 LDI  
#debug usint xNhDT^.hour
 LD   usint 0
 EQ
 JMC  _NH_NEXT_ET_L1
#srcline 1109 ;		etReQ	:= 24 * 60 + USINT_TO_UINT(xNhDT^.min) ;	
 LD   uint 24
 LD   uint 60
 MUL
 AND  $FFFF
 LEAX xNhDT
 LDIL    ; dereference 
 ADD  4  ; + offset 
 LDI  
#debug usint xNhDT^.min
 AND  $FFFF
 ADD
 AND  $FFFF
 WRY  etReQ
#debug_left uint etReQ
#srcline 1110 ;	ELSE
 JMP  _NH_NEXT_ET_L2
_NH_NEXT_ET_L1:
#srcline 1111 ;		etReQ	:= USINT_TO_UINT(xNhDT^.hour) * 60 + USINT_TO_UINT(xNhDT^.min) ;	
 LEAX xNhDT
 LDIL    ; dereference 
 ADD  3  ; + offset 
 LDI  
#debug usint xNhDT^.hour
 AND  $FFFF
 LD   uint 60
 MUL
 AND  $FFFF
 LEAX xNhDT
 LDIL    ; dereference 
 ADD  4  ; + offset 
 LDI  
#debug usint xNhDT^.min
 AND  $FFFF
 ADD
 AND  $FFFF
 WRY  etReQ
#debug_left uint etReQ
#srcline 1112 ;	END_IF;
_NH_NEXT_ET_L2:
#srcline 1113 ;	IF etReQ >= etAct THEN         // 18:30-17:20 1110-1040=70,	 18:30-17:50 1110-1070=40, 18:30-18:30  // 00:00-19:30 1440-1170=270,
 LDY  etReQ
#debug uint etReQ
 LDY  etAct
#debug uint etAct
 LT
 NEG
 JMC  _NH_NEXT_ET_L3
#srcline 1114 ;		_NH_NEXT_ET := etReQ - etAct;
 LDY  etReQ
#debug uint etReQ
 LDY  etAct
#debug uint etAct
 SUB
 AND  $FFFF
 WRX  __fc___NH_NEXT_ET
#debug_left uint _NH_NEXT_ET
#srcline 1115 ;	ELSE                           // 18:30-19:30 1110-1170=-60+24*60=1380   1110+270=1380
 JMP  _NH_NEXT_ET_L4
_NH_NEXT_ET_L3:
#srcline 1116 ;		_NH_NEXT_ET := 24*60 - (etAct - etReQ);
 LD   uint 24
 LD   uint 60
 MUL
 AND  $FFFF
 LDY  etAct
#debug uint etAct
 LDY  etReQ
#debug uint etReQ
 SUB
 AND  $FFFF
 SUB
 AND  $FFFF
 WRX  __fc___NH_NEXT_ET
#debug_left uint _NH_NEXT_ET
#srcline 1117 ;	END_IF;              						
_NH_NEXT_ET_L4:
#srcline 1118 ;END_FUNCTION
 PRV  
 LDX  __fc___NH_NEXT_ET
 ULNK
RET
E     61
#endpou 

