#srcline 459 ;           1 : yTxt := CONCAT(yTxt,'msg');
#srcline 460 ;           2 : yTxt := CONCAT(yTxt,'sms');
#srcline 461 ;           3 : yTxt := CONCAT(yTxt,'mal');
#srcline 462 ;         END_CASE;	
#srcline 463 ;         IF hed THEN
#srcline 464 ;				yTxt := CONCAT(yTxt,'.HED');					// 2308_msg.HED	
#srcline 465 ;			ELSE
#srcline 466 ;				yTxt := CONCAT(yTxt,'.txt');			
#srcline 467 ;			END_IF;	
#srcline 468 ;	   6 : //LOG/HET/rom/rr/mm/dd/		rom pride v yTxt
