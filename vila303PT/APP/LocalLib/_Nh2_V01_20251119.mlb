#srcline 416 ;      		            _Nh_DL_ADD_Task(wht:=2, par := dlgr,  	//   scena		0..15                    	// nastavi LVL pre ballast v scene
#srcline 417 ;         	                                   	sha := dlsl,    //   ballast	0..63
#srcline 418 ;            	                                	val := REAL_TO_USINT(USINT_TO_REAL(xDLs^.cx.scn.LVL[ dlgr ])*2.45) ,
#srcline 419 ;               	                             	dlm := dlma );
#srcline 420 ;							END_IF;
#srcline 421 ;						END_IF;
#srcline 422 ;				ELSIF xDls^.cx.cfg.out5inOne THEN								// do TVE, bude zobrazena RGBWA +
