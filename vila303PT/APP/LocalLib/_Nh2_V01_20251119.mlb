; End initialize - variables
#srcline 3350 ;   _Nh_LVL_100 := ( USINT_TO_REAL(lvlMin) + lvlIn * ( USINT_TO_REAL(lvlMax - lvlMin) / 100.0 )) * BOOL_TO_REAL(lvlIn > 0.0) ; // minimum + skorigovany LVL
