#srcline 2020 ;         		   xPvA^.prg      	:= false;
#srcline 2021 ;	            	xPva^.pv       	:= 0;
#srcline 2022 ;  	   	   ELSIF xTve^.cx.guard.val[0,0] > 0 AND REAL_TO_USINT(xPtIO^.val) < xTve^.cx.guard.val[0,0] THEN       // nizka teplota
#srcline 2023 ;	         		xTve^.al.CM    	:= 120;
