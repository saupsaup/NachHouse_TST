#srcline 561 ;   END_IF;
_NhSetWSB_L10:
#srcline 562 ;END_FUNCTION
 PRV  
 LDX  __fc___NhSetWSB
 ULNK
RET
E     61
#endpou 

#pou _Nh_Chk_OFF
#srcline 564 ;FUNCTION _Nh_Chk_OFF  {HIDDEN} : BOOL         // ak je filter [8]:= 49,51,57  filtruje len zapnute/ vypnute
P     61
_Nh_Chk_OFF_L0:
 LINK 0
 NXT
; Initialize - variables
 LD   0
 WRX  __fc___Nh_Chk_OFF
; End initialize - variables
#srcline 568 ;   _Nh_Chk_OFF := true;
 LD   bool -1       ; true
 WRX  __fc___Nh_Chk_OFF
#debug_left bool _Nh_Chk_OFF
#srcline 569 ;   IF xU^.o[8].fn = 49  THEN                          // bez filtra
 LEA  xU
 LDIL    ; dereference 
 ADD  101  ; + offset 
 LDIW 
#debug int xU^.o[8].fn
 EXTW 
 LD   int 49
 EQ
 JMC  _Nh_Chk_OFF_L1
#srcline 570 ;      ;
#srcline 571 ;   ELSIF xU^.o[8].fn = 57 THEN                        // v rom/zon filtrujew let kde je pritomnost / pohyb
 JMP  _Nh_Chk_OFF_L2
_Nh_Chk_OFF_L1:
 LEA  xU
 LDIL    ; dereference 
 ADD  101  ; + offset 
 LDIW 
#debug int xU^.o[8].fn
 EXTW 
 LD   int 57
 EQ
 JMC  _Nh_Chk_OFF_L3
#srcline 572 ;      xRom  := xDev;
 LEA  xDev
 LDIL 
#debug pointer xDev
 LEA  xRom
 WRIL 
#debug_left pointer xRom
#srcline 573 ;      yes   := yes AND xRom^.me.BodyQ;
 LD   yes
#debug bool yes
 LEA  xRom
 LDIL    ; dereference 
 ADD  197  ; + offset 
 MUL  8   ; -> bool pointer 
 ADD  2   ; Bool offset 
 LDIB 
#debug bool xRom^.me.BodyQ
 AND
 WR   yes
#debug_left bool yes
#srcline 574 ;   ELSIF xU^.o[8].fn = 51 THEN
 JMP  _Nh_Chk_OFF_L2
_Nh_Chk_OFF_L3:
 LEA  xU
 LDIL    ; dereference 
 ADD  101  ; + offset 
 LDIW 
#debug int xU^.o[8].fn
 EXTW 
 LD   int 51
 EQ
 JMC  _Nh_Chk_OFF_L4
#srcline 575 ;   	yes := yes AND xDev^.al.sta > 0;                   // vacsina pripadov
 LD   yes
#debug bool yes
 LEA  xDev
 LDIL    ; dereference 
 ADD  50  ; + offset 
 LDI  
#debug usint xDev^.al.sta
 LD   usint 0
 GT
 AND
 WR   yes
#debug_left bool yes
#srcline 576 ;	END_IF;
 JMP  _Nh_Chk_OFF_L2
_Nh_Chk_OFF_L4:
_Nh_Chk_OFF_L2:
#srcline 577 ;(*
#srcline 578 ;      IF yIdxR.dev.c = 2 THEN                          // riadok je CAT
#srcline 579 ;         _NhxRoW(nbr:=xA^.sbj, zon:=true);                         // namapuje xRow na Domcek alebo ak sa pouzivaju subjekty tak na subjekt-byt
#srcline 580 ;         yes :=  yes AND xRoW^.cat[ yIdxR.dev.n ];
#srcline 581 ;      ELSE
#srcline 582 ;         yes := yes AND xDev^.al.ou.val > 0.0;                   // vacsina pripadov
#srcline 583 ;      END_IF;
#srcline 584 ;   END_IF;
#srcline 585 ;*)
#srcline 586 ;END_FUNCTION
 PRV  
 LDX  __fc___Nh_Chk_OFF
 ULNK
RET
E     61
#endpou 

