#srcline 380 ;								xR^.o.ob[6].cm 	:= 251;											// posle prikaz ON/OFF pre 5in1						
#srcline 381 ;								_NhxPt(c:=xF^.cf.c, n:=xF^.cf.n, x:=-154);
#srcline 382 ;								xTve := xPt;
#srcline 383 ;								_Nh_DEF_VAR(wh:=20, o:=6, x:=ADR(xTve^.io[0].dev.o));				
#srcline 384 ;							ELSE
