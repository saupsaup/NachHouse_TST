    nSer             : usint :=  1;  (*`0 pocet serii*)
    lSer             : usint;  (*`1 LVL v ktorej bude DEV pocas cakania do dalsej serie*)
    tSer             : uint :=  60;  (*`2 cas do dalsej serie*)
    tMax             : uint :=  0;  (*`3 max cas fungovania*)
