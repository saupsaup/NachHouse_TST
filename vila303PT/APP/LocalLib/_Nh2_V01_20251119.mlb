#srcline 714 ;       4     (wh:= 20, x:= x2-85  , y:= y1 + 400,   w:= 68     , FgC := 0, BgC :=50, fn := 374),  // 4 3.Vyh¾ada nové adresy
#srcline 715 ;       5     (wh:= 20, x:= x2-85  , y:= y1 + 500,   w:= 68     , FgC := 0, BgC :=50, fn := 375),  // 5 4.Obnovi existujúce adresy
