    m                : usint;
    nWsb             : usint :=  20;  (*`max pocet predvolieb*)
    mWsb             : ARRAY [0..20] OF NH_FRM_260_DATA :=  [
						( mWsb := 0,  	cf := (rw2 := 4,x:=180,y:=500),
												txt := [80,81,616,83], 									// 0 default SVD,ZAS : Nic/prepnut/zapnut/vypnut
