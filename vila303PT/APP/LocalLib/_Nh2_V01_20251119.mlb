										( R := 255,	 G := 255,  B := 255),
										( R := 255,  G := 0,    B := 255),
										( R := 255,  G := 255,  B := 0  ),
										( R := 255,  G := 128,  B := 0  ),
										( R := 0,    G := 191,  B := 255),
										( R := 0,  	 G := 255,  B := 255),
										( R := 245,  G := 145,  B := 245),
										( R := 255,  G := 128,  B := 0  ),
										( R := 255,  G := 255,  B := 255)];
    lvl              : ARRAY [1..9] OF usint :=  [255,255,255,255,255,255,255,255,255];
  END_STRUCT;
