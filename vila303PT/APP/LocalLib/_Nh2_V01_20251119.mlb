                     GCOLOR_LIGHT_BLUE_50,                  // 24
                     GCOLOR_DKGRAY+ GCOLOR_TRANSPARENT3_4,  // 25
                     GCOLOR_WHITE + GCOLOR_TRANSPARENT1_4,  // 26
