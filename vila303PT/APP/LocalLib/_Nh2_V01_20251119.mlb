 GTF
 AND  $3F800000
 MUF
 WRX  __fc___Nh_LVL_100
#debug_left real _Nh_LVL_100
#srcline 3352 ;// _Nh_LVL_100 := USINT_TO_REAL(lMin) + LVL*( USINT_TO_REAL(lMax-lMin)/254.0 ); // minimum + skorigovany LVL
#srcline 3353 ;// _Nh_LVL_100 := _Nh_LVL_100/2.54 * BOOL_TO_REAL(LVL > 0.0); // prevod na 0..100 len ked je VAL > 0
#srcline 3354 ;//	_Nh_LVL_100	:= ( vr + xDev^.al.ou.val * (kr - vr) / 100.0) * BOOL_TO_REAL(xDev^.al.ou.val > 0.0) ;
#srcline 3355 ;END_FUNCTION
 PRV  
 LDX  __fc___Nh_LVL_100
