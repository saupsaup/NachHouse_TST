    typ              : usint :=  1;  (*`typ cielovej premennej 1=usint,3=sint*)
    aArray           : udint;  (*`adresa cieloveho pola*)
    WrkVar           : usint;  (*`pomocna premenna - ak sa cislo vyberu neuklada do nejakej premennej je va adrese aVar tato premmenne,*)
