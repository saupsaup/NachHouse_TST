VAR_GLOBAL CONSTANT
 XML_MAX_TAG_LEN : uint := 80;  (*`{CSY} max velikost tagu v XML             {ENU} max size of tag in XML document*)
 XML_MAX_ATR_LEN : uint := 64;  (*`{CSY} max velikost atributu v XML         {ENU} max size of attribute in XML document*)
 XML_MAX_VAL_LEN : uint := 192;  (*`{CSY} max velikost hodnoty v XML          {ENU} max size of value in XML document*)
 XML_MAX_TXT_LEN : uint := 254;  (*`{CSY} max velikost textu v XML            {ENU} max size of text in XML document*)
 XML_MAX_ATR_NUM : uint := 10;  (*`{CSY} max poèet atributu v XML tagu       {ENU} max number of attributes (one XML tag)*)

END_VAR

TYPE TXmlItem :
  STRUCT  (*`{CSY} struktura obsahující položky jednoho øádku XML dokumentu {ENU} struct for one XML line*)
    tag              : string [80];  (*`{CSY} název XML elementu                                       {ENU} name of XML element*)
    isTxt            : bool;  (*`{CSY} pøíznak textu                                            {ENU} text flag*)
    indexTxt         : udint;  (*`{CSY} index textu od zaèátku xml bufferu                       {ENU} index of text in the xml buffer*)
    lenTxt           : udint;  (*`{CSY} délka textu                                              {ENU} length of text*)
    txt              : string [254];  (*`{CSY} prvních 254 znakù textù                                  {ENU} text (first 254 characters)*)
    startTAG         : bool;  (*`{CSY} TRUE = zaèátek párového TAGu (napr. <ROOT>)              {ENU} TRUE means begin of pair tag*)
    endTAG {ALIGNED} : bool;  (*`{CSY} TRUE = konec párového TAGu   (napr. </ROOT>)             {ENU} TRUE means end of pair tag*)
    eod {ALIGNED} {HIDDEN} : bool;  (*`{CSY} konec dat                                                {ENU} end of data*)
    numAtr           : uint;  (*`{CSY} poèet nalezených atributu                                {ENU} number of attributes*)
    atr              : ARRAY [1..10] OF string [64];  (*`{CSY} název XML atributu                                       {ENU} name of XML attribute*)
    val              : ARRAY [1..10] OF string [192];  (*`{CSY} hodnota XML atributu                                     {ENU} value of XML attribute*)
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK fbXmlTagParser
(*`{CSY} pøevádí jeden øádek XML dokumentu do struktury TXmlItem
   {ENU} converts one line from XML document into a TXmlItem structure*)
  VAR_INPUT
    start            : bool;  (*`{CSY} TRUE zaène parsovat od zaèátku XML dat, FALSE pokracuje tam, kde se minule skonèilo {ENU} TRUE means start of parsing at the begin of XML document, FALSE means continue*)
    size             : udint;  (*`{CSY} velikost bufferu s XML daty {ENU} size of buffer containing XML document*)
  END_VAR
  VAR_IN_OUT
    sourceXML        : usint;  (*`{CSY} zaèátek XML dat      {ENU} begin of XML document*)
    itemXML          : TXmlItem;  (*`{CSY} výstup XML parseru   {ENU} XML parser output*)
  END_VAR
  VAR_OUTPUT
    eod              : bool;  (*`{CSY} Konec dat            {ENU} End of data*)
  END_VAR
  VAR
    index            : udint;  (*`index v XML bufferu - pamatovat kvuli on-line zmene*)
    src              : PTR_TO usint;
    end              : PTR_TO usint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION GetAttrValue : string [192]
(*`{CSY} Vrací hodnotu atributu definovaného jménem
  {ENU} Returns value of attribute defined by name*)
  VAR_INPUT
    name             : string [64];  (*`{CSY} jméno atributu   {ENU} name of attribute*)
  END_VAR
  VAR_IN_OUT
    itemXML          : TXmlItem;  (*`{CSY} výstup XML parseru   {ENU} XML parser output*)
  END_VAR
  VAR
    ptrVal           : PTR_TO usint;
  END_VAR
END_FUNCTION

__DECL FUNCTION SetAttrValue : bool
(*`{CSY}Zapisuje název a hodnotu atributu do struktury TXmlItem. Vrací TRUE pokud se podaøilo zapsat.
  {ENU}Write name and value of attribute to the structure TXmlItem. Returns TRUE if successful.*)
  VAR_INPUT
    name             : string [64];  (*`{CSY} jméno atributu   {ENU} name of attribute*)
    value            : string [192];  (*`{CSY} hodnota atributu   {ENU} value of attribute*)
  END_VAR
  VAR_IN_OUT
    itemXML          : TXmlItem;  (*`{CSY} výstup XML parseru   {ENU} XML parser output*)
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fbXmlTagComposer
(*`{CSY}Pøevádí strukturu TXmlItem na jeden tag XML dokumentu
   {ENU}Converts a TXmlItem structure into one tag of XML document*)
  VAR_INPUT
    start            : bool;  (*`{CSY} TRUE zaène ukládat od zaèátku XML dat, FALSE pokraèuje tam, kde se minule skonèilo {ENU} TRUE means start of composing at the begin of XML document, FALSE means continue*)
    size             : udint;  (*`{CSY} velikost bufferu pro XML data {ENU} size of buffer for XML document*)
  END_VAR
  VAR_IN_OUT
    destXML          : usint;  (*`{CSY} zaèátek XML dat       {ENU} begin of XML document*)
    itemXML          : TXmlItem;  (*`{CSY} vstup XML composeru   {ENU} XML composer input*)
  END_VAR
  VAR_OUTPUT
    sizeXML          : udint;  (*`{CSY} aktuální velikost XML {ENU} actual size of XML document*)
    sizeErr          : bool;  (*`{CSY} nedostatek místa {ENU} insuficient size*)
  END_VAR
  VAR
    beg              : PTR_TO usint;
    end              : PTR_TO usint;
    dst              : PTR_TO usint;
  END_VAR
END_FUNCTION_BLOCK

VAR_GLOBAL CONSTANT
 XML_MAX_STACK_LEVEL : sint := 9;  (*`{ENU} max level of XML stack {CSY} maximální úroveò XML stacku*)

END_VAR

TYPE TXmlStackItem :
  STRUCT
    tag              : string [80];  (*`{ENU} tag name         {CSY} název tagu*)
    dummy {HIDDEN}   : byte;  (*`{ENU} reserved         {CSY} dorovnat na sudou*)
  END_STRUCT;
END_TYPE

TYPE TXmlStack :
  STRUCT  (*`{CSY} struktura obsahující historii pársování XML dokumentu {ENU} structure about history of parsing XML document*)
    done {ALIGNED}   : bool;  (*`{ENU} next item is avalable {CSY} byla vyparsovaná položka*)
    eod {ALIGNED}    : bool;  (*`{ENU} end of document       {CSY} konec dokumentu*)
    error            : usint;  (*`{ENU} error code            {CSY} kód chyby*)
    errTxt           : string [32];  (*`{ENU} error description     {CSY} popis chyby*)
    maxLevel {HIDDEN} : sint;  (*`{ENU} max stack level       {CSY} max úroveò stacku*)
    level            : sint;  (*`{ENU} stack level           {CSY} úroveò stacku*)
    layer            : ARRAY [0..9] OF TXmlStackItem;  (*`{ENU} tag names  {CSY} názvy tagù*)
  END_STRUCT;
END_TYPE

TYPE TXmlInfo :
  STRUCT
    item             : TXmlItem;  (*`{ENU} XML parser output    {CSY} výstup XML parseru*)
    stack            : TXmlStack;  (*`{ENU} stack for parsing    {CSY} zásobník pro analýzu dokumentu*)
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK fbXmlParser
(*`{ENU} Converts one item from XML document into a TXmlItem structure and sets TXmlStack structure
   {CSY} Pøevádí jednu položku XML dokumentu do struktury TXmlItem. Zároveò nastavuje strukturu TXmlStack pro snadné parsování.*)
  VAR_INPUT
    start            : bool;  (*`{ENU} TRUE means start of parsing at the begin of XML document, FALSE means continue {CSY} TRUE zaène parsovat od zaèátku XML dat, FALSE pokraèuje tam, kde se minule skonèilo*)
    shrink           : bool;  (*`{ENU} shrink request {CSY} TRUE odstraní z bufferu již zpracovanou èást a nezpracovaný zbytek pøesune na zaèátek bufferu*)
    size             : udint;  (*`{ENU} size of buffer with XML document {CSY} velikost bufferu s XML dokumentem*)
  END_VAR
  VAR_IN_OUT
    sourceXML        : usint;  (*`{ENU} begin of XML document {CSY} zaèátek XML dat*)
    xmlItem          : TXmlItem;  (*`{ENU} XML parser output     {CSY} výstup XML parseru*)
    xmlStack         : TXmlStack;  (*`{ENU} stack for parsing     {CSY} zásobník pro analýzu dokumentu*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENU} new item is ready    {CSY} byla vyparsována další položka*)
    eod              : bool;  (*`{ENU} end of XML document  {CSY} konec XML dokumentu*)
    error            : usint;  (*`{ENU} error code           {CSY} error <> 0 ... došlo k chybì*)
    restLen          : uint;  (*`{ENU} number of bytes remaining to be processed {CSY} poèet bytù, který zbývá zpracovat*)
    line             : udint;  (*`{ENU} line number          {CSY} èíslo øádku v xml dokumentu*)
  END_VAR
  VAR
    index            : udint;
    src              : PTR_TO usint;
    end              : PTR_TO usint;
    tagState         : byte;
    commentFlg       : bool;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbXmlFileParser
(*`{ENU} Parsing of XML document from file. Information about xml element is saved into TXmlInfo structure.
  {CSY} Parsování XML dokumentu ze souboru. Informace o vyparsované položce je uložena do struktury TXmlInfo.*)
  VAR CONSTANT
    XML_BUMBER       : uint :=  512;  (*`{ENU} bumper of xml buffer {CSY} nárazník v xml bufferu*)
    XML_BUFFER_SIZE  : uint :=  768;  (*`{ENU} size of xml buffer {CSY} velikost bufferu*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{ENU} request for parsing {CSY} parsovat XML soubor*)
  END_VAR
  VAR_IN_OUT
    fileName         : string [80];  (*`{ENU} mame of XML file  {CSY} jméno souboru s XML dokumentem*)
    xmlInfo          : TXmlInfo;  (*`{ENU} result of parsing {CSY} výsledek parsování*)
  END_VAR
  VAR_OUTPUT
    start            : bool;  (*`{ENU} initialization flag          {CSY} pøíznak inicializace bloku*)
    done             : bool;  (*`{ENU} new item is ready in xmlItem {CSY} výsledek parsování je pøipraven v xmlInfo*)
    busy             : bool;  (*`{ENU} block is busy                {CSY} blok je zaneprázdnìn*)
    eof              : bool;  (*`{ENU} end of file                  {CSY} konec souboru*)
    break            : bool;  (*`{ENU} buffer processed, continue next cycle {CSY} buffer zpracován, pokraèovat pøíští cyklus*)
    err              : bool;  (*`{ENU} error flag                   {CSY} pøíznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description            {CSY} popis chyby*)
    fileSize         : udint;  (*`{ENU} size of file                 {CSY} velikost souboru*)
    processed        : udint;  (*`{ENU} processed                    {CSY} zpracováno (poèet znakù)*)
    line             : udint;  (*`{ENU} line number in XML document  {CSY} èíslo øádku v XML dokumentu*)
  END_VAR
  VAR
    rqInit           : bool;
    rqFile           : bool;
    rqParse          : bool;
    rqStart          : bool;
    trgExecOn        : R_TRIG;
    ReadFile         : ReadFromFile;
    XmlParser        : fbXmlParser;
    xmlBuffer        : ARRAY [0..768] OF usint;
    sumaLen          : udint;  (*`kolik nacteno ze souboru*)
    actLen           : udint;  (*`aktualni velikost xml bufferu*)
    restLen          : uint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbXmlPageParser
(*`{ENU} Parsing of XML document file from web site. Information about xml element is saved into TXmlInfo structure.
  {CSY} Parsování XML dokumentu z web stránky. Informace o vyparsované položce je uložena do struktury TXmlInfo.*)
  VAR CONSTANT
    XML_BUMBER       : uint :=  256;  (*`{ENU} bumper of xml buffer {CSY} nárazník v xml bufferu*)
    XML_BUFFER_SIZE  : uint :=  768;  (*`{ENU} size of xml buffer   {CSY} velikost bufferu*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{ENU} request for parsing                     {CSY} parsovat XML soubor*)
    chanCode         : uint;  (*`{ENU} channel code (ETH1_uni0, ETH1_uni1,...) {CSY} komunikaèní kanál (ETH1_uni0, ETH1_uni1,...)*)
  END_VAR
  VAR_IN_OUT
    pageName         : string [255];  (*`{ENU} mame of web page with XML file  {CSY} název web stránky s s XML dokumentem*)
    xmlInfo          : TXmlInfo;  (*`{ENU} result of parsing               {CSY} výsledek parsování*)
  END_VAR
  VAR_OUTPUT
    start            : bool;  (*`{ENU} initialization flag          {CSY} pøíznak inicializace bloku*)
    done             : bool;  (*`{ENU} new item is ready in xmlItem {CSY} výsledek parsování je pøipraven v xmlInfo*)
    busy             : bool;  (*`{ENU} block is busy                {CSY} blok je zaneprázdnìn*)
    eof              : bool;  (*`{ENU} end of file                  {CSY} konec souboru*)
    break            : bool;  (*`{ENU} buffer processed, continue next cycle {CSY} buffer zpracován, pokraèovat pøíští cyklus*)
    err              : bool;  (*`{ENU} error flag                   {CSY} pøíznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description            {CSY} popis chyby*)
    fileSize         : udint;  (*`{ENU} size of file                 {CSY} velikost souboru*)
    processed        : udint;  (*`{ENU} processed                    {CSY} zpracováno (poèet znakù)*)
    line             : udint;  (*`{ENU} line number in XML document  {CSY} èíslo øádku v XML dokumentu*)
  END_VAR
  VAR
    rqShrink         : bool;
    rqFile           : bool;
    rqParse          : bool;
    rqStart          : bool;
    closeSocket      : bool;
    trgExecOn        : R_TRIG;
    XmlParser        : fbXmlParser;
    xmlBuffer        : ARRAY [0..768] OF usint;
    sumaLen          : udint;  (*`kolik nacteno ze souboru*)
    actLen           : udint;  (*`aktualni velikost xml bufferu*)
    restLen          : uint;
    HttpIP           : TIPadr;
    HttpPort         : uint;
    HttpName         : string [80];
    Action           : string [255];
    Empty            : string [1];
    SplitUrlAddress  : fbSplitUrlAddress;
    HttpRequest      : fbHttpRequest;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbXmlFileParserFindTag
(*`{ENU} Parsing XML document from a specific tag from a file. Information about xml element is saved into TXmlInfo structure.
  {CSY} Parsování XML dokumentu od urèitého tagu ze souboru . Informace o vyparsované položce je uložena do struktury TXmlInfo.*)
  VAR CONSTANT
    XML_BUMBER       : uint :=  256;  (*`{ENU} bumper of xml buffer         {CSY} nárazník v xml bufferu*)
    XML_BUFFER_SIZE  : uint :=  768;  (*`{ENU} size of xml buffer           {CSY} velikost bufferu*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{ENU} request for parsing          {CSY} parsovat XML soubor*)
    findTag          : string [80];  (*`{ENU} start tag for parsing        {CSY} tag, od kterého se zaène parsovat XML soubor*)
    orderFindTag     : uint := 1;  (*`{ENU} the order of the search tag in the file {CSY}  udává poøadi hledaného tagu v souboru*)
  END_VAR
  VAR_IN_OUT
    fileName         : string [80];  (*`{ENU} mame of XML file             {CSY} jméno souboru s XML dokumentem*)
    xmlInfo          : TXmlInfo;  (*`{ENU} result of parsing            {CSY} výsledek parsování*)
  END_VAR
  VAR_OUTPUT
    start            : bool;  (*`{ENU} initialization flag          {CSY} pøíznak inicializace bloku*)
    done             : bool;  (*`{ENU} new item is ready in xmlItem {CSY} výsledek parsování je pøipraven v xmlInfo*)
    busy             : bool;  (*`{ENU} block is busy                {CSY} blok je zaneprázdnìn*)
    eof              : bool;  (*`{ENU} end of file                  {CSY} konec souboru*)
    break            : bool;  (*`{ENU} buffer processed, continue next cycle {CSY} buffer zpracován, pokraèovat pøíští cyklus*)
    err              : bool;  (*`{ENU} error flag                   {CSY} pøíznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description            {CSY} popis chyby*)
    fileSize         : udint;  (*`{ENU} size of file                 {CSY} velikost souboru*)
    processed        : udint;  (*`{ENU} processed                    {CSY} zpracováno (poèet znakù)*)
    line             : udint;  (*`{ENU} line number in XML document  {CSY} èíslo øádku v XML dokumentu*)
  END_VAR
  VAR
    sumaLen          : udint;  (*`kolik nacteno ze souboru*)
    actLen           : udint;  (*`aktualni velikost xml bufferu*)
    restLen          : uint;  (*`pocet bytu, ktere je zbyva zpracovat*)
    indexFindTag     : int;  (*`index hledaneho tagu*)
    FindTagFinish    : bool;  (*`nalezen koncovy tag*)
    TagFindTrue      : bool;  (*`nalezeno klièové parsované slovo*)
    rqInit           : bool;
    rqFile           : bool;
    rqParse          : bool;
    rqStart          : bool;
    memoryFindTag    : uint;  (*`pamet pro zapamatovaní na jaký tag xml souboru má reagovat*)
    trgExecOn        : R_TRIG;
    ReadFile         : ReadFromFile;
    XmlParser        : fbXmlParser;
    xmlBuffer        : ARRAY [0..768] OF usint;
    src              : PTR_TO usint;
    end              : PTR_TO usint;
    PTRxmlBuffer     : PTR_TO string [80];
    layerZerou       : F_TRIG;  (*`slouží ke zjistìní kdy pri parsovani klesne z 1 vrstvy na 0 vrstvy*)
    layersZerou_One  : bool;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbXmlPageParserFindTag
(*`{ENU} Parsing XML document from a web page from a specific tag. Information about xml element is saved into TXmlInfo structure.
  {CSY} Parsování XML dokumentu z web stránky od urèitého tagu. Informace o vyparsované položce je uložena do struktury TXmlInfo.*)
  VAR CONSTANT
    XML_BUMBER       : uint :=  256;  (*`{ENU} bumper of xml buffer {CSY} nárazník v xml bufferu*)
    XML_BUFFER_SIZE  : uint :=  768;  (*`{ENU} size of xml buffer   {CSY} velikost bufferu*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{ENU} request for parsing                         {CSY} parsovat XML soubor*)
    chanCode         : uint;  (*`{ENU} channel code (ETH1_uni0, ETH1_uni1,...)     {CSY} komunikacní kanál (ETH1_uni0, ETH1_uni1,...)*)
    findTag          : string [80];  (*`{ENU} start tag for parsing                       {CSY} tag, od kterého se zaène parsovat XML soubor*)
    orderFindTag     : uint :=  1;  (*`{ENU} the order of the search tag in the web page {CSY} udává poøadi hledaného tagu v souboru*)
  END_VAR
  VAR_IN_OUT
    pageName         : string [255];  (*`{ENU} mame of web page with XML file  {CSY} název web stránky s s XML dokumentem*)
    xmlInfo          : TXmlInfo;  (*`{ENU} result of parsing               {CSY} výsledek parsování*)
  END_VAR
  VAR_OUTPUT
    start            : bool;  (*`{ENU} initialization flag          {CSY} pøíznak inicializace bloku*)
    done             : bool;  (*`{ENU} new item is ready in xmlItem {CSY} výsledek parsování je pøipraven v xmlInfo*)
    busy             : bool;  (*`{ENU} block is busy                {CSY} blok je zaneprázdnen*)
    eof              : bool;  (*`{ENU} end of file                  {CSY} konec souboru*)
    break            : bool;  (*`{ENU} buffer processed, continue next cycle {CSY} buffer zpracován, pokraèovat pøíštím cyklu*)
    err              : bool;  (*`{ENU} error flag                   {CSY} pøíznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description            {CSY} popis chyby*)
    fileSize         : udint;  (*`{ENU} size of file                 {CSY} velikost souboru*)
    processed        : udint;  (*`{ENU} processed                    {CSY} zpracováno (poèet znaku)*)
    line             : udint;  (*`{ENU} line number in XML document  {CSY} èíslo øádku v XML dokumentu*)
  END_VAR
  VAR
    rqShrink         : bool;
    rqFile           : bool;
    rqParse          : bool;
    rqStart          : bool;
    closeSocket      : bool;
    trgExecOn        : R_TRIG;
    XmlParser        : fbXmlParser;
    xmlBuffer        : ARRAY [0..768] OF usint;
    sumaLen          : udint;  (*`kolik nacteno ze souboru*)
    actLen           : udint;  (*`aktualni velikost xml bufferu*)
    restLen          : uint;
    HttpIP           : TIPadr;
    HttpPort         : uint;
    HttpName         : string [80];
    Action           : string [255];
    Empty            : string [1];
    SplitUrlAddress  : fbSplitUrlAddress;
    HttpRequest      : fbHttpRequest;
    indexFindTag     : int;  (*`index hledaneho tagu*)
    FindTagFinish    : bool;  (*`nalezen koncovy tag*)
    TagFindTrue      : bool;  (*`nalezeno klicové parsované slovo*)
    FinishCommServer : bool;
    memoryFindTag    : uint;
    src              : PTR_TO usint;
    end              : PTR_TO usint;
    PTRxmlBuffer     : PTR_TO string [80];
    layerZerou       : F_TRIG;
    layersZerou_One  : bool;
    findTagLen       : uint;
  END_VAR
END_FUNCTION_BLOCK



