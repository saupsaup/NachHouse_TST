TYPE T_PARSE_LEVEL_2 {HIDDEN} : 
  (PARSE_2_NONE,
   PARSE_2_DATA 
  );
END_TYPE

TYPE T_PARSE_LEVEL_3 {HIDDEN} : 
  (PARSE_3_NONE,
   PARSE_3_DATA 
  );
END_TYPE

