      (c:= 500, i:= 13),(c:= 501, i:= 13),(c:= 502, i:= 14),(c:= 503, i:= 14),(c:= 504, i:= 14),(c:= 511, i:= 10),(c:= 520, i:= 12),(c:= 521, i:= 11),(c:= 522, i:= 11),(c:= 531, i:= 11),
      (c:= 600, i:= 18),(c:= 601, i:= 18),(c:= 602, i:= 18),(c:= 611, i:= 20),(c:= 612, i:= 20),(c:= 615, i:= 06),(c:= 616, i:= 06),(c:= 620, i:= 16),(c:= 621, i:= 15),(c:= 622, i:= 19),
      (c:= 701, i:= 30),(c:= 711, i:= 32),(c:= 721, i:= 31),(c:= 731, i:= 23),(c:= 741, i:= 30),(c:= 751, i:= 23),(c:= 761, i:= 22),(c:= 762, i:= 24),(c:= 771, i:= 29),(c:= 781, i:= 00),
      (c:= 800, i:= 39),(c:= 801, i:= 41),(c:= 802, i:= 38),(c:= 803, i:= 37),(c:= 804, i:= 36),
