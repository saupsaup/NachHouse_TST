__DECL FUNCTION OWM_ICON_NAME_TO_CODE {HIDDEN} : usint
  VAR_INPUT
    iconName         : string [4];
  END_VAR
  VAR
    tmpCode          : usint;
    i                : usint;
    iconIndex        : usint;
    dayNight         : string [1];
  END_VAR
  VAR CONSTANT
    OWM_CODE_TABLE   : ARRAY [0..18] OF usint :=  [
      000, // OWM_A00.PNG            weather not available  : USINT := 0;
      101, // OWM_A01.PNG (01n.png)  clear sky night        : USINT := 1;
      001, // OWM_A02.PNG (01d.png)  clear sky day          : USINT := 2;
      102, // OWM_A03.PNG (02n.png)  few clouds night       : USINT := 3;
      002, // OWM_A04.PNG (02d.png)  few clouds day         : USINT := 4;
      103, // OWM_A05.PNG (03n.png)  scattered clouds night : USINT := 5;
      003, // OWM_A06.PNG (03d.png)  scattered clouds day   : USINT := 6;
      104, // OWM_A07.PNG (04n.png)  broken clouds night    : USINT := 7;
      004, // OWM_A08.PNG (04d.png)  broken clouds day      : USINT := 8;
      109, // OWM_A09.PNG (09n.png)  shower rain night      : USINT := 9;
      009, // OWM_A10.PNG (09n.png)  shower rain day        : USINT := 10;
      110, // OWM_A11.PNG (10n.png)  rain night             : USINT := 11;
      010, // OWM_A12.PNG (10d.png)  rain day               : USINT := 12;
      111, // OWM_A13.PNG (11n.png)  thunderstorm night     : USINT := 13;
      011, // OWM_A14.PNG (11d.png)  thunderstorm day       : USINT := 14;
      113, // OWM_A15.PNG (13n.png)  snow night             : USINT := 15;
      013, // OWM_A16.PNG (13d.png)  snow day               : USINT := 16;
      150, // OWM_A17.PNG (50n.png)  mist night             : USINT := 17;
      050  // OWM_A18.PNG (50d.png)  mist day               : USINT := 18;
    ];
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fbOpenWeatherMap
(*`{ENU} Getting weather information from OpenWeatherMap server by city and country name
  ETH connection in uni mode - TCP client,
  receiving zone 512 bytes, transmitting zone 512 bytes,
  remote IP address 0.0.0.0,
  remote port 80, local port 0
  {CSY} Získává informace o poèasí ze serveru OpenWeatherMap podle názvu mìsta a státu
  ETH1 kanál v reimu uni - TCP master,
  pøijímací zóna 512 bytù, vysílací zóna 512 bytù,
  vzdálená IP adresa 0.0.0.0,
  vzdálenı port 80, místní port 0*)
  VAR_INPUT
    getWeather       : bool R_EDGE;  (*`{ENU} reguest for weather info                {CSY} ádost o naètení pøedpovìdi poèasí z Internetu*)
    city             : string [80];  (*`{ENU} name city                               {CSY} mìsto*)
    country          : string [8];  (*`{ENU} country abbreviation (Czech Republic = cz, Canada = ca, ...) {CSY} zkratka státu (Èeská republika = cz)*)
    apiKey           : string [32];  (*`{ENU} APPID obtained from http://openweathermap.org/ {CSY} APPID získanı z http://openweathermap.org/*)
    period           : FORECAST_INTERVAL;  (*`{ENU} interval of forecast( hour_3, hour_6, hour_9, hour_12) {CSY} interval pøedpovìdi poèasí( hour_3, hour_6, hour_9, hour_12)*)
    utcOff           : dint;  (*`{ENU} choose UTC in minutes                   {CSY} volba UTC pásma v minutách*)
    ethCode          : uint;  (*`{ENU} channel code (ETH1_uni0, ETH1_uni1,...) {CSY} komunikaèní kanál (ETH1_uni0, ETH1_uni1,...)*)
  END_VAR
  VAR_IN_OUT
    weatherData      : T_OPEN_WEATHER_MAP_DATA;  (*`{ENU} information about weather {CSY} získaná meteo data*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENU} operation done              {CSY} pøíznak dokonèení*)
    busy             : bool;  (*`{ENU} operation pending           {CSY} probíhá zpracování ádost o pøedpovìï*)
    err              : bool;  (*`{ENU} error flag                  {CSY} chyba pøi vykonávání bloku*)
    errorTxt         : string [80];  (*`{ENU} error description           {CSY} popis chyby*)
    processed        : udint;  (*`{ENU} processed                   {CSY} zpracováno (poèet znakù)*)
  END_VAR
  VAR
    JsonDocParser    : fbJsonPageParser;  (*`FB pro parsovani web page*)
    getCurrentWeather : bool;
    getForecast      : bool;
    parseEnable      : bool;
    saveEnable       : bool;
    errFlg           : bool;
    pageName         : string [140];
    JSON             : TJsonInfo;  (*`struktura pro vısledky pársování*)
    parametr         : uint;  (*`urcuje cislo parametru  (99 = zadny parametr)*)
    i                : uint;  (*`pro pohyb v poli masky*)
    index            : uint;  (*`pro pohyb v poli struktur*)
    helpTime         : udint;  (*`pomocna promena na pøevod Unix casu*)
    timeUTC          : time;  (*`pomocna promena s UTS posunem +-12 hodin*)
    timeInterval     : time;
    dayNight         : string [1];
    recalculationDate : dt;  (*`prepoèet data s ohledem na UTS*)
    oldRecalculation : dt;  (*`pomocna*)
    OPENWEATHERMAP_MASK_PARAMETR_DAY : ARRAY [0..18] OF string [12] :=  ['dt','id','name',
                                                                      'lon','lat','sunrise','sunset', 'temp','pressure','humidity','temp_min','temp_max','speed','deg',
                                                                      'all','main','id','icon','description']  ;
    OPENWEATHERMAP_MASK_PARAMETR_FORECAST : ARRAY [0..4] OF string [12] :=  ['temp','temp_min','temp_max','pressure','humidity'];
  END_VAR
END_FUNCTION_BLOCK

TYPE T_PARSE_LEVEL_0 {HIDDEN} : 
  (PARSE_0_NONE,
   PARSE_0_DATA 
  );
END_TYPE

TYPE T_PARSE_LEVEL_1 {HIDDEN} : 
  (PARSE_1_NONE,
