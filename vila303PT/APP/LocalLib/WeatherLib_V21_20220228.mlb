TYPE T_YAHOO_WEATHER_FORECAST :
  STRUCT
    condition        : string [80];  (*`{ENU} condition (for example partly cloudy)                         {CSY} textová informace (napr. partly cloudy)*)
    condCode         : uint :=  48;  (*`{ENU} condition code yahoo (see constants MCC_TORNADO, MCC_...)     {CSY} kód pro obrázek yahoo (viz konstanty MCC_TORNADO, MCC_...)*)
    condCodeYr       : uint;  (*`{ENU} condition code yr.no (see constants YRC_CLEAR_SKY, YRC_...)   {CSY} kód pro obrázek yr.no (viz konstanty YRC_CLEAR_SKY, YRC_...)*)
    iconCode         : usint;  (*`{ENU} icon code (see constants ICC_weather_clear_night, ICC_...)    {CSY} kód pro obrázek  (viz konstanty ICC_weather_clear_night, ICC_...)*)
    lowTemp          : real;  (*`{ENU} min temperature [°C nebo °F]                                  {CSY} min. teplota [°C nebo °F]*)
    hiTemp           : real;  (*`{ENU} max temperature [°C nebo °F]                                  {CSY} max. teplota [°C nebo °F]*)
    dayName          : string [5];  (*`{ENU} day of week ('Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun') {CSY} den v tıdnu ('Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun')*)
    dat              : date;  (*`{ENU} date of forecast                                              {CSY} datum pøedpovìdi*)
  END_STRUCT;
END_TYPE

TYPE T_YAHOO_WEATHER_DATA :
  STRUCT
    condition        : string [80];  (*`{ENU} condition (for example partly cloudy)                       {CSY} textová informace (napø. partly cloudy)*)
    condCode         : uint :=  48;  (*`{ENU} yahoo condition code (see constants MCC_TORNADO, MCC_...)   {CSY} kód poèasí yahoo (viz konstanty MCC_TORNADO, MCC_...)*)
    condCodeYr       : uint;  (*`{ENU} yr.no condition code (see YRC_CLEAR_SKY, YRC_...)           {CSY} kód poèasí yr.no (viz YRC_CLEAR_SKY, YRC_...)*)
    iconCode         : usint;  (*`{ENU} icon code (see constants ICC_weather_clear_night, ICC_...)  {CSY} kód pro obrázek  (viz konstanty ICC_weather_clear_night, ICC_...)*)
    temperature      : real;  (*`{ENU} temperature [°C or °F]                                      {CSY} teplota [°C nebo °F]*)
    humidity         : real;  (*`{ENU} humidity [%]                                                {CSY} vlhkost [%]*)
    visibility       : real;  (*`{ENU} visibility [km or miles]                                    {CSY} viditelnost [km nebo mile]*)
    pressure         : real;  (*`{ENU} barometric pressure [milibar or pounds per square inch]     {CSY} atmosférickı tlak [milibar nebo pounds per square inch]*)
