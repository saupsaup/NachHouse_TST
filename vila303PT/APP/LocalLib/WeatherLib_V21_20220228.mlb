    condCode         : uint;  (*`{ENU} OpenWeatherMap condition code  {CSY} OpenWeatherMap kód pøedpovìdi*)
  END_VAR
  VAR_IN_OUT
    condString       : string [80];  (*`{ENU} condition string in czech language {CSY} text pøedpovìdi v èeském jazyce*)
