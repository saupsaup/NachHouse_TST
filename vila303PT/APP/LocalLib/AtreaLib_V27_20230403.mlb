    sc               : bool;  (*`{CSY}v˝stup na desce RDIO (tepelnÈ Ëerpadlo chlazenÌ){ENU}C00216*)
    scA_R            : uint;  (*`{CSY}0-10V napÏùovÈ ˙rovnÏ pro 18 chyb na desce RD4int (SC) {ENU}  H00202*)
    tu1              : real;  (*`{CSY}teplotnÌ Ëidlo 1{ENU}                                I00200*)
    tu2              : real;  (*`{CSY}teplotnÌ Ëidlo 2{ENU}                                I00201*)
