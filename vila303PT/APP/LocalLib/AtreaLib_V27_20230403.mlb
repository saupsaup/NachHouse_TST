    kk               : bool;  (*`{CSY}v˝stup na desce RD4ext (Ëerpadlo topnÈ vody){ENU}     C00202*)
    yv2              : bool;  (*`{CSY}v˝stup na desce RD4ext (ventil topnÈ vody 2){ENU}     C00203*)
    yv1              : bool;  (*`{CSY}v˝stup na desce RD4ext (ventil topnÈ vody 1){ENU}     C00204*)
    sdb              : bool;  (*`{CSY}v˝stup na desce RD4int (detekce chyby){ENU}           C00209*)
    sbC              : bool;  (*`{CSY}v˝stup na desce RD4int (zav¯en˝ by-pass){ENU}       C00210   1*)
    sbO              : bool;  (*`{CSY}v˝stup na desce RD4int (otev¯en˝ by-pass){ENU}      C00211*)
