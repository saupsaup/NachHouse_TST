 LD   0   ; null string
 LDX  ErrTxt
 WRI  
 LDX  ErrTxt
 LD   90
 DST    ; Level 1
 LEAY PS0__st__[0]
 SCON 
#debug_left string ErrTxt
 PDST   ; Level 1
