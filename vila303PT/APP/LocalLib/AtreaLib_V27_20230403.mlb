    modeSett_W {HIDDEN} : T_ATREA_uintRW;  (*`{CSY}Reûim 0= off, 1= Automat, 2= VÏtr·nÌ, 3= Cirkulace s vÏtr·nÌm, 4= cirkulace, 5= noËnÌ p¯edchlazenÌ, 6= rozv·ûenÌ, 7= p¯etlakovÈ{ENU}   H01000     1008 1012*)
    perform_W {HIDDEN} : T_ATREA_uintRW;  (*`{CSY}V˝kon 0-100{ENU}                                                              //H01001           1009   1013*)
    tempSett_W {HIDDEN} : T_ATREA_realRW;  (*`{CSY}NastavenÌ poûadovanÈ teploty pro manualnÌ ¯ÌzenÌ{ENU}                         //H01006           1010   1014*)
