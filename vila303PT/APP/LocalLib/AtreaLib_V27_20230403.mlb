  'N','o',' ','e','r','r','o','r',0
P     61
GetAtreaComErrTxt_L0:
 LINK __SizeOf(GetAtreaComErrTxt__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__GetAtreaComErrTxt
; End initialize - variables
#srcline 12 ;  IF  ErrorCode > 24 THEN
 LDX  ErrorCode
#debug uint ErrorCode
 LD   uint 24
 GT
 JMC  GetAtreaComErrTxt_L1
#srcline 13 ;    GetAtreaComErrTxt := GetModbusErrTxt(ErrorCode := UINT_TO_USINT(ErrorCode)  , ErrTxt := ErrTxt );
 NXT
 LDX  ErrorCode
#debug uint ErrorCode
 AND  $FF
 WR   __Instance__GetModbusErrTxt~ErrorCode
#debug_left usint __Instance__GetModbusErrTxt~ErrorCode
 LDX  ErrTxt
 WR   __Instance__GetModbusErrTxt~ErrTxt
#debug_left pointer __Instance__GetModbusErrTxt.ErrTxt
