__DECL FUNCTION GetAtreaModeNum {HIDDEN} : uint
(*`P¯evede univerz·lnÌ ËÌslo reûimu (viz nÌûe) na ËÌslo reûimu
pro dann˝ typ jednotky a obr·cenÏ.
            0 periodickÈ vÏtr·nÌ
            1 vÏtr·nÌ
            2 automatickÈ vÏtr·nÌ
            3 vÏtr·nÌ s cirkulacÌ
            4 cirkulace
            5 z·visl· cirkulace
            6 rovnotlakÈ vÏtr·nÌ
            7 p¯etlakovÈ vÏtr·nÌ   nenÌ u reûimu dovolen· pouûit
            8 vypnuto*)
  VAR_INPUT
    invert           : bool;
    prodLine         : uint;  (*`v˝robnÌ ¯ada*)
  END_VAR
  VAR_IN_OUT
    modeNum          : uint;  (*`ËÌslo p¯Ìkazu*)
  END_VAR
END_FUNCTION

__DECL FUNCTION GetAtreaHeatNum {HIDDEN} : uint
(*`P¯evede univerz·lnÌ ËÌslo oh¯evu (viz nÌûe) na ËÌslo oh¯evu
pro dann˝ typ jednotky a obr·cenÏ.
            0 neni
            1 tepelnÈ Ëerpadlo
            2 PWM elektrick˝
            3 analogovÈ vodnÌ
            4 kontaktnÌ elektrickÈ
            5 kontaktnÌ vodnÌ
            6 reversibilnÌ*)
  VAR_INPUT
