 SHR
 AND  $FFFF
 SUB  1   ; Low range[1]
 RCHK 23   ; Range Check
 MUL  81   ; SizeOf(...)
 ADD     ; + offset 
 WRI  
 LDX  LastErr
 LDX  ErrorCode
#debug uint ErrorCode
 LD   uint 8
 SHR
 AND  $FFFF
 SUB  1   ; Low range[1]
 RCHK 23   ; Range Check
 MUL  81   ; SizeOf(...)
 ADD     ; + offset 
 LD   80
 DST    ; Level 1
 LDX  ErrTxt
#debug string ErrTxt
 SCON 
#debug_left string LastErr[WORD_TO_UINT(SHR(IN:=(UINT_TO_WORD(ErrorCode)),N:=8))]
 PDST   ; Level 1
#srcline 15 ;    ErrTxt := 'Unit: ' +  WORD_TO_STRINGF(SHR(IN := (UINT_TO_WORD(ErrorCode)) , N := 8 ), '%d') +'. '+ErrTxt;
 LD   0   ; null string
 WRY  PS0__st__[0]
 LEAY PS0__st__[0]
 LD   90
 DST    ; Level 1
 LEA  _str_GetAtreaComErrTxt_0
 SCON 
 NXT
 LDX  ErrorCode
#debug uint ErrorCode
 LD   uint 8
 SHR
 AND  $FFFF
 WR   __Instance__WORD_TO_STRINGF~in
#debug_left word __Instance__WORD_TO_STRINGF~in
 LD   0   ; null string
 LEA  __Instance__WORD_TO_STRINGF~format
 WRI 
 LEA  __Instance__WORD_TO_STRINGF~format
 LD   80
 DST    ; Level 2
 LEA  _str_GetAtreaComErrTxt_1
 SCON 
#debug_left string __Instance__WORD_TO_STRINGF~format
 PDST   ; Level 2
 PRV
 LEA  __Instance__WORD_TO_STRINGF
 CAL  WORD_TO_STRINGF_L0

 SCON 
