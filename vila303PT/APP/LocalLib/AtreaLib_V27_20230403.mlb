 CAL  GetModbusErrTxt_L0
 WRX  __fc__GetAtreaComErrTxt
#debug_left bool GetAtreaComErrTxt
#srcline 14 ;    LastErr[WORD_TO_UINT(SHR(IN := (UINT_TO_WORD(ErrorCode)) , N := 8 ))] := ErrTxt;
 LD   0   ; null string
 LDX  LastErr
 LDX  ErrorCode
#debug uint ErrorCode
