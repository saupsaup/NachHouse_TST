    HighTariff       : bool;  (*`{CSY}Vysok˝ tarif                    D01416*)
    IntSensErr       : bool;  (*`{CSY}Porucha Ëidla v interiÈru       D01417*)
    NotOper          : bool;  (*`{CSY}Jednotka nezprovoznÏna          D01418*)
