    GTSAP1_DISPLAY_unit {PUBLIC_IFOX} : string [8] :=  'ppm';  (*`{ENG} Measurement unit (%,bar,C/F ...)               {CSY} Jednotka merenÌ (%,bar,C/F ...)*)
    GTSAP1_DISPLAY_precision {PUBLIC_IFOX} : int :=  0;  (*`{ENG} Precision of fraction part of Value            {CSY} presnost desetinnou c·st hodnoty*)
    GTSAP1_DISPLAY_maxValue {PUBLIC_IFOX} : real;  (*`{ENG} max enabled level                              {CSY} max povolen· hodnota*)
    lastVal          : real;
  END_VAR
