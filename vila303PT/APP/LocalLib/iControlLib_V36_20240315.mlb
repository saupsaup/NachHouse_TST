    GTSAP1_DISPLAY_unit {PUBLIC_IFOX} : string [8] :=  'ppm';  (*`{ENG} Measurement unit (%,bar,C/F ...)               {CSY} Jednotka merenÌ (%,bar,C/F ...)*)
    GTSAP1_DISPLAY_precision {PUBLIC_IFOX} : int :=  1;  (*`{ENG} Precision of fraction part of Value            {CSY} presnost desetinnou c·st hodnoty*)
