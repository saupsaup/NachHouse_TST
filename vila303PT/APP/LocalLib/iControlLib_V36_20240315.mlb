__DECL FUNCTION_BLOCK fb_iSensorTemp
(*`{ENG} function block for measurement of temperature (degrees of Celsius) including first order filter
   and posibility of temperature correction
   {CSY} blok pro mÏ¯enÌ teploty (ve stupnÌch Celsia) s fitrem 1.¯·du
   a moûnostÌ korekce vstupnÌ hodnoty*)
  VAR_INPUT
    in               : real;  (*`{ENG} temperature (REAL variable) {CSY} teplota (REAL promÏnn·)*)
    offset           : real;  (*`{ENG} correction of temperature   {CSY} korekce teploty*)
    filterTime       : time :=  T#30s;  (*`{ENG} time constant of filter     {CSY} Ëasov· konstanta filtru*)
    name {PUBLIC_IFOX=GTSAP1_DISPLAY_name} : string [48];  (*`{ENG} name {CSY} n·zev*)
  END_VAR
  VAR_OUTPUT
    out              : real;  (*`{ENG} out := filter( in + offset) {CSY} out := filter( in + offset)*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_DISPLAY_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
  END_VAR
  VAR
    GTSAP1_DISPLAY_edit {ALIGNED} {PUBLIC_IFOX} : bool :=  0;  (*`{ENG} Indication of editable value or not            {CSY} promenou je mozno editovat v aplikaci*)
    GTSAP1_DISPLAY_type {PUBLIC_IFOX} : usint :=  ICL_DISPLAY_TYPE_REAL;  (*`{ENG} Display type (0=onOff, 1=real value)           {CSY} typ zobrazovane hodnoty (0=onOff, 1=real value)*)
    GTSAP1_DISPLAY_symbol {PUBLIC_IFOX} : uint :=  APP_SYMBOL_TEMPERATURE;  (*`{ENG} Symbol in iFoxtrot App (APP_SYMBOL_..)         {CSY} symbol v iFoxtrot App (APP_SYMBOL_..)*)
    GTSAP1_DISPLAY_value {PUBLIC_IFOX} : real;  (*`{ENG} Value to display                               {CSY} hodnota k zobrazeni*)
    GTSAP1_DISPLAY_unit {PUBLIC_IFOX} : string [8] :=  '∞C';  (*`{ENG} Measurement unit (%,bar,C/F ...)               {CSY} Jednotka merenÌ (%,bar,C/F ...)*)
    GTSAP1_DISPLAY_precision {PUBLIC_IFOX} : int :=  1;  (*`{ENG} Precision of fraction part of Value            {CSY} presnost desetinnou c·st hodnoty*)
    filter           : fbFirstOrder;  (*`filtr prvniho radu*)
    lastVal          : real;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iSensorLight
