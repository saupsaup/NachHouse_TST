__DECL FUNCTION_BLOCK fb_iDimmer
(*`{CSY} StmÌvanÈ svÏtlo s nastavov·nÌm ˙rovnÏ pomocÌ dlouh˝ch stisk˘,
         kr·tkÈ stisky zapÌnajÌ a vypÌnajÌ svÏtlo (na nastavenou ˙roveÚ s rampou "offOnRamp")
         dlouhÈ stisky mÏnÌ nastavenou ˙roveÚ s rampou "setRamp"
         V˝stup level 0..100% - pro ¯ÌzenÌ 0..10V
   {ENU} Light dimmer,
         short press activates and deactivates light (to set level with ramp "offOnRamp")
         long presses changes the level with ramp "setRamp". Output level 0..100% - for controlling 0..10V*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} turn on the light at the last level (short press) {CSY} zapnout svÏtlo na poslednÌ ˙roveÚ (kr·tk˝ stisk)*)
    levelUp          : bool;  (*`{ENG} increase the level (long press)          {CSY} zv˝öit ˙roveÚ (dlouh˝ stisk)*)
    lightOff         : bool R_EDGE;  (*`{ENG} turn off the light (short press)         {CSY} vypnout svÏtlo (kr·tk˝ stisk)*)
    levelDw          : bool;  (*`{ENG} decrease the level (long press)          {CSY} snÌûit ˙roveÚ (dlouh˝ stisk)*)
    lightToggle      : bool R_EDGE;  (*`{ENG} toggle of the light                      {CSY} p¯epnutÌ svÏtla*)
    minLevel         : real :=  10.0;  (*`{ENG} min level for light [%]                  {CSY} min ˙roveÚ pro svÏtlo (zapalovacÌ ˙roveÚ) [%]*)
    offOnRamp        : time :=  T#5s;  (*`{ENG} ramp Off/On from min level to 100% [sec] {CSY} rampa Off/On z minLevel na 100% [sec]*)
    setRamp          : time :=  T#8s;  (*`{ENG} ramp Up/Dw from min level to 100%  [sec] {CSY} rampa Up/Dw z minLevel na 100% [sec]*)
    timeLimit        : time;  (*`{ENG} maximum time limit light [sec]           {CSY} omezenÌ max. doby svÌcenÌ (automaticky zhasne) [sec]*)
    webToggle        : bool R_EDGE;  (*`{ENG} control lights from web page             {CSY} ovl·d·nÌ svÏtla z web str·nky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central switching off                    {CSY} centr·lnÌ zhasnutÌ*)
    name {PUBLIC_IFOX=GTSAP1_LIGHT_name} : string [48];  (*`{ENG} name {CSY} n·zev*)
  END_VAR
  VAR_IN_OUT
    setLevel         : real;  (*`{ENG} last level (this variable have to be RETAIN) {CSY} poslednÌ nastaven· ˙roveÚ (promÏnnou umÌstit do VAR_GLOBAL RETAIN)*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} indication Off/On  {CSY} signalizace On/Off*)
    level            : real;  (*`{ENG} level 0..100[%]    {CSY} ˙roveÚ 0..100[%]*)
    minLev           : real;  (*`{ENG} min level 0..90[%] {CSY} minim·lnÌ ˙roveÚ 0..90[%]*)
    fbPtr            : udint;  (*`{ENG} function block pointer  {CSY} pointer na funkcnÌ blok*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_LIGHT_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_LIGHT_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_LIGHT_type {ALIGNED} {PUBLIC_IFOX} : bool :=  1;
    GTSAP1_LIGHT_dimtype {PUBLIC_IFOX} : usint :=  0;  (*`0= signle channel*)
    GTSAP1_LIGHT_onoff {OPEN_UP} {PUBLIC_IFOX} : bool;
    GTSAP1_LIGHT_dimlevel {OPEN_UP} {PUBLIC_IFOX} : real;
    GTSAP1_LIGHT_tgtlevel {OPEN_UP} {PUBLIC_IFOX} : real;
    gtsap1_old       : real;  (*`pro vyhodnoceni zmeny od mobilni aplikace*)
    gtsap1_tgt_old   : real;  (*`pro vyhodnoceni zmeny od mobilni aplikace*)
    oldSetLevel      : real;  (*`pro vyhodnoceni zmeny retain promenne*)
    toggleOn         : bool;  (*`pomocna pro zapnuti*)
    toggleOff        : bool;  (*`pomocna pro vypnuti*)
    lastLevelUp      : bool;
    lastLevelDw      : bool;
    lastSL52         : udint;
    tim              : TON;  (*`casovac pro omezeni doby osvetleni*)
    tmpSetLevel      : real;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iDimmerLED
(*`{CSY} StmÌvanÈ LED svÏtlo s nastavov·nÌm ˙rovnÏ pomocÌ dlouh˝ch stisk˘,
         kr·tkÈ stisky zapÌnajÌ a vypÌnajÌ svÏtlo (na nastavenou ˙roveÚ s rampou "offOnRamp")
         dlouhÈ stisky mÏnÌ nastavenou ˙roveÚ s rampou "setRamp"
         V˝stup level 0..100%, rampa [sec] - pro jeden kan·l CIB modulu ULED/ILED/RLC
   {ENU} LED light dimmer,
         short press activates and deactivates light (to set level with ramp "offOnRamp")
         long presses changes the level with ramp "setRamp".
         Output level 0..100%, ramp [sec] for one channel of a CIB ULED/ILED/RLC*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} turn on the light at the last level (short press) {CSY} zapnout svÏtlo na poslednÌ ˙roveÚ (kr·tk˝ stisk)*)
    levelUp          : bool;  (*`{ENG} increase the level (long press)                   {CSY} zv˝öit ˙roveÚ (dlouh˝ stisk)*)
    lightOff         : bool R_EDGE;  (*`{ENG} turn off the light (short press)                  {CSY} vypnout svÏtlo (kr·tk˝ stisk)*)
    levelDw          : bool;  (*`{ENG} decrease the level (long press)                   {CSY} snÌûit ˙roveÚ (dlouh˝ stisk)*)
    lightToggle      : bool R_EDGE;  (*`{ENG} toggle of the light                               {CSY} p¯epnutÌ svÏtla*)
    minLevel         : real :=  10.0;  (*`{ENG} min level for light [%]                           {CSY} min ˙roveÚ pro svÏtlo (zapalovacÌ ˙roveÚ) [%]*)
    offOnRamp        : time :=  T#5s;  (*`{ENG} ramp Off/On from min level to 100% [sec]          {CSY} rampa Off/On z minLevel na 100% [sec]*)
    setRamp          : time :=  T#8s;  (*`{ENG} ramp Up/Dw from min level to 100%  [sec]          {CSY} rampa Up/Dw z minLevel na 100% [sec]*)
    timeLimit        : time;  (*`{ENG} maximum time limit light [sec]                    {CSY} omezenÌ max. doby svÌcenÌ (automaticky zhasne) [sec]*)
    webToggle        : bool R_EDGE;  (*`{ENG} control lights from web page                      {CSY} ovl·d·nÌ svÏtla z web str·nky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central switching off                             {CSY} centr·lnÌ zhasnutÌ*)
    name {PUBLIC_IFOX=GTSAP1_LIGHT_name} : string [48];  (*`{ENG} name {CSY} n·zev*)
  END_VAR
  VAR_IN_OUT
    setLevel         : real;  (*`{ENG} last level (this variable have to be RETAIN) {CSY} poslednÌ nastaven· ˙roveÚ (promÏnnou umÌstit do VAR_GLOBAL RETAIN)*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} indication Off/On  {CSY} signalizace On/Off*)
    level            : real;  (*`{ENG} level 0..100 [%]   {CSY} ˙roveÚ 0..100 [%]*)
    ramp             : usint;  (*`{ENG} ramp for On/Off    {CSY} rampa pro On/Off*)
    minLev           : real;  (*`{ENG} min level 0..90[%] {CSY} minim·lnÌ ˙roveÚ 0..90[%]*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_LIGHT_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_LIGHT_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_LIGHT_type {ALIGNED} {PUBLIC_IFOX} : bool :=  1;
    GTSAP1_LIGHT_dimtype {PUBLIC_IFOX} : usint :=  0;  (*`0= signle channel*)
    GTSAP1_LIGHT_onoff {OPEN_UP} {PUBLIC_IFOX} : bool;
    GTSAP1_LIGHT_dimlevel {OPEN_UP} {PUBLIC_IFOX} : real;
    gtap1_old        : real;  (*`pro vyhodnoceni zmeny od mobilni aplikace*)
    oldSetLevel      : real;  (*`pro vyhodnoceni zmeny retain promenne*)
    toggleOn         : bool;  (*`pomocna pro zapnuti*)
    toggleOff        : bool;  (*`pomocna pro vypnuti*)
    lastLevelUp      : bool;
    lastLevelDw      : bool;
    lastSL52         : udint;
    tim              : TON;  (*`casovac pro omezeni doby osvetleni*)
  END_VAR
END_FUNCTION_BLOCK

