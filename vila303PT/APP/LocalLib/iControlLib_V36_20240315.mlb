    GTSAP1_DISPLAY_type {PUBLIC_IFOX} : usint :=  ICL_DISPLAY_TYPE_REAL;  (*`{ENG} Display type (0=onOff, 1=real value)           {CSY} typ zobrazovane hodnoty (0=onOff, 1=real value)*)
