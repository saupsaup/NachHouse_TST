__DECL FUNCTION_BLOCK fb_iOpener
(*`{CSY} Univerz·lnÌ ovladaË otevÌr·nÌ
   {ENU} Universal opener*)
  VAR_INPUT
    open             : bool R_EDGE;  (*`{ENG} open request {CSY} poûadavek na otev¯enÌ*)
    close            : bool R_EDGE;  (*`{ENG} close request {CSY} poûadavek na zav¯enÌ*)
    block            : bool;  (*`{ENG} blocking {CSY} blokace ovl·dacÌch vstup˘*)
    stop             : bool R_EDGE;  (*`{ENG} stop the movement {CSY} zastavenÌ pohybu*)
    ctrOpen          : bool R_EDGE;  (*`{ENG} central open {CSY} centr·lnÌ otev¯enÌ*)
    ctrClose         : bool R_EDGE;  (*`{ENG} central close {CSY} centr·lnÌ zav¯enÌ*)
    webOpen          : bool R_EDGE;  (*`{ENG} open request from web interface {CSY} poûadavek na otev¯enÌ z web rozhranÌ*)
    webClose         : bool R_EDGE;  (*`{ENG} close request from web interface {CSY} poûadavek na zav¯enÌ z web rozhranÌ*)
    openPercent      : usint :=  100;  (*`{ENG} request for percentage opening {CSY} poûadavek na procentu·lnÌ otev¯enÌ*)
    openTime         : time :=  T#20s;  (*`{ENG} maximum time of movement {CSY} maxim·lnÌ doba bÏhu pohonu*)
    pauseTime        : time :=  T#1.0s;  (*`{ENG} delay between reversation of movement [sec] {CSY} prodleva p¯ed otoËenÌm smÏru*)
    ctrTime          : time :=  T#10.0s;  (*`{ENG} central movement delay [sec] {CSY} zpoûdÏnÌ centr·lnÌho pohybu*)
    typ {PUBLIC_IFOX=GTSAP1_OPENER_type} : usint;  (*`{ENG} type of device {CSY} typ za¯ÌzenÌ*)
    discrete {PUBLIC_IFOX=GTSAP1_OPENER_discrete} : bool;  (*`{ENG} fully open/close behavior {CSY} diskretni chovani plneho otevreni/zavreni*)
    name {PUBLIC_IFOX=GTSAP1_OPENER_name} : string [48];  (*`{ENG} name  {CSY} n·zev*)
  END_VAR
  VAR_OUTPUT
    moving           : bool;  (*`{ENG} opener is moving {CSY} signalizace chodu*)
    opening          : bool;  (*`{ENG} opening state {CSY} stav otevÌr·nÌ*)
    closing          : bool;  (*`{ENG} closing state {CSY} stav zavÌr·nÌ*)
    opened           : bool;  (*`{ENG} opened state {CSY} stav otev¯eno*)
    closed           : bool;  (*`{ENG} closed state {CSY} stav zav¯eno*)
    target           : usint;  (*`{ENG} target percentage {CSY} cÌlov˝ stav otev¯enÌ v procentech [%]*)
    current          : usint;  (*`{ENG} open percentage [%] {CSY} procentu·lnÌ stav otev¯enÌ [%]*)
    fbPtr            : udint;  (*`{ENG} function block pointer {CSY} pointer na funkcnÌ blok*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_OPENER_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_OPENER_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
    needPin {PUBLIC_IFOX=GTSAP1_OPENER_needPin} : string [10];  (*`{ENG} Require PIN for status changes from user applications           {CSY} Vyûadovat PIN pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_OPENER_moving {ALIGNED} {PUBLIC_IFOX} : bool;
    GTSAP1_OPENER_block {PUBLIC_IFOX} : bool;
    GTSAP1_OPENER_discrete {PUBLIC_IFOX} : bool;
    GTSAP1_OPENER_target {OPEN_UP} {PUBLIC_IFOX} : usint;
    GTSAP1_OPENER_current {PUBLIC_IFOX} : usint;
    state            : usint;
    delayTimer       : TON;
    runTimer         : TON;
    stopTime         : time;
    toRun            : usint;
    gtsap1_old_target : usint;  (*`pro vyhodnoceni zmeny od mobilni aplikace*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iJalousie
(*`{CSY} Ovl·d·nÌ ûaluziÌ
   {ENU} Jalousie control*)
  VAR_INPUT
    rotUp {TRACK_ADR} : bool R_EDGE;  (*`{ENG} step up  {CSY} pootoËit ûaluzie nahoru*)
    up               : bool R_EDGE;  (*`{ENG} move up {CSY} ûaluzie nahoru*)
    rotDw            : bool R_EDGE;  (*`{ENG} step down  {CSY} pootoËit ûaluzie dolu*)
    dw               : bool R_EDGE;  (*`{ENG} move down {CSY} ûaluzie dolu*)
    block            : bool;  (*`{ENG} blocking {CSY} blokace ovl·dacÌch vstup˘*)
    stop             : bool R_EDGE;  (*`{ENG} stop the movement {CSY} zastavenÌ pohybu*)
    ctrUp            : bool R_EDGE;  (*`{ENG} central up {CSY} centr·lnÌ vytaûenÌ ûaluzie*)
    ctrDw            : bool R_EDGE;  (*`{ENG} central down {CSY} centr·lnÌ spuötÏnÌ ûaluzie*)
    webUp            : bool R_EDGE;  (*`{ENG} activation of "move up" from web interface {CSY} pro vysunutÌ ûaluziÌ z web rozhranÌ*)
    webDw            : bool R_EDGE;  (*`{ENG} activation of "move down"  from web interface {CSY} pro spuötÏnÌ ûaluziÌ z web rozhranÌ*)
    upDwTime         : time :=  T#20s;  (*`{ENG} maximum time of movement {CSY} maxim·lnÌ doba bÏhu pohonu*)
    rotTime          : time :=  T#0.5s;  (*`{ENG} lenght of step [sec]  {CSY} doba trv·nÌ kroku pri poot·ËenÌ*)
    pauseTime        : time :=  T#1.0s;  (*`{ENG} delay between reversation of movement [sec] {CSY} prodleva p¯ed otoËenÌm smÏru*)
    ctrTime          : time :=  T#10.0s ;  (*`{ENG} central movement delay [sec] {CSY} zpoûdÏnÌ centr·lnÌho pohybu*)
    name {PUBLIC_IFOX=GTSAP1_SHUTTER_name} : string [48];  (*`{ENG} name {CSY} n·zev*)
  END_VAR
  VAR_OUTPUT
    outUp            : bool;  (*`{ENG} jalousie is moving up {CSY} ûaluzie nahoru*)
    outDw            : bool;  (*`{ENG} jalousie is moving down {CSY} ûaluzie dolu*)
    sig              : bool;  (*`{ENG} jalousie is moving {CSY} signalizace chodu*)
    sigUp            : bool;  (*`{ENG} jalousie is up {CSY} signalizace ûaluzie naho¯e*)
    sigDw            : bool;  (*`{ENG} jalousie is down {CSY} signalizace ûaluzie dole*)
    pd               : usint;  (*`{ENG} impulse length for rotating jalousie {CSY} doba impulzu pro natoËenÌ ûaluziÌ*)
    posit            : usint;  (*`{ENG} jalousie position [%] {CSY} poloha ûaluzie [%]*)
    fbPtr            : udint;  (*`{ENG} function block pointer {CSY} pointer na funkcnÌ blok*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_SHUTTER_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_SHUTTER_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
    needPin {PUBLIC_IFOX=GTSAP1_SHUTTER_needPin} : string [10];  (*`{ENG} Require PIN for status changes from user applications           {CSY} Vyûadovat PIN pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_SHUTTER_up {ALIGNED} {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_down {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_run {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_uppos {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_downpos {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_up_control {OPEN_UP} {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_down_control {OPEN_UP} {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_rotup_control {OPEN_UP} {PUBLIC_IFOX} : bool;
    GTSAP1_SHUTTER_rotdown_control {OPEN_UP} {PUBLIC_IFOX} : bool;
    cas_stop         : time :=  T#0s;
    pauseUp          : bool;
    pauseDw          : bool;
    longUpDw         : bool;
    timUp            : TOF;
    timDw            : TOF;
    centrUp          : bool;
    centrUpH         : bool;
    centrDw          : bool;
    centrDwH         : bool;
    centrDelay       : time;
    lpd              : usint;
    positTim         : time;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_TimeAction
(*`{CSY} Blok pro vytvo¯enÌ impulsu v zadan˝ Ëas.
   timeOfAction := T#22h odpovÌd· Ëasu 22:00:00 [hh:mm:ss]
   {ENU} Function block that creates action impulse in given time of day.
   timeOfAction := T#22h activates the output in 22:00:00 [hh:mm:ss]*)
  VAR_INPUT
    enable           : bool;  (*`{CSY} povolenÌ aktivace*)
    timeOfAction1    : time;  (*`{ENG} time of 1st action  {CSY} Ëas aktivace 1.v˝stupu*)
    timeOfAction2    : time;  (*`{ENG} time of 2nd action  {CSY} Ëas aktivace 2.v˝stupu*)
  END_VAR
  VAR_OUTPUT
    out1             : bool;  (*`{ENG} output for 1st action {CSY} v˝stup pro 1.akci*)
    out2             : bool;  (*`{ENG} output for 2nd action {CSY} v˝stup pro 2.akci*)
  END_VAR
  VAR
    out1Trgr         : R_TRIG;
    out2Trgr         : R_TRIG;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_JalAlarm
(*`{CSY} Z·kladnÌ reakce ûaluzie na poplachy.
    Priority:
    1. poû·r   : blokace a otev¯enÌ
    2. n·mraza : blokace a zastavenÌ
    3. vÌtr    : blokace a otev¯enÌ
    4. sklo    : zav¯enÌ
   {ENU} Basic reaction to alerts.
    Precedency:
    1. fire  : move up and block
    2. ice   : stop and block
    3. wind  : move up and block
    4. glass : move down*)
  VAR_INPUT
    fire             : bool;  (*`{ENG} fire alert: move up and block jalousie inputs {CSY} poplach poû·r: vytaûenÌ ûaluzie a blokace vstup˘*)
    ice              : bool;  (*`{ENG} ice alert: stop the movement and block jalousie inputs {CSY} poplach n·mraza: zastavenÌ pohybu, blokace vstup˘*)
    wind             : bool;  (*`{ENG} wind alert: move up and block jalousie inputs  {CSY} poplach siln˝ vÌtr: vytaûenÌ ûaluzie a blokace vstup˘*)
    glass            : bool;  (*`{ENG} glass breaking alert: move down {CSY} poplach rozbitÌ skla: spuötÏnÌ ûaluzie*)
    blockJal         : bool;  (*`{ENG} blocking of jalousie inputs {CSY} blokace ovl·d·nÌ*)
    stopJal          : bool R_EDGE;  (*`{ENG} stop the movement {CSY} vstup zastavenÌ pohybu ûaluzie*)
    ctrUpJal         : bool R_EDGE;  (*`{ENG} central movement up {CSY} central nahoru*)
    ctrDwJal         : bool R_EDGE;  (*`{ENG} central movement down {CSY} central dolu*)
  END_VAR
  VAR_OUTPUT
    block            : bool;  (*`{ENG} blocking of jalousie inputs, connect with jalousie control {CSY} blokace ovl·d·nÌ, propojit s blokem zaluzie*)
    stop             : bool;  (*`{ENG} stop the movement, connect with jalousie cotnrol {CSY} zastavenÌ pohybu ûaluzie, propojit s blokem zaluzie*)
    ctrUp            : bool;  (*`{ENG} central movement up, connect with jalousie cotnrol {CSY} central nahoru, propojit s blokem zaluzie*)
    ctrDw            : bool;  (*`{ENG} central movement down, connect with jalousie cotnrol  {CSY} centralne dolu, propojit s blokem zaluzie*)
  END_VAR
  VAR
    fire_Rtrig       : R_TRIG;
    ice_Rtrig        : R_TRIG;
    wind_Rtrig       : R_TRIG;
    glass_Rtrig      : R_TRIG;
    fireH            : bool;
    iceH             : bool;
    windH            : bool;
    glassH           : bool;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_RndPulse
(*`{CSY} FunkËnÌ blok pro generov·nÌ n·hodn˝ch zapÌnacÌch pulz˘ s r˘znou dÈlkou.
   {ENU} Function block that randomly activates its output for a radnom time duration.*)
  VAR_INPUT
    enable           : bool;  (*`{ENG} Enables the FB  {CSY} PovolenÌ funkce FB*)
    sTime            : time;  (*`{ENG} Start of the generating (time) {CSY} zaË·tek generov·nÌ pulz˘ T#21h odpovÌd· 21:00:00 [hh:mm:ss]*)
    eTime            : time;  (*`{ENG} End of the generating (time) {CSY} Konec generov·nÌ nov˝ch pulz˘ T#21h odpovÌd· 21:00:00 [hh:mm:ss]*)
    minOffT          : time :=  T#5m;  (*`{ENG} Minimal time of "0" {CSY} Minim·lnÌ dÈlka intervalu nuly*)
    minOnT           : time :=  T#10m;  (*`{ENG} Minimal time of "1" {CSY} Minim·lnÌ dÈlka intervalu jedniËky*)
    maxLenght        : time :=  T#1h;  (*`{ENG} Maximal length of "1" and "0". {CSY} Maxim·lnÌ dÈlka pulzu jak "1" tak "0".*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} randomly generated output signal  {CSY} v˝stup n·hodnÏ generovan˝ch a n·hodnÏ dlouh˝ch pulz˘*)
    outOn            : bool;  (*`{ENG} rising edge of out  {CSY} n·bÏûn· hrana v˝stupu out*)
    outOff           : bool;  (*`{ENG} falling edge of out {CSY} sestupn· hrana v˝stupu out*)
  END_VAR
  VAR
    tOffStart        : bool;
    dTime            : time;
    trigOn           : R_TRIG;
    trigOff          : F_TRIG;
    seed             : dint;
    k                : dint;
    random           : real;
    state            : usint;
    oldState         : usint;
    inRange          : bool;
    timer            : TON;
  END_VAR
END_FUNCTION_BLOCK

