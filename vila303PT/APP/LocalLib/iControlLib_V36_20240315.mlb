__DECL FUNCTION_BLOCK fb_iDimmerRGB
(*`{CSY} StmÌvanÈ RGB svÏtlo,
         kr·tkÈ stisky zapÌnajÌ a vypÌnajÌ svÏtlo (na nastavenou ˙roveÚ s rampou "offOnRamp")
         dlouhÈ stisky mÏnÌ nastavenou ˙roveÚ s rampou "setRamp"
         V˝stup 3 x level 0..100%, 3 x rampa [sec] - pro 3 RGB kan·ly CIB modulu ULED/ILED
   {ENU} RGB dimmer,
         short press activates and deactivates light (to set level with ramp "offOnRamp")
         long press changes the level with ramp "setRamp"
         Outputs: 3 x level 0..100%, 3 x ramp [sec] for 3 RGB channels of ULED/ILED CIB module*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} turn on the light at the last level (short press) {CSY} zapnout svÏtlo na poslednÌ ˙roveÚ (kr·tk˝ stisk)*)
    levelUp          : bool;  (*`{ENG} increase the level (long press)                   {CSY} zv˝öit ˙roveÚ (dlouh˝ stisk)*)
    lightOff         : bool R_EDGE;  (*`{ENG} turn off the light (short press)                  {CSY} vypnout svÏtlo (kr·tk˝ stisk)*)
    levelDw          : bool;  (*`{ENG} decrease the level (long press)                   {CSY} snÌûit ˙roveÚ (dlouh˝ stisk)*)
    lightToggle      : bool R_EDGE;  (*`{ENG} toggle of the light                               {CSY} p¯epnutÌ svÏtla*)
    minLevel         : real :=  5.0;  (*`{ENG} min level for light [%]                           {CSY} min ˙roveÚ pro svÏtlo (zapalovacÌ ˙roveÚ) [%]*)
    offOnRamp        : time :=  T#5s;  (*`{ENG} ramp Off/On from min level to 100% [sec]          {CSY} rampa Off/On z minLevel na 100% [sec]*)
    setRamp          : time :=  T#8s;  (*`{ENG} ramp Up/Dw from min level to 100%  [sec]          {CSY} rampa Up/Dw z minLevel na 100% [sec]*)
    timeLimit        : time;  (*`{ENG} maximum time limit light [sec]                    {CSY} omezenÌ max. doby svÌcenÌ (automaticky zhasne) [sec]*)
    webToggle        : bool R_EDGE;  (*`{ENG} control lights from web page                      {CSY} ovl·d·nÌ svÏtla z web str·nky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central switching off                             {CSY} centr·lnÌ zhasnutÌ*)
    name {PUBLIC_IFOX=GTSAP1_LIGHT_name} : string [48];  (*`{ENG} name {CSY} n·zev*)
  END_VAR
  VAR_IN_OUT
    setLight         : T_SET_RGB_LIGHT;  (*`{ENG} last level and color (this variable have to be in VAR_GLOBAL RETAIN) {CSY} poslednÌ nastaven· ˙roveÚ a barva (promÏnnou umÌstit do VAR_GLOBAL RETAIN)*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} indication Off/On      {CSY} signalizace On/Off*)
    levelRed         : real;  (*`{ENG} red level 0..100 [%]   {CSY} red ˙roveÚ 0..100 [%]*)
    levelGreen       : real;  (*`{ENG} green level 0..100 [%] {CSY} green ˙roveÚ 0..100 [%]*)
    levelBlue        : real;  (*`{ENG} blue level 0..100 [%]  {CSY} blue ˙roveÚ 0..100 [%]*)
    rampRed          : usint;  (*`{ENG} red ramp [sec]         {CSY} red rampa [sec]*)
    rampGreen        : usint;  (*`{ENG} green ramp [sec]       {CSY} green rampa [sec]*)
    rampBlue         : usint;  (*`{ENG} blue ramp [sec]        {CSY} blue rampa [sec]*)
    minLev           : real;  (*`{ENG} min level 0..90[%]     {CSY} minim·lnÌ ˙roveÚ 0..90[%]*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_LIGHT_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_LIGHT_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
