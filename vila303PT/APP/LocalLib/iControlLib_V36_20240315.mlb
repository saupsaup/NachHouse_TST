__DECL FUNCTION_BLOCK fb_iSocket
(*`{ENG} Basic control of socket (or relay output) {CSY} Z·kladnÌ ovl·d·nÌ z·suvky (nebo relÈovÈho v˝stupu)*)
  VAR_INPUT
    socketOn         : bool R_EDGE;  (*`{ENG} socket on                   {CSY} zapnutÌ z·suvky*)
    socketOff        : bool R_EDGE;  (*`{ENG} socket off                  {CSY} vypnutÌ z·suvky*)
    socketToggle     : bool R_EDGE;  (*`{ENG} socket toggle               {CSY} p¯epnutÌ z·suvky*)
    pulseTime        : time;  (*`{ENG} pulse duration              {CSY} doba trv·nÌ pulzu*)
    webToggle        : bool R_EDGE;  (*`{ENG} socket toggle from web page {CSY} p¯epnutÌ z·suvky z web str·nky*)
    socketReset      : bool R_EDGE;  (*`{ENG} central reset of socket     {CSY} centr·lnÌ vypnutÌ z·suvky*)
    name {PUBLIC_IFOX=GTSAP1_SOCKET_name} : string [48];  (*`{ENG} name  {CSY} n·zev*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} socket control  {CSY} ¯ÌzenÌ z·suvky*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_SOCKET_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_SOCKET_needAck} : bool :=  TRUE;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_SOCKET_onoff {ALIGNED} {OPEN_UP} {PUBLIC_IFOX} : bool;
    stopTime         : time;
  END_VAR
END_FUNCTION_BLOCK

