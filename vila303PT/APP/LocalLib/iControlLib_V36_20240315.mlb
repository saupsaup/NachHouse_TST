 LEAX out2Trgr
 CAL  R_TRIG_L0
; output assigment 
 LDX  out2Trgr~Q
#debug bool out2Trgr~Q
 WRX  out2
#debug_left bool out2
#srcline 29 ;  ELSE
 JMP  fb_TimeAction_L2
