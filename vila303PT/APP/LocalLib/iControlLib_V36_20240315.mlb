    GTSAP1_DISPLAY_symbol {PUBLIC_IFOX} : uint :=  APP_SYMBOL_LIGHT_INTENSITY;  (*`{ENG} Symbol in iFoxtrot App (APP_SYMBOL_..)         {CSY} symbol v iFoxtrot App (APP_SYMBOL_..)*)
