__DECL FUNCTION _icontrol_GetVarNameByAdr {HIDDEN} : string [255]
(*`{CSY} Vr·tÌ jmÈno promÏnnÈ podle adresy promÏnnÈ
{ENG} Returns name of variable according to address of variable*)
  VAR_INPUT
    varAdr           : PTR_TO byte;  (*`{ENU} variable (name of instance) {CSY} jmÈno promÏnnÈ (jmÈno instance)*)
    varSize          : udint;  (*`{ENU} size of variable (number of bytes) {CSY} velikost promÏnnÈ (poËet byt˘)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fb_iLight
(*`{ENG} Basic control of light output {CSY} Z·kladnÌ ovl·d·nÌ v˝stupu pro svÏtlo*)
  VAR_INPUT
    lightOn          : bool R_EDGE;  (*`{ENG} light on                   {CSY} zapnutÌ svÏtla*)
    lightOff         : bool R_EDGE;  (*`{ENG} light off                  {CSY} vypnutÌ svÏtla*)
    lightToggle      : bool R_EDGE;  (*`{ENG} light toggle               {CSY} p¯epnutÌ svÏtla*)
    timeLimit        : time;  (*`{ENG} duration of light on       {CSY} max. doba svÌcenÌ*)
    webToggle        : bool R_EDGE;  (*`{ENG} light toggle from web page {CSY} p¯epnutÌ svÏtla z web str·nky*)
    lightReset       : bool R_EDGE;  (*`{ENG} central reset of light     {CSY} centr·lnÌ vypnutÌ svÏtel*)
    name {PUBLIC_IFOX=GTSAP1_LIGHT_name} : string [48];  (*`{ENG} name {CSY} n·zev*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} light control  {CSY} ovl·d·nÌ svÏtla*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_LIGHT_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_LIGHT_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_LIGHT_type {ALIGNED} {PUBLIC_IFOX} : bool :=  0;
    GTSAP1_LIGHT_onoff {OPEN_UP} {PUBLIC_IFOX} : bool;
    stopTime         : time;
  END_VAR
END_FUNCTION_BLOCK

VAR_GLOBAL CONSTANT
 ICL_RELAY_TYPE_ON_OFF : usint := 0;
 ICL_RELAY_TYPE_DIMMING : usint := 1;
 ICL_RELAY_TYPE_MULTI_STATE : usint := 2;

END_VAR

__DECL FUNCTION_BLOCK fb_iRelay
(*`{ENG} Function block for basic control of relay output
         Pulse on the input 'in' starts pulse on output 'out' during defined time in the parameter 'pulsTime'.
†††††††††Only rising edge on the input 'in' (0 to 1) generates pulse on output 'out_on'.The falling edge on the input 'in' (1 to 0) generates pulse on output 'out_off'

   {CSY} FunkcnÌ blok pro z·kladnÌ ovl·d·nÌ v˝stupu pro relÈ
         Impuls na vstupu 'in' vyvol· na v˝stupu 'out' impuls o dÈlce definovanÈ v parametru 'pulsTime'.
         P¯i n·bÏûnÈ hranÏ vstupu 'in' (z 0 na 1) je generov·n impuls na v˝stup 'out_on'. Na v˝stupu 'out_off' je generov·n impuls kdyû probÏhne sestupn· hrana (z 1 na 0).*)
  VAR_INPUT
    relayOn          : bool R_EDGE;  (*`{ENG} relay on                                    {CSY} zapnutÌ relÈ*)
    relayOff         : bool R_EDGE;  (*`{ENG} relay off                                   {CSY} vypnutÌ relÈ*)
    relayToggle      : bool R_EDGE;  (*`{ENG} relay toggle                                {CSY} prepnutÌ relÈ*)
    pulseTime        : time;  (*`{ENG} pulse duration                              {CSY} doba trv·nÌ pulzu*)
    webToggle        : bool R_EDGE;  (*`{ENG} relay toggle from web page                  {CSY} prepnutÌ relÈ z web str·nky*)
    relayReset       : bool R_EDGE;  (*`{ENG} central reset of relay                      {CSY} centr·lnÌ vypnutÌ relÈ*)
    symbol           : uint;  (*`{ENG} icon in iFoxtrot App (APP_ICON_socket, ..)  {CSY} ikona pro aplikace iFoxtrot (APP_ICON_socket, ...)*)
    name {PUBLIC_IFOX=GTSAP1_RELAY_name} : string [48];  (*`{ENG} name {CSY} n·zev*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} relay control                               {CSY} ¯ÌzenÌ relÈ*)
    out_on           : bool;  (*`{ENG} Short pulse when out changed from 0 to 1    {CSY} pulz na n·bÏûnou hranu out (z 0 do 1)*)
    out_off          : bool;  (*`{ENG} Short pulse when out changed from 1 to 0    {CSY} pulz na sestupnou hranu out (z 1 do 0)*)
    fbPtr            : udint;  (*`{ENG} function block pointer                      {CSY} pointer na funkcnÌ blok*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_RELAY_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_RELAY_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
    needPin {PUBLIC_IFOX=GTSAP1_RELAY_needPin} : string [10];  (*`{ENG} Require PIN for status changes from user applications           {CSY} Vyûadovat PIN pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_RELAY_type {PUBLIC_IFOX} : usint :=  ICL_RELAY_TYPE_ON_OFF;  (*`{ENG} relay type (0=onOff, 1=dimming, 2=multiState)  {CSY} model relÈ (0=onOff, 1=dimming, 2=multiState)*)
    GTSAP1_RELAY_symbol {PUBLIC_IFOX} : uint;  (*`{ENG} icon in iFoxtrot App (APP_ICON_socket, ..)     {CSY} ikona pro aplikace iFoxtrot (APP_ICON_socket, ...)*)
    GTSAP1_RELAY_onoff {OPEN_UP} {PUBLIC_IFOX} : bool;  (*`{ENG} relay on/off command from iFoxtrot App         {CSY} povel na zapnutÌ/vypnutÌ relÈ z aplikace iFoxtrot*)
    stopTime         : time;
    in_Ftrig         : F_TRIG;
    in_Rtrig         : R_TRIG;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iAction
(*`{ENG} block catches requests of actions which are generated from mobile app or web page
  {CSY} zachyt·v· poûadavky na akci nastavovanÈ z mobilnÌ aplikace nebo z web str·nky
   pokud p¯ijde poûadavek, tak nastavÌ v˝stup bloku na TRUE a vynuluje poûadavek
   v˝stup bloku se pak pouûije pro vyvol·nÌ akce v PLC*)
  VAR_INPUT
