 LDX  setLight
 LDIL 
#debug real setLight.level
 LDX  minLev
#debug real minLev
 MAXF
 LD   real 0.0
 MAXF
 LD   real 100.
 MINF
 WRX  level
#debug_left real level
#srcline 146 ;      cfgRamp  := TIME_TO_REAL( offOnRamp) / 1000.;
 LDX  offOnRamp
#debug time offOnRamp
 ILF
 LD   real 1000.
 DIF
 WRY  cfgRamp
#debug_left real cfgRamp
#srcline 147 ;    ELSE
 JMP  fb_iDimmerWWCW_L29
fb_iDimmerWWCW_L28:
