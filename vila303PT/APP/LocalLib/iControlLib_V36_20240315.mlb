__DECL FUNCTION_BLOCK fb_iSensorCO2
(*`{ENG} function block for measurement of CO2 (ppm)
   {CSY} blok pro mÏ¯enÌ CO2 (ppm) s vyhodnocenÌm p¯ekroËenÌ zadanÈ meze*)
