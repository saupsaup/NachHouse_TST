 LDX  coldWhite
#debug real coldWhite
 SUF
 ABS
 WRY  difCold
#debug_left real difCold
#srcline 158 ;      normRamp   := MAX( difWarm, difCold) * cfgRamp;       // spocitat rampy
 LDY  difWarm
#debug real difWarm
 LDY  difCold
#debug real difCold
 MAXF
 LDY  cfgRamp
#debug real cfgRamp
 MUF
 WRY  normRamp
#debug_left real normRamp
#srcline 159 ;      IF difWarm > 0 THEN
 LDY  difWarm
#debug real difWarm
 LD   real 0
 GTF
