    GTSAP1_LIGHT_type {ALIGNED} {PUBLIC_IFOX} : bool :=  1;
    GTSAP1_LIGHT_dimtype {PUBLIC_IFOX} : usint :=  1;  (*`1= RGB svetlo*)
