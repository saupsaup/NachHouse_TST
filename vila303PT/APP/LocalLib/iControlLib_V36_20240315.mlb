 DIF
 WRY  tmpLevel
#debug_left real tmpLevel
#srcline 153 ;      warmWhite  := (100.0 - setLight.balance) * tmpLevel;  // warm white
 LD   real 100.0
 LDX  setLight
 ADD  4  ; + offset 
 LDIL 
#debug real setLight.balance
 SUF
 LDY  tmpLevel
#debug real tmpLevel
 MUF
 WRX  warmWhite
#debug_left real warmWhite
#srcline 154 ;      coldWhite  := setLight.balance * tmpLevel;            // cold white
 LDX  setLight
 ADD  4  ; + offset 
