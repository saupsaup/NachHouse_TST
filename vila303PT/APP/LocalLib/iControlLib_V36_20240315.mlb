#debug_left time dTime
#srcline 27 ;    out1Trgr(CLK := (timeOfAction1 > T#0s) and (dTime >= timeOfAction1) and (dTime < timeOfAction1+T#1s), Q => out1 );
 LDX  timeOfAction1
#debug time timeOfAction1
