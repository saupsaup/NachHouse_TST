__DECL FUNCTION_BLOCK fb_C_RC_0006R
(*`{CSY} Ovl·d·nÌ modulu C-RC-0006R
   {ENU} Control of the modul C-RC-0006R*)
  VAR_INPUT
    master           : bool :=  0;  (*`{ENG} Master module         {CSY} Master modul*)
    control          : bool :=  0;  (*`{ENG} Reset control signals {CSY} Nulovat ¯ÌdÌcÌ sign·ly*)
    iDimmer_1        : udint :=  0;  (*`{ENG} Light dimmer 1        {CSY} StmivanÈ svitlo 1*)
    iDimmer_2        : udint :=  0;  (*`{ENG} Light dimmer 2        {CSY} StmivanÈ svitlo 2*)
    iDimmer_3        : udint :=  0;  (*`{ENG} Light dimmer 3        {CSY} StmivanÈ svitlo 3*)
    iDimmer_4        : udint :=  0;  (*`{ENG} Light dimmer 4        {CSY} StmivanÈ svitlo 4*)
    iDimmer_5        : udint :=  0;  (*`{ENG} Light dimmer 5        {CSY} StmivanÈ svitlo 5*)
    iDimmer_6        : udint :=  0;  (*`{ENG} Light dimmer 6        {CSY} StmivanÈ svitlo 6*)
    iDimmer_7        : udint :=  0;  (*`{ENG} Light dimmer 7        {CSY} StmivanÈ svitlo 7*)
    iDimmer_8        : udint :=  0;  (*`{ENG} Light dimmer 8        {CSY} StmivanÈ svitlo 8*)
    iDimmer_9        : udint :=  0;  (*`{ENG} Light dimmer 9        {CSY} StmivanÈ svitlo 9*)
    iDimmer_10       : udint :=  0;  (*`{ENG} Light dimmer 10       {CSY} StmivanÈ svitlo 10*)
    iDimmer_11       : udint :=  0;  (*`{ENG} Light dimmer 11       {CSY} StmivanÈ svitlo 11*)
    iDimmer_12       : udint :=  0;  (*`{ENG} Light dimmer 12       {CSY} StmivanÈ svitlo 12*)
    iJalousie_1      : udint :=  0;  (*`{ENG} Jalousie 1            {CSY} éaluzie 1*)
    iJalousie_2      : udint :=  0;  (*`{ENG} Jalousie 2            {CSY} éaluzie 2*)
    iJalousie_3      : udint :=  0;  (*`{ENG} Jalousie 3            {CSY} éaluzie 3*)
    iJalousie_4      : udint :=  0;  (*`{ENG} Jalousie 4            {CSY} éaluzie 4*)
    iJalousie_5      : udint :=  0;  (*`{ENG} Jalousie 5            {CSY} éaluzie 5*)
    iJalousie_6      : udint :=  0;  (*`{ENG} Jalousie 6            {CSY} éaluzie 6*)
    iJalousie_7      : udint :=  0;  (*`{ENG} Jalousie 7            {CSY} éaluzie 7*)
    iJalousie_8      : udint :=  0;  (*`{ENG} Jalousie 8            {CSY} éaluzie 8*)
    iScene8          : udint :=  0;  (*`{ENG} Scene control         {CSY} ÿÌzenÌ scÈn*)
    iFan_1           : udint :=  0;  (*`{ENG} Ventilation control 1 {CSY} ÿÌzenÌ ventilace 1*)
    iFan_2           : udint :=  0;  (*`{ENG} Ventilation control 2 {CSY} ÿÌzenÌ ventilace 2*)
    iRelay           : udint :=  0;  (*`{ENG} Relay output control  {CSY} ÿÌzenÌ relÈovÈho v˝stupu*)
    AudioControl     : udint :=  0;  (*`{ENG} Audio control         {CSY} Audio ovl·d·nÌ*)
    temp             : real;  (*`{ENG} Temperature           {CSY} Teplota*)
    RH               : usint;  (*`{ENG} Humidity              {CSY} Vlhkost*)
    CO2              : uint;  (*`{ENG} CO2 concentrations    {CSY} Koncentrace CO2*)
    backl            : bool;  (*`{ENG} Display backlight     {CSY} PodsvÌcenÌ displeje*)
    buzz             : bool;  (*`{ENG} Sound signalization   {CSY} Zvukov· signalizace*)
    keyboard         : byte;  (*`{ENG} Keyboard backlight intensity 0 - 10 (0 - 100%)  {CSY} Intenzita podsvÌcenÌ kl·vesnice 0 - 10 (0 - 100%)*)
  END_VAR
  VAR_IN_OUT
    reqTemp          : real;  (*`{ENG} requested temperature  {CSY} poûadovan· teplota*)
    modul_in         : TCIB_C_RC_0006R_IN;  (*`{ENG} input structure (data from module) {CSY} vstupnÌ struktura (data z modulu)*)
    modul_out        : TCIB_C_RC_0006R_OUT;  (*`{ENG} output structure (data for module) {CSY} v˝stupnÌ struktura (data pro modul)*)
  END_VAR
  VAR
    inPaging         : TCIB_PAGING_ARR;  (*`vstupni buffer*)
    outPaging        : TCIB_PAGING_ARR;  (*`vystupni buffer*)
    pagingBackup     : TCIB_PAGING_ARR;  (*`buffer pro odlozeni neodeslanych dat*)
    confirmWait      : usint;  (*`priznak cekani na potvrzeni prijmu (odpoved)*)
    confirmType      : byte;  (*`priznak naposledy odeslanych dat*)
    confirmCnt       : usint;  (*`citac odpovedi (pro detekci zmeny - inkrementuje se po kazde odpovedi)*)
    confirmTimer     : usint;  (*`casovac cekani na odpoved*)
    newMess          : bool;  (*`priznak novych vystupnich dat/odpoved, dalsi ceka ve fronte*)
    resetUpdate      : byte;  (*`pozadavek modulu o data, nastaveni, cas ...*)
    i                : usint;
    init             : byte;  (*`inicializace: bit0 obecne, bit1 svetla, bit1 zaluzie, bit3 sceny*)
    initOffs         : usint;
    ptrToInput       : PTR_TO udint;
    ptrToUdint       : PTR_TO udint;
    ptrToReal        : PTR_TO real;
    ptrToByte        : PTR_TO byte;
    ptrToData        : PTR_TO byte;
    DateTime         : TTecoDateTime;  (*`cas a datum*)
    size             : udint;
    id               : usint;
    cmd              : byte;
    iDimmer          : ARRAY [0..11] OF PTR_TO fb_iDimmer;
    fb               : PTR_TO fb_iDimmer;
    iScene           : PTR_TO fb_iScene8;
    iJalous          : ARRAY [0..7] OF PTR_TO fb_iJalousie;
    relay            : PTR_TO fb_iRelay;
    vent             : PTR_TO fb_iFan;
    fancoil          : PTR_TO fb_iFan;
    lightLevel       : ARRAY [0..11] OF real;  (*`stmivani az 12 svetel*)
    lightSet         : ARRAY [0..11] OF byte;  (*`ovladani az 12 svetel*)
    lightNum         : usint;  (*`pocet zapojenych svetel*)
    lightTimeout     : int;
    setScene         : byte;
    jalousiePos      : ARRAY [0..7] OF usint;  (*`stav az 8 zaluzii (polona v %)*)
    jalousieNum      : usint;  (*`pocet zapojenych zaluzii*)
    jalousieOffs     : usint;
    unitListPtr      : PTR_TO TCIB_C_RC_0006R_AudioSource_Bose;
    sourceControlPtr : PTR_TO TCIB_C_RC_0006R_AudioZone_Denon;
    unitList         : TCIB_C_RC_0006R_AudioSource_Bose;
    sourceControl    : TCIB_C_RC_0006R_AudioZone_Denon;
    audioState       : byte;
    audioType        : usint;
    audioUpdate      : word;
    dataOut          : ARRAY [0..11] OF byte;
    dataOutPrev      : ARRAY [0..11] OF byte;
    dataIn           : ARRAY [0..4] OF byte;
    str              : string [6];
  END_VAR
  VAR CONSTANT
    CONFIRM_TIMEOUT  : usint :=  20;
    FANLIMIT         : usint :=  5;
    LIGHT_MAX        : usint :=  12;
    JALOUSIE_MAX     : usint :=  8;
    BOSE_UNITS_MAX   : usint :=  10;
    DATA_BYTE_LEN    : usint :=  12;
    COMM_LIGHT       : byte :=  1;
    COMM_SCENE       : byte :=  2;
    COMM_JALOUS      : byte :=  3;
    COMM_HEATCOOL    : byte :=  4;
    COMM_AUDIO       : byte :=  5;
    COMM_DATA        : byte :=  6;
    COMM_RESET       : byte :=  7;
    COMM_INIT        : byte :=  8;
    COMM_NAMES       : byte :=  9;
    DATA_TIME        : byte :=  1;
    DATA_TEMP        : byte :=  2;
    DATA_TEMP_REF    : byte :=  3;
    DATA_RH          : byte :=  4;
    DATA_CO2         : byte :=  5;
    RESET_DATA       : byte :=  16#01;  (*`pozadavek o data*)
    RESET_LIGHT      : byte :=  16#02;  (*`pozadavek o nastaveni svetel*)
    RESET_JALOUS     : byte :=  16#04;  (*`pozadavek o nastaveni zaluzii*)
    RESET_SCENE      : byte :=  16#08;  (*`pozadavek o nastaveni scen*)
    RESET_NAMES      : byte :=  16#10;  (*`pozadavek o nazev iFan*)
    RESET_AUDIO      : byte :=  16#20;  (*`pozadavek o nazev iFan*)
    RESET            : byte :=  16#40;  (*`reset*)
  END_VAR
END_FUNCTION_BLOCK

VAR_GLOBAL CONSTANT
 ENCODING_UTF8 : uint := 65001;  (*`Unicode (UTF-8)*)
 ENCODING_CP1250 : uint := 1250;  (*`Latin 2 / Central European	Similar to ISO-8859-2 but moves several characters, including multiple letters.*)
 ENCODING_CP1251 : uint := 1251;  (*`Cyrillic	Incompatible with both ISO-8859-5 and KOI-8.*)
 ENCODING_CP1252 : uint := 1252;  (*`Latin 1 / Western European	Superset of ISO-8859-1 (without C1 controls). Letter repertoire accordingly similar to CP850.*)
 ENCODING_CP1253 : uint := 1253;  (*`Greek	Similar to ISO 8859-7 but moves several characters, including a letter.*)
 ENCODING_CP1254 : uint := 1254;  (*`Turkish	Superset of ISO 8859-9 (without C1 controls).*)
 ENCODING_CP1255 : uint := 1255;  (*`Hebrew	Almost a superset of ISO 8859-8, but with two incompatible punctuation changes.*)
 ENCODING_CP1256 : uint := 1256;  (*`Arabic	Not compatible with ISO 8859-6; rather, OEM Code page 708 is a ISO 8859-6 (ASMO 708) superset.*)
 ENCODING_CP1257 : uint := 1257;  (*`Baltic	Not ISO 8859-4; the later ISO 8859-13 is closely related, but with some differences in available punctuation.*)
 ENCODING_CP1258 : uint := 1258;  (*`Vietnamese (also OEM)	Not related to VSCII or VISCII, uses fewer base characters with combining diacritics.*)

END_VAR

__DECL FUNCTION_BLOCK fb_iPublicEncoding
(*`{ENG} Publish encoding of STRING variables for mobile application (iFoxtrot, HomeKit, ...)
  {CSY} Zve¯ejnit kÛdov·nÌ promÏnn˝ch typu STRING pro aplikaci (iFoxtrot, HomeKit, ...)*)
  VAR_INPUT
    encoding {PUBLIC_IFOX=GTSAP1_ENCODING} : uint :=  ENCODING_CP1250;  (*`ENCODING_UTF8, ENCODING_CP1250, ..., ENCODING_CP1258*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iThermostat_cool
(*`{CSY} Termostat pro chlazenÌ
   {ENU} Thermostat for cooling*)
  VAR_INPUT
    coolModeOn       : bool R_EDGE;  (*`{ENG} Rising edge switches on the cooling mode {CSY} N·bÏûn· hrana zapne chladicÌ reûim*)
