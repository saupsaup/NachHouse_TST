#debug bool levelUp
 NEG
 AND
 LDX  levelDw
#debug bool levelDw
 NEG
 AND
 WRX  tim~IN
#debug_left bool tim~IN
 LDX  timeLimit
#debug time timeLimit
 WRX  tim~PT
#debug_left time tim~PT
 LEAX tim
 CAL  TON_L0
#srcline 133 ;    {asm}
#srcline 134
      LDX     tim.Q
#srcline 135
      RESX    out
