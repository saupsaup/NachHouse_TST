    needAck {PUBLIC_IFOX=GTSAP1_ACTION_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
