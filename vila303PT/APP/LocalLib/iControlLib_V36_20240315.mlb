  VAR_INPUT
    onOff            : bool :=  TRUE;  (*`{ENG} control on/off                      {CSY} ¯ÌzenÌ zapnutÈ/vypnutÈ*)
    units            : bool;  (*`{ENG} temperature units 0 = ∞C, 1 = ∞F    {CSY} jednotky 0 = ∞C, 1 = ∞F*)
    manPriority      : bool;  (*`{ENG} manual mode priority                {CSY} 0 = reûim manual skonËÌ pri 1.zmÏnÏ ËasovÈho programu, 1 = reûim manual se ukonËi pouze p¯epnutÌm do auto*)
    roomTemp         : real;  (*`{ENG} temperature                         {CSY} mÏ¯en· teplota*)
    hyst             : real :=  0.1;  (*`{ENG} hysteresis of output heat/cool      {CSY} hystereze (necitlivost v˝stupu heat/cool) <0.0,0.5>*)
    typ              : usint :=  ICL_TPW_TYPE_HEATING_COOLING;  (*`{ENG} time program type : ICL_TPW_TYPE_HEATING, ICL_TPW_TYPE_COOLING, ICL_TPW_TYPE_HEATING_COOLING {CSY} typ ËasovÈho programu : ICL_TPW_TYPE_HEATING, ICL_TPW_TYPE_COOLING, ICL_TPW_TYPE_HEATING_COOLING*)
    numTimes         : usint;  (*`{ENG} number of time marks during the day {CSY} poËet Ëasov˝ch znaËek za den (min 2, max 7)*)
    webNextProg      : bool R_EDGE;  (*`{ENG} web control auto<->manual           {CSY} zmÏna auto<->manual*)
    webNextMode      : bool R_EDGE;  (*`{ENG} web control ECO->NIGHT->COMFORT     {CSY} zmÏna v manu·lnÌm mÛdu ECO->⁄TLUM->KOMFORT*)
    webIncDelta      : bool R_EDGE;  (*`{ENG} web control increase setpoint       {CSY} zv˝öit cÌlovou teplotu*)
    webDecDelta      : bool R_EDGE;  (*`{ENG} web control decrease setpoint       {CSY} snÌûit cÌlovou teplotu*)
    name             : string [48];  (*`{ENG} name of time program                {CSY} n·zev ËasovÈho programu*)
  END_VAR
  VAR_IN_OUT
    TimeProg_Settings : T_TIME_PROG_WEEK_INTERFACE;  (*`{ENG} block state                         {CSY} stav a ¯ÌzenÌ bloku*)
  END_VAR
  VAR_OUTPUT
    heat             : bool;  (*`{ENG} heating requirement                 {CSY} poûadavek na topeni*)
    cool             : bool;  (*`{ENG} cooling requirement                 {CSY} poûadavek na chlazeni*)
    heatTemp         : real;  (*`{ENG} requested temperature of heating    {CSY} poûadovan· teplota topenÌ*)
    coolTemp         : real;  (*`{ENG} requested temperature of cooling    {CSY} poûadovan· teplota chlazenÌ*)
    webStatus        : T_TIME_PROG_WEEK_STAT;  (*`{ENG} state of control                    {CSY} stav ¯ÌzenÌ*)
    busy             : bool;  (*`{ENG} block is busy with json file        {CSY} blok zpracov·v· json soubor*)
    lastErr          : string [80];  (*`{ENG} last error description              {CSY} popis p¯ÌpadnÈ chyby*)
    jsonFile         : string [12];  (*`{ENG} name of json file with description of time program  {CSY} jmÈno json souboru s popisem ËasovÈho programu*)
    timeProgWeekData {OPEN_UP} {TRACK_ADR} : T_TIME_PROG_WEEK;  (*`{ENG} the weekly time program             {CSY} t˝dennÌ Ëasov˝ program*)
  END_VAR
  VAR
    TimeProgBasic    : fb_TimeProgWeek_Basic;
    TimeProgControl  : fb_TimeProgWeek_Control;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_iFan
(*`{CSY} Ovl·d·nÌ ventil·toru
   {ENU} Fan control*)
  VAR_INPUT
    fanOn            : bool R_EDGE;  (*`{ENG} turn on the fan {CSY} zapnutÌ ventil·toru*)
    levelUp          : bool R_EDGE;  (*`{ENG} raise the level {CSY} zv˝öit ˙roveÚ*)
    fanOff           : bool R_EDGE;  (*`{ENG} turn off the fan {CSY} vypnutÌ ventil·toru*)
    levelDw          : bool R_EDGE;  (*`{ENG} reduce the level {CSY} snÌûit ˙roveÚ*)
    fanToggle        : bool R_EDGE;  (*`{ENG} toggle the fan {CSY} p¯epnutÌ ventil·toru*)
    webToggle        : bool R_EDGE;  (*`{ENG} toggle the fan from web page {CSY} p¯epnutÌ ventil·toru z web str·nky*)
    setRamp          : time :=  T#8s;  (*`{ENG} ramp Up/Dw from min level to 100%  [sec] {CSY} rampa Up/Dw z 0 na 100% [sec]*)
    offOnRamp        : time :=  T#5s;  (*`{ENG} ramp Off/On from min level to 100% [sec] {CSY} rampa Off/On z 0 na 100% [sec]*)
    timeLimit        : time;  (*`{ENG} maximum time limit fan [sec]  {CSY} omezenÌ max. doby zapnuti (automaticky vypne) [sec]*)
    step             : real :=  20.0;  (*`{ENG} change value {CSY} hodnota zmÏny*)
    name {PUBLIC_IFOX=GTSAP1_FAN_name} : string [48];  (*`{ENG} name  {CSY} n·zev*)
  END_VAR
  VAR_IN_OUT
    setLevel         : real;  (*`{ENG} the last set level (place the variable in the VAR_GLOBAL RETAIN) {CSY} poslednÌ nastaven· ˙roveÚ (promÏnnou umÌstit do VAR_GLOBAL RETAIN)*)
  END_VAR
  VAR_OUTPUT
    out              : bool;  (*`{ENG} indication Off/On      {CSY} signalizace On/Off*)
    level            : real;  (*`{ENG} level 0..100[%]        {CSY} ˙roveo 0..100[%]*)
    fbPtr            : udint;  (*`{ENG} function block pointer {CSY} pointer na funcnÌ blok*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_FAN_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
    needAck {PUBLIC_IFOX=GTSAP1_FAN_needAck} : bool;  (*`{ENG} Require confirmation for status changes from user applications  {CSY} Vyûadovat potvrzenÌ pro zmÏnu stavu z uûivatelsk˝ch aplikacÌ*)
  END_VAR
  VAR
    GTSAP1_FAN_onoff {ALIGNED} {OPEN_UP} {PUBLIC_IFOX} : bool;  (*`{ENG}          {CSY}*)
    GTSAP1_FAN_level {OPEN_UP} {PUBLIC_IFOX} : real;  (*`{ENG}          {CSY}*)
    gtsap1_old       : real;  (*`pro vyhodnoceni zmeny od mobilni aplikace*)
    oldSetLevel      : real;  (*`pro vyhodnoceni zmeny retain promenne*)
    toggleOn         : bool;  (*`pomocna pro zapnuti*)
    toggleOff        : bool;  (*`pomocna pro vypnuti*)
    lastSL52         : udint;
    tim              : TON;  (*`casovac pro omezeni doby osvetleni*)
    levelChange      : usint;  (*`pomocna pro zmenu*)
  END_VAR
END_FUNCTION_BLOCK

