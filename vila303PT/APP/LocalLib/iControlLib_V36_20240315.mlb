 GTS
 LDY  dTime
#debug time dTime
 LDX  timeOfAction1
#debug time timeOfAction1
 LTS
 NEG
 AND
 LDY  dTime
#debug time dTime
 LDX  timeOfAction1
#debug time timeOfAction1
