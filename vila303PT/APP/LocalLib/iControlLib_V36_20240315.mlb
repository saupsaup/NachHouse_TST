    GTSAP1_DISPLAY_unit {PUBLIC_IFOX} : string [8] :=  'lx';  (*`{ENG} Measurement unit (%,bar,C/F ...)               {CSY} Jednotka merenÌ (%,bar,C/F ...)*)
