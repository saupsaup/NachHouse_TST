#debug time setRamp
 ILF
 LD   real 1000.
 DIF
 WRY  cfgRamp
#debug_left real cfgRamp
#srcline 150 ;    END_IF;
fb_iDimmerWWCW_L29:
#srcline 151 ;    IF out THEN
