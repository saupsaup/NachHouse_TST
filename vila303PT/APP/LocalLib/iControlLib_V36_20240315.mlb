    symbol {PUBLIC_IFOX=GTSAP1_DISPLAY_symbol} : uint;  (*`{ENG} icon in iFoxtrot App (APP_ICON_socket, ..) {CSY} ikona pro aplikace iFoxtrot (APP_ICON_socket, ...)*)
