#debug real setLight.balance
 LDY  tmpLevel
#debug real tmpLevel
 MUF
 WRX  coldWhite
#debug_left real coldWhite
#srcline 156 ;      difWarm    := ABS(levelWarmWhite - warmWhite);        // rozdil proti minulemu stavu
 LDX  levelWarmWhite
#debug real levelWarmWhite
 LDX  warmWhite
#debug real warmWhite
 SUF
 ABS
 WRY  difWarm
#debug_left real difWarm
#srcline 157 ;      difCold    := ABS(levelColdWhite - coldWhite);
 LDX  levelColdWhite
