__DECL FUNCTION_BLOCK fb_iDisplay_Edit
(*`{ENG} Function block for display and edit REAL value in mobile application iFoxtrot
   {CSY} FunkËnÌ blok pro zobrazenÌ a editaci REAL hodnoty v aplikaci iFoxtrot*)
  VAR_INPUT
    unit {PUBLIC_IFOX=GTSAP1_DISPLAY_unit} : string [8];  (*`{ENG} units (kWh, km/h, ...)                                 {CSY} jednotky (kWh, km/h, ...)*)
    precision {PUBLIC_IFOX=GTSAP1_DISPLAY_precision} : int;  (*`{ENG} size of fraction part                                  {CSY} poËet zobrazen˝ch desetinn˝ch mÌst (0 = celÈ ËÌslo)*)
    limitUp          : real;  (*`{ENG} Upper limit of 'Value'                                 {CSY} hornÌ limit pro zmÏny 'value'*)
    limitDw          : real;  (*`{ENG} Lower limit of 'Value'                                 {CSY} dolnÌ limit pro zmÏny 'value'*)
    STEP             : real :=  0.1;  (*`{ENG} Value of one step increment or decrement from iFoxtrot {CSY} minim·lnÌ hodnota zmÏny z app iFoxtrot*)
    webUp            : bool R_EDGE;  (*`{ENG} inc value from web interface                           {CSY} zv˝öit hodnotu z web rozhranÌ*)
    webDw            : bool R_EDGE;  (*`{ENG} dec value from web interface                           {CSY} snÌûit hodnotu z web rozhranÌ*)
    link {PUBLIC_IFOX=GTSAP1_DISPLAY_url} : string [80];  (*`{ENG} URL address of web page                                {CSY} URL adresa web str·nky*)
    symbol {PUBLIC_IFOX=GTSAP1_DISPLAY_symbol} : uint;  (*`{ENG} icon in iFoxtrot App (APP_ICON_socket, ..)             {CSY} ikona pro aplikaci iFoxtrot (APP_ICON_socket, ...)*)
    name {PUBLIC_IFOX=GTSAP1_DISPLAY_name} : string [48];  (*`{ENG} name                                                   {CSY} n·zev*)
  END_VAR
  VAR_IN_OUT
    value            : real;  (*`{ENG} value (REAL variable)                                  {CSY} hodnota (REAL promÏnn·)*)
  END_VAR
  VAR_OUTPUT
    out              : real;  (*`{ENG} copy of 'Value'                                        {CSY} kopie 'Value'*)
  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_DISPLAY_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
  END_VAR
  VAR
    GTSAP1_DISPLAY_edit {ALIGNED} {PUBLIC_IFOX} : bool :=  1;  (*`{ENG} Indication of editable value or not                 {CSY} promÏnnou lze editovat*)
    GTSAP1_DISPLAY_type {PUBLIC_IFOX} : usint :=  ICL_DISPLAY_TYPE_REAL;  (*`{ENG} Display type (1= real value)                        {CSY} typ hodnoty (1= real value)*)
    GTSAP1_DISPLAY_value {PUBLIC_IFOX} : real;  (*`{ENG} Value to display                                    {CSY} hodnota k zobrazenÌ*)
    GTSAP1_DISPLAY_incValue {PUBLIC_IFOX} : bool;  (*`{ENG} Command from App iFoxtrot to increase desired value {CSY} Povel z App iFoxtrot ke zv˝öenÌ poûadovanÈ hodnoty*)
    GTSAP1_DISPLAY_decValue {PUBLIC_IFOX} : bool;  (*`{ENG} Command from App iFoxtrot to decrease desired value {CSY} Povel z App iFoxtrot ke snÌûenÌ poûadovanÈ hodnoty*)
    GTSAP1_DISPLAY_valueSet {OPEN_UP} {PUBLIC_IFOX} : real :=  1E38;  (*`tuhle promennou zapise iFoxtrot do JSON souboru kdyz je fb_iDisplay_Val_edit zarazen do sceny*)
  END_VAR
END_FUNCTION_BLOCK

