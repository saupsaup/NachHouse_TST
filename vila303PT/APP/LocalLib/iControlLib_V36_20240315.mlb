  END_VAR
  VAR RETAIN
    enable {PUBLIC_IFOX=GTSAP1_DISPLAY_enable} : bool :=  TRUE;  (*`{ENG} enable block         {CSY} povolenÌ bloku*)
  END_VAR
  VAR
    GTSAP1_DISPLAY_edit {ALIGNED} {PUBLIC_IFOX} : bool :=  0;  (*`{ENG} Indication of editable value or not            {CSY} promenou je mozno editovat v aplikaci*)
    GTSAP1_DISPLAY_alarm {PUBLIC_IFOX} : bool;  (*`{ENG} value > max value                              {CSY} value > max value*)
    GTSAP1_DISPLAY_type {PUBLIC_IFOX} : usint :=  ICL_DISPLAY_TYPE_REAL;  (*`{ENG} Display type (0=onOff, 1=real value)           {CSY} typ zobrazovane hodnoty (0=onOff, 1=real value)*)
    GTSAP1_DISPLAY_symbol {PUBLIC_IFOX} : uint :=  APP_SYMBOL_CO;  (*`{ENG} Symbol in iFoxtrot App (APP_SYMBOL_..)         {CSY} symbol v iFoxtrot App (APP_SYMBOL_..)*)
    GTSAP1_DISPLAY_value {PUBLIC_IFOX} : real;  (*`{ENG} Value to display                               {CSY} hodnota k zobrazeni*)
    GTSAP1_DISPLAY_unit {PUBLIC_IFOX} : string [8] :=  'ppm';  (*`{ENG} Measurement unit (%,bar,C/F ...)               {CSY} Jednotka merenÌ (%,bar,C/F ...)*)
    GTSAP1_DISPLAY_precision {PUBLIC_IFOX} : int :=  0;  (*`{ENG} Precision of fraction part of Value            {CSY} presnost desetinnou c·st hodnoty*)
    GTSAP1_DISPLAY_maxValue {PUBLIC_IFOX} : real;  (*`{ENG} max enabled level                              {CSY} max povolen· hodnota*)
    lastVal          : real;
  END_VAR
END_FUNCTION_BLOCK

