    rqSendMsg        : bool;  (*`zadost o odeslani zpravy na server*)
    lenSend          : uint;  (*`delka odesilane zpravy*)
    wsUrl            : string [32];
    isRecv           : bool;  (*`prisla zprava od serveru*)
    lenRecv          : uint;  (*`delka prijate zpravy*)
