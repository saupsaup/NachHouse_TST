VAR_GLOBAL CONSTANT
 SHELLYLIB_WS_TX_BUFFER_LEN_MAX : uint := 255;
 SHELLYLIB_WS_RX_BUFFER_LEN_MAX : uint := 1500;
 SHELLYLIB_WS_URL : string [5] := 'ws://';  (*`';*)
 SHELLYLIB_WS_RPC : string [4] := '/rpc';
 SHELLYLIB_WS_ID : string [6] := '{"id":';
 SHELLYLIB_WS_SRC : string [9] := ', "src":"';
 SHELLYLIB_WS_METHOD : string [12] := '", "method":';
 SHELLYLIB_WS_METHOD_SHELLY_GET_STATUS : string [19] := '"Shelly.GetStatus"}';
 SHELLYLIB_WS_METHOD_SHELLY_GET_CONFIG : string [19] := '"Shelly.GetConfig"}';
 SHELLYLIB_WS_METHOD_SHELLY_GET_INFO : string [23] := '"Shelly.GetDeviceInfo"}';
 SHELLYLIB_WS_METHOD_SHELLY_SWITCH_SET_ON : string [45] := '"Switch.Set", "params":{"id":0, "on":true}}';
 SHELLYLIB_WS_METHOD_SHELLY_SWITCH_SET_OFF : string [45] := '"Switch.Set", "params":{"id":0, "on":false}}';
 SHELLYLIB_WS_METHOD_SHELLY_SWITCH_TOGGLE : string [35] := '"Switch.Toggle", "params":{"id":0}}';
 SHELLYLIB_WS_LOG_NAME_BEG : string [12] := 'WEB_SOCKET_';

END_VAR

TYPE stShellyInfo :
  STRUCT
    updated          : dt;
    id               : uint;
    model            : string [25];
    gen              : uint;  (*`generation*)
    ver              : string [15];
    app              : string [15];
  END_STRUCT;
END_TYPE

TYPE stShellySystem :
  STRUCT
    mac              : string [15];
    restart_required : bool;
  END_STRUCT;
END_TYPE

TYPE stShellyTemperature :
  STRUCT
    tC               : real;
    tF               : real;
  END_STRUCT;
END_TYPE

TYPE stShellyWifi :
  STRUCT
    sta_ip           : string [18];
    status           : string [20];
    ssid             : string [30];
    rssi             : int;
  END_STRUCT;
END_TYPE

TYPE stShellyCloud :
  STRUCT
    connected        : bool;
  END_STRUCT;
END_TYPE

TYPE stShellyMQTT :
  STRUCT
    connected        : bool;
  END_STRUCT;
END_TYPE

TYPE stShellyWS :
  STRUCT
    connected        : bool;
  END_STRUCT;
END_TYPE

TYPE stShellyAddOnPlusDIState :
  STRUCT
    enab             : bool;
    stat             : bool;
  END_STRUCT;
END_TYPE

TYPE stShellyAddOnPlusAIState :
  STRUCT
    enab             : bool;
    err              : bool;
    errDesc          : string [30];
    percent          : real;
  END_STRUCT;
END_TYPE

TYPE stShellyAddOnPlusTempState :
  STRUCT
    enab             : bool;
    err              : bool;
    errDesc          : string [30];
    tC               : real;
    tF               : real;
  END_STRUCT;
END_TYPE

TYPE stShellyAddOnPlusHumState :
  STRUCT
    enab             : bool;
    err              : bool;
    errDesc          : string [30];
    rh               : real;
  END_STRUCT;
END_TYPE

TYPE stShellyAddOnPlus :
  STRUCT
    conn             : bool;
    input_101        : stShellyAddOnPlusDIState;
    input_100        : stShellyAddOnPlusAIState;
    hum_100          : stShellyAddOnPlusHumState;
    temp_100         : stShellyAddOnPlusTempState;
    temp_101         : stShellyAddOnPlusTempState;
    temp_102         : stShellyAddOnPlusTempState;
    temp_103         : stShellyAddOnPlusTempState;
    temp_104         : stShellyAddOnPlusTempState;
  END_STRUCT;
END_TYPE

__DECL FUNCTION SHELLYLIB_GetPlcName {HIDDEN} : string [32]
END_FUNCTION

TYPE stShellyPlus1Input :
  STRUCT
    state            : bool;
  END_STRUCT;
END_TYPE

TYPE stShellyPlus1Switch :
  STRUCT
    source           : string [80];
    output           : bool;
    temperature      : stShellyTemperature;
  END_STRUCT;
END_TYPE

TYPE stShellyPlus1Status :
  STRUCT
    updated          : dt;
    cloud            : stShellyCloud;
    input_0          : stShellyPlus1Input;
    mqtt             : stShellyMQTT;
    switch_0         : stShellyPlus1Switch;
    _sys             : stShellySystem;
    _wifi            : stShellyWifi;
    ws               : stShellyWS;
  END_STRUCT;
END_TYPE

TYPE stShellyPlus1 :
  STRUCT
    info             : stShellyInfo;
    status           : stShellyPlus1Status;
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK fbShellyPlus1
(*`{ENG} The function block allows control of one Shelly Plus 1 switching module via wifi over a web socket protocol. This module supports the external Plus Addon module.
 {CSY} Funkиnн blok umoћтuje ovlбdбnн jednoho spнnacнho modulu Shelly Plus 1 prostшednictvнm wifi pшes web socket protokol. Tento modul podporuje externн modul Plus Addon.*)
  VAR_INPUT
    enabled          : bool :=  TRUE;  (*`{ENG} Enabling the module {CSY} Povolenн modulu*)
    wsIp             : string [15];  (*`{ENG} IP address of the module {CSY} IP adresa modulu*)
    out0Val          : bool;  (*`{ENG} Relay state setting command {CSY} Pшнkaz k nastavenн stavu relй*)
    out0Set          : bool R_EDGE;  (*`{ENG} Request to set output state according to out1 {CSY} Ћбdost o nastavenн stavu vэstupu podle out1*)
    out0Toggle       : bool R_EDGE;  (*`{ENG} Request to toggle output {CSY} Ћбdost o prepnutн vэstupu*)
    readInfoRq       : bool R_EDGE;  (*`{ENG} Request to read basic module information {CSY} Ћбdost o pшeиtenн zбkladnнch informacн o modulu*)
    logSize          : usint :=  0;  (*`{ENG} Set the log file size and the logging startup command after program start. If the value is zero, logging is not active. {CSY} Nastaveni rozmмru logovacнho souboru a pшнkaz spouљtмni logovanн po startu programu. Pokud hodnota nula, logovanн nenн aktive.*)
  END_VAR
  VAR_OUTPUT
    in0              : bool;  (*`{ENG} State of input IN0  {CSY} Stav vstupu IN0*)
    in0Up            : bool;  (*`{ENG} Button on input IN0 released  {CSY} Tlacнtko na vstupu IN0 uvolneno*)
    in0Dw            : bool;  (*`{ENG} Button on input IN0 pressed  {CSY} Stisknutй tlacнtko na vstupu IN0*)
    in0Click         : bool;  (*`{ENG} Single push event of button on input IN0  {CSY} Jednotlivй stisknutн tlacнtka na vstupu IN0*)
    in0Press         : bool;  (*`{ENG} Long press event of button on input IN0  {CSY} Udбlost dlouhйho stisku tlacнtka na vstupu IN0*)
    in0Double        : bool;  (*`{ENG} Double press event of button on input IN0 {CSY} Udбlost dvojitйho stisku tlacнtka na vstupu IN0*)
    in0triple        : bool;  (*`{ENG} Triple press event of button on input IN0 {CSY} Udбlost trojнho stisknutн tlacнtka na vstupu IN0*)
    out0             : bool;  (*`{ENG} State of output OUT0  {CSY} Stav vystupu OUT0*)
    state            : stShellyPlus1;  (*`{ENG} Basic information   about the module  {CSY} Zбkladnн informace o modulu*)
    stateAddOn       : stShellyAddOnPlus;  (*`{ENG} Basic information of the Plus AddOn expansion module {CSY} Zбkladnн informace rozљiшovacнho modulu Plus AddOn*)
    conn             : bool;  (*`{ENG} Connection status with module over WiFi  {CSY} Stav spojenн s modulem pшes WiFi*)
    busy             : bool;  (*`{ENG} Operation pending   {CSY} Operace probнha*)
    err              : bool;  (*`{ENG} Communication error {CSY} Chyba komunikace*)
    errId            : udint;  (*`{ENG} Error number 1- Not Connected*)
    errTxt           : string [80];  (*`{ENG} Error description  {CSY} Popis chyby*)
  END_VAR
  VAR CONSTANT
    SHELLYLIB_WS_DEVICE_NAME : string [80] :=  'Plus1';
  END_VAR
  VAR
    WebSocket        : fbWebSocketClient;
    JsonParserEx     : fbJsonParserEx;
    JsonInfo         : TJsonInfo;
    renewConnTimerRq : bool;
    renewConnTimer   : TON;
    renewConnRetryCnt : uint;
    renewConnTime    : time :=  T#5s;
    rqWebSocket      : bool :=  TRUE;
    msgId            : uint;
    rqSendMsg        : bool;  (*`zadost o odeslani zpravy na server*)
    lenSend          : uint;  (*`delka odesilane zpravy*)
    wsUrl            : string [32];
    isRecv           : bool;  (*`prisla zprava od serveru*)
    lenRecv          : uint;  (*`delka prijate zpravy*)
    sendMes          : ARRAY [1..255] OF usint;  (*`send buffer*)
    recvMes          : ARRAY [1..1500] OF usint;  (*`recv buffer*)
    synchRq          : bool;
    statusRq         : bool;
    dataLength       : uint;
    temp_data_length : uint;
    powerUp          : bool;
    strData          : string [255];
    pData            : PTR_TO usint;
    rqSendMsgShellyGetStatus : bool;
    rqSendMsgShellyGetInfo : bool;
    rqSendMsgShellySetOutput : bool;
    rqSendMsgShellyOutputToggle : bool;
    restReadTimeOut  : TON;
    waitResponceRq   : bool;
    out0Last         : bool;
    logFileName      : string [32];
    user             : string [32];
    eventComponent   : string [30];
    getStatusTON     : TON;
    getStatusTime    : time :=  T#30s;
    getStatusReset   : bool;
    getPollStatusRq  : bool;
  END_VAR
END_FUNCTION_BLOCK

