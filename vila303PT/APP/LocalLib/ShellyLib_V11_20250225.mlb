__DECL FUNCTION_BLOCK fbShellyPlus1PM
(*`{ENG} The function block allows control of one Shelly Plus 1PM switching module via wifi over web socket protocol. This module supports the external Plus Addon module.
 {CSY} Funkиnн blok umoћтuje ovlбdбnн jednoho spнnacнho modulu Shelly Plus 1PM prostшednictvнm wifi pшes web soket protokol. Tento modul podporuje externн modul Plus Addon.*)
  VAR_INPUT
    enabled          : bool :=  TRUE;  (*`{ENG} Enabling the module {CSY} Povolenн modulu*)
    wsIp             : string [15];  (*`{ENG} IP address of the module {CSY} IP adresa modulu*)
    out0Val          : bool;  (*`{ENG} Relay state setting command {CSY} Pшнkaz k nastavenн stavu relй*)
    out0Set          : bool R_EDGE;  (*`{ENG} Request to set output state according to out1 {CSY} Ћбdost o nastavenн stavu vэstupu podle out1*)
    out0Toggle       : bool R_EDGE;  (*`{ENG} Request to toggle output {CSY} Ћбdost o prepnutн vэstupu*)
    readInfoRq       : bool R_EDGE;  (*`{ENG} Request to read basic module information {CSY} Ћбdost o pшeиtenн zбkladnнch informacн o modulu*)
    logSize          : usint :=  0;  (*`{ENG} Set the log file size and the logging startup command after program start. If the value is zero, logging is not active. {CSY} Nastaveni rozmмru logovacнho souboru a pшнkaz spouљtмni logovanн po startu programu. Pokud hodnota nula, logovanн nenн aktive.*)
  END_VAR
  VAR_OUTPUT
    in0              : bool;  (*`{ENG} State of input IN0  {CSY} Stav vstupu IN0*)
    in0Up            : bool;  (*`{ENG} Button on input IN0 released  {CSY} Tlacнtko na vstupu IN0 uvolneno*)
    in0Dw            : bool;  (*`{ENG} Button on input IN0 pressed  {CSY} Stisknutй tlacнtko na vstupu IN0*)
    in0Click         : bool;  (*`{ENG} Single push event of button on input IN0  {CSY} Jednotlivй stisknutн tlacнtka na vstupu IN0*)
    in0Press         : bool;  (*`{ENG} Long press event of button on input IN0  {CSY} Udбlost dlouhйho stisku tlacнtka na vstupu IN0*)
    in0Double        : bool;  (*`{ENG} Double press event of button on input IN0 {CSY} Udбlost dvojitйho stisku tlacнtka na vstupu IN0*)
    in0triple        : bool;  (*`{ENG} Triple press event of button on input IN0 {CSY} Udбlost trojнho stisknutн tlacнtka na vstupu IN0*)
    out0             : bool;  (*`{ENG} State of output OUT0  {CSY} Stav vystupu OUT0*)
    state            : stShellyPlus1PM;  (*`{ENG} Basic information   about the module  {CSY} Zбkladnн informace o modulu*)
    stateAddOn       : stShellyAddOnPlus;  (*`{ENG} Basic information of the Plus AddOn expansion module {CSY} Zбkladnн informace rozљiшovacнho modulu Plus AddOn*)
    conn             : bool;  (*`{ENG} Connection status with module over WiFi  {CSY} Stav spojenн s modulem pшes WiFi*)
    busy             : bool;  (*`{ENG} Operation pending   {CSY} Operace probнha*)
    err              : bool;  (*`{ENG} Communication error {CSY} Chyba komunikace*)
