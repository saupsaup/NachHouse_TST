  END_VAR
  VAR
    WebSocket        : fbWebSocketClient;
    JsonParserEx     : fbJsonParserEx;
    JsonInfo         : TJsonInfo;
    renewConnTimerRq : bool;
    renewConnTimer   : TON;
    renewConnRetryCnt : uint;
