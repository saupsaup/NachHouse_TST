__DECL FUNCTION_BLOCK fbShellyPlusI4
(*`{ENG} The function block allows control of one Shelly I4 input module via wifi over a web socket protocol. This module supports the external Plus Addon module.
 {CSY} Funkиnн blok umoћтuje ovlбdбnн jednoho vstupnнho modulu Shelly I4 prostшednictvнm wifi pшes web soket protokol. Tento modul podporuje externн modul Plus Addon.*)
  VAR_INPUT
    enabled          : bool :=  TRUE;  (*`{ENG} Enabling the module {CSY} Povolenн modulu*)
    wsIp             : string [15];  (*`{ENG} IP address of the module {CSY} IP adresa modulu*)
    readInfoRq       : bool R_EDGE;  (*`{ENG} Request to read basic module information {CSY} Ћбdost o pшeиtenн zбkladnнch informacн o modulu*)
    logSize          : usint :=  0;  (*`{ENG} Set the log file size and the logging startup command after program start. If the value is zero, logging is not active. {CSY} Nastaveni rozmмru logovacнho souboru a pшнkaz spouљtмni logovanн po startu programu. Pokud hodnota nula, logovanн nenн aktive.*)
  END_VAR
  VAR_OUTPUT
    in0              : bool;  (*`{ENG} State of input IN0  {CSY} Stav vstupu IN0*)
    in0Up            : bool;  (*`{ENG} Button on input IN0 released  {CSY} Tlacнtko na vstupu IN0 uvolneno*)
    in0Dw            : bool;  (*`{ENG} Button on input IN0 pressed  {CSY} Stisknutй tlacнtko na vstupu IN0*)
    in0Click         : bool;  (*`{ENG} Single push event of button on input IN0  {CSY} Jednotlivй stisknutн tlacнtka na vstupu IN0*)
    in0Press         : bool;  (*`{ENG} Long press event of button on input IN0  {CSY} Udбlost dlouhйho stisku tlacнtka na vstupu IN0*)
    in0Double        : bool;  (*`{ENG} Double press event of button on input IN0 {CSY} Udбlost dvojitйho stisku tlacнtka na vstupu IN0*)
    in0triple        : bool;  (*`{ENG} Triple press event of button on input IN0 {CSY} Udбlost trojнho stisknutн tlacнtka na vstupu IN0*)
    in1              : bool;  (*`{ENG} State of input IN1  {CSY} Stav vstupu IN1*)
    in1Up            : bool;  (*`{ENG} Button on input IN1 released  {CSY} Tlacнtko na vstupu IN1 uvolneno*)
    in1Dw            : bool;  (*`{ENG} Button on input IN1 pressed  {CSY} Stisknutй tlacнtko na vstupu IN1*)
    in1Click         : bool;  (*`{ENG} Single push event of button on input IN1  {CSY} Jednotlivй stisknutн tlacнtka na vstupu IN1*)
    in1Press         : bool;  (*`{ENG} Long press event of button on input IN1  {CSY} Udбlost dlouhйho stisku tlacнtka na vstupu IN1*)
    in1Double        : bool;  (*`{ENG} Double press event of button on input IN1 {CSY} Udбlost dvojitйho stisku tlacнtka na vstupu IN1*)
    in1triple        : bool;  (*`{ENG} Triple press event of button on input IN1 {CSY} Udбlost trojнho stisknutн tlacнtka na vstupu IN1*)
    in2              : bool;  (*`{ENG} State of input IN2  {CSY} Stav vstupu IN2*)
    in2Up            : bool;  (*`{ENG} Button on input IN2 released  {CSY} Tlacнtko na vstupu IN2 uvolneno*)
    in2Dw            : bool;  (*`{ENG} Button on input IN2 pressed  {CSY} Stisknutй tlacнtko na vstupu IN2*)
    in2Click         : bool;  (*`{ENG} Single push event of button on input IN2  {CSY} Jednotlivй stisknutн tlacнtka na vstupu IN2*)
    in2Press         : bool;  (*`{ENG} Long press event of button on input IN2  {CSY} Udбlost dlouhйho stisku tlacнtka na vstupu IN2*)
    in2Double        : bool;  (*`{ENG} Double press event of button on input IN2 {CSY} Udбlost dvojitйho stisku tlacнtka na vstupu IN2*)
    in2triple        : bool;  (*`{ENG} Triple press event of button on input IN2 {CSY} Udбlost trojнho stisknutн tlacнtka na vstupu IN2*)
    in3              : bool;  (*`{ENG} State of input IN3  {CSY} Stav vstupu IN3*)
    in3Up            : bool;  (*`{ENG} Button on input IN3 released  {CSY} Tlacнtko na vstupu IN3 uvolneno*)
    in3Dw            : bool;  (*`{ENG} Button on input IN3 pressed  {CSY} Stisknutй tlacнtko na vstupu IN3*)
    in3Click         : bool;  (*`{ENG} Single push event of button on input IN3  {CSY} Jednotlivй stisknutн tlacнtka na vstupu IN3*)
    in3Press         : bool;  (*`{ENG} Long press event of button on input IN3  {CSY} Udбlost dlouhйho stisku tlacнtka na vstupu IN3*)
    in3Double        : bool;  (*`{ENG} Double press event of button on input IN3 {CSY} Udбlost dvojitйho stisku tlacнtka na vstupu IN3*)
    in3triple        : bool;  (*`{ENG} Triple press event of button on input IN3 {CSY} Udбlost trojнho stisknutн tlacнtka na vstupu IN3*)
    state            : stShellyPlusI4;  (*`{ENG} Basic information about the module  {CSY} Zбkladnн informace o modulu*)
    stateAddOn       : stShellyAddOnPlus;  (*`{ENG} Basic information of the Plus AddOn expansion module {CSY} Zбkladnн informace rozљiшovacнho modulu Plus AddOn*)
