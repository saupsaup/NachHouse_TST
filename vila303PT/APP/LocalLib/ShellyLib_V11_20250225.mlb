    recvMes          : ARRAY [1..1500] OF usint;  (*`recv buffer*)
    synchRq          : bool;
    statusRq         : bool;
    dataLength       : uint;
    temp_data_length : uint;
    powerUp          : bool;
    strData          : string [255];
    pData            : PTR_TO usint;
    rqSendMsgShellyGetStatus : bool;
    rqSendMsgShellyGetInfo : bool;
    restReadTimeOut  : TON;
    waitResponceRq   : bool;
    logFileName      : string [32];
    user             : string [32];
    eventComponent   : string [30];
    getStatusTON     : TON;
