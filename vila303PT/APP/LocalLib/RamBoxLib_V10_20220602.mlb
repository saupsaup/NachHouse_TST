__DECL FUNCTION ReadBlockFromRBx : usint
(*`{ENU} Transfer of data block from RamBox memory to variable. Maximal block size is 255 bytes. Return value : number of transfered bytes.
   {CSY} Pøenos bloku pamìti z RamBoxu do promìnné. Maximální velikost bloku je 255 bytù. Funkce vrací poèet pøenesenıch bytù.*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} source address (RamBox)  {CSY} adresa zdroje (adresa v RamBoxu)*)
    length           : usint;  (*`{ENU} size of data block (number of bytes, max 255) {CSY} velikost pøenášeného bloku (poèet bytù, max 255)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} destination address (variable) {CSY} adresa cíle (promìnná)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteBlockToRBx : usint
(*`{ENU} Transfers of data block from variable to RamBox memory. Maximal block size is 255 bytes. Return value : number of transfered bytes.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pøenos bloku pamìti z promìnné do RamBoxu. Maximální velikost bloku je 255 bytù. Funkce vrací poèet pøenesenıch bytù.
         Upozornìní !!! promìnná nesmí bıt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (RamBox)  {CSY} adresa cíle (adresa v RamBoxu)*)
    length           : usint;  (*`{ENU} size of data block (number of bytes, max 255) {CSY} velikost pøenášeného bloku (poèet bytù, max 255)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} source address (variable) {CSY} adresa zdroje (promìnná)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION ReadFromRamBox : bool
(*`{ENU} Transfer of data block from RamBox memory to variable. Return value : TRUE if all data was transfered.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pøenos bloku pamìti z RamBoxu do promìnné. Funkce vrací TRUE, pokud byla všechna poadovaná data pøenesena.
         Upozornìní !!! promìnná nesmí bıt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} source address (RamBox)  {CSY} adresa zdroje (adresa v RamBoxu)*)
    length           : uint;  (*`{ENU} size of data block (number of bytes, max 10000)  {CSY} velikost pøenášeného bloku (poèet bytù, max 10000)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} destination address (variable) {CSY} adresa cíle (promìnná)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteToRamBox : bool
(*`{ENU} Transfer of data block from variable to RamBox memory. Return value : TRUE if all data was transfered.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pøenos bloku pamìti z promìnné do RamBoxu. Funkce vrací TRUE, pokud byla všechna poadovaná data pøenesena.
         Upozornìní !!! promìnná nesmí bıt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (RamBox)  {CSY} adresa cíle (adresa v RamBoxu)*)
    length           : uint;  (*`{ENU} size of data block (number of bytes, max 10000)  {CSY} velikost pøenášeného bloku (poèet bytù, max 10000)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} source address (variable) {CSY} adresa zdroje (promìnná)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION ReadFromRBx : bool
(*`{ENU} Transfer of data block from RamBox memory to variable. Return value is TRUE if all data was transferred.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pøenos bloku pamìti z RamBoxu do promìnné. Funkce vrací TRUE, pokud byla všechna poadovaná data pøenesena.
         Upozornìní !!! promìnná nesmí bıt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} source address (address in RamBox)  {CSY} adresa zdroje (adresa v RamBoxu)*)
    length           : udint;  (*`{ENU} size of data block (number of bytes)  {CSY} velikost pøenášeného bloku (poèet bytù)*)
    varAddress       : udint;  (*`{ENU} destination address (address of variable)  {CSY} adresa cíle (adresa promìnné)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteToRBx : bool
(*`{ENU} Transfers of data block from variable to RamBox memory. Return value is TRUE if all data was transferred.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pøenos bloku pamìti z promìnné do RamBoxu. Funkce vrací TRUE, pokud byla všechna poadovaná data pøenesena.
         Upozornìní !!! promìnná nesmí bıt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (address in RamBox)  {CSY} adresa cíle (adresa v RamBoxu)*)
    length           : udint;  (*`{ENU} size of data block (number of bytes)  {CSY} velikost pøenášeného bloku (poèet bytù)*)
    varAddress       : udint;  (*`{ENU} source address (address of variable)  {CSY} adresa zdroje (adresa promìnné)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION SetValueToRamBox : bool
(*`{ENU} Sets constant into data block in RamBox memory. Return value is TRUE if all data was written.
   {CSY} Zapíše konstantu do bloku pamìti v RamBoxu. Funkce vrací TRUE, pokud se vše podaøilo zapsat.*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (address in RamBox)  {CSY} adresa cíle (adresa v RamBoxu)*)
    length           : udint;  (*`{ENU} size of data block in RamBox (number of bytes)  {CSY} velikost bloku v RAMBoxu (poèet bytù)*)
    value            : udint;  (*`{ENU} written constant  {CSY} zapisovaná konstanta*)
  END_VAR
END_FUNCTION

__DECL FUNCTION SizeOfRamBox : uint
(*`{ENU} RamBox memory size identification. Return value : RamBox memory size [kilobytes].
   {CSY} Test aktuální velikost pamìti v RamBoxu. Funkce vrací velikost RamBoxu v kilobytech.*)
END_FUNCTION

__DECL FUNCTION ResizeRamBox : bool
(*`{ENU} Resize RamBox memory. When is succesfull returns TRUE.
   {CSY} Zmìna aktuální velikost pamìti v RamBoxu. Vrací TRUE pokud se zmìna podaøí.*)
  VAR_INPUT
    newSize          : uint;  (*`{ENU} new size of memory in RamBox [kilobytes] {CSY} nová velikost pamìti v RAMBoxu v kilobytech*)
  END_VAR
END_FUNCTION



