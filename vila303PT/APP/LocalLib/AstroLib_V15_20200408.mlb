__DECL FUNCTION DegreesToAngle : lreal
(*`{CSY} Pøevede stupnì/minuty/vteøiny na úhel v radiánech
  {ENU} Combine a degrees/minutes/seconds value to an angle in degrees*)
  VAR_INPUT
    degrees          : lreal;  (*`{CSY} Stupnì  {ENU} degrees*)
    minutes          : lreal;  (*`{CSY} Minuty  {ENU} minutes*)
    seconds          : lreal;  (*`{CSY} Vteøiny {ENU} seconds*)
  END_VAR
END_FUNCTION

__DECL FUNCTION AngleToDegrees : bool
(*`{CSY} Pøevede úhel v radiánech na stupnì/minuty/vteøiny
  {ENU} Combine an angle in degrees to a degrees/minutes/seconds*)
  VAR_INPUT
    angle            : lreal;  (*`{CSY} Úhel v radiánech {ENU} angle (radians)*)
  END_VAR
  VAR_IN_OUT
    degrees          : lreal;  (*`{CSY} Stupnì  {ENU} degrees*)
    minutes          : lreal;  (*`{CSY} Minuty  {ENU} minutes*)
    seconds          : lreal;  (*`{CSY} Vteøiny {ENU} seconds*)
  END_VAR
END_FUNCTION

__DECL FUNCTION SunTime : time
(*`{CSY}
  Výpoèet èasu východu a západu slunce
  Využívá algoritmus publikovaný v Almanac for Computers, 1990
  Nautical Almanac Office, United States Naval Observatory
  {ENU}
  Sunrise/Sunset Algorithm
  Implementation of algorithm found in Almanac for Computers, 1990
  published by Nautical Almanac Office, United States Naval Observatory*)
  VAR_INPUT
    direction        : SunDirection;  (*`{CSY} Východ (Sunrise) nebo západ slunce (Sunset) {ENU} Sunrise or Sunset*)
    zenith           : dint;  (*`{CSY} Zenith_Official (90° 50'), Zenith_Civil (96°), Zenith_Nautical (102°) or Zenith_Astronomical (108°) {ENU} Zenith_Official (90° 50'), Zenith_Civil (96°), Zenith_Nautical (102°) or Zenith_Astronomical (108°)*)
    longitude        : lreal;  (*`{CSY} Zemìpisná délka ve stupních {ENU} Global position longitude in degrees. Longitude is positive for East and negative for West.*)
    latitude         : lreal;  (*`{CSY} Zemìpisná šíøka ve stupních {ENU} Global position latitude in degrees. Latitude is positive for North and negative for South.*)
    utcOffset        : lreal;  (*`{CSY} Offset proti UTC èasu (v hodinách) {ENU} The local UTC offset (f.e. +1 for Prague, Brussel, Kopenhagen, Madrid, Paris).*)
    actDate          : date;  (*`{CSY} Datum {ENU} Actual date*)
  END_VAR
  VAR
    N                : dint;  (*`day*)
    lngHour          : lreal;
    apt              : lreal;  (*`appr. time*)
    M                : lreal;  (*`mean anomaly*)
    L                : lreal;  (*`true longitude*)
    RA               : lreal;  (*`right asc*)
    Lquadrant        : lreal;
    RAquadrant       : lreal;
    sinDec           : lreal;
    cosDec           : lreal;
    cosH             : lreal;  (*`local hour angle*)
    H                : lreal;  (*`local hour*)
    T                : lreal;  (*`time*)
    UT               : lreal;  (*`universal time*)
    result           : lreal;
  END_VAR
END_FUNCTION

__DECL FUNCTION UtcOffset_CR : lreal
(*`{CSY}
  Vrací posun èasu pro Èeskou republiku proti UTC [hod] (pro systémy Foxtrot 2 vrací UTC offset dle nastaveného èasového pásma)
  {ENU}
  Returns UTC offset for Czech Republic [hours] (for systems Foxtrot 2 returns UTC offset according to set time zone)*)
END_FUNCTION

