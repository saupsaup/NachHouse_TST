__DECL FUNCTION SunDeclination : lreal
(*`{CSY}
  Úhel sevøený spojnicí "zemì-slunce" a rovinou svìtového rovníku
  Nabývá hodnot od 0° do +90° smìrem od rovníku k severnímu svìtovému pólu,
  od 0° do -90° smìrem od rovníku k jižnímu svìtovému pólu.

  {ENU}
  The angle a line of "Earth-sun " and the plane of the celestial equator
  It takes values from 0 ° to +90 ° away from the equator to the North Pole World
  It takes values from 0 ° to -90 ° away from the equator to the South Pole World*)
  VAR_INPUT
    actDate          : date;  (*`{CSY} Datum {ENU} current date*)
  END_VAR
  VAR
    d                : lreal;
    M                : lreal;
    L                : lreal;
    b                : lreal;
  END_VAR
END_FUNCTION

__DECL FUNCTION SunHeightAboveHorizon : lreal
(*`{CSY}
  Úhel sevøený rovinou horizontu a smìrem "pozorovatel-slunce"
  Nabývá hodnot od 0° do 90° od obzoru k zenitu

  {ENU}
  The angle the plane of the horizon and the direction of "observer-sun "
  It takes values from 0 ° to 90 ° from horizon to zenith*)
  VAR_INPUT
    dateTime         : dt;  (*`{CSY} Datum a èas {ENU} current date and time*)
    latitude         : lreal;  (*`{CSY} Zemìpisná šíøka {ENU} latitude*)
    longitude        : lreal;  (*`{CSY} Zemìpisná výška {ENU} longitude*)
    utcOffset        : lreal;  (*`{CSY} Èasový posun proti UTC [hod] {ENU} UTC offset [hour]*)
  END_VAR
END_FUNCTION

__DECL FUNCTION SunAzimuth : lreal
(*`{CSY}
  Úhel sevøený smìrem "jih-sever" a prùmìtem smìru "pozorovatel-slunce" do roviny horizontu

  {ENU}
  The angle towards the South-North "and the projection of the direction of" observer-sun "in the plane of the horizon*)
  VAR_INPUT
    dateTime         : dt;  (*`{CSY} Datum a èas {ENU} current date and time*)
    latitude         : lreal;  (*`{CSY} Zemìpisná šíøka {ENU} latitude*)
    longitude        : lreal;  (*`{CSY} Zemìpisná výška {ENU} longitude*)
    utcOffset        : lreal;  (*`{CSY} Èasový posun proti UTC [hod] {ENU} UTC offset [hour]*)
  END_VAR
END_FUNCTION



