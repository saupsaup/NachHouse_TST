VAR_GLOBAL CONSTANT
 Zenith_Official : dint :=  90833;  (*`{CSY} Úøední soumrak (90° 50') {ENU} Official zenith (90° 50')*)
 Zenith_Civil : dint :=  96000;  (*`{CSY} Obèanský soumrak (96°) {ENU} Civil zenith (96°)*)
 Zenith_Nautical : dint :=  102000;  (*`{CSY} Nautický soumrak (102°) {ENU} Nautical zenith (102°)*)
