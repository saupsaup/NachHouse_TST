__DECL FUNCTION VarApiToJsonBuf : udint
(*`{ENU} Writes JSON with variables description into buffer in PLC memory. Returns number of written characters.
  {CSY} ZapÌöe JSON popisem promÏnn˝ch do bufferu v pamÏti PLC. Vr·tÌ poËet zapsan˝ch znak˘.*)
  VAR_IN_OUT
    varNames         : string [80];  (*`{CSY} jmÈna promÏnn˝ch oddÏlen· znakem &  {ENU} names of variables seoarated by &*)
    buffer           : usint;  (*`{CSY} jmÈno bufferu, kam bude uloûen JSON {ENU} name of buffer for json*)
  END_VAR
  VAR_INPUT
    maxBufLen        : udint;  (*`{CSY} velikost bufferu {ENU} buffer size*)
  END_VAR
END_FUNCTION

__DECL FUNCTION JsonBufToVarApi : udint
(*`{ENU} Sets values of variables according JSON buffer. Returns number of processed characters.
  {CSY} NastavÌ hodnoty promÏnn˝ch podle JSON bufferu. Vr·tÌ poËet zpracovan˝ch znak˘.*)
  VAR_IN_OUT
    buffer           : usint;  (*`{CSY} jmÈno bufferu, kde je uloûen JSON {ENU} name of json buffer*)
  END_VAR
  VAR_INPUT
    strict           : bool;  (*`{CSY} TRUE promÏnnÈ v JSON musÌ p¯esnÏ souhlasit s promÏnn˝mi v PLC, FALSE hodnoty promÏnn˝ch, kterÈ v PLC neexistujÌ, jsou ignorov·ny {ENU} TRUE means strictly mode*)
  END_VAR
END_FUNCTION

__DECL FUNCTION VarApiToJsonFile : udint
(*`{ENU} Writes JSON with variables description into file in PLC. Returns number of written characters.
  {CSY} ZapÌöe JSON popisem promÏnn˝ch do souboru. Vr·tÌ poËet zapsan˝ch znak˘ (velikost vytvo¯enÈho souboru).*)
  VAR_IN_OUT
    varNames         : string [80];  (*`{CSY} jmÈna promÏnn˝ch oddÏlen· znakem & {ENU} names of variables seoarated by &*)
    fileName         : string [80];  (*`{CSY} n·zev souboru, kam bude uloûen JSON (vËetnÏ cesty) {ENU} file name (including path)*)
  END_VAR
  VAR_INPUT
    formatted        : bool;  (*`{CSY} TRUE form·tovan˝ JSON, FALSE neform·tovan˝ JSON {ENU} TRUE means formatted json, FALSE is unformatted json*)
  END_VAR
END_FUNCTION

__DECL FUNCTION JsonFileToVarApi : udint
(*`{ENU} Sets values of variables according JSON file. Returns number of processed characters.
  {CSY} NastavÌ hodnoty promÏnn˝ch podle JSON souboru. Vr·tÌ poËet zpracovan˝ch znak˘.*)
  VAR_IN_OUT
    fileName         : string [80];  (*`{CSY} n·zev souboru, kde je uloûen JSON (vËetnÏ cesty) {ENU} file name (including path)*)
  END_VAR
  VAR_INPUT
    strict           : bool;  (*`{CSY} TRUE promÏnnÈ v JSON musÌ p¯esnÏ souhlasit s promÏnn˝mi v PLC, FALSE hodnoty promÏnn˝ch, kterÈ v PLC neexistujÌ, jsou ignorov·ny {ENU} TRUE means strictly mode*)
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fbJsonPageParser
(*`{ENU} Parsing of JSON document file from web site. Information about json element is saved into TjsonInfo structure.
  {CSY} Parsov·nÌ JSON dokumentu z web str·nky. Informace o vyparsovanÈ poloûce je uloûena do struktury TjsonInfo.*)
  VAR CONSTANT
    JSON_BUMPER      : uint :=  256;  (*`{ENU} bumper of json buffer                    {CSY} n·raznÌk v json bufferu*)
    JSON_BUFFER_SIZE : uint :=  768;  (*`{ENU} size of json buffer                      {CSY} velikost bufferu*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{ENU} request for parsing                      {CSY} parsovat json soubor*)
    chanCode         : uint;  (*`{ENU} channel code (ETH1_uni0, ETH1_uni1,...)  {CSY} komunikaËnÌ kan·l (ETH1_uni0, ETH1_uni1,...)*)
  END_VAR
  VAR_IN_OUT
    pageName         : string [255];  (*`{ENU} mame of web page with json file          {CSY} n·zev web str·nky s s json dokumentem*)
    JsonInfo         : TJsonInfo;  (*`{ENU} result of parsing                        {CSY} v˝sledek parsov·nÌ*)
  END_VAR
  VAR_OUTPUT
    start            : bool;  (*`{ENU} initialization flag                      {CSY} p¯Ìznak inicializace bloku*)
    done             : bool;  (*`{ENU} new item is ready in jsonItem            {CSY} v˝sledek parsov·nÌ je p¯ipraven v jsonInfo*)
    busy             : bool;  (*`{ENU} block is busy                            {CSY} blok je zanepr·zdnÏn*)
    eof              : bool;  (*`{ENU} end of file                              {CSY} konec souboru*)
    break            : bool;  (*`{ENU} buffer processed, continue next cycle    {CSY} buffer zpracov·n, pokraËovat p¯ÌötÌ cyklus*)
    err              : bool;  (*`{ENU} error flag                               {CSY} p¯Ìznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description                        {CSY} popis chyby*)
    fileSize         : udint;  (*`{ENU} size of file                             {CSY} velikost souboru*)
    processed        : udint;  (*`{ENU} processed                                {CSY} zpracov·no (poËet znak˘)*)
  END_VAR
  VAR
    rqShrink         : bool;
    rqFile           : bool;
    rqParse          : bool;
    rqStart          : bool;
    trgExecOn        : R_TRIG;
    JsonParser       : fbJsonParserEx;
    JsonBuffer       : ARRAY [0..768] OF usint;
    sumaLen          : udint;  (*`kolik nacteno ze souboru*)
    actLen           : udint;  (*`aktualni velikost json bufferu*)
    restLen          : uint;
    pos              : int;
    HttpIP           : TIPadr;
    HttpPort         : uint;
    HttpName         : string [80];
    Action           : string [255];
    Empty            : string [1];
    dnsRequest       : bool;
    SplitUrlAddress  : fbSplitUrlAddress;
    HttpRequest      : fbHttpRequest;
  END_VAR
  VAR CONSTANT
    HTTP_IP_NULL     : TIPadr :=  [0,0,0,0];
  END_VAR
END_FUNCTION_BLOCK

TYPE JSONLIB_T_VAR_DESC {HIDDEN} :
  STRUCT
    addr             : udint;
    size             : udint;
    typ              : usint;
    isArray          : bool;
  END_STRUCT;
END_TYPE

__DECL FUNCTION_BLOCK fbGetJsonAndSetVar
(*`{ENU} Reading of JSON file from web site and setting PLC variables according JSON.
  {CSY} NaËÌst JSON soubor z web serveru a nastavit podle nÏho promÏnnÈ v PLC.*)
  VAR_INPUT
    exec             : bool R_EDGE;  (*`{ENU} reading of JSON starts on rising edge of exec      {CSY} n·bÏûn· hrana spustÌ naËÌt·nÌ JSON*)
    logSizeKB        : usint;  (*`{ENU} size of log file, 0 = no log                       {CSY} velikost log souboru, 0 = vypnut˝ log*)
    pageUrl          : string [255];  (*`{ENU} url address of JSON                                {CSY} url adresa, odkud se naËte JSON*)
    varName          : string [80];  (*`{ENU} name of variable which value is set according JSON {CSY} jmÈno promÏnnÈ, jejÌû poloûky budou nastaveny podle JSON*)
    timeout          : time :=  T#2m;  (*`{ENU} timeout preset                                     {CSY} p¯edvolba timeoutu*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{ENU} all is done ok          {CSY} dokonËeno bez chyby*)
    busy             : bool;  (*`{ENU} block is busy           {CSY} blok je zanepr·zdnÏn*)
    err              : bool;  (*`{ENU} error flag              {CSY} p¯Ìznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description       {CSY} popis chyby*)
    numVar           : uint;  (*`{ENU} number of set variables {CSY} poËet promÏnn˝ch nastaven˝ch podle json*)
  END_VAR
  VAR
    JsonParser       : fbJsonPageParser;  (*`FB pro parsovani odpovedi na API dotaz*)
    json             : TJsonInfo;  (*`struktura pro vysledky parsovani*)
    rqGet            : bool;  (*`vyslat GET*)
    parseEnable      : bool;  (*`pomocna pro parsovani*)
    chanHandle       : uint;  (*`handle kanalu*)
    timTimeout       : TON;  (*`casovac pro hlidani timeoutu*)
    varDesc          : JSONLIB_T_VAR_DESC;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbJsonPageParser2HttpRequest {HIDDEN}
(*`{ENU}Sends POST, PUT and GET metods via HTTP with option to set content type (Content-Type)
{CSY}VysÌl· metody GET, POST a PUT pres HTTP protokol s moûnostÌ definice typu obsahu (Content-Type)*)
  VAR_INPUT
    Post             : bool R_EDGE;  (*`{ENG}Send data via method POST {CSY}vyslat data metodou POST*)
    Put              : bool R_EDGE;  (*`{ENG}Send data via method PUT {CSY}vyslat data metodou PUT*)
    Get              : bool R_EDGE;  (*`{ENG}Get data via method GET {CSY}zÌskat data metodu GET*)
    Cancel           : bool R_EDGE;  (*`{ENG}Cancel pending operation {CSY}zruöit probÌhajÌcÌ operaci*)
    chanCode         : uint;  (*`{ENG}UNI channel {CSY}prenosov˝ kan·l {}TCP master in: 512, out: 512*)
    IPadr            : TIPadr;  (*`{ENG}IP address of remote server {CSY}IP adresa vzd·leneho serveru*)
    port             : uint :=  80;  (*`{ENG}Port of remote server {CSY}CÌslo portu vzd·lenÈho serveru*)
    bodyLen          : uint;  (*`{ENG}Lenght of data{CSY}DÈlka dat*)
    Close            : bool;  (*`{ENG}If set, block don't wait for server to close connection and close it actively after receiving all data{CSY}Pokud je nastaveno, blok necek· na server aû zavre spojenÌ a zavre jej aktivne jakmile zÌsk· vöechny data*)
  END_VAR
  VAR_IN_OUT
    Action           : string [255];  (*`{ENG}Path to the data on the server (always starts with character '/') {CSY}Cesta k datum na serveru (vûdy zacÌn· znakem '/')*)
    Host             : string [80];  (*`{ENG}Host name {CSY}JmÈno hostitele*)
    Data             : THttpPostData;  (*`{ENG}First byte of data to POST/PUT {CSY}PrvnÌ byte dat pro metodu POST/PUT*)
    ContentType      : string [80];  (*`{ENG}Content-Type {CSY}Typ obsahu (Content-Type)*)
    RecvData         : THttpBuffer;  (*`{ENG}Data buffer 512 bytes {CSY}Bufer dat 512 bytu*)
  END_VAR
  VAR_OUTPUT
    Done             : bool;  (*`{ENG}Operation done {CSY}Operace ukoncena*)
    Busy             : bool;  (*`{ENG}Operation pending {CSY}Operace probÌh·*)
    Err              : bool;  (*`{ENG}Communication error {CSY}Chyba komunikace*)
    ErrId            : usint;  (*`{ENG}Error number {CSY}CÌslo chyby*)
    DataReady        : bool;  (*`{ENG}New data received {CSY}Prijata nov· data*)
    DataLen          : uint;  (*`{ENG}Data length {CSY}DÈlka dat*)
    State            : THttpState;  (*`{ENG}State of communication {CSY}Stav komunikace*)
    Result           : int;  (*`{ENG}HTTP Code {CSY}HTTP kod*)
    Progress         : sint;  (*`{ENG}Progress of data downloading {CSY}Prubeh stahov·nÌ dat*)
  END_VAR
  VAR
    ResRecv          : bool;
    LenRecv          : bool;
    HeaderRecv       : bool;
    WasEOL           : bool;
    TimeOutTon       : TON;
    helpstring       : string [255];
    RecvFrom {HIDDEN} : fbRecvFrom;
    SendTo {HIDDEN}  : fbSendTo;
    ContLen          : dint;
    WholeLen         : dint;
    lPostLen         : uint;
    lHost            : string [80];
    lBodyLen         : uint;
    sOff             : uint;
    rLen             : uint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbJsonPageParser2
(*`{ENU} Parsing of JSON document file from web site. Information about json element is saved into TjsonInfo structure.
  {CSY} Parsov·nÌ JSON dokumentu z web str·nky. Informace o vyparsovanÈ poloûce je uloûena do struktury TjsonInfo.*)
  VAR CONSTANT
    JSON_BUMPER      : uint :=  256;  (*`{ENU} bumper of json buffer                    {CSY} n·raznÌk v json bufferu*)
    JSON_BUFFER_SIZE : uint :=  768;  (*`{ENU} size of json buffer                      {CSY} velikost bufferu*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{ENU} request for parsing                      {CSY} poûadavek na parsov·nÌ*)
    get              : bool;  (*`{ENU} use GET method                           {CSY} pouûÌt metodu GET*)
    post             : bool;  (*`{ENU} use POST method                          {CSY} pouûÌt metodu POST*)
    put              : bool;  (*`{ENU} use method                               {CSY} pouûÌt metodu PUT*)
    chanCode         : uint;  (*`{ENU} channel code (ETH1_uni0, ETH1_uni1,...)  {CSY} komunikaËnÌ kan·l (ETH1_uni0, ETH1_uni1,...)*)
    contentType      : string [80];  (*`{ENG} content-Type                             {CSY} typ obsahu (Content-Type)*)
    bodyLen          : uint;  (*`{ENG} lenght of body                           {CSY} dÈlka tÏla*)
  END_VAR
  VAR_IN_OUT
    pageName         : string [255];  (*`{ENU} mame of web page with json file          {CSY} n·zev web str·nky s s json dokumentem*)
    JsonInfo         : TJsonInfo;  (*`{ENU} result of parsing                        {CSY} v˝sledek parsov·nÌ*)
    body             : uint;  (*`{ENU} first byte of request body               {CSY} prvnÌ bajt tÏla poûadavku*)
  END_VAR
  VAR_OUTPUT
    start            : bool;  (*`{ENU} initialization flag                      {CSY} p¯Ìznak inicializace bloku*)
    done             : bool;  (*`{ENU} new item is ready in jsonItem            {CSY} v˝sledek parsov·nÌ je p¯ipraven v jsonInfo*)
    busy             : bool;  (*`{ENU} block is busy                            {CSY} blok je zanepr·zdnÏn*)
    eof              : bool;  (*`{ENU} end of file                              {CSY} konec souboru*)
    break            : bool;  (*`{ENU} buffer processed, continue next cycle    {CSY} buffer zpracov·n, pokraËovat p¯ÌötÌ cyklus*)
    err              : bool;  (*`{ENU} error flag                               {CSY} p¯Ìznak chyby*)
    errTxt           : string [80];  (*`{ENU} error description                        {CSY} popis chyby*)
    fileSize         : udint;  (*`{ENU} size of file                             {CSY} velikost souboru*)
    processed        : udint;  (*`{ENU} processed                                {CSY} zpracov·no (poËet znak˘)*)
  END_VAR
  VAR
    rqShrink         : bool;
    rqFile           : bool;
    rqParse          : bool;
    rqStart          : bool;
    dnsRequest       : bool;
    trgExecOn        : R_TRIG;
    JsonParser       : fbJsonParserEx;
    JsonBuffer       : ARRAY [0..768] OF usint;
    sumaLen          : udint;  (*`kolik nacteno ze souboru*)
    actLen           : udint;  (*`aktualni velikost json bufferu*)
    restLen          : uint;
    pos              : int;
    HttpIP           : TIPadr;
    HttpPort         : uint;
    HttpName         : string [80];
    Action           : string [255];
    SplitUrlAddress  : fbSplitUrlAddress;
    HttpRequest      : fbJsonPageParser2HttpRequest;
  END_VAR
  VAR CONSTANT
    HTTP_IP_NULL     : TIPadr :=  [0,0,0,0];
  END_VAR
END_FUNCTION_BLOCK



