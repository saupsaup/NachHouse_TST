//{Knihovna : DataBoxLib 1.7  }
(*` {CSY}Historie{ENU}History{}: *)
(*`
{CSY}
v1.0 17.02.2004	Nem Úvodni verze knihovny
                    Funkce : ReadFromDataBox - cteni dat z DataBoxu do promenne
                             WriteToDataBox  - zapis dat z promenne do DataBoxu
                             SizeOfDataBox   - vrati velikost DataBoxu v KB
v1.1 09.09.2004	Nem Funkce pøepsány bez použití direktivy system_fc on
v1.2 30.08.2007	Nem Pøelozeno s novìjší verzí ST prekladace (v3.3.2.0)
v1.3 11.01.2010	Nem Prohozeno poøadí vstupních promìnných u funkcí ReadBlockFromDBx
                    a WriteBlockToDBx kvùli použití v LD a FBD
v1.4 02.09.2010 Nem Doplnìny závislosti na knihovnách
v1.5 18.11.2013 Nem Oprava pro pøípad, kdy je adresa promìnné > %R65535
                    (Foxtrot potøebuje firmware v8.1 nebo vyšší)
v1.6 13.07.2016 Nem Doplnìny funkce ReadFromDBx() a WriteToDBx()
                    (Foxtrot potøebuje firmware v8.7 nebo vyšší) 
v1.7 09.11.2020 Nem Oprava fce WriteBlockToDBx pro Foxtrot CP-2xxx

{ENU}
v1.0 2004-02-17 Nem First edition
v1.1 2004-09-09 Nem Rewrited without using directive system_fc on
v1.2 2007-08-30 Nem Compiled with new version of ST compiler (v3.3.2.0)
v1.3 2010-01-11 Nem Order of input variables changed : 
                    functions ReadBlockFromDBx and WriteBlockToDBx 
                    (it is better for LD a FBD languages)
v1.4 2010-09-02 Nem Dependency on the libraries added
v1.5 2013-11-18 Nem Corrected bug in case when address of variable is > %R65535
                    (Foxtrot firmware v8.1 or higher is necessary)  
v1.6 2016-07-13 Nem New functions ReadFromDBx() and WriteToDBx()
                    (Foxtrot firmware v8.7 or higher is necessary)  
v1.7 2020-11-09 Nem Fix WriteBlockToDBx function for Foxtrot CP-2xxx
*)

(*----------------------------------------------------------------------------*)
{LIBRARY="LOCALLIB\STDLIB_V22_20180619.MLB"}
{LIBRARY="LOCALLIB\SYSLIB_V45_20200914.MLB"}

VAR_GLOBAL CONSTANT
 MAX_LENGTH_DATABOX_BLOCK : int :=  10000;

END_VAR

TYPE TDataBoxPar :
  STRUCT
    databoxAddress   : udint;
    registerIndex    : uint;
    blockLength      : usint;
  END_STRUCT;
END_TYPE

TYPE  TPtrNaPole : ARRAY [0..10000] OF usint;
END_TYPE

__DECL FUNCTION ReadBlockFromDBx : usint
(*`{ENU} Transfer of data block from DataBox memory to variable

         Maximal block size is 255 bytes
         Return value : number of transfered bytes

   {CSY} Pøenos bloku pamìti z DataBoxu do promìnné

         Maximální velikost bloku je 255 bytù
         Funkce vrací poèet pøenesených bytù*)
  VAR_INPUT
    dataBoxAddress   : udint;  (*`{ENU} source address (DataBox)  {CSY} adresa zdroje (adresa v DataBoxu)*)
    length           : usint;  (*`{ENU} size of data block (number of bytes, max 255) {CSY} velikost pøenášeného bloku (poèet bytù, max 255)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} destination address (variable) {CSY} adresa cíle (promìnná)*)
  END_VAR
  VAR
    par              : TDataBoxPar;
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteBlockToDBx : usint
(*`{ENU} Transfers of data block from variable to DataBox memory

         Maximal block size is 255 bytes
         Return value : number of transfered bytes

   {CSY} Pøenos bloku pamìti z promìnné do DataBoxu

         Maximální velikost bloku je 255 bytù
         Funkce vrací poèet pøenesených bytù*)
  VAR_INPUT
    dataBoxAddress   : udint;  (*`{ENU} destination address (DataBox)  {CSY} adresa cíle (adresa v DataBoxu)*)
    length           : usint;  (*`{ENU} size of data block (number of bytes, max 255) {CSY} velikost pøenášeného bloku (poèet bytù, max 255)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} source address (variable) {CSY} adresa zdroje (promìnná)*)
  END_VAR
  VAR
    par              : TDataBoxPar;
  END_VAR
END_FUNCTION

__DECL FUNCTION ReadFromDataBox : bool
(*`{ENU} Transfer of data block from DataBox memory to variable

         Maximal block size is 10000 bytes
         Return value : TRUE if all data was transfered
         Warning !!!
         - variable must be allocated inside %M or %R !!!
         - variable's data type can not be BOOL or ARRAY[] OF BOOL !!!

   {CSY} Pøenos bloku pamìti z DataBoxu do promìnné

         Maximální velikost bloku je 10000 bytù
         Funkce vrací TRUE, pokud byla všechna požadovaná data pøenesena
         Upozornìní !!!
         - promìnná musí být umístìna v pamìovém prostoru %R resp. %M
         - promìnná nesmí být typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    dataBoxAddress   : udint;  (*`{ENU} source address (DataBox)  {CSY} adresa zdroje (adresa v DataBoxu)*)
    length           : uint;  (*`{ENU} size of data block (number of bytes, max 10000)  {CSY} velikost pøenášeného bloku (poèet bytù, max 10000)*)
  END_VAR
  VAR_IN_OUT
    variable         : TPtrNaPole;  (*`{ENU} destination address (variable) {CSY} adresa cíle (promìnná)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteToDataBox : bool
(*`{ENU} Transfer of data block from variable to DataBox memory

         Maximal block size is 10000 bytes
         Return value : TRUE if all data was transfered
         Warning !!!
         - variable must be allocated inside %M or %R !!!
         - variable's data type can not be BOOL or ARRAY[] OF BOOL !!!

   {CSY} Pøenos bloku pamìti z promìnné do DataBoxu

         Maximální velikost bloku je 10000 bytù
         Funkce vrací TRUE, pokud byla všechna požadovaná data pøenesena
         Upozornìní !!!
         - promìnná musí být umístìna v pamìovém prostoru %R resp. %M
         - promìnná nesmí být typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    dataBoxAddress   : udint;  (*`{ENU} destination address (DataBox)  {CSY} adresa cíle (adresa v DataBoxu)*)
    length           : uint;  (*`{ENU} size of data block (number of bytes, max 10000)  {CSY} velikost pøenášeného bloku (poèet bytù, max 10000)*)
  END_VAR
  VAR_IN_OUT
    variable         : TPtrNaPole;  (*`{ENU} source address (variable) {CSY} adresa zdroje (promìnná)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION SizeOfDataBox : uint
(*`{ENU} DataBox memory size identification

         Return value : DataBox memory size [kilobytes]
   {CSY} Test aktuální velikost pamìti v DataBoxu

         Funkce vrací velikost DataBoxu v kilobytech*)
END_FUNCTION

__DECL FUNCTION ReadFromDBx : bool
(*`{ENU} Transfer of data block from DataBox memory to variable
         Return value is TRUE if all data was transferred
         Warning !!!
         - function requires Foxtrot with FW v8.7 or higher
         - variable's data type can not be BOOL or ARRAY[] OF BOOL !!!

   {CSY} Pøenos bloku pamìti z DataBoxu do promìnné
         Funkce vrací TRUE, pokud byla všechna požadovaná data pøenesena
         Upozornìní !!!
         - funkce vyžaduje Foxtrot s FW v8.7 nebo vyšším
         - promìnná nesmí být typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    dataBoxAddress   : udint;  (*`{ENU} source address (address in DataBox)       {CSY} adresa zdroje (adresa v DataBoxu)*)
    length           : udint;  (*`{ENU} size of data block (number of bytes)      {CSY} velikost pøenášeného bloku (poèet bytù)*)
    varAddress       : udint;  (*`{ENU} destination address (address of variable) {CSY} adresa cíle (adresa promìnné)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteToDBx : bool
(*`{ENU} Transfers of data block from variable to DataBox memory
         Return value is TRUE if all data was transferred
         Warning !!!
         - function requires Foxtrot with FW v8.7 or higher
         - variable's data type can not be BOOL or ARRAY[] OF BOOL !!!

   {CSY} Pøenos bloku pamìti z promìnné do DataBoxu
         Funkce vrací TRUE, pokud byla všechna požadovaná data pøenesena
         Upozornìní !!!
         - funkce vyžaduje Foxtrot s FW v8.7 nebo vyšším
         - promìnná nesmí být typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    dataBoxAddress   : udint;  (*`{ENU} source address (address in DataBox)       {CSY} adresa zdroje (adresa v DataBoxu)*)
    length           : udint;  (*`{ENU} size of data block (number of bytes)      {CSY} velikost pøenášeného bloku (poèet bytù)*)
    varAddress       : udint;  (*`{ENU} destination address (address of variable) {CSY} adresa cíle (adresa promìnné)*)
  END_VAR
END_FUNCTION



{USES=ReadFromDataBox:ReadBlockFromDBx}
{USES=WriteToDataBox:WriteBlockToDBx}
#srcfile 'D:\TECOLIBSRC\DATABOXLIB\DATABOXLIB\DATABOXLIB.ST'
#pou ReadBlockFromDBx
#srcline 21 ;FUNCTION ReadBlockFromDBx : usint
P     61
ReadBlockFromDBx_L0:
 LINK 0
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__ReadBlockFromDBx
 LEAX par
 LD   7
 LD   0
 FIL 
; End initialize - variables
#srcline 44 ;begin
#srcline 45 ;{asm}
#srcline 46
#def BAZE_REG %R0
#srcline 47
;
#srcline 48
;---> nastavit cislo registru
#srcline 49
;
#srcline 50
  ldx variable
#srcline 51
  lea BAZE_REG  ;absolutni adresa R0
#srcline 52
  sub     ;ld __indx( variable)
#srcline 53
  wrx par~registerIndex
#srcline 54
  gt      65535           ;asi rada L, pouzit jinou SYS
#srcline 55
  jmd     ReadBlockFromDBxNew
#srcline 56
;
#srcline 57
;---> nastavit  pocet bytu, ktery budu cist
#srcline 58
;
#srcline 59
  ldx length
#srcline 60
  wrx par~blockLength
#srcline 61
;
#srcline 62
;--->   nastavit adresu v DataBoxu
#srcline 63
;
#srcline 64
  ldx     dataBoxAddress
#srcline 65
  wrx par~databoxAddress
#srcline 66
;
#srcline 67
;---> precist blok dat z DataBoxu do pameti
#srcline 68
;
#srcline 69
  ld  __indx(__Instance__ReadBlockFromDBx~par~databoxAddress)
#srcline 70
  SYS     5               ; rdb = cteni z DataBoxu
#srcline 71
  wrx   __fc__ReadBlockFromDBx
#srcline 72
  jmp     EndReadBlockFromDBx
#srcline 73
;
#srcline 74
ReadBlockFromDBxNew:
#srcline 75
        ldx length          ; delka
#srcline 76
  ldx     dataBoxAddress  ; adresa v databoxu
#srcline 77
  ldx variable  ; adresa v zapisniku
#srcline 78
  ld      1               ; kod RDB
#srcline 79
  SYS     84              ; sysDBX
#srcline 80
  wrx   __fc__ReadBlockFromDBx
#srcline 81
;
#srcline 82
EndReadBlockFromDBx:
#srcline 83 ;{end_asm}
#srcline 84 ;END_FUNCTION
 PRV  
 LDX  __fc__ReadBlockFromDBx
 ULNK
RET
E     61
#endpou 

#pou WriteBlockToDBx
#srcline 87 ;FUNCTION WriteBlockToDBx : usint

#struct WriteBlockToDBx__temp__
  usint lenBlk1,
  usint resBlk1,
  usint lenBlk2,
  usint resBlk2
P     61
WriteBlockToDBx_L0:
 LINK __SizeOf(WriteBlockToDBx__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__WriteBlockToDBx
 LEAX par
 LD   7
 LD   0
 FIL 
; End initialize - variables
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 114 ;  IF ( System_S.S42 <> 16#49 ) AND ( System_S.S42 <> 16#4A ) THEN  // starsi centralni jednotky (vsechny rady mimo I a J)
 LD   System_S~S42
#debug byte System_S.S42
 LD   byte $49
 EQ
 NEG
 LD   System_S~S42
#debug byte System_S.S42
 LD   byte $4A
 EQ
 NEG
 AND
 JMC  WriteBlockToDBx_L1
#srcline 115 ;    {asm}
#srcline 116
      #def BAZE_REG %R0
#srcline 117
      ;
#srcline 118
      ;---> nastavit cislo registru
#srcline 119
      ;
#srcline 120
        ldx     variable
#srcline 121
        lea     BAZE_REG                ; absolutni adresa R0
#srcline 122
        sub                             ; ld __indx( variable)
#srcline 123
        wrx par~registerIndex
#srcline 124
        gt      65535
#srcline 125
        jmd     WriteBlockFromDBxNew
#srcline 126
      ;
#srcline 127
      ;---> nastavit  pocet bytu, ktery budu cist
#srcline 128
      ;
#srcline 129
        ldx     length
#srcline 130
        wrx     par~blockLength
#srcline 131
      ;
#srcline 132
      ;--->   nastavit adresu v DataBoxu
#srcline 133
      ;
#srcline 134
        ldx     dataBoxAddress
#srcline 135
        wrx     par~databoxAddress
#srcline 136
      ;
#srcline 137
      ;---> precist blok dat z DataBoxu do pameti
#srcline 138
      ;
#srcline 139
        ld      __indx(__Instance__WriteBlockToDBx~par~databoxAddress)
#srcline 140
        SYS     6                       ; wdb = zapis do DataBoxu
#srcline 141
        wrx     __fc__WriteBlockToDBx
#srcline 142
        jmp     EndWriteBlockToDBx
#srcline 143
      ;
#srcline 144
      WriteBlockFromDBxNew:
#srcline 145
        ldx     length                  ; delka
#srcline 146
        ldx     dataBoxAddress          ; adresa v databoxu
#srcline 147
        ldx     variable                ; adresa v zapisniku
#srcline 148
        ld      2                       ; kod WDB
#srcline 149
        SYS     84                      ; sysDBX
#srcline 150
        wrx     __fc__WriteBlockToDBx
#srcline 151
      ;
#srcline 152
      EndWriteBlockToDBx:
#srcline 153 ;    {end_asm}
#srcline 155 ;  ELSE                                                             // nove centralni jednotky (rady I a J)
 JMP  WriteBlockToDBx_L2
WriteBlockToDBx_L1:
#srcline 156 ;    IF (length > 16) AND ((length mod 32) < 4) THEN                // tahle delka zpusobuje chybu na FW nizsim nez v3.8
 LDX  length
#debug usint length
 LD   usint 16
 GT
 LDX  length
#debug usint length
 LD   usint 32
 MOD
 AND  $FF
 LD   usint 4
 LT
 AND
 JMC  WriteBlockToDBx_L3
#srcline 157 ;      lenBlk1 := (length / 8) * 5;                                 // rozdelime komunikaci na 2 bloky
 LDX  length
#debug usint length
 LD   usint 8
 DIVL
 AND  $FF
 LD   usint 5
 MUL
 AND  $FF
 WRY  lenBlk1
#debug_left usint lenBlk1
#srcline 158 ;      lenBlk2 := length - lenBlk1;
 LDX  length
#debug usint length
 LDY  lenBlk1
#debug usint lenBlk1
 SUB
 AND  $FF
 WRY  lenBlk2
#debug_left usint lenBlk2
#srcline 159 ;      {asm}
#srcline 160
        ldy     lenBlk1                 ; delka 1.bloku
#srcline 161
        ldx     dataBoxAddress          ; adresa v databoxu
#srcline 162
        ldx     variable                ; adresa v zapisniku
#srcline 163
        ld      2                       ; kod WDB
#srcline 164
        SYS     84                      ; sysDBX
#srcline 165
        wry     resBlk1
#srcline 166
        ldy     lenBlk1
#srcline 167
        cmp
#srcline 168
        jnz     EndWriteBlockToDBxI     ; chyba pri zapisu 1.bloku
#srcline 169
      ;
#srcline 170
        ldy     lenBlk2                 ; delka 2.bloku
#srcline 171
        ldx     dataBoxAddress          ; adresa v databoxu
#srcline 172
        ldy     lenBlk1
#srcline 173
        add
#srcline 174
        ldx     variable                ; adresa v zapisniku
#srcline 175
        ldy     lenBlk1
#srcline 176
        add
#srcline 177
        ld      2                       ; kod WDB
#srcline 178
        SYS     84                      ; sysDBX
#srcline 179
        wry     resBlk2
#srcline 180
      EndWriteBlockToDBxI:
#srcline 181 ;      {end_asm}
#srcline 182 ;      ;
#srcline 183 ;      WriteBlockToDBx := resBlk1 + resBlk2;
 LDY  resBlk1
#debug usint resBlk1
 LDY  resBlk2
#debug usint resBlk2
 ADD
 AND  $FF
 WRX  __fc__WriteBlockToDBx
#debug_left usint WriteBlockToDBx
#srcline 184 ;      return;
 JMP  WriteBlockToDBx_RET
#srcline 185 ;    ELSE
 JMP  WriteBlockToDBx_L4
WriteBlockToDBx_L3:
#srcline 186 ;      {asm}
#srcline 187
        ldx     length                  ; delka
#srcline 188
        ldx     dataBoxAddress          ; adresa v databoxu
#srcline 189
        ldx     variable                ; adresa v zapisniku
#srcline 190
        ld      2                       ; kod WDB
#srcline 191
        SYS     84                      ; sysDBX
#srcline 192
        wrx     __fc__WriteBlockToDBx
#srcline 193 ;      {end_asm}
#srcline 194 ;    END_IF;
WriteBlockToDBx_L4:
#srcline 195 ;  END_IF;
WriteBlockToDBx_L2:
#srcline 196 ;END_FUNCTION
WriteBlockToDBx_RET:
 PRV  
 LDX  __fc__WriteBlockToDBx
 ULNK
RET
E     61
#endpou 

#pou ReadFromDataBox
