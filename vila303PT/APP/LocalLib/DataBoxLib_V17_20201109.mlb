#struct ReadFromDataBox__temp__
  uint t,
  uint j
P     61
ReadFromDataBox_L0:
 LINK __SizeOf(ReadFromDataBox__temp__)
 NXT
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 229 ;    j := length;
 LDX  length
#debug uint length
 WRY  j
#debug_left uint j
#srcline 230 ;    WHILE j >0 DO
ReadFromDataBox_L1:
 LDY  j
#debug uint j
 LD   uint 0
 GT
 JMC  ReadFromDataBox_L2
 DBG 
#srcline 231 ;    IF j > 250 THEN
 LDY  j
#debug uint j
 LD   uint 250
 GT
 JMC  ReadFromDataBox_L3
#srcline 232 ;       t := USINT_TO_UINT( ReadBlockFromDBx(
 NXT
 LDX  dataBoxAddress
#debug udint dataBoxAddress
 LDY  j
#debug uint j
 ADD
 LD   udint 250
 SUB
 WR   __Instance__ReadBlockFromDBx~dataBoxAddress
#debug_left udint __Instance__ReadBlockFromDBx~dataBoxAddress
#srcline 234 ;                           length         :=250,
 LD   usint 250
 WR   __Instance__ReadBlockFromDBx~length
#debug_left usint __Instance__ReadBlockFromDBx~length
#srcline 235 ;                           variable       := void(variable[j-250])));
 LDX  variable
 LDY  j
#debug uint j
 LD   uint 250
 SUB
 AND  $FFFF
 RCHK 10000   ; Range Check
 ADD     ; + offset 
 WR   __Instance__ReadBlockFromDBx~variable
#debug_left pointer __Instance__ReadBlockFromDBx.variable
 PRV
 LEA  __Instance__ReadBlockFromDBx
 CAL  ReadBlockFromDBx_L0
 AND  $FFFF
 WRY  t
#debug_left uint t
#srcline 236 ;     IF t = 0 THEN  EXIT;  END_IF;
 LDY  t
#debug uint t
 LD   uint 0
 EQ
 JMC  ReadFromDataBox_L5
 JMP  ReadFromDataBox_L2
ReadFromDataBox_L5:
#srcline 237 ;           j := j - t;
 LDY  j
#debug uint j
 LDY  t
#debug uint t
 SUB
 AND  $FFFF
 WRY  j
#debug_left uint j
#srcline 238 ;    ELSE
 JMP  ReadFromDataBox_L4
ReadFromDataBox_L3:
#srcline 239 ;           j :=j - USINT_TO_UINT( ReadBlockFromDBx(
 LDY  j
#debug uint j
 NXT
 LDX  dataBoxAddress
#debug udint dataBoxAddress
 WR   __Instance__ReadBlockFromDBx~dataBoxAddress
#debug_left udint __Instance__ReadBlockFromDBx~dataBoxAddress
#srcline 241 ;                        length         := UINT_TO_USINT(j),
 LDY  j
#debug uint j
 AND  $FF
 WR   __Instance__ReadBlockFromDBx~length
#debug_left usint __Instance__ReadBlockFromDBx~length
#srcline 242 ;                        variable       := void(variable)));
 LDX  variable
 WR   __Instance__ReadBlockFromDBx~variable
#debug_left pointer __Instance__ReadBlockFromDBx.variable
 PRV
 LEA  __Instance__ReadBlockFromDBx
 CAL  ReadBlockFromDBx_L0
 AND  $FFFF
 SUB
 AND  $FFFF
 WRY  j
#debug_left uint j
#srcline 243 ;     EXIT;
 JMP  ReadFromDataBox_L2
#srcline 244 ;    END_IF;
ReadFromDataBox_L4:
#srcline 245 ;    END_WHILE;
 JMP  ReadFromDataBox_L1
ReadFromDataBox_L2:
 NOP  -1
#srcline 246 ;    ReadFromDataBox := j = 0;
 LDY  j
#debug uint j
 LD   uint 0
 EQ
 WRX  __fc__ReadFromDataBox
#debug_left bool ReadFromDataBox
#srcline 247 ;END_FUNCTION
 PRV  
 LDX  __fc__ReadFromDataBox
 ULNK
RET
E     61
#endpou 

