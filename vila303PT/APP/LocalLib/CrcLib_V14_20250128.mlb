__DECL FUNCTION CheckCRC_32 : udint
(*`------------------------------------------------------------------------------
  Function calculates polynomial (X32+X26+X23+X22+X16+X12+X11+X10+X8+X7+X5+X4+X2+X+1) of byte array
  Return value : UDINT polynomial*)
  VAR_INPUT
    ptr              : PTR_TO usint;
    length           : uint;
  END_VAR
  VAR
    valCRC           : dword;
    mask             : dword;
    i                : uint;
    j                : uint;
    ptrMsg           : PTR_TO byte;
  END_VAR
END_FUNCTION

