{LIBRARY="LOCALLIB\FILELIB_V31_20231122.MLB"}

__DECL FUNCTION ReadBlockFromRBx : usint
(*`{ENU} Transfer of data block from RamBox memory to variable. Maximal block size is 255 bytes. Return value : number of transfered bytes.
   {CSY} Pшenos bloku pamмti z RamBoxu do promмnnй. Maximбlnн velikost bloku je 255 bytщ. Funkce vracн poиet pшenesenэch bytщ.*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} source address (RamBox)  {CSY} adresa zdroje (adresa v RamBoxu)*)
    length           : usint;  (*`{ENU} size of data block (number of bytes, max 255) {CSY} velikost pшenбљenйho bloku (poиet bytщ, max 255)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} destination address (variable) {CSY} adresa cнle (promмnnб)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteBlockToRBx : usint
(*`{ENU} Transfers of data block from variable to RamBox memory. Maximal block size is 255 bytes. Return value : number of transfered bytes.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pшenos bloku pamмti z promмnnй do RamBoxu. Maximбlnн velikost bloku je 255 bytщ. Funkce vracн poиet pшenesenэch bytщ.
         Upozornмnн !!! promмnnб nesmн bэt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (RamBox)  {CSY} adresa cнle (adresa v RamBoxu)*)
    length           : usint;  (*`{ENU} size of data block (number of bytes, max 255) {CSY} velikost pшenбљenйho bloku (poиet bytщ, max 255)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} source address (variable) {CSY} adresa zdroje (promмnnб)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION ReadFromRamBox : bool
(*`{ENU} Transfer of data block from RamBox memory to variable. Return value : TRUE if all data was transfered.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pшenos bloku pamмti z RamBoxu do promмnnй. Funkce vracн TRUE, pokud byla vљechna poћadovanб data pшenesena.
         Upozornмnн !!! promмnnб nesmн bэt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} source address (RamBox)  {CSY} adresa zdroje (adresa v RamBoxu)*)
    length           : uint;  (*`{ENU} size of data block (number of bytes, max 10000)  {CSY} velikost pшenбљenйho bloku (poиet bytщ, max 10000)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} destination address (variable) {CSY} adresa cнle (promмnnб)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteToRamBox : bool
(*`{ENU} Transfer of data block from variable to RamBox memory. Return value : TRUE if all data was transfered.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pшenos bloku pamмti z promмnnй do RamBoxu. Funkce vracн TRUE, pokud byla vљechna poћadovanб data pшenesena.
         Upozornмnн !!! promмnnб nesmн bэt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (RamBox)  {CSY} adresa cнle (adresa v RamBoxu)*)
    length           : uint;  (*`{ENU} size of data block (number of bytes, max 10000)  {CSY} velikost pшenбљenйho bloku (poиet bytщ, max 10000)*)
  END_VAR
  VAR_IN_OUT
    variable         : usint;  (*`{ENU} source address (variable) {CSY} adresa zdroje (promмnnб)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION ReadFromRBx : bool
(*`{ENU} Transfer of data block from RamBox memory to variable. Return value is TRUE if all data was transferred.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pшenos bloku pamмti z RamBoxu do promмnnй. Funkce vracн TRUE, pokud byla vљechna poћadovanб data pшenesena.
         Upozornмnн !!! promмnnб nesmн bэt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} source address (address in RamBox)  {CSY} adresa zdroje (adresa v RamBoxu)*)
    length           : udint;  (*`{ENU} size of data block (number of bytes)  {CSY} velikost pшenбљenйho bloku (poиet bytщ)*)
    varAddress       : udint;  (*`{ENU} destination address (address of variable)  {CSY} adresa cнle (adresa promмnnй)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION WriteToRBx : bool
(*`{ENU} Transfers of data block from variable to RamBox memory. Return value is TRUE if all data was transferred.
         Warning !!! variable's data type can not be BOOL or ARRAY[] OF BOOL !!!
   {CSY} Pшenos bloku pamмti z promмnnй do RamBoxu. Funkce vracн TRUE, pokud byla vљechna poћadovanб data pшenesena.
         Upozornмnн !!! promмnnб nesmн bэt typu BOOL nebo ARRAY[] OF BOOL*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (address in RamBox)  {CSY} adresa cнle (adresa v RamBoxu)*)
    length           : udint;  (*`{ENU} size of data block (number of bytes)  {CSY} velikost pшenбљenйho bloku (poиet bytщ)*)
    varAddress       : udint;  (*`{ENU} source address (address of variable)  {CSY} adresa zdroje (adresa promмnnй)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION SetValueToRamBox : bool
(*`{ENU} Sets constant into data block in RamBox memory. Return value is TRUE if all data was written.
   {CSY} Zapнљe konstantu do bloku pamмti v RamBoxu. Funkce vracн TRUE, pokud se vљe podaшilo zapsat.*)
  VAR_INPUT
    ramBoxAddress    : udint;  (*`{ENU} destination address (address in RamBox)  {CSY} adresa cнle (adresa v RamBoxu)*)
    length           : udint;  (*`{ENU} size of data block in RamBox (number of bytes)  {CSY} velikost bloku v RAMBoxu (poиet bytщ)*)
    value            : udint;  (*`{ENU} written constant  {CSY} zapisovanб konstanta*)
  END_VAR
END_FUNCTION

__DECL FUNCTION SizeOfRamBox : uint
(*`{ENU} RamBox memory size identification. Return value : RamBox memory size [kilobytes].
   {CSY} Test aktuбlnн velikost pamмti v RamBoxu. Funkce vracн velikost RamBoxu v kilobytech.*)
END_FUNCTION

__DECL FUNCTION ResizeRamBox : bool
(*`{ENU} Resize RamBox memory. When is succesfull returns TRUE.
   {CSY} Zmмna aktuбlnн velikost pamмti v RamBoxu. Vracн TRUE pokud se zmмna podaшн.*)
  VAR_INPUT
    newSize          : uint;  (*`{ENU} new size of memory in RamBox [kilobytes] {CSY} novб velikost pamмti v RAMBoxu v kilobytech*)
  END_VAR
END_FUNCTION

__DECL FUNCTION FileReadRbx : udint
(*`{CSY} Иtenн dat ze souboru do RamBoxu
   Funkce zkopнruje zadanэ poиet znakщ ze souboru do RamBoxu. Funkce mщћe zkopнrovat i menљн poиet znakщ neћ je poћadovбno v pшнpadм, ћe dojde k chybм pшi иtenн souboru nebo je dosaћeno konce souboru.
   Funkce posouvб aktuбlnн pozici pro иtenн/zбpis do souboru podle pozice naposledy pшeиtenйho znaku.
   Funkce vracн skuteиnэ poиet ъspмљnм naиtenэch znakщ.
   {ENU} Read from file to RamBox
   FileRead attempts to copy, from the file identified by hFile, count elements (each of size size) into RamBox memory, starting at adrRbx. FileRead may copy fewer elements than count if an error, or end of file, intervenes.
   FileRead also advances the file position indicator (if any) for hFile by the number of characters actually read.
   The result of FileRead is the number of elements it succeeded in reading.*)
  VAR_INPUT
    hFile            : HANDLE;  (*`{CSY} identifikбtor souboru {ENU} file identificator*)
    adrRbx           : udint;  (*`{CSY} adresa v RamBoxu, na kterou budou zkopнrovбna data ze souboru {ENU} destination address in RamBox*)
    size             : udint;  (*`{CSY} dйlka иtenэch dat (poиet bytщ) {ENU} data length (number of bytes)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION FileWriteRbx : udint
(*`{CSY} Zбpis dat z RamBoxu do souboru
   Funkce zkopнruje zadanэ poиet znakщ z pamмti RamBox do souboru. Funkce mщћe zkopнrovat i menљн neћ zadanэ poиet znakщ, pokud dojde k chybм pшi zбpisu do souboru.
   Funkce posouvб aktuбlnн pozici pro иtenн/zбpis do souboru podle pozice naposledy zapsanйho znaku.
   Funkce vracн skuteиnэ poиet ъspмљnм zapsanэch znakщ
   {ENU} Write to a file
   FileWrite attempts to copy, starting from the RamBox memory location adrRbx, count elements (each of size size) into the file identified by hFile. FileWrite may copy fewer elements than count if an error intervenes.
   FileWrite also advances the file position indicator (if any) for hFile by the number of characters actually written.
   If FileWrite succeeds in writing all the elements you specify, the result is the same as the argument count. In any event, the result is the number of complete elements that FileWrite copied to the file.*)
  VAR_INPUT
    hFile            : HANDLE;  (*`{CSY} identifikбtor souboru {ENU} file identificator*)
    adrRbx           : udint;  (*`{CSY} adresa v RamBoxu, ze kterй budou zkopнrovanб data do souboru{ENU} RamBox address*)
    size             : udint;  (*`{CSY} dйlka zapisovanэch dat (poиet bytщ) {ENU} data length (number of bytes)*)
  END_VAR
END_FUNCTION

__DECL FUNCTION_BLOCK fbReadRbxFromFile
(*`{CSY} Pшenos dat ze souboru do pamмti RamBox. Funkиnн blok pшeиte data ze souboru a uloћн je do pamмti RamBox. Funkиnн blok je podporovбn na CPM шady I a J od verze v2.2.053.
   Funkиnн blok nastavн TRUE do promмnnй done v okamћiku, kdy se naиte poslednн blok dat ze souboru. Bмhem naинtбnн dat mб promмnnб done hodnotu FALSE a promмnnб busy hodnotu TRUE.
   Poиet skuteиnм naиtenэch bytщ udбvб promмnnб actSize. Pokud bylo иtenн bez chyby, promмnnб err mб hodnotu FALSE, v pшнpadм chyby mб hodnotu TRUE a v promмnnй errID je uloћen chybovэ kуd. Ten mщћe bэt pouћit jako vstupnн promмnnб funkce GetLastErrTxt pro zнskбnн textovйho popisu vzniklй chyby.
   {ENU} Copy data from a file to RamBox memory. Copy data from file to RamBox. Supported on CPM type I or J version v2.2.053 or higher.
   Returns: Busy is TRUE during file reading, Done is TRUE when reading is finished. If reading failed, err output is TRUE and errID output contains code of error*)
  VAR_IN_OUT
    fileName         : string [80];  (*`{CSY} jmйno souboru (vиetnм cesty) {ENU} file name (including path)*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{CSY} ћбdost o иtenн = nбbмћnб hrana zahбjн иtenн ze souboru {ENU} request (rising edge)*)
    seek             : udint;  (*`{CSY} offset od zaибtku souboru, od kterйho je zahбjeno иtenн {ENU} data offset in file*)
    dstAdr           : udint;  (*`{CSY} adresa RamBoxu, od kterй budou uloћena data pшeиtenб ze souboru {ENU} RamBox address*)
    size             : udint;  (*`{CSY} velikost иtenэch dat (poиet bytщ) {ENU} data length <= size of variable (number of bytes)*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{CSY} иtenн ze souboru je ukonиeno {ENU} action is done*)
    busy             : bool;  (*`{CSY} probнhб иtenн ze souboru {ENU} action in progress*)
    err              : bool;  (*`{CSY} pшнznak chyby pшi иtenн ze souboru {ENU} error flag*)
    errID            : udint;  (*`{CSY} {CSY} chybovэ kуd (0 = bez chyby) {ENU} error number (0 = no error)*)
    actSize          : udint;  (*`{CSY} poиet skuteиnм naиtenэch bytщ {ENU} number of bytes really read*)
  END_VAR
  VAR
    execTrig         : R_TRIG;
    errTrig          : R_TRIG;
    hnd              : HANDLE;
    adrVar           : udint;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fbWriteRbxToFile
(*`{CSY} Pшenos dat z pamмti RamBox do souboru
   Funkиnн blok zapнљe obsah pamмti RamBox do souboru. Pokud soubor neexistuje, tak je vytvoшen. Pokud soubor existuje, jeho obsah je pшepsбn. Funkиnн blok je podporovбn na CPM шady I a J od verze v2.2.053.
   Funkиnн blok nastavн TRUE do promмnnй done v okamћiku, kdy se zapнљe poslednн blok dat do souboru. Bмhem zбpisu dat mб promмnnб done hodnotu FALSE a promмnnб busy hodnotu TRUE. Poиet skuteиnм zapsanэch bytщ udбvб promмnnб actSize.
   Pokud byl zбpis do souboru bez chyby, promмnnб err mб hodnotu FALSE, v pшнpadм chyby mб hodnotu TRUE a v promмnnй errID je uloћen chybovэ kуd. Ten mщћe bэt pouћit jako vstupnн promмnnб funkce GetLastErrTxt pro zнskбnн textovйho popisu vzniklй chyby.
   {ENU} Copy data from RamBox to file
   If file does not exist new file is created. If file exists file content is overwitten. Supported on CPM type I or J version v2.2.053 or higher.
   Returns: Busy is TRUE during file writing, Done is TRUE when writing is finished.
   If writing failed, err output is TRUE and errID output contains code of error.*)
  VAR_IN_OUT
    fileName         : string [80];  (*`{CSY} jmйno souboru (vиetnм cesty) {ENU} file name (including path)*)
  END_VAR
  VAR_INPUT
    exec             : bool;  (*`{CSY} ћбdost o zбpis = nбbмћnб hrana zahбjн zбpis do souboru {ENU} request (rising edge)*)
    seek             : udint;  (*`{CSY} offset v souboru, od kterйho je zahбjen zбpis {ENU} data offset in file*)
    srcAdr           : udint;  (*`{CSY} adresa v RamBoxu, kde zaинnajн data, kterб budou uloћena do souboru {ENU} RamBox address*)
    size             : udint;  (*`{CSY} velikost zapisovanэch dat (poиet bytщ) {ENU} data length (number of bytes)*)
  END_VAR
  VAR_OUTPUT
    done             : bool;  (*`{CSY} dokonиen zбpis do souboru {ENU} action is done*)
    busy             : bool;  (*`{CSY} probнhб zбpis do souboru {ENU} action in progress*)
    err              : bool;  (*`{CSY} pшнznak chyby pшi zбpisu do souboru {ENU} error flag*)
    errID            : udint;  (*`{CSY} chybovэ kуd (0 = bez chyby) {ENU} error number (0 = no error)*)
    actSize          : udint;  (*`{CSY} poиet skuteиnм zapsanэch bytщ {ENU} number of bytes really written*)
  END_VAR
  VAR
    eTrig            : R_TRIG;
    errTrig          : R_TRIG;
    hnd              : HANDLE;
    adrVar           : udint;
  END_VAR
END_FUNCTION_BLOCK



