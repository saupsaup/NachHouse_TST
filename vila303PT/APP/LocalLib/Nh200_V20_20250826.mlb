    bpYes            : bool;  (*`pipat pri OK*)
    bpNo             : bool;  (*`pipat pri chybe*)
    LedG             : bool;
    LedR             : bool;
    Beep             : bool;
    et0              : uint :=  2000;  (*`cas medzi bliknutiami pri STAN-BY*)
  END_STRUCT;
END_TYPE

