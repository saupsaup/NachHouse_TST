#pou _Nh_DL_sha
#srcline 1 ;FUNCTION _Nh_DL_sha {HIDDEN} : USINT	    // vrati cislo SHA (0..64)/ DMA (1..2) / alebo skupiny (100..115)   podla cisla vety ND
P     61
_Nh_DL_sha_L0:
 LINK 0
 NXT
; Initialize - variables
 LD   0
 WRX  __fc___Nh_DL_sha
; End initialize - variables
#srcline 7 ;   _Nh_DL_sha := INT_TO_USINT(nd-1);								// zaznamy 1..64, 65..128, 129..  DALI 0..63
 LDX  nd
#debug int nd
 EXTW 
 LD   int 1
 SUB
 EXTW
 AND  $FF
 WRX  __fc___Nh_DL_sha
#debug_left usint _Nh_DL_sha
#srcline 8 ;	{$IFDEF __NH_DALI}
#srcline 9 ;   IF gr THEN                                     				// nd je REC skupiny 1..32,
#srcline 10 ;      IF nd > 32 THEN
#srcline 11 ;         IF ma THEN
#srcline 12 ;            _Nh_DL_sha := 3;                           		// vrati cislo MASTAR
#srcline 13 ;         ELSE
#srcline 14 ;            _Nh_DL_sha := _Nh_DL_sha - 32 + 100;            // cislo 3.grupy: napr.pre prvy spupinu druheho mastra (ND:=33)  33-1-32+100 = 100
#srcline 15 ;         END_IF;
#srcline 16 ;      ELSIF nd > 16 THEN
#srcline 17 ;         IF ma THEN
#srcline 18 ;            _Nh_DL_sha := 2;                           		// vrati cislo MASTAR
#srcline 19 ;         ELSE
#srcline 20 ;            _Nh_DL_sha := _Nh_DL_sha - 16 + 100;            // cislo 2.grupy: napr.pre prvy spupinu druheho mastra (ND:=17)  17-1-16+100 = 100
#srcline 21 ;         END_IF;
#srcline 22 ;      ELSIF ma THEN
#srcline 23 ;         _Nh_DL_sha := 1;  													
#srcline 24 ;      ELSE
#srcline 25 ;         _Nh_DL_sha := _Nh_DL_sha + 100;							// v prvom mastri : nd-1 + 100 :  1-1+100 = 100
#srcline 26 ;      END_IF;
#srcline 27 ;   ELSIF nd > 128 THEN
#srcline 28 ;      IF ma THEN                                 				// prislo cislo ballastu v druhom mastri
#srcline 29 ;         _Nh_DL_sha := 3;
#srcline 30 ;      ELSE
#srcline 31 ;         _Nh_DL_sha := _Nh_DL_sha - 128;							// 129-1-128 = 0	
#srcline 32 ;      END_IF;
#srcline 33 ;   ELSIF nd > 64 THEN
#srcline 34 ;      IF ma THEN                                 				// prislo cislo ballastu v druhom mastri
#srcline 35 ;         _Nh_DL_sha := 2;
#srcline 36 ;      ELSE
#srcline 37 ;         _Nh_DL_sha := _Nh_DL_sha - 64;							// 65-1-64 = 0	
#srcline 38 ;      END_IF;
#srcline 39 ;   ELSIF ma THEN
#srcline 40 ;      _Nh_DL_sha := 1;                                     	// cislo prveho mastra
#srcline 41 ;   END_IF;
#srcline 42 ;	{$END_IF}
#srcline 43 ;END_FUNCTION
 PRV  
 LDX  __fc___Nh_DL_sha
 ULNK
RET
E     61
#endpou 



 

