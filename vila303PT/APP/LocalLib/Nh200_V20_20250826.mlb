#debug bool SYSTEM_S.R_EDGE_100MS
 JMC  _Nh_FILTER_1R_L3
#srcline 1754 ;		New 	:= (New * fil + In ) / (fil + 1.0) ;
 LDX  New
#debug real New
 LDX  fil
#debug real fil
 MUF
 LDX  In
#debug real In
 ADF
 LDX  fil
#debug real fil
 LD   real 1.0
 ADF
 DIF
 WRX  New
#debug_left real New
#srcline 1755 ;		IF rstBig  THEN
 LDX  rstBig
#debug bool rstBig
 JMC  _Nh_FILTER_1R_L4
