										( rws := 7,	clm := 1 ),          // browser - riadok
										( rws := 6,	clm := 2 ),          // brows - velky dash
										( rws :=14,	clm := 2 ),          // brows - maly dash
										( rws :=14,	clm := 1 )];
  END_STRUCT;
END_TYPE

TYPE NH_SLD_POD {HIDDEN} :
