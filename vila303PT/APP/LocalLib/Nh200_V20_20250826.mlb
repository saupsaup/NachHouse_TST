 LD   bool -1       ; true
 WRX  Qr
#debug_left bool Qr
#srcline 1769 ;			Out   := ROUND(new*10.)*0.1;
 LDX  new
#debug real new
 LD   real 10.
 MUF
 RND
 LD   real 0.1
 MUF
 WRX  Out
#debug_left real Out
#srcline 1770 ;		END_IF;
