TYPE NH_LOG_IMP :
  STRUCT  (*`struktura EVN-log*)
    ok               : string [1] := ' ';
    sok              : byte :=  16#3b;
    cf               : string [3];
    s1               : byte :=  16#3b;
    cfg              : string [3];
    s2               : byte :=  16#3b;
    ID               : string [5];  (*`nacitane z exportu*)
    s6               : byte :=  16#3b;  (*`nacitane z exportu*)
    inv              : string [1] := '0';  (*`on/off*)
    s3i              : byte :=  16#3b;  (*`on/off*)
    typ              : string [1] := '0';
    s3               : byte :=  16#3b;
    typYes           : string [1] := 'N';  (*`prepisuje sa typ*)
    sy               : byte :=  16#3b;  (*`prepisuje sa typ*)
    d                : string [1] := '0';  (*`hw.d[d]*)
    d2               : byte :=  16#3b;  (*`hw.d[d]*)
    HWs              : string [8];
    sa               : byte :=  16#3b;
    HWtyp            : string [1] :=  '0';
    d22              : byte :=  16#3b;
    IO               : string [1];  (*`I=vstup, Q=vystup, M=pamat*)
    sb               : byte :=  16#3b;  (*`I=vstup, Q=vystup, M=pamat*)
    MEM              : string [1];  (*`0=BOOL,1=REAL,*)
    sc               : byte :=  16#3b;  (*`0=BOOL,1=REAL,*)
    RomID            : string [3] := '   ';  (*`RomID, ktore sa bude hladat v xRom^.cf.ID*)
    s7               : byte :=  16#3b;  (*`RomID, ktore sa bude hladat v xRom^.cf.ID*)
    Rom              : string [3] := '   ';  (*`cislo vety rom {nd}*)
    s5               : byte :=  16#3b;  (*`cislo vety rom {nd}*)
    typRom           : string [1] := ' ';  (*`0=admin,1=vnutorna,2=vonkajsia,3=podzemna,4=wellmess,5=sauna*)
    s4               : byte :=  16#3b;  (*`0=admin,1=vnutorna,2=vonkajsia,3=podzemna,4=wellmess,5=sauna*)
    Name             : string [20];
    s8               : byte :=  16#3b;
    NameCf           : string [20];  (*`aktualny nazov v CFG*)
    s81              : byte :=  16#3b;  (*`aktualny nazov v CFG*)
    Cr               : byte :=  16#0D;
    Lf               : byte :=  16#0A;
  END_STRUCT;
END_TYPE

