    DimHW            : bool :=  1;  (*`ma sa hardwarovo stmievanat (ak ma adrresu)*)
    dummy1           : bool;
    dummy2           : bool;
    dummy3           : bool;
  END_STRUCT;
END_TYPE

TYPE NH_CFX_DALI {HIDDEN} :
