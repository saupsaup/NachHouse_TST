  VAR_INPUT
    send             : bool;
  END_VAR
  VAR
    notification     : TWebPushNotif;
    webPush {HIDDEN} : fbWebPushService;  (*`prehliadace na win/*)
  END_VAR
END_FUNCTION_BLOCK

