#pou _Nh_LVL_100
#srcline 502 ;FUNCTION _Nh_LVL_100 {HIDDEN} :  REAL  // vypocita LVL 0..100 a koriguje o Minimum a Maximu
P     61
_Nh_LVL_100_L0:
 LINK 0
 NXT
; Initialize - variables
 LD   0.0
 WRX  __fc___Nh_LVL_100
; End initialize - variables
#srcline 508 ;   _Nh_LVL_100 := ( USINT_TO_REAL(lvlMin) + lvlIn *( USINT_TO_REAL(lvlMax-lvlMin)/100.0 )) * BOOL_TO_REAL(lvlIn > 0.0) ;   // minimum + skorigovany LVL
 LDX  lvlMin
#debug usint lvlMin
 ULF
 LDX  lvlIn
#debug real lvlIn
 LDX  lvlMax
#debug usint lvlMax
 LDX  lvlMin
#debug usint lvlMin
 SUB
 AND  $FF
 ULF
 LD   real 100.0
 DIF
 MUF
 ADF
 LDX  lvlIn
#debug real lvlIn
 LD   real 0.0
 GTF
 AND  $3F800000
 MUF
 WRX  __fc___Nh_LVL_100
#debug_left real _Nh_LVL_100
#srcline 510 ;//   _Nh_LVL_100 := USINT_TO_REAL(lMin) + LVL*( USINT_TO_REAL(lMax-lMin)/254.0 );   // minimum + skorigovany LVL
#srcline 511 ;//   _Nh_LVL_100 := _Nh_LVL_100/2.54 * BOOL_TO_REAL(LVL > 0.0);              // prevod na 0..100 len ked je VAL > 0
#srcline 512 ;//	_Nh_LVL_100	:= ( vr + xDev^.al.ou.val * (kr - vr) / 100.0)  * BOOL_TO_REAL(xDev^.al.ou.val > 0.0) ;
#srcline 513 ;END_FUNCTION
 PRV  
 LDX  __fc___Nh_LVL_100
 ULNK
RET
E     61
#endpou 

