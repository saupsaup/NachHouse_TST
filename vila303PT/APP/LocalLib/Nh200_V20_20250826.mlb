#pou _Nh_PWM
#srcline 523 ;FUNCTION_BLOCK _Nh_PWM  {HIDDEN}  // Blikac / Pulsne sirkova modulace
P     61
_Nh_PWM_L0:
 LINK 0
#srcline 536 ;   Q  := false;
 LD   bool 0       ; false
 WRX  Q
#debug_left bool Q
#srcline 537 ;   IF Run = false THEN                          // je spusteny blikac
 LDX  Run
#debug bool Run
 LD   bool 0       ; false
 XOR
 NEG
 JMC  _Nh_PWM_L1
#srcline 538 ;      et    := 0;
 LD   uint 0
 WRX  et
#debug_left uint et
#srcline 539 ;      IF Out THEN                            // ak prisiel stop (run=0) v priebehu trvania impulzu, vystup mohol byt zapnuty
 LDX  Out
#debug bool Out
 JMC  _Nh_PWM_L3
#srcline 540 ;         Out   := false;                     // finalne vypne vystup
 LD   bool 0       ; false
 WRX  Out
#debug_left bool Out
#srcline 541 ;         Q     := true;
 LD   bool -1       ; true
 WRX  Q
#debug_left bool Q
#srcline 542 ;      END_IF;
_Nh_PWM_L3:
#srcline 543 ;   ELSIF et = 0 THEN                         // start
 JMP  _Nh_PWM_L2
_Nh_PWM_L1:
 LDX  et
#debug uint et
 LD   uint 0
 EQ
 JMC  _Nh_PWM_L5
#srcline 544 ;      et := MAX(50,Per);
 LD   uint 50
 LDX  Per
#debug uint Per
 MAX
 WRX  et
#debug_left uint et
#srcline 545 ;      IF pls > 0 THEN                        // zapne sa len ked ma nejake trvanie
 LDX  pls
#debug usint pls
 LD   usint 0
 GT
 JMC  _Nh_PWM_L6
#srcline 546 ;         Out   := true;
 LD   bool -1       ; true
 WRX  Out
#debug_left bool Out
#srcline 547 ;         Q     := true;
 LD   bool -1       ; true
 WRX  Q
#debug_left bool Q
#srcline 548 ;      END_IF;
_Nh_PWM_L6:
#srcline 549 ;   ELSE
 JMP  _Nh_PWM_L2
_Nh_PWM_L5:
#srcline 550 ;      et    := et - MIN(et,aSys.mSec);
 LDX  et
#debug uint et
 LDX  et
#debug uint et
 LD   aSys~mSec
#debug uint aSys.mSec
 MIN
 SUB
 AND  $FFFF
 WRX  et
#debug_left uint et
#srcline 551 ;      IF et > 0 AND Out AND pls < 100 THEN
 LDX  et
#debug uint et
 LD   uint 0
 GT
 LDX  Out
#debug bool Out
 AND
 LDX  pls
#debug usint pls
 LD   usint 100
 LT
 AND
 JMC  _Nh_PWM_L8
#srcline 552 ;         IF et <= REAL_TO_UINT( UINT_TO_REAL(per) * 0.01 * USINT_TO_REAL(100-pls)) THEN   // zostavanic cas je meni ako doba vypnutia (100-pls)
 LDX  et
#debug uint et
 LDX  per
#debug uint per
 ULF
 LD   real 0.01
 MUF
 LD   usint 100
 LDX  pls
#debug usint pls
 SUB
 AND  $FF
 ULF
 MUF
 RND
 UFW
 GT
 NEG
 JMC  _Nh_PWM_L10
#srcline 553 ;            Out   := false;
 LD   bool 0       ; false
 WRX  Out
#debug_left bool Out
#srcline 554 ;            Q     := true;
 LD   bool -1       ; true
 WRX  Q
#debug_left bool Q
#srcline 555 ;         END_IF;
_Nh_PWM_L10:
#srcline 556 ;      END_IF;
_Nh_PWM_L8:
#srcline 557 ;   END_IF;
_Nh_PWM_L2:
#srcline 558 ;END_FUNCTION_BLOCK
 ULNK
RET
E     61
#endpou 

