 LDX  Qn
#debug uint Qn
 LD   uint 0
 EQ
 JMC  _Nh_FILTER_1R_L8
#srcline 1767 ;		IF ABS(New - Out) > hys THEN
 LDX  New
#debug real New
 LDX  Out
#debug real Out
 SUF
 ABS
 LDX  hys
#debug real hys
 GTF
 JMC  _Nh_FILTER_1R_L10
