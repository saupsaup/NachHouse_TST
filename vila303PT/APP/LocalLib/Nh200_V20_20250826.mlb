  STRUCT
    Nx               : ARRAY [1..8] OF bool :=  [1,0,0,0,0,1];  (*`povolenia pre 1.BTN : 1..5 Click, 6=Push, 7= Hold, 8 Cl1+P*)
  END_STRUCT;
END_TYPE

TYPE NH_LED_WSB {HIDDEN} :
  STRUCT
