#pou _NhSrtVaz
#srcline 704 ;FUNCTION _NhSrtVaz {HIDDEN} : BOOL  // nastavi aktualne zobrazenie pre usra do menu[2], xL^.dsh

#struct _NhSrtVaz__temp__
  udint nw
P     61
_NhSrtVaz_L0:
 LINK __SizeOf(_NhSrtVaz__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc___NhSrtVaz
; End initialize - variables
; Initialize - dynamic variables
; End initialize - dynamic variables
#srcline 715 ;   _NhSrtVaz := true;
 LD   bool -1       ; true
 WRX  __fc___NhSrtVaz
#debug_left bool _NhSrtVaz
#srcline 716 ;   IF poz = new THEN                                                                         // veta s trafila za kopirovanu vetu
 LDX  poz
#debug int poz
 EXTW 
 LDX  new
#debug int new
 EXTW 
 EQ
 JMC  _NhSrtVaz_L1
#srcline 717 ;      RETURN;
 JMP  _NhSrtVaz_RET
#srcline 718 ;   END_IF;
_NhSrtVaz_L1:
#srcline 720 ;//	{ $ IF CPU_CODE = 2000} 	                                                               // pre odkladanie kopirovaneho bloku sa pouzije rychla RAM
#srcline 722 ;//	{ $ ELSE } 	
#srcline 724 ;      IF new > poz THEN                                                                      // nova veta je za pozadovanou poziciou
 LDX  new
#debug int new
 EXTW 
 LDX  poz
#debug int poz
 EXTW 
 GTS
 JMC  _NhSrtVaz_L3
#srcline 725 ;         rj    :=  INT_TO_UDINT(new-poz)*SIZEOF(NH_VAZ);                                      // vekost kopirovnych viet
 LDX  new
#debug int new
 EXTW 
 LDX  poz
#debug int poz
 EXTW 
 SUB
 EXTW
 LD   11  ; SizeOf()
 MUL
 WR   rj
#debug_left udint rj
#srcline 726 ;         va    :=  aVaz[vaz].ram + INT_TO_UDINT(poz-1)*SIZEOF(NH_VAZ);                        // zaciatok bloku viet, ktore sa maju presuvat
 LEA  aVaz
 LDX  vaz
#debug usint vaz
 SUB  1   ; Low range[1]
 RCHK 8   ; Range Check
 MUL  18   ; SizeOf(...)
 ADD     ; + offset 
 ADD  4  ; + offset 
 LDIL 
#debug udint aVaz[vaz].ram
 LDX  poz
#debug int poz
 EXTW 
 LD   int 1
 SUB
 EXTW
 LD   11  ; SizeOf()
 MUL
 ADD
 WR   va
#debug_left udint va
#srcline 727 ;         nw    :=  va + SIZEOF(NH_VAZ);                                                      // kam sa maju nakopirovat presuvane vety
 LD   va
#debug udint va
 LD   11  ; SizeOf()
 ADD
 WRY  nw
#debug_left udint nw
#srcline 728 ;      ELSE
 JMP  _NhSrtVaz_L4
_NhSrtVaz_L3:
#srcline 729 ;         poz   :=  poz - 1;                                                                  // kopiruje sa na vetu, ktora je kopirovna
 LDX  poz
#debug int poz
 EXTW 
 LD   int 1
 SUB
 EXTW
 WRX  poz
#debug_left int poz
#srcline 730 ;         rj    :=  INT_TO_UDINT(poz-new)*SIZEOF(NH_VAZ);                                      // vekost kopirovnych viet
 LDX  poz
#debug int poz
 EXTW 
 LDX  new
#debug int new
 EXTW 
 SUB
 EXTW
 LD   11  ; SizeOf()
 MUL
 WR   rj
#debug_left udint rj
#srcline 731 ;         va    :=  aVaz[vaz].ram + INT_TO_UDINT(new)*SIZEOF(NH_VAZ);                          // zaciatok bloku viet, ktore sa maju presuvat - za pridanu vetu
 LEA  aVaz
 LDX  vaz
#debug usint vaz
 SUB  1   ; Low range[1]
 RCHK 8   ; Range Check
 MUL  18   ; SizeOf(...)
 ADD     ; + offset 
 ADD  4  ; + offset 
 LDIL 
#debug udint aVaz[vaz].ram
 LDX  new
#debug int new
 EXTW 
 LD   11  ; SizeOf()
 MUL
 ADD
 WR   va
#debug_left udint va
#srcline 732 ;         nw    :=  va - SIZEOF(NH_VAZ);                                                      // kam sa maju nakopirovat presuvane vety
 LD   va
#debug udint va
 LD   11  ; SizeOf()
 SUB
 WRY  nw
#debug_left udint nw
#srcline 733 ;      END_IF;
_NhSrtVaz_L4:
#srcline 734 ;      IF _NH_RAM - aDbx.vRam >= rj THEN                                                      // ochrana prednedostatkom pamate
 LD   udint 150000
 LD   udint aDbx~vRam
#debug udint aDbx.vRam
 SUB
 LD   rj
#debug udint rj
 LT
 NEG
 JMC  _NhSrtVaz_L5
#srcline 735 ;         // do volnej pamati sa odlozia zaznamy, ktore sa maju presuvat
#srcline 736 ;         MemCpyEx(length := rj, source := VOID(mRam[va]), dest := VOID( mRam[ aDbx.vRam ] ) );
 NXT
 LD   rj
#debug udint rj
 WR   __Instance__MemcpyEx~length
#debug_left udint __Instance__MemcpyEx~length
 LEA  mRam
 LD   va
#debug udint va
 RCHK 150000   ; Range Check
 ADD     ; + offset 
 WR   __Instance__MemcpyEx~source
#debug_left pointer __Instance__MemcpyEx.source
 LEA  mRam
 LD   udint aDbx~vRam
#debug udint aDbx.vRam
 RCHK 150000   ; Range Check
 ADD     ; + offset 
 WR   __Instance__MemcpyEx~dest
#debug_left pointer __Instance__MemcpyEx.dest
 LD   0
 WR   __Instance__MemcpyEx~offSource
 WR   __Instance__MemcpyEx~offDest
 PRV
 LEA  __Instance__MemcpyEx
#debug pointer __Instance__MemcpyEx ;<debug_call>
 CAL  MemcpyEx_L0
#srcline 737 ;         // odlozene zaznamy sa presunu spat, ale na novu adresu
#srcline 738 ;         MemCpyEX(length := rj, source := VOID( mRam[ aDbx.vRam ] ), dest := VOID(mRam[nw]));
 NXT
 LD   rj
#debug udint rj
 WR   __Instance__MemcpyEx~length
#debug_left udint __Instance__MemcpyEx~length
 LEA  mRam
 LD   udint aDbx~vRam
#debug udint aDbx.vRam
 RCHK 150000   ; Range Check
 ADD     ; + offset 
 WR   __Instance__MemcpyEx~source
#debug_left pointer __Instance__MemcpyEx.source
 LEA  mRam
 LDY  nw
#debug udint nw
 RCHK 150000   ; Range Check
 ADD     ; + offset 
 WR   __Instance__MemcpyEx~dest
#debug_left pointer __Instance__MemcpyEx.dest
 LD   0
 WR   __Instance__MemcpyEx~offSource
 WR   __Instance__MemcpyEx~offDest
 PRV
 LEA  __Instance__MemcpyEx
#debug pointer __Instance__MemcpyEx ;<debug_call>
 CAL  MemcpyEx_L0
#srcline 739 ;         // na ziadanu poziciu sa nakopiruju data odlozenej vety
#srcline 740 ;         MemCpyEX(length := SIZEOF(NH_VAZ), source := VOID( yVaz ), dest := VOID( mRam[ aVaz[vaz].ram + INT_TO_UDINT(poz-1)*SIZEOF(NH_VAZ) ]) );
 NXT
 LD   11  ; SizeOf()
 WR   __Instance__MemcpyEx~length
#debug_left udint __Instance__MemcpyEx~length
 LEA  yVaz
 WR   __Instance__MemcpyEx~source
#debug_left pointer __Instance__MemcpyEx.source
 LEA  mRam
 LEA  aVaz
 LDX  vaz
#debug usint vaz
 SUB  1   ; Low range[1]
 RCHK 8   ; Range Check
 MUL  18   ; SizeOf(...)
 ADD     ; + offset 
 ADD  4  ; + offset 
 LDIL 
#debug udint aVaz[vaz].ram
 LDX  poz
#debug int poz
 EXTW 
 LD   int 1
 SUB
 EXTW
 LD   11  ; SizeOf()
 MUL
 ADD
 RCHK 150000   ; Range Check
 ADD     ; + offset 
 WR   __Instance__MemcpyEx~dest
#debug_left pointer __Instance__MemcpyEx.dest
 LD   0
 WR   __Instance__MemcpyEx~offSource
 WR   __Instance__MemcpyEx~offDest
 PRV
 LEA  __Instance__MemcpyEx
#debug pointer __Instance__MemcpyEx ;<debug_call>
 CAL  MemcpyEx_L0
#srcline 741 ;      ELSE
 JMP  _NhSrtVaz_L6
_NhSrtVaz_L5:
#srcline 742 ;         // error sprava
#srcline 743 ;         aSys.Err_vSrt := rj - (_NH_RAM - aDbx.vRam);
 LD   rj
#debug udint rj
 LD   udint 150000
 LD   udint aDbx~vRam
#debug udint aDbx.vRam
