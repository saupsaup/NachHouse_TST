#srcline 3318 ;			///// toto je pokus 21.12.24 pri oprave stmievania cez DIM {presunute do ELSE}
#srcline 3319 ;			{$IFDEF __NH_DALI}
#srcline 3320 ;			CASE cf OF
#srcline 3321 ;			  	42: 	// DALI MASTER DLma
#srcline 3322 ;						xDLm	:= xDev;
#srcline 3323 ;						IF xDLm^.al.sta < 2 THEN										// NE-bezi QUERY, alebo RND
#srcline 3324 ;							IF cmd = 42 THEN									
#srcline 3325 ;								dlma := INT_TO_USINT(nd);
#srcline 3326 ;     							_Nh_DL_ADD_Task(wht:=2, sha:=255, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);				// rampa
#srcline 3327 ;								_Nh_DL_ADD_Task(wht:=1, sha:=255, lvl:=xDev^.al.IN.val, dlm:=dlma ); // lvl
#srcline 3328 ;								xDLm^.me.lvl255 	:= true;                                                          // priznak mastra
#srcline 3329 ;								xDLm^.me.Rmp255 	:= xDev^.al.rmp;                                                  // aka rampa do vsetkych DLS
#srcline 3330 ;				      	   _NhMemSetPTR(size := SIZEOF(NH_DLM_GRP), dest:= ADR(xDLm^.me.scn) );						// vynuluje sceny
#srcline 3331 ;							ELSE
#srcline 3332 ;								xDLm^.al.In.val 	:= 0.0;											// vynuluje sa, LVL urobi az sumarne DLs
#srcline 3333 ;							END_IF;
#srcline 3334 ;							xDev^.al.OU.val	:= xDev^.al.IN.val;              			
#srcline 3335 ;							xDLm^.al.sta	:= 0;                               			// stav	sa urobi az v DLs	
#srcline 3336 ;						END_IF;
#srcline 3337 ;//						ok3 := 0;                               								// nevyhodnoti sta, to az kazde DEV
#srcline 3339 ;				44:	// DLg sa robi pred DLs ( ballastom )
#srcline 3340 ;    					xDLg 					:= xDev;
#srcline 3341 ;				  		dlma 					:= _Nh_DL_sha(nd:=nd, gr:=true, ma:=true);   // 1..2
#srcline 3342 ;	              	dlsl 					:= _Nh_DL_sha(nd:=nd, gr:=true);     			// 100..115
#srcline 3343 ;						_NhxDLm(dlm:=dlma);															// namapuje xDLm
#srcline 3344 ;						IF xDLm^.me.lvl255 THEN														// prikaz z mastra oznaci len v SW sceny vypnute, nic neposiela do HW
#srcline 3345 ;							xDev^.al.IN.val := 0.0;						
#srcline 3346 ;						ELSIF cmd = 44 THEN									
#srcline 3347 ;	 						IF xDLg^.me.rmp <> xDev^.al.rmp THEN                   		// zmena rampy
#srcline 3348 ;		         			_Nh_DL_ADD_Task(wht:=2, sha:=dlsl, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);			// rampa dp vsetkych ballastov v scene
#srcline 3349 ;	   						xDLg^.me.rmp := xDev^.al.rmp;
#srcline 3350 ;   		   	      END_IF;
#srcline 3351 ;							
#srcline 3352 ;							IF xDev^.al.IN.val > 99.0 THEN								      // zapnut celu scenu na LVL ballastov v scene, na nizsi Level sa drobi v DLs
#srcline 3353 ;								_Nh_DL_ADD_Task(wht:=7, sha:=dlsl, par:=dlsl-100, dlm:=dlma );	// par je GRP 0..15,  sha je skupinova adresa 100..115
#srcline 3354 ;							ELSE	//IF xDev^.al.IN.val = 0. THEN											// len vypnut
#srcline 3355 ;								_Nh_DL_ADD_Task(wht:=1, sha:=dlsl, dlm:=dlma, lvl:=xDev^.al.IN.val );  // sha je skupinova adresa 100..115
#srcline 3356 ;							END_IF;		
#srcline 3358 ;      					// v mastri oznaci, ze bol set sceny
#srcline 3359 ;							xDev^.al.Qx						:= true;									// priznak, ze scena je zapnuta
#srcline 3360 ;							xDLm^.me.scn.SET[dlsl-100] := true;									// priznak nastavene sceny						
#srcline 3361 ;							xDLm^.me.scn.LVL[dlsl-100] := REAL_TO_USINT(xDev^.al.IN.val);
#srcline 3362 ;							xDLm^.me.scn.RMP[dlsl-100] := xDLg^.me.rmp;						//	ramapa do vsetkych SHA					
#srcline 3364 ;						ELSIF xDLm^.me.scn.LVL[dlsl-100] > 0  THEN							// SCN je zapnuta
#srcline 3365 ;							IF xDLm^.me.scn.DEV[dlsl-100] = false THEN						// ziadne DEV v SCN NIE-je zanute aspon na minimum
#srcline 3366 ;								xDLm^.me.scn.LVL[dlsl-100] := 0;									// toto musi byt koli xDlG^.al.in.CMD 	:= 3;
#srcline 3367 ;								xDlG^.al.in.CMD 				:= 3;									// len vypne scenu a resetne casy, ALE NEPOJDE DALEJ DO PRIKAZU !!!
#srcline 3368 ;							END_IF;
#srcline 3369 ;						END_IF;        	
#srcline 3370 ;						xDLm^.me.scn.DEV[dlsl-100] := false;
#srcline 3371 ;						xDev^.al.OU.val	:= xDev^.al.IN.val;
#srcline 3373 ;				43:	// na konci urobi ballast , sumare do mastra aj skontroluje scenu
#srcline 3374 ;						xDLs	:= xDev;
#srcline 3375 ;  		            dlsl 	:= _Nh_DL_sha(nd:=nd);              								// 0..64 pre master
#srcline 3376 ;     					dlma 	:= _Nh_DL_sha(nd:=nd, ma:=true);          						// 1..2
#srcline 3377 ;						_NhxDLm(dlm := dlma);                              					// xDLm
#srcline 3379 ;						IF xDLm^.me.lvl255 THEN															// bol centralny LVL, ma najvyssiu prioritu
#srcline 3380 ;							xDev^.al.In.Val	:= xDLm^.al.Ou.Val;           					// do ballastu zapise LVL z mastra
#srcline 3381 ;     						xDLs^.me.rmp 		:= xDlm^.al.rmp;                             // preberie sa aj rampa, ktoru nastavil master do vsetkych SHA
#srcline 3382 ;							xDev^.al.OU.Val 	:= xDev^.al.IN.Val;									
#srcline 3383 ;						ELSIF cmd = 43 THEN									      					// klasicke dev
#srcline 3384 ;							IF xDLs^.me.rmp <> xDev^.al.rmp THEN
#srcline 3385 ; 								_Nh_DL_ADD_Task(wht:=2, sha:=dlsl, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);
#srcline 3386 ;      						xDLs^.me.rmp := xDev^.al.rmp;
#srcline 3387 ;           				END_IF;
#srcline 3388 ;							_Nh_DL_ADD_Task(wht:=1, sha:=dlsl, lvl:=xDev^.al.IN.val, dlm:=dlma );
#srcline 3389 ;							xDev^.al.OU.Val 	:= xDev^.al.IN.Val;									
#srcline 3390 ;						ELSIF  cmd = 143 THEN 															// len pre xDLs^.cx.cfg.out5inOne
#srcline 3391 ;							xDev^.al.et 	:= 0;
#srcline 3392 ;							xDev^.al.ex 	:= 0;
#srcline 3393 ;	         			xDLs^.al.rmp   := 0;                                        // tu sa nestmieva, ide sa na ON/OFF
#srcline 3394 ;							IF xDLs^.me.rmp <> xDLs^.al.rmp THEN
#srcline 3395 ;  								_Nh_DL_ADD_Task(wht:=2, sha:=dlsl, par:= 20, val:=xDev^.al.rmp, dlm:=dlma);
#srcline 3396 ;       						xDLs^.me.rmp := xDev^.al.rmp;
#srcline 3397 ;	           			END_IF;
#srcline 3398 ;							xDLs^.me.SendDLM := true;
#srcline 3399 ;							_Nh_DL_ADD_Task(wht:=6, sha := dlsl, dlm := dlma, lvl := xDev^.al.IN.Val  );
#srcline 3400 ;							// zistit stav
#srcline 3401 ;							xDev^.al.Ou.Val := 0.0;     											// na zaciatku podhodi sa vypnute			
#srcline 3402 ;							FOR i := 1 TO 5 DO
#srcline 3403 ;								IF xPar^.rgb.lvl[i] > 0 THEN          							// default parameter je namapovany
#srcline 3404 ;//									xDev^.al.Ou.Val := 254;											// ak je nieco z RGBWA zapnute, je cely SHA zapnuty
#srcline 3405 ;									xDev^.al.Ou.Val := 100.;										// ak je nieco z RGBWA zapnute, je cely SHA zapnuty
#srcline 3406 ;									EXIT;
#srcline 3407 ;								END_IF;
#srcline 3408 ;          				END_FOR;
#srcline 3409 ;							xDev^.al.In.Val := 0.0;													// u tohto typu vynuluje vstup
#srcline 3410 ;						
#srcline 3411 ;						// ponastavuje DLg
#srcline 3412 ;						ELSIF xDLs^.cx.scn.grp <> _eBtn15 THEN									// patri do nejakej sceny
#srcline 3413 ;                  	FOR i := 0 TO 15 DO															
#srcline 3414 ;								IF xDLs^.cx.scn.grp[i] THEN										// patri do sceny i
#srcline 3415 ;									_NhxDLg(grp := i, dlm := dlma);								// namapuje scenu	
#srcline 3416 ;									IF xDLm^.me.scn.set[i]	THEN									// scena bola v tomto cykle ON alebo OFF
#srcline 3417 ;										IF xDLg^.al.Ou.Val < 100. THEN                 		// scena pola stmievana, toto dev sa nezaplo/nevyplo 	
#srcline 3418 ;											xDev^.al.IN.Val := xDLg^.al.Ou.Val;					// scena nastavila len lvl, nezapla DEV
#srcline 3419 ;										ELSE
#srcline 3420 ;											xDev^.al.IN.Val := USINT_TO_REAL(xDLs^.cx.scn.lvl[i]);	// toto DLs sa nastavilo na LVL, ktoru ma urcenu v SCENE
#srcline 3421 ;										END_IF;
#srcline 3422 ;										xDLs^.me.rmp 		:= xDLm^.me.scn.RMP[i];				// scena vzdy nastavi rmpu kazdeho DLs
#srcline 3423 ;										xDev^.al.OU.Val 	:= xDev^.al.IN.Val;									
#srcline 3424 ;										xDLm^.me.scn.DEV[i] := true;
#srcline 3425 ;//									ELSIF xDlg^.al.Qx = false THEN								// uz bola vypnuta scena predchadzajucin DEV
#srcline 3426 ;										;
#srcline 3427 ;									ELSIF xDLs^.cx.scn.lvl[i] > 0 AND xDev^.al.Ou.Val > 0. THEN // DEV ma mat uroven a je vypnute
#srcline 3428 ;//										xDlg^.al.Qx 		:= false;
#srcline 3429 ;										xDLm^.me.scn.DEV[i] := true;
#srcline 3430 ;//										xDlG^.al.in.CMD 	:= 3;										// len vypne scenu a resetne casy
#srcline 3432 ;(*
#srcline 3433 ;									ELSIF xDev^.al.Ou.Val = 0 AND xDLs^.cx.scn.lvl[i] > 0 THEN // DEV ma mat uroven a je vypnute
#srcline 3434 ;										xDlg^.al.Qx 		:= false;
#srcline 3435 ;										xDlG^.al.in.CMD 	:= 3;										// len vypne scenu a resetne casy
#srcline 3436 ;*)
#srcline 3437 ;									
#srcline 3438 ;(*
#srcline 3439 ;									ELSIF xDlg^.al.Qx = false THEN
#srcline 3440 ;										;
#srcline 3441 ;									ELSIF xDLg^.al.Ou.Val < 100. THEN                 		// scena pola stmievana, toto dev sa nezaplo/nevyplo 	
#srcline 3442 ;										IF xDev^.al.Ou.Val <> xDLg^.al.Ou.Val THEN  // dev ma iny LVL ak o ma mat v ecene
#srcline 3443 ;											xDlg^.al.Qx 		:= false;
#srcline 3444 ;											xDlG^.al.in.CMD 	:= 3;										// len vypne scenu a resetne casy
#srcline 3445 ;										END_IF;
#srcline 3446 ;									ELSIF REAL_TO_USINT(xDev^.al.Ou.Val) <> xDLs^.cx.scn.lvl[i] THEN  // dev ma iny LVL ak o ma mat v ecene
#srcline 3447 ;										xDlg^.al.Qx 		:= false;
#srcline 3448 ;										xDlG^.al.in.CMD 	:= 3;										// len vypne scenu a resetne casy
#srcline 3449 ;*)
#srcline 3450 ;									END_IF;
#srcline 3451 ;								END_IF;
#srcline 3452 ;							END_FOR;
#srcline 3453 ;						END_IF;
#srcline 3455 ;						IF xDLm^.al.sta < 2 AND xDLm^.me.lvl255 = false THEN         		// zapise priznak do mastra, ak neprebieha CHK alebo nebol centralny prikaz		
#srcline 3456 ;							xDLm^.al.In.Val	:= MAX(xDLm^.al.In.Val, xDev^.al.IN.Val); 	// do mastra zapise hodnotu z ballastu													
#srcline 3457 ; 			  				xDLm^.al.Ou.Val 	:= xDLm^.al.In.Val;                				
#srcline 3458 ;							IF xDLm^.al.Ou.Val > 0.0 THEN
#srcline 3459 ;								xDLm^.al.sta	:= 1;															// az tu sa oznaci master, ze svieti
#srcline 3460 ;							END_IF;
#srcline 3461 ;						END_IF;
#srcline 3462 ;			ELSE
#srcline 3463 ;				xDev^.al.Ou.CMD	:= 0;	
#srcline 3464 ;			END_CASE;
#srcline 3465 ;			{$END_IF}
