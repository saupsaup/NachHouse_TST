__DECL FUNCTION _NhDevRef {HIDDEN} : bool
  VAR_INPUT
    ref              : bool :=  true;
    xR               : PTR_TO NH_RGB;  (*`vacsinou xDev, xPt insk potom konkretne xTgl...*)
  END_VAR
END_FUNCTION

__DECL FUNCTION _Nh_PvValOut {HIDDEN} : usint
  VAR_INPUT
    het              : bool;
    up               : usint;
    pv               : usint;
    reQ              : real;
    val              : real;
    wht              : PTR_TO NH_HET_MODE;
  END_VAR
END_FUNCTION

VAR_GLOBAL
 aCfg AT mRam[_Cfg0] : ARRAY [1..70] OF NH_CFG_CFG := [
			(cfg:='ROM',
                     ver:=1,
                     Siz   := SIZEOF(NH_ROM),                         // 1
                     al    := SIZEOF(NH_ROM.AL),
                     cx    := SIZEOF(NH_ROM.CX),
                     hw    := 0,                         // 1
                     io    := SIZEOF(NH_ROM.IO),                         // 1
                     me    := SIZEOF(NH_ROM.ME),                         // 1
                     cat   := 0,
                     fBr   := 14,
                     fSc   := 204,
                     mWsb  := 1,
                     mnu   := 25,
//                     wh    := 100,        // zobrazenie teploty v browse
                     ar2   := 1,
                     stp   := 0,

                     ref   := 252,
							del   := 1,								
                     imp   := 1,
							bck	:= 1,
							RomIsZone:=1,	

							NbrPoi:=1,
							),
         (cfg:='CAT',
                     ver:=0,
//                     Siz   := SIZEOF(NH_CAT),                         // 1
//                     al    := SIZEOF(NH_CAT.AL),
                     Siz   := 0,                         // 1
                     al    := 0,
                     cx    := 0,
                     hw    := 0,                         // 1
                     me    := 0,                         // 1
                     cat   := 0,
                     ar2   := 1,
