  END_STRUCT;
END_TYPE

TYPE NH_BTN_N {HIDDEN} :
  STRUCT
    new              : usint;  (*`cislo aktualne stlaceneh BTN v HW*)
    old              : usint;  (*`cislo stareho BTN*)
    Click            : usint;  (*`cislo clicku*)
    et               : uint;  (*`beziaci cas*)
    Busy             : bool;  (*`priznak, ze bol aspon raz vyhodnoteny click*)
    End              : bool;  (*`vyslat CMD*)
    Done             : bool;
  END_STRUCT;
END_TYPE

