TYPE NH_WEEK_FROM_TO {HIDDEN} :
  STRUCT  (*`FRM- TIM / RND*)
    week             : NH_DAYS_OF_WEEK;  (*`riadok 2*)
    ValidFrom        : NH_DAT_TIM2 :=  ( txt := [          // riadok 3
						(fn:=0,FgC:=0),							// fn:=0 ... hlavny {1.riadok}
						(),
						(),
						(),
						(wh:=0),
						(wh:=0)
						]);  (*`riadok 3*)
    ValidTo          : NH_DAT_TIM2 :=  ( txt := [            // riadok 4 ToDate
						(fn:=3),							// 0 = riadiaci objekt fn:=2 ... suvisi s 2 ridkom
						(y := y1+900),				// YY
						(y := y1+900),      		// MM
						(y := y1+900),       		// DD
						(wh:=0),   		 							// HH
						(wh:=0),     								// MM
						(),                                 // SS
						(),
						(Wh:=0),                            // 8. navestie
						(y := y1+900, cf:=(n:=532)),			// 8. 'Do'															
						(wh:=0)										// 10. slider je v 2.riadku
						]);  (*`riadok 4 ToDate*)
  END_STRUCT;
END_TYPE

