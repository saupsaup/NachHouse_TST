			 	(wh:=105,x:=145,            w:= 64,h:=64,FgC:=3,BgC:=4,cf:=(n:=203),fn:=276),   	// 8 -> 9 party
			 	(wh:=105,x:=220,            w:= 64,h:=64,FgC:=3,BgC:=4,cf:=(n:=204),fn:=279),   	// 9 -> 10 sviatok
			 	(wh:=105,x:=295,            w:= 64,h:=64,FgC:=3,BgC:=4,cf:=(n:=205),fn:=282)   	//10 -> 11 party
			];
