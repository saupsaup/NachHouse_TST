#srcline 322 ;	         dlsl     := _Nh_DL_sha(nd := xR^.h.cf.n);
#srcline 323 ;   	      dlma     := _Nh_DL_sha(ma := true, nd := xR^.h.cf.n);
#srcline 324 ;				IF new THEN
#srcline 325 ;	            x4o   := ADR(xR^.o.ob[7]);
#srcline 326 ;					IF xM^.set AND xA^.UsrRight > 2 THEN														
#srcline 327 ;						x4o^.wh			:= 107;
#srcline 328 ;	   	         x4o^.obr[1]   	:= USINT_TO_INT( dlsl );
#srcline 329 ;  	      	      IF xDLs^.cx.sta.Present = false THEN
#srcline 330 ;     	      	      x4o^.BgC[1] := 2;
#srcline 331 ;      	         ELSE
#srcline 332 ;  	      	         x4o^.BgC[1] := 5;
#srcline 333 ;     	      	   END_IF;
#srcline 334 ;        	      	IF xDLs^.cx.sta.ErrID > 0 THEN
#srcline 335 ;           	      	x4o^.ok [3] := 1;
#srcline 336 ;               	   x4o^.obr[3] := USINT_TO_INT( xDLs^.cx.sta.ErrID );;
#srcline 337 ;	                  xR^.o.ob[0].FgC := 7;                                 				// cela dlazdica bude cevena
#srcline 338 ;  		            ELSE
#srcline 339 ;     		            x4o^.ok[3]        := 0;
#srcline 340 ;        		         xR^.o.ob[0].FgC   := 1;
#srcline 341 ;           		   END_IF;
#srcline 342 ;	               x4o^.ok[2]  := 1;
#srcline 343 ;  		            x4o^.obr[2] := USINT_TO_INT( dlma );
#srcline 345 ;						IF xR^.h.chk  = false  THEN                                 		// len ked nie je vo vazbach
#srcline 346 ;							xR^.o.ob[5].w  	:= 300;        											// skrati slider {mozno ho out5inOne aj tak prepise}
#srcline 347 ;							xR^.o.ob[6] 		:= _NhBrwObj.dlgl;										// obrazok vseobecneho listu
#srcline 348 ;							IF xDLs^.cx.scn.grp<>_eBtn15 THEN
#srcline 349 ;  	   						xR^.o.ob[6].fn   	:= 334;
#srcline 350 ;							ELSIF xDev^.al.lst THEN
#srcline 351 ;     							xR^.o.ob[6].fn   	:= 192;
#srcline 352 ;							ELSE
#srcline 353 ;     							xR^.o.ob[6].fn   	:= 39;
#srcline 354 ;							END_IF;													       					
#srcline 355 ;						END_IF;
#srcline 356 ;					ELSE
#srcline 357 ;						x4o^.wh			:= 0;						
#srcline 358 ;					END_IF;
#srcline 360 ;						IF xDls^.cx.cfg.out5inOne THEN
#srcline 361 ;							xR^.o.ob[5] 		:= _NhBrwObj.rgbwa;										// RGBWA namiesto slidera
#srcline 362 ;							xR^.o.ob[5].wh		:= 121;
#srcline 363 ;							xR^.o.ob[4].fn		:= 124;
#srcline 364 ;							xR^.o.ob[4].cm		:= 74;	                                       // otvori priradenie RGBWA k DEV
#srcline 365 ;							xR^.o.ob[2].cm 	:= 249;														// posle prikaz ON/OFF pre 5in1, hoci je aj chk						
#srcline 366 ;						END_IF;
#srcline 369 ;					IF xR^.h.chk THEN
#srcline 370 ;						_NhxPt(c := xF^.cf.c, n := xF^.cf.n,x:=432);
#srcline 371 ;						IF xF^.cf.c = 44 THEN                                			// do DLg
#srcline 372 ;							// DLs v scene nema parameter, nastavuje sa len LVL v strukture
#srcline 373 ;	     					dlgr := _Nh_DL_sha(gr:=1,nd := xF^.cf.n)-100 ;				// 0..15
#srcline 374 ;							_Nh_Frm_Row_O13(ob:=5, t:=1, vb:=PTR_TO_UDINT(ADR(xDLs^.cx.scn.LVL[ dlgr ])) );
#srcline 375 ;							xR^.o.ob[2].cm 	:= 0;
#srcline 376 ;						ELSIF xDls^.cx.cfg.out5inOne THEN
#srcline 377 ;							IF xF^.cf.c = 8 THEN													// zatial len pre TVE
#srcline 378 ;								xR^.o.ob[6] 		:= _NhBrwObj.srgbwa;							// led na sebe = ktory port {RGBWA} je priradeny k DEV v hlavicke
#srcline 379 ;								xR^.o.ob[6].cm 	:= 251;											// posle prikaz ON/OFF pre 5in1						
#srcline 380 ;								_NhxPt(c:=xF^.cf.c, n:=xF^.cf.n, x:=-154);
#srcline 381 ;								xTve := xPt;
#srcline 382 ;								_Nh_DEF_VAR(wh:=20, o:=6, x:=ADR(xTve^.io[0].dev.o));				
#srcline 383 ;							ELSE
#srcline 384 ;								xR^.o.ob[6].wh 	:= 0;											// nebude zobrazovat vyber konkretnej farby
#srcline 385 ;							END_IF;
#srcline 386 ;						ELSIF _Nh_IO_MAP(cIo:=xF^.cf.c, Dev:=xR^.h.cf.c)  THEN
#srcline 387 ;							_Nh_Frm_Row_O13(ob:=5, t:=0, vb:=PTR_TO_UDINT(ADR( xPtIOa^.val ) ));
#srcline 388 ;							xR^.o.ob[2].cm 	:= 0;
#srcline 389 ;						ELSIF xR^.o.ob[4].cf.c = 15 THEN                                				// check PIR ma prednost
#srcline 390 ;      					xR^.o.ob[5].wh 	:= 0;
#srcline 391 ;						ELSIF _NhxPar(cp := aCfg[xR^.h.cf.c].par , np := xR^.h.cf.p,x:=-1006) THEN		// SCN,ACT,BLK
#srcline 392 ;							_Nh_Frm_Row_O13(ob:=5, t:=1, vb:=PTR_TO_UDINT(ADR(xPar^.all.lvl)) );											
#srcline 393 ;						ELSE
#srcline 394 ;							xR^.o.ob[5].wh := 0;								
#srcline 395 ;							xR^.o.ob[2].cm := 0;								
#srcline 396 ;						END_IF;
#srcline 398 ;(*
#srcline 399 ;					ELSIF xDls^.cx.cfg.out5inOne THEN								// do TVE, bude zobrazena RGBWA +
#srcline 400 ;						xR^.o.ob[5] 		:= _NhBrwObj.rgbwa;											// obrazok vseobecneho listu
#srcline 401 ;						xR^.o.ob[5].wh		:= 121;
#srcline 402 ;						xR^.o.ob[2].cm 	:= 249;													// posle prikaz ON/OFF pre 5in1						
#srcline 403 ;*)
#srcline 404 ;					END_IF;
#srcline 406 ;				ELSIF	xR^.h.chk THEN
#srcline 407 ;						IF xF^.cf.c = 44 THEN                                		// do DLg
#srcline 408 ;      					dlgr := _Nh_DL_sha(gr:=1,nd := xF^.cf.n)-100 ;				// 0..15
#srcline 409 ;							IF  xR^.o.ob[2].tch THEN												// prepnut LVL s status - LVL je uz zapisany v parametri
#srcline 410 ;								xDLs^.cx.scn.LVL[ dlgr ] := xPar^.all.lvl;
#srcline 411 ;							END_IF;
#srcline 412 ;							IF xR^.o.ob[2].tch OR (xR^.o.ob[5].tch AND xA^.tch.Qf) THEN
#srcline 413 ;//		                  _Nh_DL_ADD_Task(wht:=  4, par:= 1, sha := dlsl , val := dlGr+100, dlm := dlma  );	// prida ballast do sceny, hoci tam uz moze byt
#srcline 414 ;//      		            _Nh_DL_ADD_Task(wht:=102, par := dlgr,  	//   scena		0..15                    	// nastavi LVL pre ballast v scene
#srcline 415 ;      		            _Nh_DL_ADD_Task(wht:=2, par := dlgr,  	//   scena		0..15                    	// nastavi LVL pre ballast v scene
#srcline 416 ;         	                                   	sha := dlsl,    //   ballast	0..63
#srcline 417 ;            	                                	val := REAL_TO_USINT(USINT_TO_REAL(xDLs^.cx.scn.LVL[ dlgr ])*2.45) ,
#srcline 418 ;               	                             	dlm := dlma );
#srcline 419 ;							END_IF;
#srcline 420 ;						END_IF;
#srcline 421 ;				ELSIF xDls^.cx.cfg.out5inOne THEN								// do TVE, bude zobrazena RGBWA +
#srcline 422 ;					;
#srcline 423 ;//					xR^.o.ob[4].fn	:= 124;
#srcline 424 ;//					xR^.o.ob[4].cm	:= 76;	
#srcline 426 ;				ELSE
#srcline 427 ;					_Nh_Frm_Row_O13(ob:=5, t:=0, vb:=PTR_TO_UDINT(ADR(xDev^.al.in.val)) );											
#srcline 428 ;				END_IF;
#srcline 430 ;				IF xDls^.cx.cfg.out5inOne THEN
#srcline 431 ;						;
#srcline 432 ;				ELSE
#srcline 433 ;					_Nh_Frm_STA_OU(obj:=2, o:=8);											// ikony nad stavovym obrazkom
#srcline 434 ;				END_IF;
#srcline 436 ;      44: // DLg
#srcline 437 ;			      // 56:  DLs ->  DLg		... v hlavicke je DLsa v riadkoc su sceny do ktorych moze ist
#srcline 438 ;				   xDLg     := xDev;
#srcline 439 ;   	         dlma     := _Nh_DL_sha(gr:=1, ma := true, nd := xR^.h.cf.n);            // master
#srcline 440 ;      	      dlgr     := _Nh_DL_sha(gr:=1, nd := xR^.h.cf.n)-100;                    // cislo GRP - 100 prevedie na 0..15
#srcline 441 ;					xDLg^.al.lst	:= xDLg^.cx.Sta.Present;											// dolezitejsi je Present, je aj po restarte aktivny
#srcline 442 ;	            x4o   := ADR(xR^.o.ob[7]);
#srcline 443 ;       			IF xR^.h.chk  THEN
#srcline 444 ;						IF xF^.cf.c = 43  THEN																// DLs v hlavicke do tejto sceny
#srcline 445 ;							IF _NhXPt(c:=xF^.cf.c, n:=xF^.cf.n,x:=-135) THEN
#srcline 446 ;								xDLs := xPt;
#srcline 447 ;					         dlsl     := _Nh_DL_sha(nd := xF^.cf.n);
#srcline 448 ;								_Nh_Frm_Row_O13(ob:=5, t:=1, vb:=PTR_TO_UDINT(ADR(xDLs^.cx.scn.lvl[dlgr])) );					
#srcline 449 ;								IF (xR^.o.ob[5].tch AND xA^.tch.Qf) THEN
#srcline 450 ;      			            _Nh_DL_ADD_Task(wht:=2,par := dlgr,  	//   scena		0..15                    	// nastavi LVL pre ballast v scene
#srcline 451 ;         		                                   sha := dlsl,    //   ballast	0..63
#srcline 452 ;            		                                val := REAL_TO_USINT(USINT_TO_REAL( xDLs^.cx.scn.LVL[ dlgr ])*2.45),
#srcline 453 ;               		                             dlm := dlma );
#srcline 454 ;								END_IF;
#srcline 455 ;							ELSE
#srcline 456 ;								xR^.o.ob[5].wh := 0;
#srcline 457 ;							END_IF;
#srcline 458 ;						ELSIF xR^.o.ob[4].cf.c <>  15 THEN
#srcline 459 ;		         	   _Nh_Frm_Row_O13(off:=xR^.h.pir, ob:=5);						
#srcline 460 ;						END_IF;
#srcline 462 ;					ELSE
#srcline 463 ;	         	   _Nh_Frm_Row_O13(off:=xR^.h.pir, ob:=5);
#srcline 464 ;//		            xR^.o.ob[5].BgC := _Nh_U12(xDLg^.al.ou.val=254.0,6,5);                   // slider - aktivovana SCN je oranzova, inak zlta
#srcline 465 ;		            xR^.o.ob[5].BgC := _Nh_U12(xDLg^.al.ou.val=100.0,6,5);                   // slider - aktivovana SCN je oranzova, inak zlta
#srcline 466 ;					END_IF;
#srcline 468 ;					IF xM^.set AND xA^.UsrRight > 2 THEN														
#srcline 469 ;							x4o^.wh	:= 107;
#srcline 470 ;      		         x4o^.obr[1]   := USINT_TO_INT( dlgr );
#srcline 471 ;         		      IF xDLg^.cx.sta.Present = false THEN
#srcline 472 ;            		      x4o^.BgC[1] := 2;
#srcline 473 ;	          	     	ELSE
#srcline 474 ;   	         	      x4o^.BgC[1] := 6;
#srcline 475 ;	   	            END_IF;
#srcline 476 ;   	   	         IF xDLg^.cx.sta.ErrID > 0 THEN
#srcline 477 ;      	   	         x4o^.ok [3] := 1;
#srcline 478 ;         	   	      x4o^.obr[3] := USINT_TO_INT( xDLg^.cx.sta.ErrID );;
#srcline 479 ;            	   	   xR^.o.ob[0].FgC := 7;                                 // cela dlazdica bude cevena
#srcline 480 ;	               	ELSE
#srcline 481 ;		                  x4o^.ok[3]        := 0;
#srcline 482 ;   		               xR^.o.ob[0].FgC   := 1;
#srcline 483 ;      		         END_IF;
#srcline 484 ;         		      x4o^.ok[2]  := 1;
#srcline 485 ;            		   x4o^.obr[2] := USINT_TO_INT( dlma );
#srcline 487 ;                  IF xR^.o.ob[4].cf.c = 15 THEN
#srcline 488 ;   			         xR^.o.ob[5].wh 	:= 0;
#srcline 489 ;						ELSIF xR^.o.ob[6].wh <> 1 THEN
#srcline 490 ;   						xR^.o.ob[6] 		:= _NhBrwObj.list;											// obrazok vseobecneho listu
#srcline 491 ;	     	            xR^.o.ob[6].fn   	:= _Nh_O12(in := xDev^.al.lst , o1:=192, o2:=39); // LIST zeleny/sivy
#srcline 492 ;						   xR^.o.ob[5].w  	:= 300;        												// skrati slider
#srcline 493 ;						END_IF;
#srcline 495 ;   				ELSE
#srcline 496 ;						x4o^.wh	:= 0;
#srcline 497 ;   				END_IF;
#srcline 503 ;(*
