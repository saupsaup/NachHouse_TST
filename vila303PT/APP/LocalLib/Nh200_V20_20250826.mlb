 ADD  21  ; + offset 
 LDX  up
#debug usint up
 RCHK 1   ; Range Check
 MUL  3   ; Num items[2]
 LD   i
#debug usint i
 SUB  1  ; Low range[2]
 RCHK 2   ; Range Check
 ADD
 MUL  4   ; SizeOf(...)
 ADD     ; + offset 
 LDIL 
#debug real wht^.hys[up,i]
 WR   kr
#debug_left real kr
#srcline 2415 ;(*
#srcline 2416 ;		IF up THEN
#srcline 2417 ;			kr		:= wht^.hys.up[i];
#srcline 2418 ;		ELSE
#srcline 2419 ;			kr		:= wht^.hys.dn[i];	
#srcline 2420 ;		END_IF;
#srcline 2421 ;*)
#srcline 2422 ;		IF het THEN														// kurenie	
 LDX  het
#debug bool het
 JMC  _Nh_PvValOut_L3
#srcline 2424 ;(*      	
#srcline 2425 ;					UP                 		DN
#srcline 2426 ;			23.3  0.                      0.
#srcline 2427 ;			23.2  0.                      0.
#srcline 2428 ;			23.1  0.                 		1.	<= [23+0.1=23.1]
#srcline 2429 ;			23.0  0 --------------------- 1.
#srcline 2430 ;			22.9	0.                      2.	<= [23-0.1=22.9]
#srcline 2431 ;			22.8  0.                      2.
#srcline 2432 ;			22.7  0.                      2.
#srcline 2433 ;			22.6	0.	                     2.
#srcline 2434 ;			22.5  1.	<= [23-0.5=22.5]     2.
#srcline 2435 ;			22.4  1.                      2.
#srcline 2436 ;			22.3  1.                      3.	<= [23-0.7=22.3]
#srcline 2437 ;			22.2  1.                      3.
#srcline 2438 ;			22.1  1.                      3.
#srcline 2439 ;			22.0  2.	<= [23-1.0=22.0]     3.
#srcline 2440 ;			21.9  2.                      3.
#srcline 2441 ;			21.8  2.                      3.
#srcline 2442 ;			21.7  2.
#srcline 2443 ;			21.6  2.
#srcline 2444 ;			21.5  2.
#srcline 2445 ;			21.4  2.
#srcline 2446 ;			21.3  2.
#srcline 2447 ;			21.2  2.
#srcline 2448 ;			21.1  2.
#srcline 2449 ;			21.0  3.	<= [23-2.0=21.0]
#srcline 2450 ;			20.9	3.	
#srcline 2451 ;*)
#srcline 2453 ;//			IF val <= reQ - kr THEN
#srcline 2454 ;			IF val <= reQ + kr THEN
 LDX  val
#debug real val
 LDX  reQ
#debug real reQ
 LD   kr
#debug real kr
 ADF
 GTF
 NEG
 JMC  _Nh_PvValOut_L5
#srcline 2455 ;				EXIT;
 JMP  _Nh_PvValOut_L2
#srcline 2456 ;			END_IF;
_Nh_PvValOut_L5:
#srcline 2457 ;		ELSIF	pv = 0 THEN												// pri chladenie/vetrani/odvlhceni je PV=0 OFF	
 JMP  _Nh_PvValOut_L4
_Nh_PvValOut_L3:
 LDX  pv
#debug usint pv
 LD   usint 0
 EQ
 JMC  _Nh_PvValOut_L7
#srcline 2458 ;			i := 1;
 LD   usint 1
 WR   i
#debug_left usint i
#srcline 2459 ;		ELSIF val >= reQ + kr THEN
 JMP  _Nh_PvValOut_L4
_Nh_PvValOut_L7:
 LDX  val
#debug real val
 LDX  reQ
#debug real reQ
 LD   kr
#debug real kr
 ADF
 LTF
 NEG
 JMC  _Nh_PvValOut_L8
#srcline 2460 ;			EXIT;
 JMP  _Nh_PvValOut_L2
#srcline 2461 ;		END_IF;
 JMP  _Nh_PvValOut_L4
_Nh_PvValOut_L8:
_Nh_PvValOut_L4:
#srcline 2462 ;		i := i-1;
 LD   i
#debug usint i
 LD   usint 1
 SUB
 AND  $FF
 WR   i
#debug_left usint i
#srcline 2463 ;	END_WHILE;
 JMP  _Nh_PvValOut_L1
_Nh_PvValOut_L2:
 NOP  -1
#srcline 2464 ;	_Nh_PvValOut := i;				
 LD   i
#debug usint i
 WRX  __fc___Nh_PvValOut
#debug_left usint _Nh_PvValOut
#srcline 2465 ;END_FUNCTION
 PRV  
 LDX  __fc___Nh_PvValOut
 ULNK
RET
E     61
#endpou 


