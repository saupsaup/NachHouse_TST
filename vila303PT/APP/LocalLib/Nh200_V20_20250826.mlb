#srcline 537 ;//            xR^.o.ob[5].h     :=  52;
#srcline 538 ;//            xR^.o.ob[5].cf.c  :=  xWsb^.cx.LedNbr-1;
#srcline 539 ;         ELSE
 JMP  _NhSetWSB_L8
_NhSetWSB_L9:
#srcline 540 ;            xR^.o.ob[5].cf.c  :=  3;
 LD   usint 3
 LEA  xR
 LDIL    ; dereference 
 ADD  181  ; + offset 
 WRI 
#debug_left usint xR^.o.ob[5].cf.c
#srcline 541 ;      END_CASE;
_NhSetWSB_L8:
#srcline 542 ;      xR^.o.ob[5].FgC   :=   2;
 LD   usint 2
 LEA  xR
 LDIL    ; dereference 
 ADD  170  ; + offset 
 WRI 
#debug_left usint xR^.o.ob[5].FgC
#srcline 543 ;//      xPtD  := ADR( xR^.o.ob[5].cf.n) ;
#srcline 544 ;//      xPtD^ := PTR_TO_UDINT(ADR(xWsb^.cx.Led[1])) ;                     // adresa zoznamu DayMode
#srcline 545 ;   ELSE
 JMP  _NhSetWSB_L4
_NhSetWSB_L7:
#srcline 546 ;      xR^.o.ob[5].wh    :=  0;
 LD   usint 0
 LEA  xR
 LDIL    ; dereference 
 ADD  158  ; + offset 
 WRI 
#debug_left usint xR^.o.ob[5].wh
#srcline 547 ;   END_IF;
_NhSetWSB_L4:
#srcline 548 ;//         blk               := xR^.h.chk = false;                                       // blk len ked nie je vo vazbe
#srcline 549 ;   IF aCfg[ xR^.h.cf.c].tgrp = 13 THEN                                                    // vo vazbe nie je v riadku wsb
 LEA  aCfg
 LEA  xR
 LDIL    ; dereference 
 LDI  
#debug usint xR^.h.cf.c
 SUB  1   ; Low range[1]
 RCHK 69   ; Range Check
 MUL  52   ; SizeOf(...)
 ADD     ; + offset 
 ADD  25  ; + offset 
 LDI  
#debug usint aCfg[xR^.h.cf.c].tgrp
 LD   usint 13
 EQ
 JMC  _NhSetWSB_L10
#srcline 550 ;      xR^.o.ob[ 2].w    := 72;                                                      // zvacsi sa velkot obrazka PIR-On (088)
 LD   int 72
 LEA  xR
 LDIL    ; dereference 
 ADD  73  ; + offset 
 WRIW 
#debug_left int xR^.o.ob[2].w
#srcline 551 ;      xR^.o.ob[ 2].fn   := xR^.o.ob[ 1].fn;                                         // zvacsi sa velkot obrazka PIR-On (088)
 LEA  xR
 LDIL    ; dereference 
 ADD  48  ; + offset 
 LDIW 
#debug int xR^.o.ob[1].fn
 EXTW 
 LEA  xR
 LDIL    ; dereference 
 ADD  78  ; + offset 
 WRIW 
#debug_left int xR^.o.ob[2].fn
#srcline 552 ;      IF xDev^.al.ou.Val > 0.0 THEN                                                 // v riadku je WSB
 LEA  xDev
 LDIL    ; dereference 
 ADD  44  ; + offset 
 LDIL 
#debug real xDev^.al.ou.Val
 LD   real 0.0
 GTF
 JMC  _NhSetWSB_L12
#srcline 553 ;         xR^.o.ob[2].wh    :=  10;
 LD   usint 10
 LEA  xR
 LDIL    ; dereference 
 ADD  68  ; + offset 
 WRI 
#debug_left usint xR^.o.ob[2].wh
#srcline 554 ;         xR^.o.ob[2].BgC   :=  3;                                                   // zlta
 LD   usint 3
 LEA  xR
 LDIL    ; dereference 
 ADD  81  ; + offset 
 WRI 
#debug_left usint xR^.o.ob[2].BgC
#srcline 555 ;         xR^.o.ob[2].FgC   :=  REAL_TO_USINT(xWsb^.al.ou.Val);                                          // cislo BTN z parametra vazby
 LEA  xWsb
 LDIL    ; dereference 
 ADD  44  ; + offset 
 LDIL 
#debug real xWsb^.al.ou.Val
 RND
 UFW
 AND  $FF
 LEA  xR
 LDIL    ; dereference 
 ADD  80  ; + offset 
 WRI 
#debug_left usint xR^.o.ob[2].FgC
#srcline 556 ;      ELSE
 JMP  _NhSetWSB_L13
_NhSetWSB_L12:
#srcline 557 ;         xR^.o.ob[2].wh    :=  0;
 LD   usint 0
 LEA  xR
 LDIL    ; dereference 
 ADD  68  ; + offset 
 WRI 
#debug_left usint xR^.o.ob[2].wh
#srcline 558 ;      END_IF;
_NhSetWSB_L13:
#srcline 559 ;   END_IF;
_NhSetWSB_L10:
#srcline 560 ;END_FUNCTION
 PRV  
 LDX  __fc___NhSetWSB
 ULNK
RET
E     61
#endpou 

#pou _Nh_Chk_OFF
#srcline 562 ;FUNCTION _Nh_Chk_OFF  {HIDDEN} : BOOL         // ak je filter [8]:= 49,51,57  filtruje len zapnute/ vypnute
P     61
_Nh_Chk_OFF_L0:
 LINK 0
 NXT
; Initialize - variables
 LD   0
 WRX  __fc___Nh_Chk_OFF
; End initialize - variables
#srcline 566 ;   _Nh_Chk_OFF := true;
 LD   bool -1       ; true
 WRX  __fc___Nh_Chk_OFF
#debug_left bool _Nh_Chk_OFF
#srcline 567 ;   IF xU^.o[8].fn = 49  THEN                          // bez filtra
 LEA  xU
 LDIL    ; dereference 
 ADD  101  ; + offset 
 LDIW 
#debug int xU^.o[8].fn
 EXTW 
 LD   int 49
 EQ
 JMC  _Nh_Chk_OFF_L1
#srcline 568 ;      ;
#srcline 569 ;   ELSIF xU^.o[8].fn = 57 THEN                        // v rom/zon filtrujew let kde je pritomnost / pohyb
 JMP  _Nh_Chk_OFF_L2
_Nh_Chk_OFF_L1:
 LEA  xU
 LDIL    ; dereference 
 ADD  101  ; + offset 
 LDIW 
#debug int xU^.o[8].fn
 EXTW 
 LD   int 57
 EQ
 JMC  _Nh_Chk_OFF_L3
#srcline 570 ;      xRom  := xDev;
 LEA  xDev
 LDIL 
#debug pointer xDev
 LEA  xRom
 WRIL 
#debug_left pointer xRom
#srcline 571 ;      yes   := yes AND xRom^.me.BodyQ;
 LD   yes
#debug bool yes
 LEA  xRom
 LDIL    ; dereference 
 ADD  197  ; + offset 
 MUL  8   ; -> bool pointer 
 ADD  2   ; Bool offset 
 LDIB 
#debug bool xRom^.me.BodyQ
 AND
 WR   yes
#debug_left bool yes
#srcline 572 ;   ELSIF xU^.o[8].fn = 51 THEN
 JMP  _Nh_Chk_OFF_L2
_Nh_Chk_OFF_L3:
 LEA  xU
 LDIL    ; dereference 
 ADD  101  ; + offset 
 LDIW 
#debug int xU^.o[8].fn
 EXTW 
 LD   int 51
 EQ
 JMC  _Nh_Chk_OFF_L4
#srcline 573 ;   	yes := yes AND xDev^.al.sta > 0;                   // vacsina pripadov
 LD   yes
#debug bool yes
 LEA  xDev
 LDIL    ; dereference 
 ADD  50  ; + offset 
 LDI  
#debug usint xDev^.al.sta
 LD   usint 0
 GT
 AND
 WR   yes
#debug_left bool yes
#srcline 574 ;	END_IF;
 JMP  _Nh_Chk_OFF_L2
_Nh_Chk_OFF_L4:
_Nh_Chk_OFF_L2:
#srcline 575 ;(*
#srcline 576 ;      IF yIdxR.dev.c = 2 THEN                          // riadok je CAT
#srcline 577 ;         _NhxRoW(nbr:=xA^.sbj, zon:=true);                         // namapuje xRow na Domcek alebo ak sa pouzivaju subjekty tak na subjekt-byt
#srcline 578 ;         yes :=  yes AND xRoW^.cat[ yIdxR.dev.n ];
#srcline 579 ;      ELSE
#srcline 580 ;         yes := yes AND xDev^.al.ou.val > 0.0;                   // vacsina pripadov
#srcline 581 ;      END_IF;
#srcline 582 ;   END_IF;
#srcline 583 ;*)
#srcline 584 ;END_FUNCTION
 PRV  
 LDX  __fc___Nh_Chk_OFF
 ULNK
RET
E     61
#endpou 

