    Qr               : bool;  (*`xA^.trg.Qr*)
    Qf               : bool;  (*`xA^.trg.Qf*)
    Qs               : bool;  (*`toto pouziva objekt, nenastavuje sa nikde - koniec dotyku slidera, ....*)
