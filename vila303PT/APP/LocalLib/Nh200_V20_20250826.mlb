    mno              : ARRAY [1..2] OF NH_OBJ_MNU;  (*`zalohovanie horneho riadka pri editacii*)
    mnu              : ARRAY [0..3] OF NH_MNU;  (*`menu*)
    lvd              : ARRAY [0..3] OF NH_LVL;  (*`data jednotlivych vnoreni (level=lv)*)
