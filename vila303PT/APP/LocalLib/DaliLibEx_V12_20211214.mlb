#srcline 49 ;    Err   := false; ErrID := 0;                  // nulovat chybu
 LD   bool 0       ; false
 WRX  Err
#debug_left bool Err
 LD   usint 0
 WRX  ErrID
#debug_left usint ErrID
#srcline 50 ;    Busy  := true; Done := false;
 LD   bool -1       ; true
