    command          : usint;
    data             : usint;
  END_STRUCT;
END_TYPE

TYPE tStat_Ball :
  STRUCT
    BallastSate      : bool;  (*`0ë=OK,  Ballast State*)
    LampFailure      : bool;  (*`0ë=OK,  Lamp Failure*)
    LampPowerOn      : bool;  (*`0ë=Off, Lamp Power On*)
    LimitError       : bool;  (*`0ë=Off, Limit Error*)
    TerminateFading  : bool;  (*`0ë=Terminate Fading*)
    ResetState       : bool;  (*`0ë=No, Reset State*)
    MissingShortAddr : bool;  (*`0ë=No, Missing Short Address*)
    PowerFailure     : bool;  (*`0ë=No, Power Failure*)
  END_STRUCT;
END_TYPE

TYPE tBallast_DALI :
  STRUCT
    StatBall         : tStat_Ball;
    ViewScene        : usint;  (*`pom. pro zobrazenÌ na Webu*)
    NumScene         : usint;  (*`pom. cislo zobrazovanÈ scÈny*)
    ActualLevel      : usint;
    PowONLevel       : usint;
    FailLevel        : usint;
    MinLevel         : usint;
    MaxLevel         : usint;
    FadeRate         : usint;
    FadeTime         : usint;
    ShortAddr        : usint;
    Groupe0_7        : byte;
    Groupe8_15       : byte;
    Scene            : ARRAY [0..15] OF usint;
    Status           : usint;
    Version          : usint;  (*`ROM*)
    PhyMinLevel      : usint;  (*`ROM*)
  END_STRUCT;
END_TYPE

TYPE tBallast_DALI_64 :
  STRUCT
    DataOK           : ARRAY [0..63] OF bool;  (*`kter˝ je UpDate*)
    Present          : ARRAY [0..63] OF bool;  (*`kter˝ je p¯Ìtomen*)
    PresentErr       : ARRAY [0..63] OF bool;  (*`kter˝ je s chybou dva na stejnÈ adrese*)
    Ballast          : ARRAY [0..63] OF tBallast_DALI;  (*`data balast˘*)
  END_STRUCT;
END_TYPE

