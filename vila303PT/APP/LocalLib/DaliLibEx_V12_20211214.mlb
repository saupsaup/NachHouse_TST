    Aktiv            : bool;  (*`- ShAdr obsazena*)
    AktivErr         : bool;  (*`- ShAdr obsazena vÌce p¯ed¯adnÌk˘*)
    NoAktiv          : bool;  (*`- ShAdr nenÌ obsazena*)
    ClrGroupe        : bool;  (*`- smaz·nÌ Groupe p¯ed¯adnÌk˘*)
    ClrAll           : bool;  (*`- smaz·nÌ vöech ShAdr p¯ed¯adnÌk˘*)
    ShortAdr         : usint;  (*`{ENG} Processed Short Address {CSY}Zpracov·van· Short Address*)
    State            : usint;  (*`internal state*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_0012Sin;
    C_DL_ModuleOut   : tC_DL_0012Sout;
  END_VAR
  VAR
    TM_Rnd_St        : TON;
    TM_WD_State      : TON;  (*`timeOut stavu*)
    Exec_old         : bool;
    Auto_Man_old     : bool;
    Clear_ShAdr_old  : bool;
    State_old        : usint;
    MemShortAdr      : usint;  (*`odloûen· ShAdr*)
    Transciever {HIDDEN} : fb_DL_Transceiver;
    Blinking         : fb_DL_Blink;
  END_VAR
END_FUNCTION_BLOCK

