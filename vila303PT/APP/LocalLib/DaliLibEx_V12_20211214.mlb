 CAL  TON_L0
#srcline 68 ;  IF TM_WD_State.Q THEN State :=0; END_IF;
 LDX  TM_WD_State~Q
#debug bool TM_WD_State.Q
 JMC  fb_DL_RNDAddr_L5
 LD   usint 0
 WRX  State
#debug_left usint State
fb_DL_RNDAddr_L5:
#srcline 69 ;  TM_Rnd_St( PT := T#200ms);    //  Wait100
 LD   time 200
 WRX  TM_Rnd_St~PT
#debug_left time TM_Rnd_St~PT
