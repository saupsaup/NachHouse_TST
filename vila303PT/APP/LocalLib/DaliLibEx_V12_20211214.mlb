#srcline 32 ;  IF Enable AND NOT Enable_old THEN State := 4;   END_IF;    // Start blink
 LDX  Enable
#debug bool Enable
 LDX  Enable_old
#debug bool Enable_old
 NEG
 AND
 JMC  fb_DL_Blink_L1
 LD   usint 4
 WRX  State
#debug_left usint State
fb_DL_Blink_L1:
#srcline 33 ;  IF NOT Enable AND Enable_old THEN State := 7;   END_IF;    // Off
 LDX  Enable
#debug bool Enable
 NEG
 LDX  Enable_old
#debug bool Enable_old
 AND
 JMC  fb_DL_Blink_L3
 LD   usint 7
 WRX  State
#debug_left usint State
fb_DL_Blink_L3:
#srcline 34 ;  IF ShAdr <> ShortAdr   THEN State := 8;   END_IF;    // zmÏna
 LDX  ShAdr
#debug usint ShAdr
 LDX  ShortAdr
#debug usint ShortAdr
 EQ
 NEG
 JMC  fb_DL_Blink_L5
 LD   usint 8
 WRX  State
#debug_left usint State
fb_DL_Blink_L5:
#srcline 36 ;  CASE State OF
 LDX  State
#debug usint State
 WRY  P0__st__
 LD   0
 LDY  P0__st__
 EQ  
 JMC  fb_DL_Blink_L8
#srcline 37 ;     0  :                    // klid
#srcline 38 ;          Busy := false;
 LD   bool 0       ; false
 WRX  Busy
#debug_left bool Busy
#srcline 39 ;          Done := false;
 LD   bool 0       ; false
 WRX  Done
#debug_left bool Done
#srcline 40 ;          State := 0; Transciever.Enable := 0; TM_Blink.IN :=0; Status := 0;
 LD   usint 0
 WRX  State
#debug_left usint State
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
 LD   bool 0       ; false
 WRX  TM_Blink~IN
#debug_left bool TM_Blink.IN
 LD   bool 0       ; false
 WRX  Status
#debug_left bool Status
 JMP  fb_DL_Blink_L7
fb_DL_Blink_L8:
 LD   4
 LDY  P0__st__
 EQ  
 JMC  fb_DL_Blink_L9
#srcline 41 ;     4  :  // Query Actual Level
#srcline 42 ;         Transciever.command := 160;Transciever.Adr_Oper := ShAdr; Transciever.Enable := 1;
 LD   int 160
 WRX  Transciever~command
#debug_left int Transciever.command
 LDX  ShAdr
#debug usint ShAdr
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
 LD   bool -1      ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 43 ;         IF Transciever.Done THEN
 LDX  Transciever~Done
#debug bool Transciever.Done
 JMC  fb_DL_Blink_L10
#srcline 44 ;           ActualLevel := Transciever.Output; Transciever.Enable := 0;
 LDX  Transciever~Output
#debug usint Transciever.Output
 WRX  ActualLevel
#debug_left usint ActualLevel
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 45 ;           State := 5;
 LD   usint 5
 WRX  State
#debug_left usint State
#srcline 46 ;         ELSIF Transciever.Err THEN
 JMP  fb_DL_Blink_L11
fb_DL_Blink_L10:
 LDX  Transciever~Err
#debug bool Transciever.Err
 JMC  fb_DL_Blink_L12
#srcline 47 ;           State := 5;
 LD   usint 5
 WRX  State
#debug_left usint State
#srcline 48 ;         END_IF;
 JMP  fb_DL_Blink_L11
fb_DL_Blink_L12:
fb_DL_Blink_L11:
 JMP  fb_DL_Blink_L7
fb_DL_Blink_L9:
 LD   5
 LDY  P0__st__
 EQ  
 JMC  fb_DL_Blink_L13
#srcline 49 ;     5  :  // MaxLevel   Blik·nÌ 1
#srcline 50 ;         Transciever.command := 5; Transciever.Adr_Oper := ShAdr; Transciever.Enable := 1;
 LD   int 5
 WRX  Transciever~command
#debug_left int Transciever.command
 LDX  ShAdr
#debug usint ShAdr
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
 LD   bool -1      ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 51 ;         TM_Blink.IN :=1;  Busy :=1; Status := 1;                 // start ËasovaËe
 LD   bool -1      ; true
 WRX  TM_Blink~IN
#debug_left bool TM_Blink.IN
 LD   bool -1      ; true
 WRX  Busy
#debug_left bool Busy
 LD   bool -1      ; true
 WRX  Status
#debug_left bool Status
#srcline 52 ;         IF TM_Blink.Q THEN  TM_Blink.IN := 0; State := 6; Transciever.Enable := 0;END_IF;
 LDX  TM_Blink~Q
#debug bool TM_Blink.Q
 JMC  fb_DL_Blink_L14
 LD   bool 0       ; false
 WRX  TM_Blink~IN
#debug_left bool TM_Blink.IN
 LD   usint 6
 WRX  State
#debug_left usint State
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
fb_DL_Blink_L14:
 JMP  fb_DL_Blink_L7
fb_DL_Blink_L13:
 LD   6
 LDY  P0__st__
 EQ  
 JMC  fb_DL_Blink_L16
#srcline 53 ;     6  :  // Off (MinLevel)   Blik·nÌ 0
#srcline 54 ;//         Transciever.command := 6;Transciever.Adr_Oper := ShAdr; Transciever.Enable := 1;
#srcline 55 ;         Transciever.command := 0;Transciever.Adr_Oper := ShAdr; Transciever.Enable := 1;
 LD   int 0
 WRX  Transciever~command
#debug_left int Transciever.command
 LDX  ShAdr
#debug usint ShAdr
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
 LD   bool -1      ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 56 ;         TM_Blink.IN :=1; Status := 0;                            // start ËasovaËe
 LD   bool -1      ; true
 WRX  TM_Blink~IN
#debug_left bool TM_Blink.IN
 LD   bool 0       ; false
 WRX  Status
#debug_left bool Status
#srcline 57 ;         IF TM_Blink.Q THEN
 LDX  TM_Blink~Q
#debug bool TM_Blink.Q
 JMC  fb_DL_Blink_L17
#srcline 58 ;           TM_Blink.IN := 0; State := 5; Transciever.Enable := 0;                        //
 LD   bool 0       ; false
 WRX  TM_Blink~IN
#debug_left bool TM_Blink.IN
 LD   usint 5
 WRX  State
#debug_left usint State
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 59 ;           IF NOT Enable THEN State := 7; Done := 1; END_IF;     // ukonËÌ
 LDX  Enable
#debug bool Enable
 NEG
 JMC  fb_DL_Blink_L19
 LD   usint 7
 WRX  State
#debug_left usint State
 LD   bool -1      ; true
 WRX  Done
#debug_left bool Done
fb_DL_Blink_L19:
#srcline 60 ;         END_IF;
fb_DL_Blink_L17:
 JMP  fb_DL_Blink_L7
fb_DL_Blink_L16:
 LD   7
 LDY  P0__st__
 EQ  
 JMC  fb_DL_Blink_L21
#srcline 61 ;     7   :  // Off
#srcline 62 ;         Transciever.command := -1;Transciever.Adr_Oper := ShortAdr; Transciever.Enable := 1;
 LD   int -1
 WRX  Transciever~command
#debug_left int Transciever.command
 LDX  ShortAdr
#debug usint ShortAdr
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
 LD   bool -1      ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 63 ;         Transciever.Power := ActualLevel;  // vr·tit p˘vodnÌ hodnotu
 LDX  ActualLevel
#debug usint ActualLevel
 WRX  Transciever~Power
#debug_left usint Transciever.Power
#srcline 64 ;         IF Transciever.Done THEN
 LDX  Transciever~Done
#debug bool Transciever.Done
 JMC  fb_DL_Blink_L22
#srcline 65 ;           State := 0;   Done := 1;
 LD   usint 0
 WRX  State
#debug_left usint State
 LD   bool -1      ; true
 WRX  Done
#debug_left bool Done
#srcline 66 ;         END_IF;
fb_DL_Blink_L22:
 JMP  fb_DL_Blink_L7
fb_DL_Blink_L21:
 LD   8
 LDY  P0__st__
 EQ  
 JMC  fb_DL_Blink_L24
#srcline 67 ;     8   :  // return ActualLevel ShortAdr
#srcline 68 ;         Transciever.command := -1;Transciever.Adr_Oper := ShortAdr; Transciever.Enable := 1;
 LD   int -1
 WRX  Transciever~command
#debug_left int Transciever.command
 LDX  ShortAdr
#debug usint ShortAdr
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
 LD   bool -1      ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 69 ;         Transciever.Power := ActualLevel;  // vr·tit p˘vodnÌ hodnotu
 LDX  ActualLevel
#debug usint ActualLevel
 WRX  Transciever~Power
#debug_left usint Transciever.Power
#srcline 70 ;         IF Transciever.Done THEN
 LDX  Transciever~Done
#debug bool Transciever.Done
 JMC  fb_DL_Blink_L25
#srcline 71 ;           State := 4; Transciever.Enable := 0;
 LD   usint 4
 WRX  State
#debug_left usint State
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 72 ;         END_IF;
fb_DL_Blink_L25:
 JMP  fb_DL_Blink_L7
fb_DL_Blink_L24:
fb_DL_Blink_L7:
#srcline 75 ;  Enable_old := Enable; ShortAdr:= ShAdr;
 LDX  Enable
#debug bool Enable
 WRX  Enable_old
#debug_left bool Enable_old
 LDX  ShAdr
#debug usint ShAdr
 WRX  ShortAdr
#debug_left usint ShortAdr
#srcline 77 ;  
#srcline 78 ;//------------------------------------------------------------------
#srcline 79 ;END_FUNCTION_BLOCK
 ULNK
RET
E     61

