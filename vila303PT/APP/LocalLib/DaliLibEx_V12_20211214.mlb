TYPE TStatC_DL_0012S {HIDDEN} :
  STRUCT
    dummy0 {HIDDEN}  : bool;
    dummy1 {HIDDEN}  : bool;
    RNDOK            : bool;
    SHS              : bool;
    RRE              : bool;  (*`odpovÏ°s chybou*)
    RRF              : bool;  (*`kladn· odpovÏÔ*)
    Done             : bool;  (*`hotov· odpovÏÔ ( kladn·, z·porn·, s_chybou)*)
    ARC              : bool;  (*`alternace*)
  END_STRUCT;
END_TYPE

TYPE TContC_DL_0012S {HIDDEN} :
  STRUCT
    LENM             : bool;
    DBL              : bool;
    RNDS             : bool;
    CHS              : bool;
    dummy4 {HIDDEN}  : bool;  (*`pouûit jako semafor busy vysÌlacÌho buferu C_DL_0012Sout*)
    dummy5 {HIDDEN}  : bool;
    TRG              : bool;  (*`vyslat zpr·vu*)
