 JMP  fb_DL_WebSetting_L2
fb_DL_WebSetting_L1:
#srcline 121 ;      numBal := 64;
 LD   usint 64
 WRX  numBal
#debug_left usint numBal
#srcline 122 ;    END_IF;
fb_DL_WebSetting_L2:
#srcline 124 ;//*******************************************************************
#srcline 125 ;    Show_FlashAddr  := bt_RND;
 LDX  bt_RND
#debug bool bt_RND
 WRX  Show_FlashAddr
#debug_left bool Show_FlashAddr
#srcline 126 ;    Show_Bt_Enter   := bt_RND;
 LDX  bt_RND
#debug bool bt_RND
 WRX  Show_Bt_Enter
#debug_left bool Show_Bt_Enter
#srcline 127 ;    Show_Bt_Yes     := NOT bt_RND AND Bt_Cancel;
 LDX  bt_RND
#debug bool bt_RND
 NEG
 LDX  Bt_Cancel
#debug bool Bt_Cancel
 AND
 WRX  Show_Bt_Yes
#debug_left bool Show_Bt_Yes
#srcline 128 ;    Show_Bt_No      := NOT bt_RND AND Bt_Cancel;
 LDX  bt_RND
#debug bool bt_RND
 NEG
 LDX  Bt_Cancel
#debug bool Bt_Cancel
 AND
 WRX  Show_Bt_No
#debug_left bool Show_Bt_No
#srcline 129 ;    Show_Bt_Cancel  := NOT bt_RND AND (k<>numBal) AND NOT bt_flash AND NOT bt_Present AND NOT bt_UpDate;
 LDX  bt_RND
#debug bool bt_RND
 NEG
 LDX  k
#debug usint k
 LDX  numBal
#debug usint numBal
 EQ
 NEG
 AND
 LDX  bt_flash
#debug bool bt_flash
 NEG
 AND
 LDX  bt_Present
#debug bool bt_Present
 NEG
 AND
 LDX  bt_UpDate
#debug bool bt_UpDate
 NEG
 AND
 WRX  Show_Bt_Cancel
#debug_left bool Show_Bt_Cancel
#srcline 130 ;    Show_Bt_Auto    := bt_RND;
 LDX  bt_RND
#debug bool bt_RND
 WRX  Show_Bt_Auto
#debug_left bool Show_Bt_Auto
#srcline 131 ;    Show_Bt_Flash   := NOT bt_RND;
 LDX  bt_RND
#debug bool bt_RND
 NEG
 WRX  Show_Bt_Flash
#debug_left bool Show_Bt_Flash
#srcline 133 ;    IF Show_Dspl_WakeUp THEN
 LDX  Show_Dspl_WakeUp
#debug bool Show_Dspl_WakeUp
 JMC  fb_DL_WebSetting_L3
#srcline 134 ;      Show_Dspl_WakeUp := 0; Show_Dspl_WakeUp_RND :=1;
 LD   bool 0       ; false
 WRX  Show_Dspl_WakeUp
#debug_left bool Show_Dspl_WakeUp
 LD   bool -1      ; true
 WRX  Show_Dspl_WakeUp_RND
#debug_left bool Show_Dspl_WakeUp_RND
#srcline 135 ;      Show_Dspl_ShA   :=1; k := SetShAddr.ShAdr;
 LD   bool -1      ; true
 WRX  Show_Dspl_ShA
#debug_left bool Show_Dspl_ShA
 LDX  SetShAddr~ShAdr
#debug usint SetShAddr.ShAdr
 WRX  k
#debug_left usint k
