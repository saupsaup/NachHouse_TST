    C_DL_ModuleOut   : tC_DL_0012Sout;
  END_VAR
  VAR
    Transciever {HIDDEN} : fb_DL_Transceiver;
    First            : bool;
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_DL_RNDAddr
(*`{ENG}RND addressing{CSY}RND adresace*)
  VAR_INPUT
    Exec             : bool;  (*`{ENG} execute{CSY} vykonat*)
    ShAdr            : usint;  (*`{ENG} manually assigned ShortAdr{CSY} manualnÏ p¯idÏlen· ShortAdr*)
    Enter            : bool R_EDGE;  (*`{ENG} enter ShAdr{CSY} potvrdit ShAdr*)
    Auto_Man         : bool;  (*`{ENG} ShortAdr assigned  0.. manual, 1.. automatically {CSY} ShortAdr p¯idÏlovat  0.. manualnÏ, 1.. automaticky*)
    All              : bool;  (*`{ENG} 1..all included in addressing RND, 0..only without ShAdr{CSY} 1..vöechny za¯adit do RND adresace, 0..pouze bez ShAdr*)
    One              : bool;  (*`{ENG} 1..one included in addressing RND, 0..only without ShAdr{CSY} 1..jeden  za¯adit do RND adresace, 0..pouze bez ShAdr*)
    Clear_ShAdr      : bool R_EDGE;  (*`{ENG} clear ShAdr or 255..cleared all {CSY} smazat ShAdr nebo 255.. smaûe vöechny*)
    MaxAdr           : usint :=  63;
