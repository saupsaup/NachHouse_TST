#srcline 116 ;    COUNTER_10MS    :=  System_S.COUNTER_10MS;
 LD   System_S~COUNTER_10MS
#debug usint System_S.COUNTER_10MS
 WRX  COUNTER_10MS
#debug_left usint COUNTER_10MS
#srcline 117 ;    PERIOD_1SEC     :=  System_S.PERIOD_PULSE_1SEC;
 LD   System_S~PERIOD_PULSE_1SEC
#debug bool System_S.PERIOD_PULSE_1SEC
 WRX  PERIOD_1SEC
#debug_left bool PERIOD_1SEC
#srcline 118 ;    IF C_DL_64or12  THEN
 LDX  C_DL_64or12
#debug bool C_DL_64or12
 JMC  fb_DL_WebSetting_L1
#srcline 119 ;      numBal := 12;
 LD   usint 12
 WRX  numBal
#debug_left usint numBal
