#srcline 72 ;    Transciever.Adr_Oper := Address;
 LDX  Address
#debug usint Address
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
#srcline 73 ;    Transciever.Enable := 1;
 LD   bool -1      ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 74 ;  END_IF;
fb_DL_Query_L1:
#srcline 75 ;//------------------------------------------------------------------
#srcline 76 ;  Transciever( Global_DALI_in := C_DL_ModuleIn, Global_DALI_out := C_DL_ModuleOut, Err =>Err, ErrID => ErrID);   // vysÌlaË DALI
 LDX  C_DL_ModuleIn
 WRX  Transciever~Global_DALI_in
#debug_left pointer Transciever.Global_DALI_in
 LDX  C_DL_ModuleOut
 WRX  Transciever~Global_DALI_out
#debug_left pointer Transciever.Global_DALI_out
 LEAX Transciever
 CAL  fb_DL_Transceiver_L0
; output assigment 
 LDX  Transciever~Err
#debug bool Transciever~Err
 WRX  Err
#debug_left bool Err
 LDX  Transciever~ErrID
#debug usint Transciever~ErrID
 WRX  ErrID
#debug_left usint ErrID
#srcline 77 ;  Enable_old := Enable;
 LDX  Enable
#debug bool Enable
 WRX  Enable_old
#debug_left bool Enable_old
#srcline 78 ;  IF Transciever.Done THEN
 LDX  Transciever~Done
#debug bool Transciever.Done
 JMC  fb_DL_Query_L44
#srcline 79 ;    Transciever.Enable := 0;
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 80 ;	  IF What = 20 THEN
 LDX  What
#debug usint What
 LD   usint 20
 EQ
 JMC  fb_DL_Query_L46
#srcline 81 ;      Output := BYTE_TO_USINT(SHR(USINT_TO_BYTE(Transciever.Output),4) AND 16#0F); //FADE TIME kladn· odpovÏd s daty
 LDX  Transciever~Output
#debug usint Transciever.Output
 AND  $FF
 LD   uint 4
 SHR
 AND  $FF
 LD   byte $0F
 AND
 WRX  Output
#debug_left usint Output
#srcline 82 ;	  ELSIF What = 21 THEN
 JMP  fb_DL_Query_L47
fb_DL_Query_L46:
 LDX  What
#debug usint What
 LD   usint 21
 EQ
 JMC  fb_DL_Query_L48
#srcline 83 ;      Output := BYTE_TO_USINT(USINT_TO_BYTE(Transciever.Output) AND 16#0F);        //FADE RATE kladn· odpovÏd s daty
 LDX  Transciever~Output
#debug usint Transciever.Output
 AND  $FF
 LD   byte $0F
 AND
 WRX  Output
#debug_left usint Output
#srcline 84 ;	  ELSE
 JMP  fb_DL_Query_L47
fb_DL_Query_L48:
#srcline 85 ;      Output := Transciever.Output;           // kladn· odpovÏd s daty
 LDX  Transciever~Output
#debug usint Transciever.Output
 WRX  Output
