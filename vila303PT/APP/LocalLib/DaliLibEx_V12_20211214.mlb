#srcfile ''
#srcfile 'D:\TECOLIBSRC\DALILIBEX\DALILIBEX\MASKTONUMBER.ST'
#pou MaskToNumber
#srcline 1 ;FUNCTION MaskToNumber {HIDDEN}: USINT

#struct MaskToNumber__temp__
  pointer ptrArray,
  pointer ptrArrayEnd
P     61
MaskToNumber_L0:
 LINK __SizeOf(MaskToNumber__temp__)
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__MaskToNumber
; End initialize - variables
; Initialize - dynamic variables
 LD   udint $FFFFFFFF    ; nil
 WRY  ptrArray
 LD   udint $FFFFFFFF    ; nil
 WRY  ptrArrayEnd
; End initialize - dynamic variables
#srcline 14 ;    ptrArray := ADR(BoolAray); ptrArrayEnd := ptrArray + USINT_TO_UDINT(size);
 LDX  BoolAray
#debug pointer BoolAray
 LEAY ptrArray
 WRIL 
#debug_left pointer ptrArray
 LEAY ptrArray
 LDIL 
#debug pointer ptrArray
 LDX  size
#debug usint size
 ADD
 LEAY ptrArrayEnd
 WRIL 
#debug_left pointer ptrArrayEnd
#srcline 15 ;    WHILE PTR_TO_UDINT(ptrArray) <> PTR_TO_UDINT(ptrArrayEnd) DO
MaskToNumber_L1:
 LEAY ptrArray
 LDIL 
#debug pointer ptrArray
 LEAY ptrArrayEnd
 LDIL 
#debug pointer ptrArrayEnd
 EQ
 NEG
 JMC  MaskToNumber_L2
 DBG 
#srcline 16 ;      IF ptrArray^ THEN
 LEAY ptrArray
 LDIL    ; dereference 
 LDIB 
#debug bool ptrArray^
 JMC  MaskToNumber_L3
#srcline 17 ;        EXIT;
 JMP  MaskToNumber_L2
#srcline 18 ;      END_IF;
MaskToNumber_L3:
#srcline 19 ;      ptrArray := ptrArray + 1;
 LEAY ptrArray
 LDIL 
#debug pointer ptrArray
 LD   udint 1
 ADD
 LEAY ptrArray
 WRIL 
#debug_left pointer ptrArray
#srcline 20 ;    END_WHILE;
 JMP  MaskToNumber_L1
MaskToNumber_L2:
 NOP  -1
#srcline 21 ;    MaskToNumber := size - UDINT_TO_USINT(PTR_TO_UDINT(ptrArrayEnd) - PTR_TO_UDINT(ptrArray));
 LDX  size
#debug usint size
 LEAY ptrArrayEnd
 LDIL 
#debug pointer ptrArrayEnd
 LEAY ptrArray
 LDIL 
#debug pointer ptrArray
 SUB
 AND  $FF
 SUB
 AND  $FF
 WRX  __fc__MaskToNumber
#debug_left usint MaskToNumber
#srcline 22 ;END_FUNCTION
 PRV  
 LDX  __fc__MaskToNumber
 ULNK
RET
E     61
#endpou 



 

#srcfile ''
#srcfile 'D:\TECOLIBSRC\DALILIBEX\DALILIBEX\F_DL_LEVEL_TO_POWER.ST'
#pou fc_DL_Level_To_Power
#srcline 1 ;FUNCTION fc_DL_Level_To_Power : USINT
P     61
fc_DL_Level_To_Power_L0:
 LINK 0
 NXT
; Initialize - variables
 LD   0
 WRX  __fc__fc_DL_Level_To_Power
; End initialize - variables
#srcline 10 ;    IF lin_log THEN                        // korekce logaritmickou funkcÌ pro DALI (graf kap.2.1. fb_DL_Direct)
 LDX  lin_log
#debug bool lin_log
 JMC  fc_DL_Level_To_Power_L1
#srcline 11 ;      fc_DL_Level_To_Power := REAL_TO_USINT( log( level + 0.0973066) * 84.333333 + 85.333333);
 LDX  level
#debug real level
 LD   real 0.0973066
 ADF
 LOG
 LD   real 84.333333
 MUF
 LD   real 85.333333
 ADF
 RND
 UFW
 AND  $FF
 WRX  __fc__fc_DL_Level_To_Power
#debug_left usint fc_DL_Level_To_Power
#srcline 12 ;    ELSE
 JMP  fc_DL_Level_To_Power_L2
fc_DL_Level_To_Power_L1:
#srcline 13 ;      fc_DL_Level_To_Power := REAL_TO_USINT( level * 2.54);
 LDX  level
#debug real level
 LD   real 2.54
 MUF
 RND
 UFW
 AND  $FF
 WRX  __fc__fc_DL_Level_To_Power
#debug_left usint fc_DL_Level_To_Power
#srcline 14 ;    END_IF;
fc_DL_Level_To_Power_L2:
#srcline 15 ;END_FUNCTION
 PRV  
 LDX  __fc__fc_DL_Level_To_Power
 ULNK
RET
E     61
#endpou 



 

#srcfile ''
#srcfile 'D:\TECOLIBSRC\DALILIBEX\DALILIBEX\FB_DL_TRANSCEIVER.ST'
#pou fb_DL_Transceiver
#srcline 1 ;FUNCTION_BLOCK fb_DL_Transceiver {HIDDEN}
P     61
fb_DL_Transceiver_L0:
 LINK 0
#srcline 39 ;  IF Enable AND NOT Busy THEN
 LDX  Enable
#debug bool Enable
 LDX  Busy
#debug bool Busy
 NEG
 AND
 JMC  fb_DL_Transceiver_L1
#srcline 40 ;    IF (command <> command_old) OR (Power <> Power_old) OR (Adr_Oper <> Adr_Oper_old) OR (Enable AND NOT Enable_old) THEN        // nov˝ p¯Ìkaz  nebo nov˝ operand
 LDX  command
#debug int command
 EXTW 
 LDX  command_old
#debug int command_old
 EXTW 
 EQ
 NEG
 LDX  Power
#debug usint Power
 LDX  Power_old
#debug usint Power_old
 EQ
 NEG
 OR  
 LDX  Adr_Oper
#debug usint Adr_Oper
 LDX  Adr_Oper_old
#debug usint Adr_Oper_old
 EQ
 NEG
 OR  
 LDX  Enable
#debug bool Enable
 LDX  Enable_old
#debug bool Enable_old
 NEG
 AND
 OR  
 JMC  fb_DL_Transceiver_L3
#srcline 41 ;      NewMessage.cont.CHS := 0;
 LD   bool 0       ; false
 WRX  NewMessage~cont~CHS
#debug_left bool NewMessage.cont.CHS
#srcline 42 ;      NewMessage.cont.TRG := 0;
 LD   bool 0       ; false
 WRX  NewMessage~cont~TRG
#debug_left bool NewMessage.cont.TRG
#srcline 43 ;      NewMessage.cont.LENM := 0;                    // z·kladnÌ prostÈ p¯Ìkazy 2 byte
 LD   bool 0       ; false
 WRX  NewMessage~cont~LENM
#debug_left bool NewMessage.cont.LENM
#srcline 44 ;      NewMessage.cont.DBL := (command > 31 AND command < 129) OR command = 258 OR command = 259; // dvojitÈ p¯Ìkazy
 LDX  command
#debug int command
 EXTW 
 LD   int 31
 GTS
 LDX  command
#debug int command
 EXTW 
 LD   int 129
 LTS
 AND
 LDX  command
#debug int command
 EXTW 
 LD   int 258
 EQ
 OR  
 LDX  command
#debug int command
 EXTW 
 LD   int 259
 EQ
 OR  
 WRX  NewMessage~cont~DBL
#debug_left bool NewMessage.cont.DBL
#srcline 45 ;      RqMes:= true; ErrID := 0;
 LD   bool -1       ; true
 WRX  RqMes
#debug_left bool RqMes
 LD   usint 0
 WRX  ErrID
#debug_left usint ErrID
#srcline 46 ;      NewMessage.cont.TRG := 1;
 LD   bool -1      ; true
 WRX  NewMessage~cont~TRG
#debug_left bool NewMessage.cont.TRG
#srcline 47 ;      Answer := 0;                                   // Ëek·nÌ na odpovÏd
 LD   bool 0       ; false
 WRX  Answer
#debug_left bool Answer
#srcline 48 ;      
#srcline 49 ;      IF command = -2  THEN                          // ----Hled·nÌ RND adresy
 LDX  command
#debug int command
 EXTW 
 LD   int -2
 EQ
 JMC  fb_DL_Transceiver_L5
#srcline 50 ;        NewMessage.address := Adr_Oper;              // nastavovan· kr·tk· adresa
 LDX  Adr_Oper
#debug usint Adr_Oper
 WRX  NewMessage~address
#debug_left usint NewMessage.address
#srcline 51 ;        NewMessage.command := Power;                 // maska z·kazu programov·nÌ(v·ha 0), bez Query(v·ha 1) a Withdraw(v·ha 2)
 LDX  Power
#debug usint Power
 WRX  NewMessage~command
#debug_left usint NewMessage.command
#srcline 52 ;        NewMessage.cont.CHS := 1;
 LD   bool -1      ; true
 WRX  NewMessage~cont~CHS
#debug_left bool NewMessage.cont.CHS
#srcline 53 ;        NewMessage.cont.TRG := 0;
 LD   bool 0       ; false
 WRX  NewMessage~cont~TRG
#debug_left bool NewMessage.cont.TRG
#srcline 55 ;      ELSIF command = -1  THEN                       // ----Direct power control
 JMP  fb_DL_Transceiver_L6
fb_DL_Transceiver_L5:
 LDX  command
#debug int command
 EXTW 
 LD   int -1
 EQ
 JMC  fb_DL_Transceiver_L7
#srcline 56 ;        IF Adr_Oper = 255 THEN                       // globalnÌ adresa
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 255
 EQ
 JMC  fb_DL_Transceiver_L8
#srcline 57 ;           NewMessage.address := 16#FE;
 LD   usint $FE
 WRX  NewMessage~address
#debug_left usint NewMessage.address
#srcline 58 ;        ELSIF Adr_Oper < 64 THEN                     // ShortAddress
 JMP  fb_DL_Transceiver_L9
fb_DL_Transceiver_L8:
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 64
 LT
 JMC  fb_DL_Transceiver_L10
#srcline 59 ;           NewMessage.address := WORD_TO_USINT(USINT_TO_WORD(Adr_Oper * 2) AND 16#FE)+0;
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 2
 MUL
 AND  $FF
 LD   word $FE
 AND
 AND  $FF
 LD   usint 0
 ADD
 AND  $FF
 WRX  NewMessage~address
#debug_left usint NewMessage.address
#srcline 60 ;        ELSIF (Adr_Oper > 99) AND (Adr_Oper < 116) THEN  // GroupAddress  Skupinov· adresa (0..15)+64
 JMP  fb_DL_Transceiver_L9
fb_DL_Transceiver_L10:
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 99
 GT
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 116
 LT
 AND
 JMC  fb_DL_Transceiver_L11
#srcline 61 ;           NewMessage.address := WORD_TO_USINT(USINT_TO_WORD((Adr_Oper - 100 +64) *2))+0;
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 100
 SUB
 AND  $FF
 LD   usint 64
 ADD
 AND  $FF
 LD   usint 2
 MUL
 AND  $FF
 AND  $FF
 LD   usint 0
 ADD
 AND  $FF
 WRX  NewMessage~address
#debug_left usint NewMessage.address
#srcline 62 ;        ELSE
 JMP  fb_DL_Transceiver_L9
fb_DL_Transceiver_L11:
#srcline 63 ;           RqMes:= 0;                                // nepoöle zpr·vu adresa je mimo
 LD   bool 0       ; false
 WRX  RqMes
#debug_left bool RqMes
#srcline 64 ;           NewMessage.cont.TRG := 0;
 LD   bool 0       ; false
 WRX  NewMessage~cont~TRG
#debug_left bool NewMessage.cont.TRG
#srcline 65 ;        END_IF;
fb_DL_Transceiver_L9:
#srcline 66 ;        NewMessage.command := Power;                 // power 0..254, beze zmÏny 255
 LDX  Power
#debug usint Power
 WRX  NewMessage~command
#debug_left usint NewMessage.command
#srcline 68 ;      ELSIF (command >-1) AND  (command < 256) THEN      // ----Undirect, Query, Extendet
 JMP  fb_DL_Transceiver_L6
fb_DL_Transceiver_L7:
 LDX  command
#debug int command
 EXTW 
 LD   int -1
 GTS
 LDX  command
#debug int command
 EXTW 
 LD   int 256
 LTS
 AND
 JMC  fb_DL_Transceiver_L12
#srcline 69 ;        IF Adr_Oper = 255 THEN                       // globalnÌ adresa
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 255
 EQ
 JMC  fb_DL_Transceiver_L13
#srcline 70 ;           NewMessage.address := 16#FF;
 LD   usint $FF
 WRX  NewMessage~address
#debug_left usint NewMessage.address
#srcline 71 ;        ELSIF Adr_Oper < 64 THEN                     // ShortAddress   kr·tk· adresa 0..63
 JMP  fb_DL_Transceiver_L14
fb_DL_Transceiver_L13:
 LDX  Adr_Oper
#debug usint Adr_Oper
 LD   usint 64
 LT
 JMC  fb_DL_Transceiver_L15
