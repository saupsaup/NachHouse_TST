#srcline 137 ;    ELSE
 JMP  fb_DL_WebSetting_L4
fb_DL_WebSetting_L3:
#srcline 138 ;      Show_Dspl_ShA   := (NOT (k = numBal) AND NOT bt_RND) OR (SetShAddr.State=6 AND (System_S.PERIOD_PULSE_1SEC OR Show_Dspl_WakeUp_RND) AND bt_RND  ) OR UpDate OR Present OR Bt_Cancel;
 LDX  k
#debug usint k
 LDX  numBal
#debug usint numBal
 EQ
 NEG
 LDX  bt_RND
#debug bool bt_RND
 NEG
 AND
 LDX  SetShAddr~State
