 WRX  Show_Dspl_ShA
#debug_left bool Show_Dspl_ShA
#srcline 139 ;    END_IF;
fb_DL_WebSetting_L4:
#srcline 141 ;    IF SetShAddr.State<>6 OR NOT bt_RND THEN Show_Dspl_WakeUp_RND :=0; END_IF;
 LDX  SetShAddr~State
#debug usint SetShAddr.State
