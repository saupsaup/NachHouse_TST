#srcfile ''
#srcfile 'D:\TECOLIBSRC\DALILIBEX\DALILIBEX\FB_DL_ADDRESS.ST'
#pou fb_DL_Address
#srcline 1 ;FUNCTION_BLOCK fb_DL_Address
P     61
fb_DL_Address_L0:
 LINK 0
; R_EDGE, F_EDGE 
 LDX  ShortAddr
 LETX __EDGE_R__ShortAddr
 WRX  ShortAddr
 LDX  AddToGroupe
 LETX __EDGE_R__AddToGroupe
 WRX  AddToGroupe
 LDX  RemGroupe
 LETX __EDGE_R__RemGroupe
 WRX  RemGroupe
#srcline 26 ;  Done := 0; Err := 0;
 LD   bool 0       ; false
 WRX  Done
#debug_left bool Done
 LD   bool 0       ; false
 WRX  Err
#debug_left bool Err
#srcline 27 ;  IF ShortAddr OR AddToGroupe OR RemGroupe OR First THEN  // zmÏna  odeöle nov˝ p¯Ìkaz
 LDX  ShortAddr
#debug bool ShortAddr
 LDX  AddToGroupe
#debug bool AddToGroupe
 OR  
 LDX  RemGroupe
#debug bool RemGroupe
 OR  
 LDX  First
#debug bool First
 OR  
 JMC  fb_DL_Address_L1
#srcline 28 ;    Busy := 1;
 LD   bool -1      ; true
 WRX  Busy
#debug_left bool Busy
#srcline 29 ;    IF ShortAddr AND NOT First THEN
 LDX  ShortAddr
#debug bool ShortAddr
 LDX  First
#debug bool First
 NEG
 AND
 JMC  fb_DL_Address_L3
#srcline 30 ;      Transciever.Enable  := true;
 LD   bool -1       ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 31 ;      First := 1;
 LD   bool -1      ; true
 WRX  First
#debug_left bool First
#srcline 32 ;      Transciever.Command  := 257;     // UloûÌ 8 bit˘ XXXX XXXX do DTR vöech ballast˘ 257-DATA TRANSFER REGISTER (DTR)
 LD   int 257
 WRX  Transciever~Command
#debug_left int Transciever.Command
#srcline 33 ;      IF Value = 255 THEN
 LDX  Value
#debug usint Value
 LD   usint 255
 EQ
 JMC  fb_DL_Address_L5
#srcline 34 ;        Transciever.Adr_Oper := 255;
 LD   usint 255
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
#srcline 35 ;      ELSE
 JMP  fb_DL_Address_L6
fb_DL_Address_L5:
#srcline 36 ;        Transciever.Adr_Oper := WORD_TO_USINT(USINT_TO_WORD(Value) AND 16#3F) *2 +1; // zadan· hodnota ShAddress do DTR
 LDX  Value
#debug usint Value
 LD   word $3F
 AND
 AND  $FF
 LD   usint 2
 MUL
 AND  $FF
 LD   usint 1
 ADD
 AND  $FF
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
#srcline 37 ;      END_IF;
fb_DL_Address_L6:
#srcline 38 ;    END_IF;
fb_DL_Address_L3:
#srcline 39 ;    IF (Transciever.Done OR Transciever.Err) AND First THEN
 LDX  Transciever~Done
#debug bool Transciever.Done
 LDX  Transciever~Err
#debug bool Transciever.Err
 OR  
 LDX  First
#debug bool First
 AND
 JMC  fb_DL_Address_L7
#srcline 40 ;      First := 0;
 LD   bool 0       ; false
 WRX  First
#debug_left bool First
#srcline 41 ;      Transciever.Command  := 128;     // DTR to SHORT ADDRESS
 LD   int 128
 WRX  Transciever~Command
#debug_left int Transciever.Command
#srcline 42 ;      Transciever.Adr_Oper := Address;
 LDX  Address
#debug usint Address
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
#srcline 43 ;    END_IF;
fb_DL_Address_L7:
#srcline 45 ;    IF AddToGroupe OR RemGroupe THEN
 LDX  AddToGroupe
#debug bool AddToGroupe
 LDX  RemGroupe
#debug bool RemGroupe
 OR  
 JMC  fb_DL_Address_L9
#srcline 46 ;      Transciever.Enable  := true;
 LD   bool -1       ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 47 ;      IF Value < 16 THEN
 LDX  Value
#debug usint Value
 LD   usint 16
 LT
 JMC  fb_DL_Address_L11
#srcline 48 ;        Transciever.Command  := WORD_TO_INT(USINT_TO_WORD(Value) AND 16#0F) +96; // 96..ADD TO GROUP    *** Pet 18.4.2013 rev1.7 opr.Group Ard 100..115
 LDX  Value
#debug usint Value
 LD   word $0F
 AND
 LD   int 96
 ADD
 EXTW
 WRX  Transciever~Command
#debug_left int Transciever.Command
#srcline 49 ;      ELSIF Value > 99 AND Value < 116 THEN
 JMP  fb_DL_Address_L12
fb_DL_Address_L11:
 LDX  Value
#debug usint Value
 LD   usint 99
 GT
 LDX  Value
#debug usint Value
 LD   usint 116
 LT
 AND
 JMC  fb_DL_Address_L13
#srcline 50 ;        Transciever.Command  := WORD_TO_INT(USINT_TO_WORD(Value-100) AND 16#0F) +96; // 96..ADD TO GROUP    *** Pet 18.4.2013 rev1.7 opr.Group Ard 100..115
 LDX  Value
#debug usint Value
 LD   usint 100
 SUB
 AND  $FF
 LD   word $0F
 AND
 LD   int 96
 ADD
 EXTW
 WRX  Transciever~Command
#debug_left int Transciever.Command
#srcline 51 ;      ELSE
 JMP  fb_DL_Address_L12
fb_DL_Address_L13:
#srcline 52 ;        Transciever.Enable  := 0;          // neposilat
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 53 ;      END_IF;
fb_DL_Address_L12:
#srcline 54 ;      IF RemGroupe THEN
 LDX  RemGroupe
#debug bool RemGroupe
 JMC  fb_DL_Address_L14
#srcline 55 ;        Transciever.Command  := Transciever.Command + 16; // Remove from GROUP
 LDX  Transciever~Command
#debug int Transciever.Command
 EXTW 
 LD   int 16
 ADD
 EXTW
 WRX  Transciever~Command
#debug_left int Transciever.Command
#srcline 56 ;      END_IF;
fb_DL_Address_L14:
#srcline 57 ;      Transciever.Adr_Oper := Address;
 LDX  Address
#debug usint Address
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
#srcline 58 ;    END_IF;
fb_DL_Address_L9:
#srcline 60 ;  END_IF;
fb_DL_Address_L1:
#srcline 61 ;  Transciever( Global_DALI_in := C_DL_ModuleIn, Global_DALI_out := C_DL_ModuleOut, Err =>Err, ErrID =>ErrID );
 LDX  C_DL_ModuleIn
 WRX  Transciever~Global_DALI_in
#debug_left pointer Transciever.Global_DALI_in
 LDX  C_DL_ModuleOut
 WRX  Transciever~Global_DALI_out
#debug_left pointer Transciever.Global_DALI_out
 LEAX Transciever
 CAL  fb_DL_Transceiver_L0
; output assigment 
 LDX  Transciever~Err
#debug bool Transciever~Err
 WRX  Err
#debug_left bool Err
 LDX  Transciever~ErrID
#debug usint Transciever~ErrID
 WRX  ErrID
#debug_left usint ErrID
#srcline 62 ;  IF Transciever.Done AND NOT First THEN
 LDX  Transciever~Done
#debug bool Transciever.Done
 LDX  First
#debug bool First
 NEG
 AND
 JMC  fb_DL_Address_L16
#srcline 63 ;    Done := 1 ;
 LD   bool -1      ; true
 WRX  Done
#debug_left bool Done
#srcline 64 ;    Transciever.Enable  := 0;
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 65 ;  END_IF;
fb_DL_Address_L16:
#srcline 66 ;  IF Transciever.Err THEN
 LDX  Transciever~Err
#debug bool Transciever.Err
 JMC  fb_DL_Address_L18
#srcline 67 ;    Err := 1;
 LD   bool -1      ; true
 WRX  Err
#debug_left bool Err
#srcline 68 ;    Transciever.Enable  := 0;
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 69 ;  END_IF;
fb_DL_Address_L18:
#srcline 70 ;  IF Done OR Err THEN Busy := 0; END_IF;
 LDX  Done
#debug bool Done
 LDX  Err
#debug bool Err
 OR  
 JMC  fb_DL_Address_L20
 LD   bool 0       ; false
 WRX  Busy
#debug_left bool Busy
fb_DL_Address_L20:
#srcline 71 ;END_FUNCTION_BLOCK
 ULNK
RET
E     61
#endpou 



 

#srcfile ''
