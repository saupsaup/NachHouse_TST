__DECL FUNCTION_BLOCK fb_DL_Transceiver {HIDDEN}
(*`{ENG} transmiter and receiver of DALI commands {CSY}*)
  VAR_INPUT
    Enable           : bool;  (*`{ENG} Enable {CSY}PovolenÌ*)
    Command          : int;  (*`{ENG} Command number (-1,0..287) according to the table in the documentation {CSY} »Ìslo p¯Ìkazu (-1,0..287) podle tabulky v dokumentaci*)
    Adr_Oper         : usint;  (*`{ENG} Address [0..63,100..115,255] for commands (1..128, 267, 268) or data for commands (-2,-1 257,258,264,265.266 and 272) {CSY}Adresa[0..63,100..115,255] pro p¯Ìkazy(1 aû 128, 267, 268) nebo Data pro p¯Ìkazy (-2,-1, 257,258,264,265,266 a 272)*)
    Power            : usint;  (*`{ENG} {CSY} Pro p¯Ìkaz -1 û·dan˝ v˝kon, pro p¯Ìkaz -2 maska p¯Ìkaz˘*)
  END_VAR
  VAR_OUTPUT
    Done             : bool;  (*`{ENG} Done {CSY}Hotovo*)
    Busy             : bool;  (*`{ENG} Busy {CSY}Zpracov·nÌ*)
    Yes              : bool;  (*`{ENG} Yes {CSY} Ano*)
    Err              : bool;  (*`{ENG} Error {CSY}Chyba*)
    ErrID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address, 3.. Not what to look for*)
    Output           : usint;  (*`{ENG} Reading value {CSY}P¯eËten· hodnota*)
  END_VAR
  VAR_IN_OUT
    Global_DALI_in   : tC_DL_0012Sin;
    Global_DALI_out  : tC_DL_0012Sout;
  END_VAR
  VAR
    command_old      : int;  (*`pamÏù p¯Ìkazu*)
    Adr_Oper_old     : usint;  (*`pamÏù adresy*)
    Power_old        : usint;  (*`pamÏù Power*)
    NewMessage       : tC_DL_0012Sout;  (*`1.zpr·va pro odvysÌl·nÌ*)
    WatchDog         : TON;  (*`WatchDog pro dummy4*)
    WatchDog1        : TON;  (*`WatchDog pro Confirmace*)
    Answer           : bool;  (*`OËek·vat odpovÏÔ*)
    RqMes            : bool;
    Confirmation     : bool;  (*`je stav Ëek·nÌ na potvrzenÌ p¯es DONE =1*)
    Confirmation1    : bool;  (*`je stav Ëek·nÌ na potvrzenÌ p¯es DONE =0*)
    ARC_old          : bool;  (*`pamÏù alternace*)
    Enable_old       : bool;
    pom_Bit          : bool;
    PocOpak          : usint;  (*`poËet opakov·nÌ povel˘ p¯i chybÏ     //****Pet 1.10.2014*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_DL_Blink
(*`{ENG}Blinking{CSY}Blik·nÌ*)
  VAR_INPUT
    Enable           : bool;  (*`{ENG} enable{CSY} povolit*)
    T_Blink          : time :=  T#1.0s;  (*`{ENG} time of blink pulse {CSY}doba impulzu blikanÌ*)
    ShAdr            : usint;  (*`{ENG} manually assigned ShortAdr{CSY} manualnÏ p¯idÏlen· ShortAdr*)
  END_VAR
  VAR_OUTPUT
    Done             : bool;  (*`{ENG} done {CSY}hotovo*)
    Busy             : bool;  (*`{ENG} busy {CSY}zpracov·nÌ*)
    Err              : bool;  (*`{ENG} error {CSY}nastala chyba*)
    ErrID            : usint;  (*`{ENG} 1.. Request WatchDog, 2.. Any collision of Short Address*)
    Status           : bool;  (*`{ENG} status of lamp On/Off {CSY} stav lampy On/Off*)
  END_VAR
  VAR_IN_OUT
    C_DL_ModuleIn    : tC_DL_0012Sin;
    C_DL_ModuleOut   : tC_DL_0012Sout;
  END_VAR
  VAR
    TM_Blink         : TON;  (*`Ëas blikanÌ v 0*)
    Transciever {HIDDEN} : fb_DL_Transceiver;
    State            : usint;  (*`internal state*)
    ActualLevel      : usint;  (*`aktu·lnÌ hodnota p¯ed blok·nÌm*)
    Enable_old       : bool;
    ShortAdr         : usint;  (*`{ENG} new Short Address {CSY}nov· Short Address, kter· bude blikat*)
  END_VAR
END_FUNCTION_BLOCK

__DECL FUNCTION_BLOCK fb_DL_Address
(*`{ENG} set ShortAddres, add/rem Groupe {CSY} nastavenÌ ShortAddresy, p¯idat/odebrat do/z skupiny "groupe"*)
  VAR_INPUT
    ShortAddr        : bool R_EDGE;  (*`{ENG} Store as SHORT ADDRESS {CSY} uloûit jako kr·tkou adresu*)
    AddToGroupe      : bool R_EDGE;  (*`{ENG} Add to GROUP {CSY} p¯idat do skupiny*)
    RemGroupe        : bool R_EDGE;  (*`{ENG} Remove from GROUP {CSY} odebrat ze skupiny*)
    Value            : usint;  (*`{ENG} New address or groupe number {CSY} Nov· adresa, nebo ËÌslo skupiny*)
    Address          : usint;  (*`{ENG}ShortAddress= 0 .. 63 or GroupAddress= 100 .. 115 {CSY}Kr·tk· adresa= 0 .. 63 nebo Skupinov· adresa= 100 .. 115*)
  END_VAR
  VAR_OUTPUT
