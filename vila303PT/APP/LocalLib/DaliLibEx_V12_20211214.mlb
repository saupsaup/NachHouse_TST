fb_DL_RNDAddr_L3:
#srcline 57 ;//  IF(State = 0 ) AND (Auto_Man AND NOT Auto_Man_old) THEN
#srcline 58 ;//    State := 30; Blinking.Enable := 1; Blinking.ShAdr := ShAdr; ShortAdr := ShAdr;
#srcline 59 ;//    Busy  := true; Done := false;
#srcline 60 ;//  END_IF;
#srcline 61 ;  Aktiv     :=0;
