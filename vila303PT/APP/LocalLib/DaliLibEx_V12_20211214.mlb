#pou fb_DL_Direct
#srcline 1 ;FUNCTION_BLOCK fb_DL_Direct
P     61
fb_DL_Direct_L0:
 LINK 0
#srcline 26 ;  IF ((PowerOld <> Power) OR  NOT Enable_old) AND Enable AND NOT Busy THEN // zmÏna power odeöle nov˝ p¯Ìkaz nebo
 LDX  PowerOld
#debug usint PowerOld
 LDX  Power
#debug usint Power
 EQ
 NEG
 LDX  Enable_old
#debug bool Enable_old
 NEG
 OR  
 LDX  Enable
#debug bool Enable
 AND
 LDX  Busy
#debug bool Busy
 NEG
 AND
 JMC  fb_DL_Direct_L1
#srcline 27 ;    Transciever.Command := -1; Transciever.Enable := 1;
 LD   int -1
 WRX  Transciever~Command
#debug_left int Transciever.Command
 LD   bool -1      ; true
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
#srcline 28 ;    Transciever.Adr_Oper := Address;
 LDX  Address
#debug usint Address
 WRX  Transciever~Adr_Oper
#debug_left usint Transciever.Adr_Oper
#srcline 29 ;    Transciever.Power := Power;       // zadan˝ v˝kon
 LDX  Power
#debug usint Power
 WRX  Transciever~Power
#debug_left usint Transciever.Power
#srcline 30 ;    PowerOld := Power;
 LDX  Power
#debug usint Power
 WRX  PowerOld
#debug_left usint PowerOld
#srcline 31 ;  END_IF;
fb_DL_Direct_L1:
#srcline 32 ;  Transciever( Global_DALI_in := C_DL_ModuleIn, Global_DALI_out := C_DL_ModuleOut,Done => Done, Busy => Busy,  ErrID => ErrID, Err => Err );   // vysÌlaË DALI
 LDX  C_DL_ModuleIn
 WRX  Transciever~Global_DALI_in
#debug_left pointer Transciever.Global_DALI_in
 LDX  C_DL_ModuleOut
 WRX  Transciever~Global_DALI_out
#debug_left pointer Transciever.Global_DALI_out
 LEAX Transciever
 CAL  fb_DL_Transceiver_L0
; output assigment 
 LDX  Transciever~Done
#debug bool Transciever~Done
 WRX  Done
#debug_left bool Done
 LDX  Transciever~Busy
#debug bool Transciever~Busy
 WRX  Busy
#debug_left bool Busy
 LDX  Transciever~ErrID
#debug usint Transciever~ErrID
 WRX  ErrID
#debug_left usint ErrID
 LDX  Transciever~Err
#debug bool Transciever~Err
 WRX  Err
#debug_left bool Err
#srcline 33 ;  Enable_old := Enable;
 LDX  Enable
#debug bool Enable
 WRX  Enable_old
#debug_left bool Enable_old
#srcline 34 ;  IF NOT Transciever.Busy THEN Transciever.Enable := 0; END_IF;
 LDX  Transciever~Busy
#debug bool Transciever.Busy
 NEG
 JMC  fb_DL_Direct_L3
 LD   bool 0       ; false
 WRX  Transciever~Enable
#debug_left bool Transciever.Enable
fb_DL_Direct_L3:
#srcline 35 ;//------------------------------------------------------------------
#srcline 36 ;END_FUNCTION_BLOCK
 ULNK
RET
E     61
#endpou 



 

