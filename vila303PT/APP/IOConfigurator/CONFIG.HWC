;Upozornení
;Soubor je automaticky regenerován a všechny rucní modifikace budou ztracené.

#struct _TTS_UNIINIT
        UINT code,
        UINT mode,
        USINT chMod,
        USINT adr,
        USINT speed,
        USINT tor,
        USINT tot,
        USINT rez1,
        USINT rez11,
        USINT interface,
        WORD sysMap,
        USINT[10] rez2,
        UINT lendi,
        UINT lendo,
        UDINT idati,
        UDINT idato,
        USINT lnc,
        USINT msc,
        USINT opd,
        USINT opm,
        USINT prot,
        USINT sdl,
        USINT edl,
        USINT edh,
        USINT acl,
        USINT ach,
        UINT pad,
        UINT pas,
        UINT chs,
        UINT plm,
        UINT mlm

#struct TModulE2
        USINT version,
        UDINT hwCode,
        DWORD busId,
        UDINT address,
        UDINT port,
        UINT lenInputs,
        UINT lenOutputs,
        DINT offsetInputs,
        DINT offsetOutputs,
        INT initTable,
        INT driverInitTable

#struct _TTS_Head
        UINT ModulID,
        BYTE Stat0,
        BYTE Stat1

#struct _TTS_EnbCNTI
        BYTE ESCNT,
        BYTE ECNT,
        BYTE ECNTB

#struct _TTS_EnbCNTO
        BYTE ECCNT,
        BYTE ESET

#struct _TTS_SPE4
        BOOL SPE0,
        BOOL SPE1,
        BOOL SPE2,
        BOOL SPE3,
        BOOL dummy4,
        BOOL dummy5,
        BOOL dummy6,
        BOOL dummy7

#struct _TTS_SPP4
        BOOL SPP0,
        BOOL SPP1,
        BOOL SPP2,
        BOOL SPP3,
        BOOL dummy4,
        BOOL dummy5,
        BOOL dummy6,
        BOOL dummy7

#struct T_CFGCNT
        BOOL dummy0,
        BOOL dummy1,
        BOOL PNI,
        BOOL PMD,
        BOOL dummy4,
        BOOL dummy5,
        BOOL dummy6,
        BOOL dummy7

#struct _TTS_IniCNT
        BYTE MODCNT,
        T_CFGCNT CFGCNT

#struct _TTS_IR1501
        _TTS_Head Head,
        USINT EDI,
        USINT EDIP,
        _TTS_EnbCNTI[2] ECNTI,
        USINT EDO,
        USINT Erez,
        _TTS_EnbCNTO[2] ECNTO,
        _TTS_SPE4 SPE,
        _TTS_SPP4 SPP,
        _TTS_IniCNT[2] SetCNT

#struct _TCIBHeader_
        UINT code,
        WORD mode,
        WORD fadr,
        USINT ladr,
        USINT ndev

#struct _TCIBDevice
        BYTE typdev,
        BYTE bloko,
        UINT leindev,
        UINT leoutdev

#struct TCIB_3357_init
        _TCIBHeader_ Header,
        _TCIBDevice[5] Dev,
        INT thermOffset,
        BYTE ai1type,
        BYTE ai2type,
        USINT thermTau,
        USINT ai1tau,
        USINT ai2tau,
        USINT tPress

#struct TCIB_3361_init
        _TCIBHeader_ Header,
        _TCIBDevice[6] Dev,
        BYTE ezs,
        USINT tPress,
        INT thermOffset,
        BYTE ai1type,
        BYTE ai2type,
        USINT ai1tau,
        USINT ai2tau,
        USINT co2tau

#struct TCIB_3356_init
        _TCIBHeader_ Header,
        _TCIBDevice[5] Dev,
        INT thermOffset,
        BYTE ai1type,
        BYTE ai2type,
        USINT thermTau,
        USINT ai1tau,
        USINT ai2tau,
        USINT tPress

#struct TCIB_3367_init
        _TCIBHeader_ Header,
        _TCIBDevice[2] Dev,
        BYTE manDis

#struct TCIB_3303_init
        _TCIBHeader_ Header,
        _TCIBDevice[2] Dev,
        BYTE manDis

#struct TCIB_3368_init
        _TCIBHeader_ Header,
        _TCIBDevice Dev1,
        _TCIBDevice Dev2,
        _TCIBDevice Dev3,
        BYTE manDis,
        USINT reversTime

#struct TCIB_3306_init
        _TCIBHeader_ Header,
        _TCIBDevice[6] Dev,
        BYTE ezsenb1,
        BYTE ezsenb2,
        BYTE ezsenb3,
        BYTE ezstype1,
        BYTE ezstype2,
        BYTE ezstype3,
        USINT tPress,
        BYTE ai1type,
        BYTE ai2type,
        BYTE ai3type,
        BYTE ai4type,
        USINT ai1tau,
        USINT ai2tau,
        USINT ai3tau,
        USINT ai4tau

#struct TCIB_3326_init
        _TCIBHeader_ Header,
        _TCIBDevice[5] Dev,
        BYTE ezsenb,
        BYTE ezstype,
        BYTE ai1_4type,
        BYTE ai5type,
        USINT ai1_4tau,
        USINT ai5tau

#struct TCIB_3347_init
        _TCIBHeader_ Header,
        _TCIBDevice[5] Dev,
        BYTE ai1type,
        BYTE ai2type,
        USINT ai1tau,
        USINT ai2tau

#struct _TTS_EnbCHAI
        BYTE ESTAT,
        BYTE EFS,
        BYTE EENG,
        BYTE EPCT

#struct _TTS_IniCHAI
        BYTE Mode,
        USINT Filter,
        REAL Offset,
        REAL Gain

#struct _TTS_IR2553
        _TTS_Head Head,
        USINT NUMVARI,
        USINT NUMVARO,
        USINT EDIS,
        USINT EDIP,
        _TTS_EnbCHAI[4] EAI,
        USINT ESTPW,
        USINT EUSRC,
        USINT ESACU,
        USINT EIACU,
        USINT EDOS,
        _TTS_SPE4 SPE,
        _TTS_SPP4 SPP,
        _TTS_IniCHAI[4] SetAI

#struct _TTS_OI2872
        _TTS_Head Head,
        USINT NUMVARI,
        USINT NUMVARO,
        BYTE EKEY,
        BYTE EDISP0,
        BYTE EDISP1,
        BYTE EDISP2,
        BYTE EDISP3,
        BYTE ECDPG,
        UINT CDPG,
        USINT AREP,
        BYTE MARK,
        UINT LIGHTTIME,
        DWORD MODE

